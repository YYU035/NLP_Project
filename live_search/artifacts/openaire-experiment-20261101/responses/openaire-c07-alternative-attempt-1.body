icles::253e0792781052f6209709122ab03589","value":"Nutrients"},"collectedFrom":{"key":"openaire____::c2cdfa5866e03cdd07d313cbc8fb8311","value":"Multidisciplinary Digital Publishing Institute"}}],"links":[],"otherTitles":null,"inDiamondJournal":false,"green":true,"isGreen":true,"isInDiamondJournal":false},{"authors":[{"id":null,"fullName":"Marni E, Shoemaker","name":"Marni E","surname":"Shoemaker","rank":1,"pid":null},{"id":null,"fullName":"Linda M, Huynh","name":"Linda M","surname":"Huynh","rank":2,"pid":null},{"id":null,"fullName":"Cory M, Smith","name":"Cory M","surname":"Smith","rank":3,"pid":null},{"id":null,"fullName":"Vikkie A, Mustad","name":"Vikkie A","surname":"Mustad","rank":4,"pid":null},{"id":null,"fullName":"Maria O, Duarte","name":"Maria O","surname":"Duarte","rank":5,"pid":null},{"id":"orcid_______::1616940525aa210a47f971dc54a15007","fullName":"Joel T, Cramer","name":"Joel T","surname":"Cramer","rank":6,"pid":{"id":{"scheme":"orcid","value":"0000-0002-5270-9359"},"provenance":null}}],"openAccessColor":null,"publiclyFunded":false,"eoscIfGuidelines":null,"type":"publication","language":{"code":"eng","label":"English"},"countries":null,"subjects":[{"subject":{"scheme":"FOS","value":"0301 basic medicine"},"provenance":null},{"subject":{"scheme":"FOS","value":"0303 health sciences"},"provenance":null},{"subject":{"scheme":"FOS","value":"03 medical and health sciences"},"provenance":null},{"subject":{"scheme":"SDG","value":"3. Good health"},"provenance":null}],"mainTitle":"Immunomodulatory Effects of Vitamin D and Prevention of Respiratory Tract Infections and COVID-19","subTitle":null,"descriptions":["<jats:p>Little is known about potential protective factors for severe acute respiratory syndrome coronavirus 2 (SARS-CoV-2), referred to as COVID-19. Suboptimal vitamin D status is a risk factor for immune dysfunction, respiratory tract infections (RTIs), and viral infections. Supplementation of vitamin D (2000–4000 IU) has decreased incidence and complications from RTIs, respiratory distress syndrome, and pneumonia and may be beneficial in high-risk populations. Given the possible link between low vitamin D status and RTIs, such as COVID-19, this review examined whether vitamin D supplementation can be supported as a nutritional strategy for reducing risk of infection, complications, and mortality from COVID-19 and found that the relationship between vitamin D and RTIs warrants further exploration.</jats:p>"],"publicationDate":"2022-07-01","publisher":"Ovid Technologies (Wolters Kluwer Health)","embargoEndDate":null,"sources":["Crossref"],"formats":null,"contributors":null,"coverages":null,"bestAccessRight":null,"container":{"name":"Topics in Clinical Nutrition","issnPrinted":"0883-5691","issnOnline":null,"issnLinking":null,"ep":"217","iss":null,"sp":"203","vol":"37","edition":null,"conferencePlace":null,"conferenceDate":null},"documentationUrls":null,"codeRepositoryUrl":null,"programmingLanguage":null,"contactPeople":null,"contactGroups":null,"tools":null,"size":null,"version":null,"geoLocations":null,"id":"doi_dedup___::45e15afe350e391b9f6dc9c64d6ba037","originalIds":["10.1097/tin.0000000000000284","50|doiboost____|45e15afe350e391b9f6dc9c64d6ba037","od_______267::18aea94a3890f3252e9fcb66d76ec972","35761885","PMC9222791"],"pids":[{"scheme":"doi","value":"10.1097/tin.0000000000000284"},{"scheme":"pmid","value":"35761885"},{"scheme":"pmc","value":"PMC9222791"}],"dateOfCollection":null,"lastUpdateTimeStamp":null,"indicators":{"citationImpact":{"citationCount":5.0,"influence":2.2551305E-9,"popularity":4.6822843E-9,"impulse":5.0,"citationClass":"C5","influenceClass":"C5","impulseClass":"C4","popularityClass":"C4"}},"projects":null,"organizations":[{"legalName":"University of Nebraska Medical Center","acronym":"UNMC","id":"openorgs____::29f92fd653ac64addc9d6f0ae0da5ae9","pids":[{"scheme":"fundref","value":"100008291"},{"scheme":"GRID","value":"grid.266813.8"},{"scheme":"fundref","value":"100006518"},{"scheme":"ROR","value":"