34"}],"alternateIdentifiers":[{"scheme":"doi","value":"10.1109/aero55745.2023.10115580"},{"scheme":"urn","value":"2-s2.0-85160553176"}],"accessRight":{"code":"c_14cb","label":"CLOSED","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/","openAccessRoute":null},"type":"Conference object","urls":["https://ieeexplore.ieee.org/document/10115580","https://doi.org/10.1109/aero55745.2023.10115580","https://hdl.handle.net/11588/1005134"],"publicationDate":"2023-01-01","refereed":"nonPeerReviewed","hostedBy":{"key":"opendoar____::d8c24ca8f23c562a5600876ca2a550ce","value":"Archivio della ricerca - Università degli studi di Napoli Federico II"},"collectedFrom":{"key":"opendoar____::d8c24ca8f23c562a5600876ca2a550ce","value":"Archivio della ricerca - Università degli studi di Napoli Federico II"}}],"links":[],"otherTitles":null,"inDiamondJournal":false,"green":false,"isGreen":false,"isInDiamondJournal":false},{"authors":[{"id":"orcid_______::faea58398a7f5bde85801c880fc0ee3d","fullName":"Ngwashi, Divine Khan","name":"Divine Khan","surname":"Ngwashi","rank":1,"pid":{"id":{"scheme":"orcid","value":"0000-0002-1188-5524"},"provenance":null}},{"id":"orcid_______::d76481b0bb8f1ff587ad7de0878c699a","fullName":"Phung, Luong Viêt","name":"Luong Viêt","surname":"Phung","rank":2,"pid":{"id":{"scheme":"orcid","value":"0000-0003-0469-046x"},"provenance":null}}],"openAccessColor":null,"publiclyFunded":false,"eoscIfGuidelines":null,"type":"publication","language":{"code":"eng","label":"English"},"countries":[{"code":"FR","label":"France","provenance":null}],"subjects":[{"subject":{"scheme":"keyword","value":"[SPI]Engineering Sciences [physics]"},"provenance":null},{"subject":{"scheme":"keyword","value":"Threshold voltage"},"provenance":null},{"subject":{"scheme":"keyword","value":"[SPI] Engineering Sciences [physics]"},"provenance":null},{"subject":{"scheme":"FOS","value":"0103 physical sciences"},"provenance":null},{"subject":{"scheme":"FOS","value":"0202 electrical engineering, electronic engineering, information engineering"},"provenance":null},{"subject":{"scheme":"keyword","value":"Failures"},"provenance":null},{"subject":{"scheme":"keyword","value":"621"},"provenance":null},{"subject":{"scheme":"keyword","value":"SiC MOSFETs"},"provenance":null},{"subject":{"scheme":"keyword","value":"Instability"},"provenance":null},{"subject":{"scheme":"FOS","value":"02 engineering and technology"},"provenance":null},{"subject":{"scheme":"FOS","value":"01 natural sciences"},"provenance":null},{"subject":{"scheme":"SDG","value":"7. Clean energy"},"provenance":null},{"subject":{"scheme":"keyword","value":"620"},"provenance":null}],"mainTitle":"Recent review on failures in silicon carbide power MOSFETs","subTitle":null,"descriptions":["Abstract   In every new technology, the understanding of its failure mechanism is essential to ensure reliability. In this paper an overview on some state-of-the-art characterization methods of 4H-SiC metal oxide semiconductor field effect transistors (MOSFETs) are presented. Silicon-based devices employ many different tools for the study of failure mechanism, which can be exploited for silicon carbide (SiC) devices. Silicon carbide semiconductor offers very interesting electrical and thermal properties for power electronics application in comparison to Si but exhibits different failure mechanisms that need to be studied. Silicon carbide MOSFETs allow for a better energy conversion efficiency in comparison to silicon-based devices, with potential applications in electric vehicles and microgrids converters. Silicon carbide technology can greatly improve on electrical energy management and so failure mechanism studies will lead to the production of robust and high performance devices."],"publicationDate":"2021-08-01","publisher":"Elsevier BV","embargoEndDate":null,"sources":["Crossref"],"formats":null,"contributors":["Phung, Luong Viêt","University of Buéa","Ampère, Département Energie Electrique (EE)","Ampère (AMPERE)","École Centrale de Lyon (ECL)","Université de Lyon-Université de Lyon-Université Claude Bernard Lyon 1 (UCBL)","Université de Lyon-Institut National des Sciences Appliquées de Lyon (INSA Lyon)","Université de Lyon-Institut National des Sciences Appliquées (INSA)-Institut National des Sciences Appliquées (INSA)-Centre National de la Recherche Scientifique (CNRS)-Institut National de Recherche pour l’Agriculture, l’Alimentation et l’Environnement (INRAE)-École Centrale de Lyon (ECL)","Université de Lyon-Institut National des Sciences Appliquées (INSA)-Institut National des Sciences Appliquées (INSA)-Centre National de la Recherche Scientifique (CNRS)-Institut National de Recherche pour l’Agriculture, l’Alimentation et l’Environnement (INRAE)"],"coverages":null,"bestAccessRight":{"code":"c_14cb","label":"CLOSED","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/"},"container":{"name":"Microelectronics Reliability","issnPrinted":"0026-2714","issnOnline":null,"issnLinking":null,"ep":null,"iss":null,"sp":"114169","vol":"123","edition":null,"conferencePlace":null,"conferenceDate":null},"documentationUrls":null,"codeRepositoryUrl":null,"programmingLanguage":null,"contactPeople":null,"contactGroups":null,"tools":null,"size":null,"version":null,"geoLocations":null,"id":"doi_dedup___::1ada5427a08fd575a4243453aefeceeb","originalIds":["S0026271421001359","10.1016/j.microrel.2021.114169","50|doiboost____|1ada5427a08fd575a4243453aefeceeb","3168854508","oai:HAL:hal-03268425v1","50|od______9730::625b9193e90a79a1e9a7dd86111c3503","50|base_oa_____::b83ae79e7b4d5ccb885d57a90cb981c3","ftinraparis:oai:HAL:hal-03268425v1"],"pids":[{"scheme":"doi","value":"10.1016/j.microrel.2021.114169"}],"dateOfCollection":null,"lastUpdateTimeStamp":null,"indicators":{"citationImpact":{"citationCount":38.0,"influence":5.126567E-9,"popularity":2.7191613E-8,"impulse":18.0,"citationClass":"C4","influenceClass":"C4","impulseClass":"C4","popularityClass":"C4"}},"proj