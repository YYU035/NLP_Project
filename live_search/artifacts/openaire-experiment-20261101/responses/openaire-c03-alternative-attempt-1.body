nType":"resultProject","relationClass":"isProducedBy","relatedIdentifier":"ukri________::d44576fbe0ea04f64c6a46081f6992b9","relatedRecordType":"project","relationProvenance":"iis","trust":"0.6971"},"collectedfrom":[{"dsId":"openaire____::92ed35af5f7f859de570d1d2919c09a4","dsName":"UK Research and Innovation"}],"projectTitle":"Reliability, Condition Monitoring and Health Management Technologies for WBG Power Modules","code":"EP/R004366/1","funding":{"funder":{"id":"ukri________::UKRI","shortname":"UKRI","name":"UK Research and Innovation","jurisdiction":{"code":"GB","label":"United Kingdom"},"pid":null},"level0":{"id":"ukri________::UKRI::EPSRC","description":"EPSRC","name":"EPSRC"},"level1":{"id":null,"description":null,"name":null},"level2":{"id":null,"description":null,"name":null}},"startDate":"2017-10-01","endDate":"2021-12-31"}],"otherTitles":null,"inDiamondJournal":false,"green":true,"isGreen":true,"isInDiamondJournal":false},{"authors":[{"id":"orcid_______::91fb14b141ed8a025740d680fb0f02dc","fullName":"Deldimos, Dimitrios","name":"Dimitrios","surname":"Deldimos","rank":1,"pid":{"id":{"scheme":"orcid","value":"0009-0005-9934-2020"},"provenance":null}},{"id":null,"fullName":"Stella, Fausto","name":"Fausto","surname":"Stella","rank":2,"pid":{"id":{"scheme":"orcid_pending","value":"0000-0002-0101-8435"},"provenance":null}},{"id":"orcid_______::cb6a50c9c4c617243de1c880f719fe2a","fullName":"Pellegrino, Gianmario","name":"Gianmario","surname":"Pellegrino","rank":3,"pid":{"id":{"scheme":"orcid","value":"0000-0003-4264-1917"},"provenance":null}}],"openAccessColor":null,"publiclyFunded":false,"eoscIfGuidelines":null,"type":"publication","language":{"code":"und","label":"Undetermined"},"countries":[{"code":"IT","label":"Italy","provenance":null}],"subjects":[{"subject":{"scheme":"FOS","value":"0202 electrical engineering, electronic engineering, information engineering"},"provenance":null},{"subject":{"scheme":"FOS","value":"02 engineering and technology"},"provenance":null}],"mainTitle":"Dynamic Redistribution of Switching Losses in Parallel Connected SiC MOSFETs for Active Thermal Balance","subTitle":null,"descriptions":["SiC MOSFETs are quickly replacing silicon-based devices in high-power applications because of their enhanced electrical and thermal performance. However, due to fabrication limitations, commercial SiC dies have lower current ratings compared to their silicon counterparts. Consequently, multiple Si C MOSFETs need to be connected in parallel for high-current applications. This leads to thermal imbalances among the devices, caused by asymmetrical layouts and parameter mismatches. To tackle this problem, this paper presents an active thermal balancing control strategy that monitors the case temperatures of parallel-connected Si C MOSFETs and dynamically redistributes the switching losses among the power devices. The proposed solution enables optimal utilization of each device, eliminating the need for current derating that is commonly necessary in parallel-connected switching devices. Experimental results are provided to verify the proposed approach."],"publicationDate":"2025-10-19","publisher":"IEEE","embargoEndDate":null,"sources":["Crossref"],"formats":["application/pdf"],"contributors":null,"coverages":null,"bestAccessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/"},"container":{"name":"2025 IEEE Energy Conversion Conference Congress and Exposition (ECCE)","issnPrinted":null,"issnOnline":null,"issnLinking":null,"ep":"6","iss":null,"sp":"1","vol":null,"edition":null,"conferencePlace":null,"conferenceDate":null},"documentationUrls":null,"codeRepositoryUrl":null,"programmingLanguage":null,"contactPeople":null,"contactGroups":null,"tools":null,"size":null,"version":null,"geoLocations":null,"id":"doi_dedup___::454d319527bf0bed7f3fec326eba8d06","originalIds":["10.1109/ecce58356.2025.11259784","50|doiboost____|454d319527bf0bed7f3fec326eba8d06","50|od______2153::bbf92b4bcf6b1da5e7637c5774563699","oai:iris.polito.it:11583/3005632"],"pids":[{"scheme":"doi","value":"10.1109/ecce58356.2025.11259784"},{"scheme":"handle","value":"11583/3005632"}],"dateOfCollection":null,"lastUpdateTimeStamp":null,"indicators":{"citationImpact":{"citationCount":2.0,"influence":2.2820803E-9,"popularity":3.5571932E-9,"impulse":2.0,"citationClass":"C5","influenceClass":"C5","impulseClass":"C5","popularityClass":"C4"}},"projects":null,"organizations":[{"legalName":"Polytechnic University of Turin","acronym":"POLITO","id":"openorgs____::d3e085ecb411286b3e3929a885b7a9ce","pids":[{"scheme":"ROR","value":"https://ror.org/00bgk9508"},{"scheme":"PIC","value":"999977754"},{"scheme":"Wikidata","value":"Q392897"},{"scheme":"GRID","value":"grid.4800.c"},{"scheme":"OrgReg","value":"IT0082"},{"scheme":"ISNI","value":"0000000419370343"},{"scheme":"mag_id","value":"177477856"},{"scheme":"OrgRef","value":"911906"},{"scheme":"fundref","value":"100013000"},{"scheme":"FundRef","value":"100013000"},{"scheme":"wikidata","value":"Q392897"}],"countries":[{"code":"IT","label":"Italy"}],"websiteurl":"http://www.polito.it/"}],"communities":null,"collectedFrom":[{"key":"opendoar____::cb8da6767461f2812ae4290eac7cbc42","value":"Publications Open Repository TOrino"},{"key":"openaire____::081b82f96300b6a6e3d282bad31cb6e2","value":"Crossref"}],"instances":[{"pids":[{"scheme":"doi","value":"10.1109/ecce58356.2025.11259784"}],"license":"STM Policy #29","accessRight":{"code":"c_14cb","label":"CLOSED","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/","openAccessRoute":null},"type":"Article","urls":["https://doi.org/10.1109/ecce58356.2025.11259784"],"publicationDate":"2025-10-19","refereed":"peerReviewed","hostedBy":{"key":"openaire____::55045bd2a65019fd8e6741a755395c8c","value":"Unknown Repository"},"collectedFrom":{"key":"openaire____::081b82f96300b6a6e3d282bad31cb6e2","value":"Crossref"}},{"pids":[{"scheme":"handle","value":"11583/3005632"}],"alternateIdentifiers":[{"scheme":"doi","value":"10.1109/ecce58356.2025.11259784"},{"scheme":"urn","value":"2-s2.0-105030333250"}],"accessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/","openAccessRoute":null},"type":"Conference object","urls":["https://doi.org/10.1109/ecce58356.2025.11259784","https://hdl.handle.net/11583/3005632"],"publicationDate":"2025-01-01","refereed":"nonPeerReviewed","hostedBy":{"key":"opendoar____::cb8da6767461f2812ae4290eac7cbc42","value":"Publications Open Repository TOrino"},"collectedFrom":{"key":"opendoar____::cb8da6767461f2812ae4290eac7cbc42","value":"Publications Open Repository TOrino"}}],"links":[],"otherTitles":null,"inDiamondJournal":false,"green":false,"isGreen":false,"isInDiamondJournal":false},{"authors":[{"id":null,"fullName":"Zhengyang Li","name":"Zhengyang","surname":"Li","rank":1,"pid":null}],"openAccessColor":"hybrid","publiclyFunded":false,"eoscIfGuidelines":null,"type":"publication","language":{"code":"und","label":"Undetermined"},"countries":null,"subjects":[{"subject":{"scheme":"FOS","value":"0202 electrical engineering, electronic engineering, information engineering"},"provenance":null},{"subject":{"scheme":"FOS","value":"02 engineering and technology"},"provenance":null}],"mainTitle":"High-Voltage Direct Current Transmission Systems Based on Silicon Carbide MOSFETs","subTitle":null,"descriptions":["<jats:p>High-Voltage Direct Current (HVDC) transmission technology plays a pivotal role in modern power systems due to its capability for efficient long-distance power transmission. Compared to traditional High-Voltage Alternating Current (HVAC) transmission, HVDC systems offer significant advantages in reducing transmission losses, enhancing transmission capacity, and bolstering system stability. In recent years, the use of Silicon Carbide (SiC) materials in power electronic devices has gained widespread attention. Compared to traditional silicon-based MOSFETs, SiC MOSFETs have a higher breakdown electric field, a wider bandgap, and higher thermal conductivity. These characteristics makes them highly promising in high-voltage, high-power applications and considered a significant developmental direction for future high-performance power electronic devices. This paper will initially introduce the material characteristics of SiC, including polymorphism, wide bandgap, and diverse characteristic colors. It will also discuss the structure and main characteristics of SiC MOSFETs, including transfer, output, and breakdown characteristics. Subsequently, it will present the fundamental principles of HVDC systems and the two primary topologies: Line Commutated Converter HVDC and Voltage Source Converters HVDC. Lastly, it will discuss the advantages of SiC MOSFETs over silicon devices in HVDC, along with potential application prospects. The research findings indicate that SiC MOSFETs possess significant application potential and technological advantages in high-voltage direct current transmission, providing theoretical support and a practical foundation for the optimization of future power electronic systems. </jats:p>"],"publicationDate":"2024-11-25","publisher":"Warwick Evans Publishing","embargoEndDate":null,"sources":["Crossref"],"formats":null,"contributors":null,"coverages":null,"bestAccessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/"},"container":{"name":"Transactions on Computer Science and Intelligent Systems Research","issnPrinted":"2960-1800","issnOnline":"2960-2238","issnLinking":null,"ep":"19","iss":null,"sp":"13","vol":"7","edition":null,"conferencePlace":null,"conferenceDate":null},"documentationUrls":null,"codeRepositoryUrl":null,"programmingLanguage":null,"contactPeople":null,"contactGroups":null,"tools":null,"size":null,"version":null,"geoLocations":null,"id":"doi_________::d112c6706792b2d087abb2775ee4fce8","originalIds":["