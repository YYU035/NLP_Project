s":[{"scheme":"doi","value":"10.1109/irps45951.2020.9129259"}],"type":"Conference object","urls":["https://doi.org/10.1109/IRPS45951.2020.9129259","https://dblp.org/rec/conf/irps/BerensWPARSG20.html"],"refereed":"nonPeerReviewed","hostedBy":{"key":"openaire____::d8b68cc0a53121f6f896883a7d60c1db","value":"DBLP"},"collectedFrom":{"key":"openaire____::d8b68cc0a53121f6f896883a7d60c1db","value":"DBLP"}},{"alternateIdentifiers":[{"scheme":"mag_id","value":"3040580115"},{"scheme":"doi","value":"10.1109/irps45951.2020.9129259"}],"type":"Article","urls":["https://dx.doi.org/10.1109/irps45951.2020.9129259"],"refereed":"nonPeerReviewed","hostedBy":{"key":"openaire____::55045bd2a65019fd8e6741a755395c8c","value":"Unknown Repository"},"collectedFrom":{"key":"openaire____::5f532a3fc4f1ea403f37070f59a7a53a","value":"Microsoft Academic Graph"}},{"alternateIdentifiers":[{"scheme":"mag_id","value":"3040580115"},{"scheme":"doi","value":"10.1109/irps45951.2020.9129259"}],"type":"Article","urls":["https://dx.doi.org/10.1109/irps45951.2020.9129259"],"refereed":"nonPeerReviewed","hostedBy":{"key":"openaire____::55045bd2a65019fd8e6741a755395c8c","value":"Unknown Repository"},"collectedFrom":{"key":"openaire____::5f532a3fc4f1ea403f37070f59a7a53a","value":"Microsoft Academic Graph"}}],"links":[],"otherTitles":null,"inDiamondJournal":false,"green":false,"isGreen":false,"isInDiamondJournal":false},{"authors":[{"id":"orcid_______::c061f3e95d2b351ab0e92add98a728b9","fullName":"Borghese, A.","name":"A.","surname":"Borghese","rank":1,"pid":{"id":{"scheme":"orcid","value":"0000-0002-6285-4242"},"provenance":null}},{"id":null,"fullName":"Boccarossa, M.","name":"M.","surname":"Boccarossa","rank":2,"pid":null},{"id":null,"fullName":"Riccio, M.","name":"M.","surname":"Riccio","rank":3,"pid":{"id":{"scheme":"orcid_pending","value":"0000-0002-5926-4911"},"provenance":null}},{"id":null,"fullName":"Maresca, L.","name":"L.","surname":"Maresca","rank":4,"pid":null},{"id":null,"fullName":"Breglio, G.","name":"G.","surname":"Breglio","rank":5,"pid":{"id":{"scheme":"orcid_pending","value":"0000-0002-9350-5483"},"provenance":null}},{"id":null,"fullName":"Irace, A.","name":"A.","surname":"Irace","rank":6,"pid":{"id":{"scheme":"orcid_pending","value":"0000-0003-1400-8380"},"provenance":null}}],"openAccessColor":null,"publiclyFunded":false,"eoscIfGuidelines":null,"type":"publication","language":{"code":"und","label":"Undetermined"},"countries":[{"code":"IT","label":"Italy","provenance":null}],"subjects":[{"subject":{"scheme":"keyword","value":"Insulated gate bipolar transistors, MOSFET, Silicon carbide, Switches, Silicon, Robustness, Power semiconductor devices"},"provenance":null},{"subject":{"scheme":"keyword","value":"MOSFET"},"provenance":null},{"subject":{"scheme":"keyword","value":"Silicon"},"provenance":null},{"subject":{"scheme":"keyword","value":"Power semiconductor devices"},"provenance":null},{"subject":{"scheme":"FOS","value":"0103 physical sciences"},"provenance":null},{"subject":{"scheme":"keyword","value":"Silicon carbide"},"provenance":null},{"subject":{"scheme":"keyword","value":"Robustness"},"provenance":null},{"subject":{"scheme":"FOS","value":"01 natural sciences"},"provenance":null},{"subject":{"scheme":"keyword","value":"Switches"},"provenance":null},{"subject":{"scheme":"keyword","value":"Insulated gate bipolar transistors"},"provenance":null}],"mainTitle":"Short-circuit and Avalanche Robustness of SiC Power MOSFETs for Aerospace Power Converters","subTitle":null,"descriptions":["Silicon Carbide (SiC) power MOSFETs are emerging as powerful switches to be used where compactness and light weight of the circuit are mandatory, as in aerospace converters, because the switching speed of SiC devices is faster than their silicon (Si) counterpart and therefore smaller inductors can be used. On the other hand, the operation out of the safe operating area of power semiconductor devices becomes critical especially where device, circuit and system reliability are important. In the aerospace sector, SiC devices still lag Si IGBTs and the gap needs to be filled. In this paper, a review of the principal failure mechanisms during short circuit (SC) and unclamped inductive switching (UIS) events on SiC power MOSFETs is presented."],"publicationDate":"2023-03-04","publisher":"IEEE","embargoEndDate":null,"sources":["Crossref"],"formats":null,"contributors":null,"coverages":null,"bestAccessRight":{"code":"c_14cb","label":"CLOSED","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/"},"container":{"name":"2023 IEEE Aerospace Conference","issnPrinted":null,"issnOnline":null,"issnLinking":null,"ep":"8","iss":null,"sp":"1","vol":null,"edition":null,"conferencePlace":null,"conferenceDate":null},"documentationUrls":null,"codeRepositoryUrl":null,"programmingLanguage":null,"contactPeople":null,"contactGroups":null,"tools":null,"size":null,"version":null,"geoLocations":null,"id":"doi_dedup___::895cfdd4f3cefcb5f743135f7bcd85fc","originalIds":["10.1109/aero55745.2023.10115580","50|doiboost____|895cfdd4f3cefcb5f743135f7bcd85fc","50|dris___01076::f7e710e588c8d6cc356199198305da00","oai:www.iris.unina.it:11588/1005134","50|od______3730::f7e710e588c8d6cc356199198305da00"],"pids":[{"scheme":"doi","value":"10.1109/aero55745.2023.10115580"},{"scheme":"handle","value":"11588/1005134"}],"dateOfCollection":null,"lastUpdateTimeStamp":null,"indicators":{"citationImpact":{"citationCount":7.0,"influence":2.5533213E-9,"popularity":6.272905E-9,"impulse":7.0,"citationClass":"C5","influenceClass":"C5","impulseClass":"C4","popularityClass":"C4"}},"projects":null,"organizations":[{"legalName":"University Federico II of Naples","acronym":"University Federico II of Naples","id":"openorgs____::eb0669daa9efeb898a3090d8aac7c953","pids":[{"scheme":"Wikidata","value":"Q691851"},{"scheme":"fundref","value":"100009052"},{"scheme":"PIC","value":"999976590"},{"scheme":"FundRef","value":"100009052"},{"scheme":"OrgRef","value":"4932663"},{"scheme":"ROR