{"scheme":"Wikidata","value":"Q1343386"},{"scheme":"ROR","value":"https://ror.org/006teas31"},{"scheme":"OrgRef","value":"919887"}],"countries":[{"code":"CN","label":"China (People's Republic of)"}],"websiteurl":"https://www.shu.edu.cn"},{"legalName":"Hebei University","acronym":"Hebei University","id":"openorgs____::0153f073c67e09c2b54ae61176deed59","pids":[{"scheme":"mag_id","value":"21153639"},{"scheme":"GRID","value":"grid.459531.f"},{"scheme":"mag_id","value":"15823474"},{"scheme":"mag_id","value":"43337087"},{"scheme":"mag_id","value":"173899330"},{"scheme":"GRID","value":"grid.410747.1"},{"scheme":"GRID","value":"grid.440663.3"},{"scheme":"GRID","value":"grid.256922.8"},{"scheme":"mag_id","value":"46482218"},{"scheme":"mag_id","value":"49232843"},{"scheme":"GRID","value":"grid.411412.3"},{"scheme":"GRID","value":"grid.256885.4"},{"scheme":"mag_id","value":"13175533"}],"countries":[{"code":"CN","label":"China (People's Republic of)"}],"websiteurl":"http://www.hbu.edu.cn/"}],"communities":null,"collectedFrom":[{"key":"openaire____::081b82f96300b6a6e3d282bad31cb6e2","value":"Crossref"}],"instances":[{"pids":[{"scheme":"doi","value":"10.62051/1ffqyk92"}],"license":"CC BY NC","accessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/","openAccessRoute":"hybrid"},"type":"Article","urls":["https://doi.org/10.62051/1ffqyk92"],"publicationDate":"2024-11-25","refereed":"peerReviewed","hostedBy":{"key":"issn___print::ed63c2bfdd84571c7b1f6a0eb271f048","value":"Transactions on Computer Science and Intelligent Systems Research"},"collectedFrom":{"key":"openaire____::081b82f96300b6a6e3d282bad31cb6e2","value":"Crossref"}}],"links":[],"otherTitles":null,"inDiamondJournal":false,"green":false,"isGreen":false,"isInDiamondJournal":false},{"authors":[{"id":"orcid_______::72e2dd331969ad13f959fdd551e0859d","fullName":"Judith Berens","name":null,"surname":null,"rank":1,"pid":{"id":{"scheme":"orcid","value":"0000-0001-5611-7564"},"provenance":null}},{"id":null,"fullName":"Magdalena Weger","name":null,"surname":null,"rank":2,"pid":null},{"id":null,"fullName":"Gregor Pobegen","name":null,"surname":null,"rank":3,"pid":null},{"id":null,"fullName":"Thomas Aichinger","name":null,"surname":null,"rank":4,"pid":null},{"id":"orcid_______::fb9e26f3fb446f849cf608d46351abe7","fullName":"Gerald Rescher","name":null,"surname":null,"rank":5,"pid":{"id":{"scheme":"orcid","value":"0000-0002-2068-3991"},"provenance":null}},{"id":"orcid_______::8abec329fc886bd44be1443eeee6521b","fullName":"Christian Schleich","name":null,"surname":null,"rank":6,"pid":{"id":{"scheme":"orcid","value":"0000-0002-8832-520x"},"provenance":null}},{"id":null,"fullName":"Tibor Grasser","name":null,"surname":null,"rank":7,"pid":null}],"openAccessColor":null,"publiclyFunded":false,"eoscIfGuidelines":null,"type":"publication","language":{"code":"und","label":"Undetermined"},"countries":null,"subjects":[{"subject":{"scheme":"FOS","value":"0103 physical sciences"},"provenance":null},{"subject":{"scheme":"FOS","value":"01 natural sciences"},"provenance":null},{"subject":{"scheme":"SDG","value":"7. Clean energy"},"provenance":null}],"mainTitle":"Similarities and Differences of BTI in SiC and Si Power MOSFETs","subTitle":null,"descriptions":["Bias temperature instability (BTI) is a serious reliability concern not only in 4H silicon carbide (4H-SiC) power MOSFETs, but also in Si technology. Even though previous studies presented large BTI drifts for some SiC devices compared to Si, we show that BTI in modern SiC may become uncritical by improved device processing. As will be shown, NBTI can even be reduced to a similar drift level as in Si power MOSFETs. Furthermore, we demonstrate that BTI in SiC and Si devices share many features such as a comparable time and voltage evolution. Thus, BTI in SiC MOSFETs can be described with the same empirical and simple physical models, and is therefore as predictable as for Si-based devices. In addition, this indicates that BTI in SiC and Si power MOSFETs is caused by the same physical origin of the degradation."],"publicationDate":"2020-04-01","publisher":"IEEE","embargoEndDate":null,"sources":["Crossref"],"formats":null,"contributors":null,"coverages":null,"bestAccessRight":{"code":"c_14cb","label":"CLOSED","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/"},"container":{"name":"2020 IEEE International Reliability Physics Symposium (IRPS)","issnPrinted":null,"issnOnline":null,"issnLinking":null,"ep":"7","iss":null,"sp":"1","vol":null,"edition":null,"conferencePlace":null,"conferenceDate":null},"documentationUrls":null,"codeRepositoryUrl":null,"programmingLanguage":null,"contactPeople":null,"contactGroups":null,"tools":null,"size":null,"version":null,"geoLocations":null,"id":"doi_dedup___::7c0f900f1c5facb4ae3d047cb8a98d2c","originalIds":["10.1109/irps45951.2020.9129259","50|doiboost____|7c0f900f1c5facb4ae3d047cb8a98d2c","50|dblp________::6b7f3a5c657080591b7d7c433c8d18ca","3040580115"],"pids":[{"scheme":"doi","value":"10.1109/irps45951.2020.9129259"}],"dateOfCollection":null,"lastUpdateTimeStamp":null,"indicators":{"citationImpact":{"citationCount":16.0,"influence":3.2808316E-9,"popularity":1.2438212E-8,"impulse":10.0,"citationClass":"C4","influenceClass":"C4","impulseClass":"C4","popularityClass":"C4"}},"projects":null,"organizations":[{"legalName":"TU Wien","acronym":"TUW","id":"openorgs____::9d089cd60852c6e601104f886a677f28","pids":[{"scheme":"wikidata","value":"Q689400"},{"scheme":"OrgRef","value":"1267354"},{"scheme":"fundref","value":"100007223"},{"scheme":"FundRef","value":"501100012650"},{"scheme":"FundRef","value":"501100004729"},{"scheme":"FundRef","value":"100007223"},{"scheme":"GRID","value":"grid.5329.d"},{"scheme":"wikidata","value":"Q757615"},{"scheme":"ROR","value":"https://ror.org/04d836q62"},{"scheme":"ISNI","value":"0000000123484034"},{"scheme":"fundref","value":"501100012650"},{"scheme":"RRID","value":"RR