tps://pubmed.ncbi.nlm.nih.gov/34737021"],"publicationDate":"2022-03-04","refereed":"nonPeerReviewed","hostedBy":{"key":"openaire____::55045bd2a65019fd8e6741a755395c8c","value":"Unknown Repository"},"collectedFrom":{"key":"opendoar____::8b6dd7db9af49e67306feb59a8bdc52c","value":"Europe PubMed Central"}},{"alternateIdentifiers":[{"scheme":"doi","value":"10.1016/j.neulet.2021.136322"},{"scheme":"mag_id","value":"3211310835"}],"type":"Article","urls":["https://dx.doi.org/10.1016/j.neulet.2021.136322"],"refereed":"nonPeerReviewed","hostedBy":{"key":"openaire____::55045bd2a65019fd8e6741a755395c8c","value":"Unknown Repository"},"collectedFrom":{"key":"openaire____::5f532a3fc4f1ea403f37070f59a7a53a","value":"Microsoft Academic Graph"}},{"alternateIdentifiers":[{"scheme":"mag_id","value":"3211310835"},{"scheme":"doi","value":"10.1016/j.neulet.2021.136322"}],"type":"Article","urls":["https://dx.doi.org/10.1016/j.neulet.2021.136322"],"refereed":"nonPeerReviewed","hostedBy":{"key":"openaire____::55045bd2a65019fd8e6741a755395c8c","value":"Unknown Repository"},"collectedFrom":{"key":"openaire____::5f532a3fc4f1ea403f37070f59a7a53a","value":"Microsoft Academic Graph"}}],"links":[],"otherTitles":null,"inDiamondJournal":false,"green":false,"isGreen":false,"isInDiamondJournal":false},{"authors":[{"id":null,"fullName":"Marcos Roberto, Kunzler","name":"Marcos Roberto","surname":"Kunzler","rank":1,"pid":null},{"id":"orcid_______::7f60eea44477762d5344f140f67bd552","fullName":"Felipe P, Carpes","name":"Felipe P","surname":"Carpes","rank":2,"pid":{"id":{"scheme":"orcid","value":"0000-0001-8923-4855"},"provenance":null}}],"openAccessColor":null,"publiclyFunded":false,"eoscIfGuidelines":null,"type":"publication","language":{"code":"eng","label":"English"},"countries":null,"subjects":[{"subject":{"scheme":"keyword","value":"Male"},"provenance":null},{"subject":{"scheme":"FOS","value":"03 medical and health sciences"},"provenance":null},{"subject":{"scheme":"keyword","value":"Young Adult"},"provenance":null},{"subject":{"scheme":"FOS","value":"0302 clinical medicine"},"provenance":null},{"subject":{"scheme":"keyword","value":"Cognition"},"provenance":null},{"subject":{"scheme":"keyword","value":"Humans"},"provenance":null},{"subject":{"scheme":"keyword","value":"Attention"},"provenance":null},{"subject":{"scheme":"keyword","value":"Exercise"},"provenance":null},{"subject":{"scheme":"keyword","value":"Aged"},"provenance":null},{"subject":{"scheme":"keyword","value":"Bicycling"},"provenance":null},{"subject":{"scheme":"keyword","value":"Exercise Therapy"},"provenance":null}],"mainTitle":"Moderate Intensity Cycling Combined with Cognitive Dual-task Improves                     Selective Attention","subTitle":null,"descriptions":["<jats:title>Abstract</jats:title><jats:p>Physical and cognitive exercises have positive long-term effects on cognitive                     capacities. However, acute effects still are controversial. Here we determine                     the acute effects of physical exercise combined with concurrent cognitive                     exercise on cognitive performance in young adults. Simple reaction time,                     selective attention, and memory were evaluated in 23 young men before and after                     30 min of stationary cycling exercise, 30 min of stationary                     cycling exercise combined with cognitive exercise, and 30 min of rest.                     Exercise intensity was continuously controlled to ensure exercise at moderate                     intensity. We found that physical exercise combined with cognitive dual-task                     improves selective attention. Both exercise conditions showed similar effects on                     simple reaction time, and memory was not affected by the different exercise                     conditions. We conclude that the combination of cycling exercise at moderate                     intensity with a cognitive exercise acutely improves selective attention in                     young adults. These results can be of particular interest for interventions                     aiming at improving selective attention in sports and for older adults and                     individuals with difficulty to suppress and filter out task-irrelevant                     information, like when receiving instruction or learning a new task or                     concept.</jats:p>"],"publicationDate":"2021-11-02","publisher":"Georg Thieme Verlag KG","embargoEndDate":null,"sources":["Crossref"],"formats":null,"contributors":null,"coverages":null,"bestAccessRight":null,"container":{"name":"International Journal of Sports Medicine","issnPrinted":"0172-4622","issnOnline":"1439-3964","issnLinking":null,"ep":null,"iss":null,"sp":null,"vol":"43","edition":null,"conferencePlace":null,"conferenceDate":null},"documentationUrls":null,"codeRepositoryUrl":null,"programmingLanguage":null,"contactPeople":null,"contactGroups":null,"tools":null,"size":null,"version":null,"geoLocations":null,"id":"doi_dedup___::6c9d6081c814e625f82478b421ff1fe5","originalIds":["10.1055/a-1684-9151","50|doiboost____|6c9d6081c814e625f82478b421ff1fe5","34729731","3210057015"],"pids":[{"scheme":"doi","value":"10.1055/a-1684-9151"},{"scheme":"pmid","value":"34729731"}],"dateOfCollection":null,"lastUpdateTimeStamp":null,"indicators":{"citationImpact":{"citationCount":3.0,"influence":2.2638806E-9,"popularity":3.2491685E-9,"impulse":1.0,"citationClass":"C5","influenceClass":"C5","impulseClass":"C5","popularityClass":"C4"}},"projects":null,"organizations":[{"legalName":"Universidade Federal do Pampa","acronym":"Universidade Federal do Pampa","id":"pending_org_::a39c05ede235a6664c9e950757664b0c","pids":[{"scheme":"ISNI","value":"0000000403879962"},{"scheme":"OrgRef","value":"20684130"},{"scheme":"GRID","value":"grid.412376.5"},{"scheme":"Wikidata","value":"Q7894382"},{"scheme":"fundref","value":"501100010598"},{"scheme":"wikidata","value":"Q7894382"},{"scheme":"FundRef","value