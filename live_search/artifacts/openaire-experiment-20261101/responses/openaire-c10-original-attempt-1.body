d31cb6e2","value":"Crossref"},{"key":"opendoar____::8b6dd7db9af49e67306feb59a8bdc52c","value":"Europe PubMed Central"}],"instances":[{"pids":[{"scheme":"doi","value":"10.1007/7854_2024_495"}],"license":"Springer Nature TDM","accessRight":{"code":"c_14cb","label":"CLOSED","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/","openAccessRoute":null},"type":"Part of book or chapter of book","urls":["https://doi.org/10.1007/7854_2024_495"],"publicationDate":"2024-01-01","refereed":"peerReviewed","hostedBy":{"key":"openaire____::55045bd2a65019fd8e6741a755395c8c","value":"Unknown Repository"},"collectedFrom":{"key":"openaire____::081b82f96300b6a6e3d282bad31cb6e2","value":"Crossref"}},{"pids":[{"scheme":"pmid","value":"39083174"}],"alternateIdentifiers":[{"scheme":"doi","value":"10.1007/7854_2024_495"}],"type":"Article","urls":["https://pubmed.ncbi.nlm.nih.gov/39083174"],"publicationDate":"2024-11-05","refereed":"nonPeerReviewed","hostedBy":{"key":"openaire____::55045bd2a65019fd8e6741a755395c8c","value":"Unknown Repository"},"collectedFrom":{"key":"opendoar____::8b6dd7db9af49e67306feb59a8bdc52c","value":"Europe PubMed Central"}},{"pids":[{"scheme":"handle","value":"2066/311709"}],"alternateIdentifiers":[{"scheme":"doi","value":"10.1007/7854_2024_495"}],"accessRight":{"code":"c_16ec","label":"RESTRICTED","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/","openAccessRoute":null},"type":"Part of book or chapter of book","urls":["https://hdl.handle.net/2066/311709"],"publicationDate":"2024-01-01","refereed":"nonPeerReviewed","hostedBy":{"key":"opendoar____::7bccfde7714a1ebadf06c5f4cea752c1","value":"Radboud Repository"},"collectedFrom":{"key":"opendoar____::7bccfde7714a1ebadf06c5f4cea752c1","value":"Radboud Repository"}}],"links":[],"otherTitles":null,"inDiamondJournal":false,"green":false,"isGreen":false,"isInDiamondJournal":false},{"authors":[{"id":null,"fullName":"rui yang","name":"rui","surname":"yang","rank":1,"pid":{"id":{"scheme":"orcid_pending","value":"0000-0002-2317-8704"},"provenance":null}},{"id":null,"fullName":"xiguang zhang","name":"xiguang","surname":"zhang","rank":2,"pid":null},{"id":null,"fullName":"wenyi li","name":"wenyi","surname":"li","rank":3,"pid":null},{"id":null,"fullName":"cheng guo","name":"cheng","surname":"guo","rank":4,"pid":null}],"openAccessColor":"hybrid","publiclyFunded":false,"eoscIfGuidelines":null,"type":"publication","language":{"code":"und","label":"Undetermined"},"countries":null,"subjects":[{"subject":{"scheme":"FOS","value":"03 medical and health sciences"},"provenance":null},{"subject":{"scheme":"FOS","value":"0302 clinical medicine"},"provenance":null}],"mainTitle":"Treadnill exercise ameliorated stress-induced neuron impairment and dopamine loss in rat hippocampus and improved working memory","subTitle":null,"descriptions":["<jats:p>Stress-related memory deficit is correlated with neurotransmitter system impairment. Exercise improves memory function and neurotransmitter. However, no studies have been performed to directly observe exercise-related effects on neurotransmitter in stress model, in association with memory function and hippocampal neuron. This study aimed to investigate the effect of exercise on hippocampal neuron and dopamine in stress model, followed by working memory in a passive avoid test. Our study found that stress rat had significantly neuron impairment and dopamine loss in hippocampus plus working memory deficit, which can be rescued by exercise. In summary, this study demonstrated that the neuroprotective effect of stress-associated working memory by treadmill exercise via ameliorated neuron impairment and dopamine loss.</jats:p>"],"publicationDate":"2023-01-30","publisher":"Wiley","embargoEndDate":null,"sources":["Crossref"],"formats":null,"contributors":null,"coverages":null,"bestAccessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/"},"conta