ef"}],"instances":[{"pids":[{"scheme":"doi","value":"10.22541/au.167508632.24198391/v1"}],"type":"Article","urls":["https://doi.org/10.22541/au.167508632.24198391/v1"],"publicationDate":"2023-01-30","refereed":"peerReviewed","hostedBy":{"key":"openaire____::55045bd2a65019fd8e6741a755395c8c","value":"Unknown Repository"},"collectedFrom":{"key":"openaire____::081b82f96300b6a6e3d282bad31cb6e2","value":"Crossref"}},{"pids":[{"scheme":"doi","value":"10.21203/rs.3.rs-3092984/v1"}],"license":"CC BY","accessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/","openAccessRoute":"hybrid"},"type":"Article","urls":["https://doi.org/10.21203/rs.3.rs-3092984/v1"],"publicationDate":"2023-07-05","refereed":"peerReviewed","hostedBy":{"key":"openaire____::55045bd2a65019fd8e6741a755395c8c","value":"Unknown Repository"},"collectedFrom":{"key":"openaire____::081b82f96300b6a6e3d282bad31cb6e2","value":"Crossref"}}],"links":[],"otherTitles":null,"inDiamondJournal":false,"green":false,"isGreen":false,"isInDiamondJournal":false},{"authors":[{"id":"orcid_______::bc87b6c324f905a5f307869f72377402","fullName":"Héctor Vázquez‐Lorente","name":"Héctor","surname":"Vázquez‐Lorente","rank":1,"pid":{"id":{"scheme":"orcid","value":"0000-0003-0183-6902"},"provenance":null}},{"id":null,"fullName":"Alejandro De‐la‐O","name":"Alejandro","surname":"De‐la‐O","rank":2,"pid":null},{"id":null,"fullName":"Almudena Carneiro‐Barrera","name":"Almudena","surname":"Carneiro‐Barrera","rank":3,"pid":null},{"id":"orcid_______::54d31c0e7ee664bc4f508bc8bdef2cb8","fullName":"Cristina Molina‐Hidalgo","name":"Cristina","surname":"Molina‐Hidalgo","rank":4,"pid":{"id":{"scheme":"orcid","value":"0000-0002-5483-5666"},"provenance":null}},{"id":null,"fullName":"Manuel J. Castillo","name":"Manuel J.","surname":"Castillo","rank":5,"pid":null},{"id":"orcid_______::b301cccf582c0025f7453d530a6a8dbb","fullName":"Francisco J. Amaro‐Gahete","name":"Francisco J.","surname":"Amaro‐Gahete","rank":6,"pid":{"id":{"scheme":"orcid","value":"0000-0002-7207-9016"},"provenance":null}}],"openAccessColor":"hybrid","publiclyFunded":false,"eoscIfGuidelines":null,"type":"publication","language":{"code":"eng","label":"English"},"countries":[{"code":"ES","label":"Spain","provenance":null}],"subjects":[{"subject":{"scheme":"keyword","value":"Adult"},"provenance":null},{"subject":{"scheme":"keyword","value":"Male"},"provenance":null},{"subject":{"scheme":"keyword","value":"Aging"},"provenance":null},{"subject":{"scheme":"keyword","value":"Long- term memory"},"provenance":null},{"subject":{"scheme":"keyword","value":"Physical exercise"},"provenance":null},{"subject":{"scheme":"keyword","value":"S- Klotho"},"provenance":null},{"subject":{"scheme":"keyword","value":"Middle Aged"},"provenance":null},{"subject":{"scheme":"keyword","value":"High-Intensity Interval Training"},"provenance":null},{"subject":{"scheme":"keyword","value":"Long-term memory"},"provenance":null},{"subject":{"scheme":"keyword","value":"Short- term memory"},"provenance":null},{"subject":{"scheme":"keyword","value":"Humans"},"provenance":null},{"subject":{"scheme":"keyword","value":"Short-term memory"},"provenance":null},{"subject":{"scheme":"keyword","value":"Female"},"provenance":null},{"subject":{"scheme":"keyword","value":"1,25-dihydroxivitamin D"},"provenance":null},{"subject":{"scheme":"keyword","value":"S-Klotho"},"provenance":null},{"subject":{"scheme":"keyword","value":"Exercise"},"provenance":null},{"subject":{"scheme":"keyword","value":"Aged"},"provenance":null}],"mainTitle":"Physical exercise improves memory in sedentary middle‐aged adults: Are these exercise‐induced benefits associated with <scp>S‐Klotho</scp> and 1,<scp>25‐dihydroxivitamin</scp> D? The <scp>FIT‐AGEING</scp> randomized controlled trial","subTitle":null,"descriptions":["<jats:title>Abstract</jats:title><jats:p>We aimed to investigate the effect of three types of exercise interventions on memory (i.e., immediate memory (IM), long‐term memory (LTM), and recognition). We also investigated whether exercise‐induced changes in circulating S‐Klotho and 1,25‐dihydroxivitamin D (1,25(OH)<jats:sub>2</jats:sub>D) levels were related to those observed in memory in healthy middle‐aged sedentary adults. A 12‐week randomized controlled trial was performed with a parallel‐group design. Seventy‐four participants (45–65 years old: 53% women) were randomly assigned to (1) no exercise (control) group, (2) concurrent training based on the international physical activity recommendations (PAR) group, (3) high‐intensity interval training (HIIT) group, or (4) HIIT plus whole‐body electromyostimulation (HIIT‐EMS) group. Memory outcomes were assessed using the Wechsler Memory Scale‐third edition. S‐Klotho plasma levels were determined according to a solid‐phase sandwich enzyme‐linked immunosorbent assay kit while 1,25(OH)<jats:sub>2</jats:sub>D plasma levels were measured using a DiaSorin‐Liaison immunochemiluminometric analyzer. IM‐Verbal Paired Associates (IM‐VPA) and IM‐Logical Memory (IM‐LM) were improved in both the HIIT and HIIT‐EMS groups compared with the control group (all <jats:italic>p</jats:italic> ≤ 0.045). Exercise‐induced changes in S‐Klotho plasma levels were positively associated with those observed in IM, LTM, and recognition (all <jats:italic>p</jats:italic> ≤ 0.007), whereas exercise‐induced changes in 1,25(OH)<jats:sub>2</jats:sub>D plasma levels were directly related to changes in IM and LTM (all <jats:italic>p</jats:italic> ≤ 0.048). In conclusion, a 12‐week HIIT intervention with or without WB‐EMS seems to be the most effective exercise program to improve IM. The significant and positive associations between exercise‐induced changes in S‐Klotho and 1,25(OH)<jats:sub>2</jats:sub>D levels with those observed in memory outcomes suggest that these factors may be potentially related to exercise‐induced improvements of memory in middle‐aged adults.</jats:p>"],"publicationDate":"2023-10-12","publisher":"Wiley","embargoEndDate":null,"sources":["Crossref","reponame:Brújula","instname:Universidad Loyola Andalucía","reponame:Digibug. Repositorio Institucional de la Universidad de Granada","instname:Universidad de Granada (UGR)"],"formats":null,"contributors":null,"coverages":null,"bestAccessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/"},"container":{"name":"Scandinavian Journal of Medicine &amp; Science in Sports","issnPrinted":"0905-7188","issnOnline":"1600-0838","issnLinking":null,"ep":null,"iss":null,"sp":null,"vol":"34","edition":null,"conferencePlace":null,"conferenceDate":null},"documentationUrls":null,"codeRepositoryUrl":null,"programmingLanguage":null,"contactPeople":null,"contactGroups":null,"tools":null,"size":null,"version":null,"geoLocations":null,"id":"doi_dedup___::cffa62f01b6dbc7bb9e09beaed1111f4","originalIds":["10.1111/sms.14519","50|doiboost____|cffa62f01b6dbc7bb9e09beaed1111f4","37823465","50|RECOLECTA___::2e3b1b079efc090266235cb14b473cab","oai:dnet:brújula_____::61ef2bf1e1078b626ba2fbab33f614a1","oai:digibug.ugr.es:10481/84957","50|RECOLECTA___::79c484d7c8c9072d0d7d5b11f37a1513","50|RECOLECTA___::abb29723e5a5b4bc4afff5f641e1614c","oai:dnet:brújula_____::ec1740d705bd7eef035700a86fb5c050","50|RECOLECTA___::ed4f41a1616546c6249d857678578b36","oai:digibug.ugr.es:10481/85611","50|od______1648::79c484d7c8c9072d0d7d5b11f37a1513","50|od______1648::ed4f41a1616546c6249d857678578b36","50|od______4479::61ef2bf1e1078b626ba2fbab33f614a1","oai:repositorio.uloyola.es:20.500.12412/5693","oai:repositorio.uloyola.es:20.500.12412/5737","50|od______4479::ec1740d705bd7eef035700a86fb5c050"],"pids":[{"scheme":"doi","value":"10.1111/sms.14519"},{"scheme":"pmid","value":"37823465"},{"scheme":"handle","value":"20.500.12412/5693"},{"scheme":"handle","value":"10481/84957"},{"scheme":"handle","value":"20.500.12412/5737"},{"scheme":"handle","value":"10481/85611"}],"dateOfCollectio