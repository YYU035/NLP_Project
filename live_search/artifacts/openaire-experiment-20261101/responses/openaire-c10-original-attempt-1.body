:"10.1111/sms.14519"}],"license":"CC BY NC ND","accessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/","openAccessRoute":null},"type":"Article","urls":["https://hdl.handle.net/10481/84957"],"publicationDate":"2023-10-13","refereed":"nonPeerReviewed","hostedBy":{"key":"opendoar____::7437d136770f5b35194cb46c1653efaa","value":"Repositorio Institucional Universidad de Granada"},"collectedFrom":{"key":"opendoar____::7437d136770f5b35194cb46c1653efaa","value":"Repositorio Institucional Universidad de Granada"}},{"pids":[{"scheme":"handle","value":"10481/85611"}],"alternateIdentifiers":[{"scheme":"doi","value":"10.1111/sms.14519"}],"license":"CC BY NC ND","accessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/","openAccessRoute":null},"type":"Article","urls":["https://hdl.handle.net/10481/85611"],"publicationDate":"2023-11-13","refereed":"nonPeerReviewed","hostedBy":{"key":"opendoar____::7437d136770f5b35194cb46c1653efaa","value":"Repositorio Institucional Universidad de Granada"},"collectedFrom":{"key":"opendoar____::7437d136770f5b35194cb46c1653efaa","value":"Repositorio Institucional Universidad de Granada"}},{"pids":[{"scheme":"handle","value":"20.500.12412/5693"}],"alternateIdentifiers":[{"scheme":"doi","value":"10.1111/sms.14519"}],"license":"CC BY NC ND","type":"Article","urls":["https://hdl.handle.net/20.500.12412/5693"],"publicationDate":"2024-04-30","refereed":"nonPeerReviewed","hostedBy":{"key":"opendoar____::c89ca36e4d0430e75ca2390470a59a59","value":"Brújula - Repositorio Institucional"},"collectedFrom":{"key":"opendoar____::c89ca36e4d0430e75ca2390470a59a59","value":"Brújula - Repositorio Institucional"}},{"pids":[{"scheme":"handle","value":"20.500.12412/5737"}],"alternateIdentifiers":[{"scheme":"doi","value":"10.1111/sms.14519"}],"license":"CC BY NC ND","type":"Article","urls":["https://hdl.handle.net/20.500.12412/5737"],"publicationDate":"2024-05-06","refereed":"nonPeerReviewed","hostedBy":{"key":"opendoar____::c89ca36e4d0430e75ca2390470a59a59","value":"Brújula - Repositorio Institucional"},"collectedFrom":{"key":"opendoar____::c89ca36e4d0430e75ca2390470a59a59","value":"Brújula - Repositorio Institucional"}}],"links":[],"otherTitles":null,"inDiamondJournal":false,"green":true,"isGreen":true,"isInDiamondJournal":false},{"authors":[{"id":null,"fullName":"Fernando Tadeu Serra","name":"Fernando Tadeu","surname":"Serra","rank":1,"pid":null},{"id":"orcid_______::a2f1451cc56397efb8dad4c8e1a23bae","fullName":"Fabrizio dos Santos Cardoso","name":"Fabrizio dos Santos","surname":"Cardoso","rank":2,"pid":{"id":{"scheme":"orcid","value":"0000-0002-7547-8880"},"provenance":null}},{"id":"orcid_______::aac4ca1973a590b39e7e2688d7380f63","fullName":"Nathália Petraconi","name":"Nathália","surname":"Petraconi","rank":3,"pid":{"id":{"scheme":"orcid","value":"0000-0002-3515-542x"},"provenance":null}},{"id":null,"fullName":"Julio Cesar Claudino dos Santos","name":"Julio Cesar Claudino","surname":"dos Santos","rank":4,"pid":null},{"id":null,"fullName":"Bruno Henrique Silva Araujo","name":"Bruno Henrique Silva","surname":"Araujo","rank":5,"pid":null},{"id":"orcid_______::6abe62857233554f76f20179598910bc","fullName":"Ricardo Mário Arida","name":"Ricardo Mário","surname":"Arida","rank":6,"pid":{"id":{"scheme":"orcid","value":"0000-0002-7771-6133"},"provenance":null}},{"id":"orcid_______::e9be79dd6eb096bce1e05695b0b3013b","fullName":"Sérgio Gomes da Silva","name":"Sérgio","surname":"Gomes da Silva","rank":7,"pid":{"id":{"scheme":"orcid","value":"0000-0002-9650-809x"},"provenance":null}}],"openAccessColor":null,"publiclyFunded":false,"eoscIfGuidelines":null,"type":"publication","language":{"code":"eng","label":"English"},"countries":null,"subjects":[{"subject":{"scheme":"FOS","value":"0301 basic medicine"},"provenance":null},{"subject":{"scheme":"keyword","value":"Male"},"provenance":null},{"subject":{"scheme":"FOS","value":"0303 health sciences"},"provenance":null},{"subject":{"scheme":"keyword","value":"Aging"},"provenance":null},{"subject":{"scheme":"keyword","value":"Resistance Training"},"provenance":null},{"subject":{"scheme":"keyword","value":"Hippocampus"},"provenance":null},{"subject":{"scheme":"keyword","value":"Rats"},"provenance":null},{"subject":{"scheme":"FOS","value":"03 medical and health sciences"},"provenance":null},{"subject":{"scheme":"keyword","value":"Memory"},"provenance":null},{"subject":{"scheme":"keyword","value":"Physical Conditioning, Animal"},"provenance":null},{"subject":{"scheme":"keyword","value":"Metabolome"},"provenance":null},{"subject":{"scheme":"keyword","value":"Animals"},"provenance":null},{"subject":{"scheme":"keyword","value":"Learning"},"provenance":null},{"subject":{"scheme":"keyword","value":"Rats, Wistar"},"provenance":null}],"mainTitle":"Resistance Exercise Improves Learning and Memory and Modulates Hippocampal Metabolomic Profile in Aged Rats","subTitle":null,"descriptions":["Physical activity has been considered an important non-medication intervention to preserve mnemonic processes during aging. However, how resistance exercise promotes such benefits remains unclear. A possible hypothesis is that brain-metabolic changes of regions responsible for memory consolidation is affected by muscular training. Therefore, we analyzed the memory, axiety and the metabolomic of aged male Wistar rats (19-20 months old in the 1st day of experiment) submitted to a 12-week resistance exercise protocol (EX, n = 11) or which remained without physical exercise (CTL, n = 13). Barnes maze, elevated plus maze and inhibitory avoidance tests were used to assess the animals' behaviour. The metabolomic profile was identified by nuclear magnetic resonance spectrometry. EX group had better performance in the tests of learning and spatial memory in Barnes maze, and an increase of short and long-term aversive memories formation in inhibitory avoidance. In addition, the exercised animals showed a greater amount of metabolites, such as 4-aminobutyrate, acetate, butyrate, choline, fumarate, glycerol, glycine, histidine, hypoxanthine, isoleucine, leucine, lysine, niacinamide, phenylalanine, succinate, tyrosine, valine and a reduction of ascorbate and aspartate compared to the control animals. These data indicate that the improvement in learning and memory of aged rats submitted to resistance exercise program is associated by changes in the hippocampal metabolomic profile."],"publicationDate":"2021-01-01","publisher":"Elsevier BV","embargoEndDate":null,"sources":["Crossref"],"formats":null,"contributors":null,"coverages":null,"bestAccessRight":{"code":"c_14cb","label":"CLOSED","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/"},"container":{"name":"SSRN Electronic Journal","issnPrinted":null,"issnOnline":"1556-5068","issnLinking":null,"ep":null,"iss":null,"sp":null,"vol":null,"edition":null,"conferencePlace":null,"conferenceDate":null},"documentationUrls":null,"codeRepositoryUrl":null,"programmingLanguage":null,"contactPeople":null,"contactGroups":null,"tools":null,"size":null,"version":null,"geoLocations":null,"id":"doi_dedup___::08c1b4d1fc466000d91a3b23dfc1f8a4","originalIds":["10.2139/ssrn.3951406","50|doiboost____|08c1b4d1fc466000d91a3b23dfc1f8a4","S0304394021007011","10.1016/j.neulet.2021.136322","50|doiboost____|72800f6372f66f00fd0a741ccc718b99","34737021","3211310835"],"pids":[{"scheme":"doi","value":"10.2139/ssrn.3951406"},{"scheme":"doi","value":"10.1016/j.neulet.2021.136322"},{"scheme":"pmid","value":"34737021"}],"dateOfCollection":null,"lastUpdateTimeStamp":null,"indicators":{"citationImpact":{"citationCount":17.0,"influence":2.4647455E-9,"popularity":1.231778E-8,"impulse":9.0,"citationClass":"C4","influenceClass":"C5","impulseClass":"C4","popularityClass":"C4"}},"projects":null,"organizations":[{"legalName":"Brazilian Biosciences National Laboratory","acronym":"LNBio","id":"pend