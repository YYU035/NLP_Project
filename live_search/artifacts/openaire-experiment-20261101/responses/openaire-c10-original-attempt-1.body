ublicationDate":"2025-03-07","refereed":"nonPeerReviewed","hostedBy":{"key":"openaire____::55045bd2a65019fd8e6741a755395c8c","value":"Unknown Repository"},"collectedFrom":{"key":"opendoar____::8b6dd7db9af49e67306feb59a8bdc52c","value":"Europe PubMed Central"}}],"links":[],"otherTitles":null,"inDiamondJournal":false,"green":false,"isGreen":false,"isInDiamondJournal":false},{"authors":[{"id":null,"fullName":"Schmitter, M.","name":"M.","surname":"Schmitter","rank":1,"pid":null},{"id":null,"fullName":"Vrijsen, J.N.","name":"J. N.","surname":"Vrijsen","rank":2,"pid":null}],"openAccessColor":null,"publiclyFunded":false,"eoscIfGuidelines":null,"type":"publication","language":{"code":"eng","label":"English"},"countries":[{"code":"NL","label":"Netherlands","provenance":null}],"subjects":[{"subject":{"scheme":"keyword","value":"Experimental Psychopathology and Treatment"},"provenance":null},{"subject":{"scheme":"keyword","value":"Cognitive Affective Neuroscience"},"provenance":null},{"subject":{"scheme":"keyword","value":"Psychiatry - Radboud University Medical Center - DCMN"},"provenance":null},{"subject":{"scheme":"keyword","value":"Memory"},"provenance":null},{"subject":{"scheme":"FOS","value":"05 social sciences"},"provenance":null},{"subject":{"scheme":"keyword","value":"Current Topics in Behavioral Neurosciences"},"provenance":null},{"subject":{"scheme":"keyword","value":"Humans"},"provenance":null},{"subject":{"scheme":"FOS","value":"0501 psychology and cognitive sciences"},"provenance":null},{"subject":{"scheme":"keyword","value":"Exercise"},"provenance":null}],"mainTitle":"Exercise and Memory","subTitle":null,"descriptions":["Our memory is crucial to our daily functioning, our identity, and how we interact with the world around us. Maintaining memory functioning is therefore important in many ways. Exercise positively affects our memory. Even a single exercise session can directly boost different memory types, including working, procedural, and episodic memory. Due to these benefits, exercise has great potential as an intervention in different settings, such as schools or rehabilitation centers, and as a prevention strategy. In this chapter, we first give an overview of what memory is and why it is so relevant to our mental health. Next, we briefly discuss how, for whom, and under which circumstances exercise improves memory functioning. Then, we will summarize the literature of experimental studies investigating the direct effect of exercise on different memory types, while acknowledging current limitations and potential future directions. Finally, we briefly highlight the potential of exercise as intervention to preserve and improve memory."],"publicationDate":"2024-01-01","publisher":"Springer International Publishing","embargoEndDate":null,"sources":["Crossref","Current Topics in Behavioral Neurosciences ISBN: 9783031689765","Cisler, J.M.; Crombie, K.M.; Adams, T.G. (ed.), Exercise and mental health, pp. 141-154"],"formats":null,"contributors":["Cisler, J.M.","Crombie, K.M.","Adams, T.G."],"coverages":null,"bestAccessRight":{"code":"c_16ec","label":"RESTRICTED","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/"},"container":null,"documentationUrls":null,"codeRepositoryUrl":null,"programmingLanguage":null,"contactPeople":null,"contactGroups":null,"tools":null,"size":null,"version":null,"geoLocations":null,"id":"doi_dedup___::1b38ec5f71c4a2b75239dc0aa04de54c","originalIds":["10.1007/7854_2024_495","50|doiboost____|1b38ec5f71c4a2b75239dc0aa04de54c","39083174","oai:repository.ubn.ru.nl:2066/311709","50|od______1236::ff76694901db982b73250ede21811fdc"],"pids":[{"scheme":"doi","value":"10.1007/7854_2024_495"},{"scheme":"pmid","value":"39083174"},{"scheme":"handle","value":"2066/311709"}],"dateOfCollection":null,"lastUpdateTimeStamp":null,"indicators":{"citationImpact":{"citationCount":1.0,"influence":2.1855013E-9,"popularity":2.577189E-9,"impulse":1.0,"citationClass":"C5","influenceClass":"C5","impul