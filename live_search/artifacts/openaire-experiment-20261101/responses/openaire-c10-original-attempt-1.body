df"],"refereed":"nonPeerReviewed","hostedBy":{"key":"doajarticles::9a6cbbe808d014e28c3b6705b60c016b","value":"Frontiers in Human Neuroscience"},"collectedFrom":{"key":"openaire____::8ac8380272269217cb09a928c8caa993","value":"UnpayWall"}},{"pids":[{"scheme":"pmid","value":"35153701"},{"scheme":"pmc","value":"PMC8829997"}],"alternateIdentifiers":[{"scheme":"doi","value":"10.3389/fnhum.2021.771553"}],"accessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/","openAccessRoute":"gold"},"type":"Article","urls":["https://pubmed.ncbi.nlm.nih.gov/35153701"],"refereed":"nonPeerReviewed","hostedBy":{"key":"doajarticles::9a6cbbe808d014e28c3b6705b60c016b","value":"Frontiers in Human Neuroscience"},"collectedFrom":{"key":"opendoar____::8b6dd7db9af49e67306feb59a8bdc52c","value":"Europe PubMed Central"}},{"alternateIdentifiers":[{"scheme":"doi","value":"10.3389/fnhum.2021.771553"}],"license":"CC BY","accessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/","openAccessRoute":null},"type":"Article","urls":["http://dx.doi.org/10.3389/fnhum.2021.771553"],"publicationDate":"2022-01-27","refereed":"nonPeerReviewed","hostedBy":{"key":"opendoar____::eda80a3d5b344bc40f3bc04f65b7a357","value":"PubMed Central"},"collectedFrom":{"key":"opendoar____::eda80a3d5b344bc40f3bc04f65b7a357","value":"PubMed Central"}},{"alternateIdentifiers":[{"scheme":"doi","value":"10.3389/fnhum.2021.771553"}],"accessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/","openAccessRoute":"gold"},"type":"Article","urls":["https://doaj.org/article/d5a1232b29bb479dacbc3ef79eb1f04c"],"publicationDate":"2022-01-01","refereed":"nonPeerReviewed","hostedBy":{"key":"doajarticles::9a6cbbe808d014e28c3b6705b60c016b","value":"Frontiers in Human Neuroscience"},"collectedFrom":{"key":"driver______::bee53aa31dc2cbb538c10c2b65fa5824","value":"DOAJ"}}],"links":[],"otherTitles":null,"inDiamondJournal":false,"green":true,"isGreen":true,"isInDiamondJournal":false},{"authors":[{"id":"orcid_______::4f0e1a7fe2c7690ba1e2d23116aa7c86","fullName":"Noriteru, Morita","name":"Noriteru","surname":"Morita","rank":1,"pid":{"id":{"scheme":"orcid","value":"0000-0003-3427-7174"},"provenance":null}},{"id":"orcid_______::78ff670b5ff5f76e52d5f162de0e19dd","fullName":"Toru, Ishihara","name":"Toru","surname":"Ishihara","rank":2,"pid":{"id":{"scheme":"orcid","value":"0000-0003-3544-6822"},"provenance":null}},{"id":"orcid_______::d6ae173c33ec1b5c2cd8385be01ee723","fullName":"Charles H, Hillman","name":"Charles H","surname":"Hillman","rank":3,"pid":{"id":{"scheme":"orcid","value":"0000-0002-3722-5612"},"provenance":null}},{"id":null,"fullName":"Keita, Kamijo","name":"Keita","surname":"Kamijo","rank":4,"pid":null}],"openAccessColor":"hybrid","publiclyFunded":false,"eoscIfGuidelines":null,"type":"publication","language":{"code":"eng","label":"English"},"countries":null,"subjects":[{"subject":{"scheme":"keyword","value":"Male"},"provenance":null},{"subject":{"scheme":"keyword","value":"Adult"},"provenance":null},{"subject":{"scheme":"keyword","value":"Young Adult"},"provenance":null},{"subject":{"scheme":"keyword","value":"Memory, Long-Term"},"provenance":null},{"subject":{"scheme":"keyword","value":"Memory, Episodic"},"provenance":null},{"subject":{"scheme":"FOS","value":"05 social sciences"},"provenance":null},{"subject":{"scheme":"keyword","value":"Mental Recall"},"provenance":null},{"subject":{"scheme":"keyword","value":"Humans"},"provenance":null},{"subject":{"scheme":"FOS","value":"0501 psychology and cognitive sciences"},"provenance":null},{"subject":{"scheme":"keyword","value":"Female"},"provenance":null},{"subject":{"scheme":"keyword","value":"Exercise"},"provenance":null}],"mainTitle":"Movement boosts memory: Investigating the effects of acute exercise on episodic long-term memory","subTitle":null,"descriptions":["Long-term memory is important for cognitive health across the lifespan. Previously research has indicated that a bout of exercise improves memory retention for approximately one week; however, its prolonged effects are unknown. This study investigated the effects of acute moderate-intensity exercise on long-term memory for 11 months. Participants engaged in the exercise intervention and seated rest control condition, followed by a word encoding memory task. Word retention in the exercise intervention was better than in the control condition at 6- and 8-weeks post-encoding. These findings suggest that exercise before encoding enhances long-term episodic memory recall for at least eight weeks."],"publicationDate":"2025-03-01","publisher":"Elsevier BV","embargoEndDate":null,"sources":["Crossref"],"formats":null,"contributors":null,"coverages":null,"bestAccessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/"},"container":{"name":"Journal of Science and Medicine in Sport","issnPrinted":"1440-2440","issnOnline":null,"issnLinking":null,"ep":"259","iss":null,"sp":"256","vol":"28","edition":null,"conferencePlace":null,"conferenceDate":null},"documentationUrls":null,"codeRepositoryUrl":null,"programmingLanguage":null,"contactPeople":null,"contactGroups":null,"tools":null,"size":null,"version":null,"geoLocations":null,"id":"doi_dedup___::fa59901312e67ae976bc99275040fafc","originalIds":["S1440244024005553","10.1016/j.jsams.2024.10.011","50|doiboost____|fa59901312e67ae976bc99275040fafc","39572311"],"pids":[{"scheme":"doi","value":"10.1016/j.jsams.2024.10.011"},{"scheme":"pmid","value":"39572311"}],"dateOfCollection":null,"lastUpdateTimeStamp":null,"indicators":{"citationImpact":{"citationCount":2.0,"influence":2.2471158E-9,"popularity":3.5404166E-9,"impulse":2.0,"citationClass":"C5","influenceClass":"C5","impulseClass":"C5","popularityClass":"C4"}},"projects":null,"organizations":[{"legalName":"Hokkaido Un