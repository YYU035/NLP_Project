vid-19","label":"Corona Virus Disease","provenance":null}],"collectedFrom":[{"key":"driver______::bee53aa31dc2cbb538c10c2b65fa5824","value":"DOAJ"},{"key":"opendoar____::8b6dd7db9af49e67306feb59a8bdc52c","value":"Europe PubMed Central"},{"key":"openaire____::8687d924ebc4162c13d0030e57a632ac","value":"mEDRA"},{"key":"opendoar____::eda80a3d5b344bc40f3bc04f65b7a357","value":"PubMed Central"}],"instances":[{"pids":[{"scheme":"pmid","value":"35872670"},{"scheme":"pmc","value":"PMC9272973"}],"alternateIdentifiers":[{"scheme":"doi","value":"10.22088/cjim.13.0.264"}],"accessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/","openAccessRoute":"gold"},"type":"Article","urls":["https://pubmed.ncbi.nlm.nih.gov/35872670"],"refereed":"nonPeerReviewed","hostedBy":{"key":"doajarticles::08d999d0c662607c672bf204f6e47577","value":"Caspian Journal of Internal Medicine"},"collectedFrom":{"key":"opendoar____::8b6dd7db9af49e67306feb59a8bdc52c","value":"Europe PubMed Central"}},{"alternateIdentifiers":[{"scheme":"doi","value":"10.22088/cjim.13.0.264"}],"license":"http://creativecommons.org/licenses/by/3.0/This is an Open Access article distributed under the terms of the Creative Commons Attribution License, (http://creativecommons.org/licenses/by/3.0/ (http://creativecommons.org/licenses/by/3.0/) ) which permits unrestricted use, distribution, and reproduction in any medium, provided the original work is properly cited.","accessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/","openAccessRoute":null},"type":"Article","urls":["http://dx.doi.org/10.22088/cjim.13.0.264"],"publicationDate":"2022-01-01","refereed":"nonPeerReviewed","hostedBy":{"key":"opendoar____::eda80a3d5b344bc40f3bc04f65b7a357","value":"PubMed Central"},"collectedFrom":{"key":"opendoar____::eda80a3d5b344bc40f3bc04f65b7a357","value":"PubMed Central"}},{"accessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/","openAccessRoute":"gold"},"type":"Article","urls":["https://doaj.org/article/6a76d879535043d188460d2a199f594c"],"publicationDate":"2022-01-01","refereed":"nonPeerReviewed","hostedBy":{"key":"doajarticles::08d999d0c662607c672bf204f6e47577","value":"Caspian Journal of Internal Medicine"},"collectedFrom":{"key":"driver______::bee53aa31dc2cbb538c10c2b65fa5824","value":"DOAJ"}},{"pids":[{"scheme":"doi","value":"10.22088/cjim.13.0.264"}],"type":"Article","urls":["https://doi.org/10.22088/cjim.13.0.264"],"publicationDate":"2022-01-01","refereed":"nonPeerReviewed","hostedBy":{"key":"openaire____::8687d924ebc4162c13d0030e57a632ac","value":"mEDRA"},"collectedFrom":{"key":"openaire____::8687d924ebc4162c13d0030e57a632ac","value":"mEDRA"}},{"pids":[{"scheme":"doi","value":"10.22088/cjim.13.covid_19_supplement_2.264"}],"type":"Article","urls":["https://doi.org/10.22088/cjim.13.covid_19_supplement_2.264"],"publicationDate":"2022-01-01","refereed":"nonPeerReviewed","hostedBy":{"key":"openaire____::8687d924ebc4162c13d0030e57a632ac","value":"mEDRA"},"collectedFrom":{"key":"openaire____::8687d924ebc4162c13d0030e57a632ac","value":"mEDRA"}}],"links":[],"otherTitles":null,"inDiamondJournal":false,"green":true,"isGreen":true,"isInDiamondJournal":false},{"authors":[{"id":null,"fullName":"Yi Guo","name":null,"surname":null,"rank":1,"pid":null},{"id":null,"fullName":"Yi Guo","name":null,"surname":null,"rank":2,"pid":null},{"id":null,"fullName":"Ke Hu","name":null,"surname":null,"rank":3,"pid":null},{"id":null,"fullName":"Yuxuan Li","name":null,"surname":null,"rank":4,"pid":null},{"id":null,"fullName":"Chanjun Lu","name":null,"surname":null,"rank":5,"pid":null},{"id":null,"fullName":"Ken Ling","name":null,"surname":null,"rank":6,"pid":null},{"id":null,"fullName":"Chuanqi Cai","name":null,"surname":null,"rank":7,"pid":null},{"id":null,"fullName":"Weici Wang","name":null,"surname":null,"rank":8,"pid":null},{"id":null,"fullName":"Dawei Ye","name":null,"surname":null,"rank":9,"pid":null},{"id":null,"fullName":"Dawei Ye","name":null,"surname":null,"rank":10,"pid":null}],"openAccessColor":"gold","publiclyFunded":false,"eoscIfGuidelines":null,"type":"publication","language":{"code":"und","label":"Undetermined"},"countries":null,"subjects":[{"subject":{"scheme":"FOS","value":"0301 basic medicine"},"provenance":null},{"subject":{"scheme":"FOS","value":"0303 health sciences"},"provenance":null},{"subject":{"scheme":"keyword","value":"SARS-CoV-2"},"provenance":null},{"subject":{"scheme":"keyword","value":"Tumor Necrosis Factor-alpha"},"provenance":null},{"subject":{"scheme":"keyword","value":"TNF-α inhibitor"},"provenance":null},{"subject":{"scheme":"keyword","value":"COVID-19"},"provenance":null},{"subject":{"scheme":"keyword","value":"cytokine release syndrome"},"provenance":null},{"subject":{"scheme":"keyword","value":"MIS-C"},"provenance":null},{"subject":{"scheme":"keyword","value":"COVID-19 Drug Treatment"},"provenance":null},{"subject":{"scheme":"SDG","value":"3. Good health"},"provenance":null},{"subject":{"scheme":"FOS","value":"03 medical and health sciences"},"provenance":null},{"subject":{"scheme":"keyword","value":"Humans"},"provenance":null},{"subject":{"scheme":"keyword","value":"Public Health"},"provenance":null},{"subject":{"scheme":"keyword","value":"Public aspects of medicine"},"provenance":null},{"subject":{"scheme":"keyword","value":"RA1-1270"},"provenance":null},{"subject":{"scheme":"keyword","value":"infliximab"},"provenance":null},{"subject":{"scheme":"keyword","value":"Cytokine Release Syndrome"},"provenance":null}],"mainTitle":"Targeting TNF-α for COVID-19: Recent Advanced and Controversies","subTitle":null,"descriptions":["<jats:p>Recent advances in the pathophysiologic understanding of coronavirus disease 2019 (COVID-19) suggests that cytokine release syndrome (CRS) has an association with the severity of disease, which is characterized by increased tumor necrosis factor α (TNF-α), interleukin (IL)-6, IL-2, IL-7, and IL-10. Hence, managing CRS has been recommended for rescuing severe COVID-19 patients. TNF-α, one of the pro-inflammatory cytokines commonly upregulated in acute lung injury, triggers CRS and facilitates SARS-CoV-2 interaction with angiotensin-converting enzyme 2 (ACE2). TNF-α inhibitors, therefore, may serve as an effective therapeutic strategy for attenuating disease progression in severe SARS-CoV-2 infection. Below, we review the possibilities and challenges of targeting the TNF-α pathway in COVID-19 treatment.</jats:p>"],"publicationDate":"2022-02-11","publisher":"Frontiers Media SA","embargoEndDate":null,"sources":["Crossref","Front Public Health","Frontiers in Public Health, Vol 10 (2022)"],"formats":null,"contributors":null,"coverages":null,"bestAccessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/"},"container":{"name":"Frontiers in Public Health","issnPrinted":null,"issnOnline":"2296-2565","issnLinking":null,"ep":null,"iss":null,"sp":null,"vol":"10","edition":null,"conferencePlace":null,"conferenceDate":null},"documentationUrls":null,"codeRepositoryUrl":null,"programmingLanguage":null,"contactPeople":null,"contactGroups":null,"tools":null,"size":null,"version":null,"geoLocations":null,"id":"doi_dedup___::d69da4ae944a9dea4e539201030e4965","originalIds":["10.3389/fpubh.2022.833967","50|doiboost____|d69da4ae944a9dea4e539201030e4965","od_______267::f781d212fe60553c4dbd9a20142f4d3c","35223745","PMC8873570","50|od_______267::f781d212fe60553c4dbd9a20142f4d3c","oai:pubmedcentral.nih.gov:8873570","oai:doaj.org/article:becd1c0a2f404f5383f99f237b5f7a56","50|doajarticles::6aff30a15bd87ed08c8f7d667c9fc7f7"],"pids":[{"scheme":"doi","value":"10.3389/fpubh.2022.833967"},{"scheme":"pmid","value":"35223745"},{"scheme":"pmc","value":"PMC8873570"}],"dateOfCollection":null,"lastUpdateTimeStamp":null,"indicators":{"citationImpact":{"ci