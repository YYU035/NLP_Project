],"countries":[{"code":"CN","label":"China (People's Republic of)"}],"websiteurl":"http://www.sydyy.net.cn/"},{"legalName":"Shanxi Academy of Medical Sciences","acronym":"Shanxi Academy of Medical Sciences","id":"pending_org_::26f5227fbc4028966a9866eacf0c84c4","pids":[{"scheme":"ROR","value":"https://ror.org/04tshhm50"},{"scheme":"GRID","value":"grid.470966.a"}],"countries":[{"code":"CN","label":"China (People's Republic of)"}],"websiteurl":"http://www.sxdyy.org/"},{"legalName":"Huazhong University of Science and Technology","acronym":"HUST","id":"openorgs____::f3b0ea8ad2e4be9dce76048a2061d622","pids":[{"scheme":"FundRef","value":"501100003397"},{"scheme":"fundref","value":"501100003397"},{"scheme":"mag_id","value":"47720641"},{"scheme":"PIC","value":"997826100"},{"scheme":"OrgRef","value":"1127585"},{"scheme":"GRID","value":"grid.33199.31"},{"scheme":"wikidata","value":"Q1711196"},{"scheme":"ROR","value":"https://ror.org/00p991c53"},{"scheme":"Wikidata","value":"Q1711196"},{"scheme":"ISNI","value":"0000000403687223"},{"scheme":"OrgRef","value":"3461729"}],"countries":[{"code":"CN","label":"China (People's Republic of)"}],"websiteurl":"http://english.hust.edu.cn/"}],"communities":[{"code":"covid-19","label":"Corona Virus Disease","provenance":null}],"collectedFrom":[{"key":"openaire____::8ac8380272269217cb09a928c8caa993","value":"UnpayWall"},{"key":"driver______::bee53aa31dc2cbb538c10c2b65fa5824","value":"DOAJ"},{"key":"openaire____::081b82f96300b6a6e3d282bad31cb6e2","value":"Crossref"},{"key":"opendoar____::8b6dd7db9af49e67306feb59a8bdc52c","value":"Europe PubMed Central"},{"key":"opendoar____::eda80a3d5b344bc40f3bc04f65b7a357","value":"PubMed Central"}],"instances":[{"pids":[{"scheme":"doi","value":"10.3389/fpubh.2022.833967"}],"license":"CC BY","accessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/","openAccessRoute":"gold"},"type":"Article","urls":["https://doi.org/10.3389/fpubh.2022.833967"],"publicationDate":"2022-02-11","refereed":"peerReviewed","hostedBy":{"key":"doajarticles::87b6e5aecc2f7a2f346dd99a0d494c8a","value":"Frontiers in Public Health"},"collectedFrom":{"key":"openaire____::081b82f96300b6a6e3d282bad31cb6e2","value":"Crossref"}},{"pids":[{"scheme":"doi","value":"10.3389/fpubh.2022.833967"}],"license":"CC BY","accessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/","openAccessRoute":"gold"},"type":"Article","urls":["https://www.frontiersin.org/articles/10.3389/fpubh.2022.833967/pdf"],"refereed":"nonPeerReviewed","hostedBy":{"key":"doajarticles::87b6e5aecc2f7a2f346dd99a0d494c8a","value":"Frontiers in Public Health"},"collectedFrom":{"key":"openaire____::8ac8380272269217cb09a928c8caa993","value":"UnpayWall"}},{"pids":[{"scheme":"pmid","value":"35223745"},{"scheme":"pmc","value":"PMC8873570"}],"alternateIdentifiers":[{"scheme":"doi","value":"10.3389/fpubh.2022.833967"}],"accessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/","openAccessRoute":"gold"},"type":"Article","urls":["https://pubmed.ncbi.nlm.nih.gov/35223745"],"publicationDate":"2022-03-02","refereed":"nonPeerReviewed","hostedBy":{"key":"doajarticles::87b6e5aecc2f7a2f346dd99a0d494c8a","value":"Frontiers in Public Health"},"collectedFrom":{"key":"opendoar____::8b6dd7db9af49e67306feb59a8bdc52c","value":"Europe PubMed Central"}},{"alternateIdentifiers":[{"scheme":"doi","value":"10.3389/fpubh.2022.833967"}],"license":"CC BY","accessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/","openAccessRoute":null},"type":"Article","urls":["http://dx.doi.org/10.3389/fpubh.2022.833967"],"publicationDate":"2022-02-11","refereed":"nonPeerReviewed","hostedBy":{"key":"opendoar____::eda80a3d5b344bc40f3bc04f65b7a357","value":"PubMed Central"},"collectedFrom":{"key":"opendoar____::eda80a3d5b344bc40f3bc04f65b7a357","value":"PubMed Central"}},{"alternateIdentifiers":[{"scheme":"doi","value":"10.3389/fpubh.2022.833967"}],"accessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/","openAccessRoute":"gold"},"type":"Article","urls":["https://doaj.org/article/becd1c0a2f404f5383f99f237b5f7a56"],"publicationDate":"2022-02-01","refereed":"nonPeerReviewed","hostedBy":{"key":"doajarticles::87b6e5aecc2f7a2f346dd99a0d494c8a","value":"Frontiers in Public Health"},"collectedFrom":{"key":"driver______::bee53aa31dc2cbb538c10c2b65fa5824","value":"DOAJ"}}],"links":[],"otherTitles":null,"inDiamondJournal":false,"green":true,"isGreen":true,"isInDiamondJournal":false},{"authors":[{"id":null,"fullName":"Shorouk Ibrahim","name":null,"surname":null,"rank":1,"pid":null},{"id":null,"fullName":"Basem Essa","name":null,"surname":null,"rank":2,"pid":null},{"id":null,"fullName":"mona khattab","name":null,"surname":null,"rank":3,"pid":null},{"id":null,"fullName":"Ola Ahmed","name":null,"surname":null,"rank":4,"pid":null}],"openAccessColor":"gold","publiclyFunded":false,"eoscIfGuidelines":null,"type":"publication","language":{"code":"eng","label":"English"},"countries":null,"subjects":[{"subject":{"scheme":"FOS","value":"0303 health sciences"},"provenance":null},{"subject":{"scheme":"FOS","value":"03 medical and health sciences"},"provenance":null},{"subject":{"scheme":"keyword","value":"tumor necrosis factor alpha (tnf- α)"},"provenance":null},{"subject":{"scheme":"keyword","value":"interferon type i (ifn )"},"provenance":null},{"subject":{"scheme":"keyword","value":"severe acute respiratory syndrome coronavirus 2 (sars-cov-2)"},"provenance":null},{"subject":{"scheme":"keyword","value":"Infectious and parasitic diseases"},"provenance":null},{"subject":{"scheme":"keyword","value":"RC109-216"},"provenance":null}],"mainTitle":"Serum levels of tumor necrosis factor alpha and interferon alpha in COVID-19 patients and their correlations with disease severity.","subTitle":null,"descriptions":["Background: By the end of 2019, the severe acute respiratory syndrome coronavirus 2 (SARS-CoV-2) was revealed in China and led to a widespread global outbreak and posed a serious threat to public health. The pathophysiology of COVID-19 is heavily reliant on cytokines either beneficial like type I interferon (IFN), or harmful like tumour necrosis factor alpha (TNF-α), considering the so-called cytokine storm. Aim of the study: to assess serum levels of TNF-α & IFN-α in COVID-19 patients and their correlations with disease severity. This might add a new aspect in COVID-19 treatment either cytokine and/or anti-cytokine therapy. Methods: The current study was conducted on 60 patients diagnosed as COVID-19, divided into two groups ICU and non ICU (30 patients each) and 30 apparently healthy individuals. Serum levels of TNF-α and IFN-α were measured by ELISA. Results: There was a statistical significant difference between COVID-19 patients and control group as regards TNFα and INFα serum levels (P<0.001, P<0.001) respectively. Significant correlation between TNF -α, INF-α serum levels and patients outcome ( p =0.000, p =0.000) respectively. Conclusion: Serum level of TNF-α is significantly higher in COVID-19 patients compared to controls while serum level of INF α that is significantly higher in controls compared to COVID-19 patients. Their association with disease severity suggests that they can possibly serve as reliable biomarkers for monitoring disease activity and predicting severity and outcome in COVID-19."],"publicationDate":"2024-07-04","publisher":"Egyptian Knowledge Bank","embargoEndDate":null,"sources":["Crossref","Microbes and Infectious Diseases, Vol 5, Iss 4, Pp 1253-1263 (2024)"],"formats":null,"contributors":null,"coverages":null,"bestAccessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/"},"container":{"name":"Microbes and Infectious Diseases","issnPrinted":null,"issnOnline":"2682-4140","issnLinking":null,"ep":"0","iss":null,"sp":"0","vol":"0","edition":null,"conferencePlace":null,"conferenceDate":null},"documentationUrls":null,"codeRepositoryUrl":null,"programmingLanguage":null,"contactPeople":null,"contactGroups":null,"tools":null,"size":null,"version":null,"geoLocations":null,"id":"doi_dedup___::3d41a205b77d99df12a8b0143b6ba7ee","originalIds":["10.21608/mid.2024.286615.1931","50|doiboost____|3d41a205b77d99df12a8b0143b6ba7ee","50|doajarticles::1f917d4123879c051e1cdbff1e4fd28b","oai:doaj.org/article:0ede2867785a4a69b8e037ae940d0413"],"pids":[{"scheme":"doi","value":"10.21608/mid.2024.286615.1931"}],"dateOfCollection":null,"lastUpdateTimeStamp":null,"indicators":{"citationImpact":{"citationCount":1.0,"influence":2.1993398E-9,"popularity":2.583829E-9,"impulse":1.0,"citationClass":"C5","influenceClass":"C5","impulseClass":"C5","popularityClass":"C5"}},"projects":null,"organizations":[{"legalName":"Ain Shams University","acronym":"ASU","id":"openorgs____::e296a817e0ddb2e6094c1417078dbb35","pids":[{"scheme":"ISNI","value":"0000000406211570"},{"scheme":"OrgRef","value":"1980417"},{"scheme":"FundRef","value":"501100002352"},{"scheme":"wikidata","value":"Q2723670"},{"scheme":"mag_id","value":"107720978"},{"scheme":"Wikidata","value":"Q2723670"},{"scheme":"GRID","value":"grid.7269.a"},{"scheme":"FundRef","value":"501100002374"},{"scheme":"PIC","value":"996315228"},{"scheme":"fundref","value":"501100002352"},{"scheme":"ROR","value":"https://ror.org/00cb9w016"},{"scheme":"fundref","value":"501100002374"}],"countries":[{"code":"EG","label":"Egypt"}],"websiteurl":"http://www.asu.edu.eg/"},{"legalName":"Research Institute for Tropical Medicine","acronym":"RITM","id":"openorgs____::fd65f59ef8953d972a064f0ee242bfd6","pids":[{"scheme":"Wikidata","value":"Q7315099"},{"scheme":"ISNI","value":"000000044690374X"},{"scheme":"ROR","value":"https://ror.org/01g79at26"},{"scheme":"mag_id","value":"2800979572"},{"scheme":"PIC","value":"904767889"},{"scheme":"OrgRef","value":"12380655"},{"scheme":"GRID","value":"grid.437564.7"},{"scheme":"wikidata","value":"Q7315099"}],"countries":[{"code":"PH","label":"Philippines"}],"websiteurl":"http://www.ritm.gov.ph/"}],"communities":[{"code":"covid-19","label":"Corona Virus Disease","provenance":null}],"collectedFrom":[{"key":"driver______::bee53aa31dc2cbb538c10c2b65fa5824","value":"DOAJ"},{"key":"openaire____::081b82f96300b6a6e3d282bad31cb6e2","value":"Crossref"}],"instances":[{"pids":[{"scheme":"doi","value":"10.21608/mid.2024.286615.1931"}],"accessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/","openAccessRoute":"gold"},"type":"Article","urls":["https://doi.org/10.21608/mid.2024.286615.1931"],"publicationDate":"2024-07-04","refereed":"peerReviewed","hostedBy":{"key":"doajarticles::88f93c88710736e25087edaca51cbc3b","value":"Microbes and Infectious Diseases"},"collectedFrom":{"key":"openaire____::081b82f96300b6a6e3d282bad31cb6e2","value":"Crossref"}},{"alternateIdentifiers":[{"scheme":"doi","value":"10.21608/mid.2024.286615.1931"}],"accessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/","openAccessRoute":"gold"},"type":"Article","urls":["https://doaj.org/article/0ede2867785a4a69b8e037ae940d0413"],"publicationDate":"2024-11-01","refereed":"nonPeerReviewed","hostedBy":{"key":"doajarticles::88f93c88710736e25087edaca51cbc3b","value":"Microbes and Infectious Diseases"},"collectedFrom":{"key":"driver______::bee53aa31dc2cbb538c10c2b65fa5824","value":"DOAJ"}}],"links":[],"otherTitles":null,"inDiamondJournal":false,"green":false,"isGreen":false,"isInDiamondJournal":false},{"authors":[{"id":null,"fullName":"Mahdi Ghatrehsamani","name":"Mahdi","surname":"Ghatrehsamani","rank":1,"pid":null},{"id":null,"fullName":"Jafar Majidi","name":"Jafar","surname":"Majidi","rank":2,"pid":null},{"id":null,"fullName":"Ezat Shmsipoor Dehkordi","name":"Ezat Shmsipoor","surname":"Dehkordi","rank":3,"pid":null},{"id":null,"fullName":"Akbar Soleymani Babadi","name":"Akbar Soleymani","surname":"Babadi","rank":4,"pid":null},{"id":null,"fullName":"Mohammad Mousavi","name":"Mohammad","surname":"Mousavi","rank":5,"pid":{"id":{"scheme":"orcid_pending","value":"0000-0002-4936-701x"},"provenance":null}}],"openAccessColor":null,"publiclyFunded":false,"eoscIfGuidelines":null,"type":"publication","language":{"code":"und","label":"Undetermined"},"countries":null,"subjects":[{"subject":{"scheme":"FOS","value":"0303 health sciences"},"provenance":null},{"subject":{"scheme":"FOS","value":"03 medical and health sciences"},"provenance":null},{"subject":{"scheme":"SDG","value":"3. Good health"},"provenance":null}],"mainTitle":"A case report of severe acute respiratory syndrome coronavirus-2 infected patient treated with infliximab","subTitle":null,"descriptions":["<jats:p>Extensive immune response associated inflammation is the major reason for the pathological outcome of COVID-19 infection. Infliximab is an anti tumor necrosis factor (anti-TNF) drug that is used to reduce inflammation through TNF-α inhibition. Inhibition of main inflammatory cytokine such as TNF-α may has a potential effect in COVID-19 treatment. Here, we report the clinical outcome associated with Infliximab treatment in a 65-year-old woman with confirmed COVID-19 infection. Infliximab therapy was started on day 9th, patient demonstrated clinical improvement and recovery from COVID-19. Our findings suggest that the association of TNF-α inhibition and clinical management together contributes to COVID-19 patient survival.</jats:p>"],"publicationDate":"2024-01-31","publisher":"Wiley","embargoEndDate":null,"sources":["Crossref"],"formats":null,"contributors":null,"coverages":null,"bestAccessRight":null,"container":null,"documentationUrls":null,"codeRepositoryUrl":null,"programmingLanguage":null,"contactPeople":null,"contactGroups":null,"tools":null,"size":null,"version":null,"geoLocations":null,"id":"doi_________::434f9d5bae25d2c69e02d8a5fbeb3e48","originalIds":["10.22541/au.170667676.60180250/v1","50|doiboost____|434f9d5bae25d2c69e02d8a5fbeb3e48"],"pids":[{"scheme":"doi","value":"10.22541/au.170667676.60180250/v1"}],"dateOfCollection":null,"lastUpdateTimeStamp":null,"indicators":{"citationImpact":{"citationCount":0.0,"influence":2.1746283E-9,"popularity":1.944044E-9,"impulse":0.0,"citationClass":"C5","influenceClass":"C5","impulseClass":"C5","popularityClass":"C5"}},"projects":null,"organizations":[{"legalName":"Shahrekord University of Medical Sciences","acronym":"SKUMS","id":"openorgs____::05ef996243c5aa6ad27e70d2f9107224","pids":[{"scheme":"OrgRef","value":"5741433"},{"scheme":"ROR","value":"https://ror.org/0506tgm76"},{"scheme":"Wikidata","value":"Q16053407"},{"scheme":"ISNI","value":"0000000403848883"},{"scheme":"wikidata","value":"Q16053407"},{"scheme":"GRID","value":"grid.440801.9"},{"scheme":"fundref","value":"501100005756"},{"scheme":"mag_id","value":"170350485"},{"scheme":"FundRef","value":"501100005756"}],"countries":[{"code":"IR","label":"Iran (Islamic Republic of)"}],"websiteurl":"http://en.skums.ac.ir/"}],"communities":[{"code":"covid-19","label":"Corona Virus Disease","provenance":null}],"collectedFrom":[{"key":"openaire____::081b82f96300b6a6e3d282bad31cb6e2","value":"Crossref"}],"instances":[{"pids":[{"scheme":"doi","value":"10.22541/au.170667676.60180250/v1"}],"type":"Article","urls":["https://doi.org/10.22541/au.170667676.60180250/v1"],"publicationDate":"2024-01-31","refereed":"peerReviewed","hostedBy":{"key":"openaire____::55045bd2a65019fd8e6741a755395c8c","value":"Unknown Repository"},"collectedFrom":{"key":"openaire____::081b82f96300b6a6e3d282bad31cb6e2","value":"Crossref"}}],"links":[],"otherTitles":null,"inDiamondJournal":false,"green":false,"isGreen":false,"isInDiamondJournal":false},{"authors":[{"id":null,"fullName":"Jia, Fang","name":"Fang","surname":"Jia","rank":1,"pid":null},{"id":null,"fullName":"Wang, Gang","name":"Gang","surname":"Wang","rank":2,"pid":null},{"id":null,"fullName":"Xu, Jing","name":"Jing","surname":"Xu","rank":3,"pid":null},{"id":null,"fullName":"Long, Junhong","name":"Junhong","surname":"Long","rank":4,"pid":null},{"id":null,"fullName":"Deng, Fuxue","name":"Fuxue","surname":"Deng","rank":5,"pid":null},{"id":null,"fullName":"Jiang, Wei","name":"Wei","surname":"Jiang","rank":6,"pid":null}],"openAccessColor":"gold","publiclyFunded":false,"eoscIfGuidelines":null,"type":"publication","language":{"code":"eng","label":"English"},"countries":null,"subjects":[{"subject":{"scheme":"FOS","value":"0301 basic medicine"},"provenance":null},{"subject":{"scheme":"keyword","value":"Male"},"provenance":null},{"subject":{"scheme":"FOS","value":"0303 health sciences"},"provenance":null},{"subject":{"scheme":"keyword","value":"China"},"provenance":null},{"subject":{"scheme":"keyword","value":"SARS-CoV-2"},"provenance":null},{"subject":{"scheme":"keyword","value":"Tumor Necrosis Factor-alpha"},"provenance":null},{"subject":{"scheme":"keyword","value":"Critical Illness"},"provenance":null},{"subject":{"scheme":"keyword","value":"Interleukins"},"provenance":null},{"subject":{"scheme":"keyword","value":"Pneumonia, Viral"},"provenance":null},{"subject":{"scheme":"keyword","value":"COVID-19"},"provenance":null},{"subject":{"scheme":"keyword","value":"Immunologic Tests"},"provenance":null},{"subject":{"scheme":"keyword","value":"Middle Aged"},"provenance":null},{"subject":{"scheme":"keyword","value":"Severity of Illness Index"},"provenance":null},{"subject":{"scheme":"SDG","value":"3. Good health"},"provenance":null},{"subject":{"scheme":"FOS","value":"03 medical and health sciences"},"provenance":null},{"subject":{"scheme":"keyword","value":"Predictive Value of Tests"},"provenance":null},{"subject":{"scheme":"keyword","value":"Risk Factors"},"provenance":null},{"subject":{"scheme":"keyword","value":"Humans"},"provenance":null},{"subject":{"scheme":"keyword","value":"Female"},"provenance":null},{"subject":{"scheme":"keyword","value":"Tumor Necrosis Factor Inhibitors"},"provenance":null},{"subject":{"scheme":"keyword","value":"Hospital Mortality"},"provenance":null},{"subject":{"scheme":"keyword","value":"Mortality"},"provenance":null},{"subject":{"scheme":"keyword","value":"Tomography, X-Ray Computed"},"provenance":null},{"subject":{"scheme":"keyword","value":"Research Paper"},"provenance":null}],"mainTitle":"Role of tumor necrosis factor-α in the mortality of hospitalized patients with severe and critical COVID-19 pneumonia","subTitle":null,"descriptions":["The coronavirus disease 2019 (COVID-19) is presently the most pressing public health concern worldwide. Cytokine storm is an important factor leading to death of patients with COVID-19. This study aims to characterize serum cytokines of patients with severe or critical COVID-19. Clinical records were obtained from 149 patients who were tested at the Sino-French New City Branch of Tongji Hospital from 30 January to 30 March 2020. Data regarding the clinical features of the patients was collected and analyzed. Among the 149, 45 (30.2%) of them had severe conditions and 104 (69.8%) of that presented critical symptoms. In the meantime, 80 (53.7%) of that 149 died during hospitalization. Of all, male patients accounted for 94 (69.1%). Compared with patients in severe COVID-19, those who in critical COVID-19 had significantly higher levels of tumor necrosis factor-α (TNF-α), interleukin-6 (IL-6), IL-8, and IL-10. Moreover, the passed-away patients had considerably higher levels of TNF-α, IL-6, IL-8, and IL-10 than those survived from it. Regression analysis revealed that serum TNF-α level was an independent risk factor for the death of patient with severe conditions. Among the proinflammatory cytokines (IL-1β, TNF-α, IL-8, and IL-6) analyzed herein, TNF-α was seen as a risk factor for the death of patients with severe or critical COVID-19. This study suggests that anti-TNF-α treatment allows patients with severe or critical COVID-19 pneumonia to recover."],"publicationDate":"2021-11-01","publisher":"Impact Journals, LLC","embargoEndDate":null,"sources":["Crossref","Aging (Albany NY)"],"formats":null,"contributors":null,"coverages":null,"bestAccessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/"},"container":{"name":"Aging","issnPrinted":null,"issnOnline":"1945-4589","issnLinking":null,"ep":"23912","iss":null,"sp":"23895","vol":"13","edition":null,"conferencePlace":null,"conferenceDate":null},"documentationUrls":null,"codeRepositoryUrl":null,"programmingLanguage":null,"contactPeople":null,"contactGroups":null,"tools":null,"size":null,"version":null,"geoLocations":null,"id":"doi_dedup___::5d57b2f4fd40452b2fbb5140490bebb5","originalIds":["203663","34725309","10.18632/aging.203663","50|doiboost____|5d57b2f4fd40452b2fbb5140490bebb5","od_______267::6e965c4650f7f54b8e8482321d6dc001","PMC8610114","oai:pubmedcentral.nih.gov:8610114","50|od_______267::6e965c4650f7f54b8e8482321d6dc001","3208409862"],"pids":[{"scheme":"doi","value":"10.18632/aging.203663"},{"scheme":"pmid","value":"34725309"},{"scheme":"pmc","value":"PMC8610114"}],"dateOfCollection":null,"lastUpdateTimeStamp":null,"indicators":{"citationImpact":{"citationCount":29.0,"influence":3.0811238E-9,"popularity":2.0255072E-8,"impulse":18.0,"citationClass":"C4","influenceClass":"C4","impulseClass":"C4","popularityClass":"C4"}},"projects":null,"organizations":[{"legalName":"Xi’an Jiaotong-Liverpool University","acronym":"XJTLU","id":"openorgs____::3709a29f1acee67eeba5008c161f6d7b","pids":[{"scheme":"mag_id","value":"69356397"},{"scheme":"wikidata","value":"Q13562485"},{"scheme":"FundRef","value":"501100002412"},{"scheme":"mag_id","value":"87445476"},{"scheme":"Wikidata","value":"Q13562485"},{"scheme":"ROR","value":"https://ror.org/03zmrmn05"},{"scheme":"OrgRef","value":"11539096"},{"scheme":"ISNI","value":"0000000417654000"},{"scheme":"ROR","value":"https://ror.org/017zhmm22"},{"scheme":"wikidata","value":"Q981237"},{"scheme":"PIC","value":"990982071"},{"scheme":"FundRef","value":"501100006683"},{"scheme":"GRID","value":"grid.440701.6"},{"scheme":"fundref","value":"501100006683"},{"scheme":"GRID","value":"grid.43169.39"},{"scheme":"OrgRef","value":"663079"},{"scheme":"ISNI","value":"0000000105991243"},{"scheme":"Wikidata","value":"Q981237"},{"scheme":"fundref","value":"501100002412"}],"countries":[{"code":"CN","label":"China (People's Republic of)"}],"websiteurl":"http://www.xjtlu.edu.cn/en/"},{"legalName":"Second Affiliated Hospital of Xi'an Jiaotong University","acronym":"Second Affiliated Hospital of Xi'an Jiaotong University","id":"openorgs____::4f1e030f8bc853e7a3af085158f80551","pids":[{"scheme":"ROR","value":"https://ror.org/03aq7kf18"},{"scheme":"ISNI","value":"0000000417575804"},{"scheme":"wikidata","value":"Q30296340"},{"scheme":"Wikidata","value":"Q30296340"},{"scheme":"GRID","value":"grid.452672.0"}],"countries":[{"code":"CN","label":"China (People's Republic of)"}],"websiteurl":"http://www.2yuan.org/"}],"communities":[{"code":"covid-19","label":"Corona Virus Disease","provenance":null}],"collectedFrom":[{"key":"openaire____::8ac8380272269217cb09a928c8caa993","value":"UnpayWall"},{"key":"openaire____::081b82f96300b6a6e3d282bad31cb6e2","value":"Crossref"},{"key":"openaire____::5f532a3fc4f1ea403f37070f59a7a53a","value":"Microsoft Academic Graph"},{"key":"opendoar____::8b6dd7db9af49e67306feb59a8bdc52c","value":"Europe PubMed Central"},{"key":"opendoar____::eda80a3d5b344bc40f3bc04f65b7a357","value":"PubMed Central"}],"instances":[{"pids":[{"scheme":"doi","value":"10.18632/aging.203663"}],"accessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/","openAccessRoute":"gold"},"type":"Article","urls":["https://doi.org/10.18632/aging.203663"],"publicationDate":"2021-11-01","refereed":"