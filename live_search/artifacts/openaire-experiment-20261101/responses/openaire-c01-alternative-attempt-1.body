_::f45b7bea82cb53d5b80183ad7090fc35","pids":[{"scheme":"Wikidata","value":"Q4294347"},{"scheme":"GRID","value":"grid.415741.2"},{"scheme":"wikidata","value":"Q4294347"},{"scheme":"ROR","value":"https://ror.org/042qjjy86"},{"scheme":"OrgRef","value":"28642229"}],"countries":[{"code":"MM","label":"Myanmar"}],"websiteurl":"http://www.moh.gov.mm/"}],"communities":[{"code":"covid-19","label":"Corona Virus Disease","provenance":null}],"collectedFrom":[{"key":"openaire____::081b82f96300b6a6e3d282bad31cb6e2","value":"Crossref"},{"key":"opendoar____::8b6dd7db9af49e67306feb59a8bdc52c","value":"Europe PubMed Central"},{"key":"opendoar____::eda80a3d5b344bc40f3bc04f65b7a357","value":"PubMed Central"}],"instances":[{"pids":[{"scheme":"doi","value":"10.3390/ijms24076142"}],"license":"CC BY","accessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/","openAccessRoute":"gold"},"type":"Article","urls":["https://doi.org/10.3390/ijms24076142"],"publicationDate":"2023-03-24","refereed":"peerReviewed","hostedBy":{"key":"doajarticles::69253e9729bd4a3c6f33cf0de70ae7c5","value":"International Journal of Molecular Sciences"},"collectedFrom":{"key":"openaire____::081b82f96300b6a6e3d282bad31cb6e2","value":"Crossref"}},{"pids":[{"scheme":"pmid","value":"37047115"},{"scheme":"pmc","value":"PMC10094668"}],"alternateIdentifiers":[{"scheme":"doi","value":"10.3390/ijms24076142"}],"accessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/","openAccessRoute":"gold"},"type":"Article","urls":["https://pubmed.ncbi.nlm.nih.gov/37047115"],"publicationDate":"2023-04-14","refereed":"nonPeerReviewed","hostedBy":{"key":"doajarticles::69253e9729bd4a3c6f33cf0de70ae7c5","value":"International Journal of Molecular Sciences"},"collectedFrom":{"key":"opendoar____::8b6dd7db9af49e67306feb59a8bdc52c","value":"Europe PubMed Central"}},{"alternateIdentifiers":[{"scheme":"doi","value":"10.3390/ijms24076142"}],"license":"CC BY","accessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/","openAccessRoute":null},"type":"Conference object","urls":["http://dx.doi.org/10.3390/ijms24076142"],"publicationDate":"2023-03-24","refereed":"nonPeerReviewed","hostedBy":{"key":"opendoar____::eda80a3d5b344bc40f3bc04f65b7a357","value":"PubMed Central"},"collectedFrom":{"key":"opendoar____::eda80a3d5b344bc40f3bc04f65b7a357","value":"PubMed Central"}}],"links":[],"otherTitles":null,"inDiamondJournal":false,"green":true,"isGreen":true,"isInDiamondJournal":false},{"authors":[{"id":null,"fullName":"Ramezani, Mahtab","name":"Mahtab","surname":"Ramezani","rank":1,"pid":null},{"id":null,"fullName":"Rezaei, Omidvar","name":"Omidvar","surname":"Rezaei","rank":2,"pid":null},{"id":null,"fullName":"Alavi Darzam, Ilad","name":"Ilad","surname":"Alavi Darzam","rank":3,"pid":null},{"id":null,"fullName":"Hajiesmaeili, Mohammadreza","name":"Mohammadreza","surname":"Hajiesmaeili","rank":4,"pid":null},{"id":null,"fullName":"Amirdosara, Mahdi","name":"Mahdi","surname":"Amirdosara","rank":5,"pid":null},{"id":null,"fullName":"Simani, Leila","name":"Leila","surname":"Simani","rank":6,"pid":null},{"id":null,"fullName":"Aliaghaei, Abbas","name":"Abbas","surname":"Aliaghaei","rank":7,"pid":null}],"openAccessColor":"gold","publiclyFunded":false,"eoscIfGuidelines":null,"type":"publication","language":{"code":"eng","label":"English"},"countries":null,"subjects":[{"subject":{"scheme":"keyword","value":"covid-19"},"provenance":null},{"subject":{"scheme":"keyword","value":"inflammation"},"provenance":null},{"subject":{"scheme":"keyword","value":"apoptosis"},"provenance":null},{"subject":{"scheme":"keyword","value":"Case Series"},"provenance":null},{"subject":{"scheme":"keyword","value":"Internal medicine"},"provenance":null},{"subject":{"scheme":"keyword","value":"RC31-1245"},"provenance":null}],"mainTitle":"Altered serum and cerebrospinal fluid TNF-α, caspase 3, and IL 1β in COVID-19 disease.","subTitle":null,"descriptions":["We evaluated the levels of the tumor necrosis factor-α (TNF-α), interleukin-1β (IL-1β), and caspase-3 in the cerebrospinal fluid (CSF) and serum of COVID-19 patients to improve our knowledge about underlying mechanisms caused by this virus in central nervous system involvement.This case series study included six COVID-19 patients from March 26, 2020, to April 17, 2020, and six healthy control patients. CSF and serum levels of TNF-α, IL-1β, and caspase-3 have been assayed using monoclonal antibodies-based ELISAs.Patients with COVID-19 had significantly higher level of IL-1β, TNF-α, and caspase-3 in serum (239.16±35.73 pg/ml, 100.50±12.49 pg/ml, 3.58±0.11pg/ml, p < 0.001) and CSF (146.66±17.55 pg/ml, 63.16±14.68 pg/ml,3.22±0.03pg/ml, p<0.001), respectively as compared to control. In addition, our results showed that these biomarkers were significantly higher in serum compared with CSF of the COVID-19 patients (p<0.001).This study provides essential information for understanding the pathogenesis of COVID-19 infection and sheds light on the potential mechanisms of virus transmission. The obtained data could be useful for designing new prevention and treatment strategies for COVID-19."],"publicationDate":"2022-01-01","publisher":"Babol University of Medical Sciences","embargoEndDate":null,"sources":["Caspian J Intern Med","Caspian Journal of Internal Medicine, Vol 13, Iss Covid 19 Supplement 2, Pp 264-269 (2022)"],"formats":null,"contributors":null,"coverages":null,"bestAccessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/"},"container":{"name":"Caspian journal of internal medicine","issnPrinted":"2008-6164","issnOnline":null,"issnLinking":null,"ep":null,"iss":null,"sp":null,"vol":"13","edition":null,"conferencePlace":null,"conferenceDate":null},"documentationUrls":null,"codeRepositoryUrl":null,"programmin