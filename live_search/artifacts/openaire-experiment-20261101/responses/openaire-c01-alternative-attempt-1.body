"15603351"},{"scheme":"fundref","value":"501100022025"},{"scheme":"GRID","value":"grid.412707.7"}],"countries":[{"code":"EG","label":"Egypt"}],"websiteurl":"http://www.svu.edu.eg/"},{"legalName":"Al Ain University of Science and Technology","acronym":"AAU","id":"openorgs____::a6e7e05b0f3f2b5fad7636b5c91ca564","pids":[{"scheme":"OrgRef","value":"16050204"},{"scheme":"GRID","value":"grid.444473.4"},{"scheme":"fundref","value":"100020599"},{"scheme":"mag_id","value":"161913731"},{"scheme":"Wikidata","value":"Q4703454"},{"scheme":"FundRef","value":"100020599"},{"scheme":"ROR","value":"https://ror.org/023abrt21"},{"scheme":"ISNI","value":"0000000417629411"},{"scheme":"wikidata","value":"Q4703454"}],"countries":[{"code":"AE","label":"United Arab Emirates"}],"websiteurl":"http://aau.ac.ae/en/"},{"legalName":"University of Jordan","acronym":"UJ","id":"openorgs____::2651b044145ac08e726419c5e85ff78f","pids":[{"scheme":"PIC","value":"997223342"},{"scheme":"FundRef","value":"100007776"},{"scheme":"GRID","value":"grid.9670.8"},{"scheme":"OrgRef","value":"2599076"},{"scheme":"fundref","value":"100007776"},{"scheme":"ROR","value":"https://ror.org/05k89ew48"},{"scheme":"wikidata","value":"Q610253"},{"scheme":"FundRef","value":"501100021772"},{"scheme":"FundRef","value":"501100005712"},{"scheme":"fundref","value":"501100021772"},{"scheme":"fundref","value":"501100005712"},{"scheme":"Wikidata","value":"Q610253"},{"scheme":"ISNI","value":"0000000121744509"},{"scheme":"mag_id","value":"114972647"}],"countries":[{"code":"JO","label":"Jordan"}],"websiteurl":"http://ju.edu.jo/home.aspx"},{"legalName":"Aswan University","acronym":"Aswan University","id":"openorgs____::fc6c88a68e3ac79a2977f276503ef564","pids":[{"scheme":"mag_id","value":"86310350"},{"scheme":"ISNI","value":"0000000446993028"},{"scheme":"ROR","value":"https://ror.org/048qnr849"},{"scheme":"GRID","value":"grid.417764.7"},{"scheme":"FundRef","value":"501100022026"},{"scheme":"OrgRef","value":"38499555"},{"scheme":"Wikidata","value":"Q4811978"},{"scheme":"fundref","value":"501100022026"},{"scheme":"PIC","value":"934123484"},{"scheme":"wikidata","value":"Q4811978"}],"countries":[{"code":"EG","label":"Egypt"}],"websiteurl":"http://www.aswu.edu.eg/English/Pages/default.aspx"},{"legalName":"South Valley University, Faculty of Medicine","acronym":"South Valley University, Faculty of Medicine","id":"pending_org_::c7634a2d12ce6b65572dc2631aefe0d1","pids":null,"countries":[{"code":"EG","label":"Egypt"}],"websiteurl":null}],"communities":[{"code":"covid-19","label":"Corona Virus Disease","provenance":null}],"collectedFrom":[{"key":"driver______::bee53aa31dc2cbb538c10c2b65fa5824","value":"DOAJ"},{"key":"openaire____::081b82f96300b6a6e3d282bad31cb6e2","value":"Crossref"},{"key":"opendoar____::8b6dd7db9af49e67306feb59a8bdc52c","value":"Europe PubMed Central"},{"key":"opendoar____::eda80a3d5b344bc40f3bc04f65b7a357","value":"PubMed Central"}],"instances":[{"pids":[{"scheme":"doi","value":"10.3345/cep.2024.00941"}],"license":"CC BY NC","accessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/","openAccessRoute":"gold"},"type":"Article","urls":["https://doi.org/10.3345/cep.2024.00941"],"publicationDate":"2024-12-15","refereed":"peerReviewed","hostedBy":{"key":"doajarticles::a176c48b9e695951794a8025582e4e03","value":"Clinical and Experimental Pediatrics"},"collectedFrom":{"key":"openaire____::081b82f96300b6a6e3d282bad31cb6e2","value":"Crossref"}},{"pids":[{"scheme":"pmid","value":"39600173"},{"scheme":"pmc","value":"PMC11621736"}],"alternateIdentifiers":[{"scheme":"doi","value":"10.3345/cep.2024.00941"}],"accessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/","openAccessRoute":"gold"},"type":"Article","urls":["https://pubmed.ncbi.nlm.nih.gov/39600173"],"refereed":"nonPeerReviewed","hostedBy":{"key":"doajarticles::a176c48b9e695951794a8025582e4e03","value":"Clinical and Experimental Pediatrics"},"collectedFrom":{"key":"opendoar____::8b6dd7db9af49e67306feb59a8bdc52c","value":"Europe PubMed Central"}},{"alternateIdentifiers":[{"scheme":"doi","value":"10.3345/cep.2024.00941"}],"license":"CC BY NC","accessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/","openAccessRoute":null},"type":"Article","urls":["http://dx.doi.org/10.3345/cep.2024.00941"],"publicationDate":"2024-11-27","refereed":"nonPeerReviewed","hostedBy":{"key":"opendoar____::eda80a3d5b344bc40f3bc04f65b7a357","value":"PubMed Central"},"collectedFrom":{"key":"opendoar____::eda80a3d5b344bc40f3bc04f65b7a357","value":"PubMed Central"}},{"alternateIdentifiers":[{"scheme":"doi","value":"10.3345/cep.2024.00941"}],"accessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/","openAccessRoute":"gold"},"type":"Article","urls":["https://doaj.org/article/5e5e0e9c3b1945f0ab8d23661645f707"],"publicationDate":"2024-12-01","refereed":"nonPeerReviewed","hostedBy":{"key":"doajarticles::a176c48b9e695951794a8025582e4e03","value":"Clinical and Experimental Pediatrics"},"collectedFrom":{"key":"driver______::bee53aa31dc2cbb538c10c2b65fa5824","value":"DOAJ"}}],"links":[],"otherTitles":null,"inDiamondJournal":false,"green":true,"isGreen":true,"isInDiamondJournal":false},{"authors":[{"id":null,"fullName":"Babaei, Mansour","name":"Mansour","surname":"Babaei","rank":1,"pid":null},{"id":null,"fullName":"Heidari, Behzad","name":"Behzad","surname":"Heidari","rank":2,"pid":null},{"id":null,"fullName":"Sadeghi Haddad Zavareh, Mahmoud","name":"Mahmoud","surname":"Sadeghi Haddad Zavareh","rank":3,"pid":null},{"id":null,"fullName":"Ahmadnia, Zahra","name":"Zahra","surname":"Ahmadnia","rank":4,"pid":null},{"id":null,"fullName":"Ghorbani, Hossein","name":"Hossein","surname":"Ghorbani","rank":5,"pid":null},{"id":null,"fullName":"Rouhi, Samaneh","name":"Samaneh","surname":"Rouhi","rank":6,"pid":null}],"openAccessColor":"gold","publiclyFunded":false,"eoscIfGuidelines":null,"type":"publication","language":{"code":"eng","label":"English"},"countries":null,"subjects":[{"subject":{"scheme":"FOS","value":"03 medical and health sciences"},"provenance":null},{"subject":{"scheme":"keyword","value":"obesity"},"provenance":null},{"subject":{"scheme":"FOS","value":"0302 clinical medicine"},"provenance":null},{"subject":{"scheme":"keyword","value":"diabetes"},"provenance":null},{"subject":{"scheme":"keyword","value":"sex"},"provenance":null},{"subject":{"scheme":"keyword","value":"Original Article"},"provenance":null},{"subject":{"scheme":"keyword","value":"tumor necrosis factor-alpha (tnf-α)"},"provenance":null},{"subject":{"scheme":"keyword","value":"Internal medicine"},"provenance":null},{"subject":{"scheme":"keyword","value":"RC31-1245"},"provenance":null},{"subject":{"scheme":"keyword","value":"coronavirus disease (covid-19)"},"provenance":null}],"mainTitle":"Serum tumor necrosis factor-alpha status in hospitalized patients with coronavirus disease-2019 (COVID-19).","subTitle":null,"descriptions":["Tumor necrosis factor alpha (TNF-α) produces an inflammatory process and plays a critical role against infection and in the control of viral infection. The present study was conducted to determine the status of serum TNF-α in hospitalized patients with coronavirus disease-2019 (COVID-19).In this cross-sectional study the serum TNF-α level, sex, and age, were determined in patients with COVID-19. The association between variables was determined using the student t-test, analysis of variance (ANOVA) test, multiple logistic regression analysis, and the statistical package for the Social Sciences (SPSS)-18 (p < 0.05).A total of 91 (women 41.75%, and men 58.24%) patients with a mean serum TNF-α level of 9.9 picograms per milliliter (pg/mL) were considered. In all (100%) patients, the TNF-α serum level was more than the normal limit (P=0.95). 95.60% of patients suffered severe COVID-19, with a TNF-a serum level of 10.20 pg/mL (P=0.87). Mean TNF-α serum levels in women and men were 11.37 pg/mL and 8.8 pg/mL, respectively (P= 0.17). In the age group of > 70 years (11.30 pg/mL), serum TNF-α concentration was higher than the other age groups (p>0.05).A significant proportion of women and men patients with COVID-19 in the middle and old age had a high concentration of serum TNF-α which may indicate the severity of the disease. Serum TNF-α level is different in women and men of different ages, so it can contribute to treatment strategies."],"publicationDate":"2024-08-01","publisher":"Babol University of Medical Sciences","embargoEndDate":null,"sources":["Caspian J Intern Med","Caspian Journal of Internal Medicine, Vol 15, Iss 4, Pp 601-605 (2024)"],"formats":null,"contributors":null,"coverages":null,"bestAccessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/"},"container":{"name":"Caspian journal of internal medicine","issnPrinted":"2008-6164","issnOnline":null,"issnLinking":null,"ep":null,"iss":null,"sp":null,"vol":"15","edition":null,"conferencePlace":null,"conferenceDate":null},"documentationUrls":null,"codeRepositoryUrl":null,"programmingLanguage":null,"contactPeople":null,"contactGroups":null,"tools":null,"size":null,"version":null,"geoLocations":null,"id":"doi_dedup___::140e5520e334a94f402251432fa820ba","originalIds":["od_______267::8fc272223fd4149a04bfe24a6a3444ba","39359436","PMC11444111","oai:pubmedcentral.nih.gov:11444111","50|od_______267::8fc272223fd4149a04bfe24a6a3444ba","oai:doaj.org/article:2e0d2858197a4334a8695b690164ec17","50|doajarticles::d2956c8bba43ad94fdac9d88f1adcde0","50|medra_______::140e5520e334a94f402251432fa820ba","10.22088/cjim.15.4.601"],"pids":[{"scheme":"pmid","value":"39359436"},{"scheme":"pmc","value":"PMC11444111"},{"scheme":"doi","value":"10.22088/cjim.15.4.601"}],"dateOfCollection":null,"lastUpdateTimeStamp":null,"indicators":{"citationImpact":{"citationCount":0.0,"influence":2.1746283E-9,"popularity":1.944044E-9,"impulse":0.0,"citationClass":"C5","influenceClass":"C5","impulseClass":"C5","popularityClass":"C5"}},"projects":null,"organizations":[{"legalName":"Babol University of Medical Sciences","acronym":"BUMS","id":"openorgs____::6d12bf820a83436676395254cb04db5b","pids":[{"scheme":"ISNI","value":"0000000404214102"},{"scheme":"GRID","value":"grid.411495.c"},{"scheme":"OrgRef","value":"1573634"},{"scheme":"wikidata","value":"Q4837979"},{"scheme":"ROR","value":"https://ror.org/02r5cmz65"},{"scheme":"mag_id","value":"70876197"},{"scheme":"FundRef","value":"501100005716"},{"scheme":"fundref","value":"501100005716"},{"scheme":"Wikidata","value":"Q4837979"}],"countries":[{"code":"IR","label":"Iran (Islamic Republic of)"}],"websiteurl":"http://en.mubabol.ac.ir/"},{"legalName":"National Institute of Health Researches of Iran","acronym":"NIHR","id":"pending_org_::4036cd3938df93c7db965bb5eac65f62","pids":[{"scheme":"Wikidata","value":"Q88980859"},{"scheme":"wikidata","value":"Q88980859"},{"scheme":"ROR","value":"https://ror.org/00spd2n27"}],"countries":[{"code":"IR","label":"Iran (Islamic Republic of)"}],"websiteurl":"https://nihr.tums.ac.ir"}],"communities":[{"code":"covid-19","label":"Corona Virus Disease","provenance":null}],"collectedFrom":[{"key":"driver______::bee53aa31dc2cbb538c10c2b65fa5824","value":"DOAJ"},{"key":"opendoar____::8b6dd7db9af49e67306feb59a8bdc52c","value":"Europe PubMed Central"},{"key":"openaire____::8687d924ebc4162c13d0030e57a632ac","value":"mEDRA"},{"key":"opendoar____::eda80a3d5b344bc40f3bc04f65b7a357","value":"PubMed Central"}],"instances":[{"pids":[{"scheme":"pmid","value":"39359436"},{"scheme":"pmc","value":"PMC11444111"}],"alternateIdentifiers":[{"scheme":"doi","value":"10.22088/cjim.15.4.601"}],"accessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/","openAccessRoute":"gold"},"type":"Article","urls":["https://pubmed.ncbi.nlm.nih.gov/39359436"],"refereed":"nonPeerReviewed","hostedBy":{"key":"doajarticles::08d999d0c662607c672bf204f6e47577","value":"Caspian Journal of Internal Medicine"},"collectedFrom":{"key":"opendoar____::8b6dd7db9af49e67306feb59a8bdc52c","value":"Europe PubMed Central"}},{"alternateIdentifiers":[{"scheme":"doi","value":"10.22088/cjim.15.4.601"}],"license":"http://creativecommons.org/licenses/by-nc/4.0/ http://creativecommons.org/licenses/by-nc/4.0/","accessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/","openAccessRoute":null},"type":"Article","urls":["http://dx.doi.org/10.22088/cjim.15.4.601"],"publicationDate":"2024-08-30","refereed":"nonPeerReviewed","hostedBy":{"key":"opendoar____::eda80a3d5b344bc40f3bc04f65b7a357","value":"PubMed Central"},"collectedFrom":{"key":"opendoar____::eda80a3d5b344bc40f3bc04f65b7a357","value":"PubMed Central"}},{"accessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/","openAccessRoute":"gold"},"type":"Article","urls":["https://doaj.org/article/2e0d2858197a4334a8695b690164ec17"],"publicationDate":"2024-08-01","refereed":"nonPeerReviewed","hostedBy":{"key":"doajarticles::08d999d0c662607c672bf204f6e47577","value":"Caspian Journal of Internal Medicine"},"collectedFrom":{"key":"driver______::bee53aa31dc2cbb538c10c2b65fa5824","value":"DOAJ"}},{"pids":[{"scheme":"doi","value":"10.22088/cjim.15.4.601"}],"type":"Article","urls":["https://doi.org/10.22088/cjim.15.4.601"],"publicationDate":"2024-08-01","refereed":"nonPeerReviewed","hostedBy":{"key":"openaire____::8687d924ebc4162c13d0030e57a632ac","value":"mEDRA"},"collectedFrom":{"key":"openaire____::8687d924ebc4162c13d0030e57a632ac","value":"mEDRA"}}],"links":[],"otherTitles":null,"inDiamondJournal":false,"green":true,"isGreen":true,"isInDiamondJournal":false}]}