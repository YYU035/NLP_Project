articles::f5c883d7dea7cfa40d9bf7581df67fde","value":"The Astrophysical Journal"},"collectedFrom":{"key":"openaire____::081b82f96300b6a6e3d282bad31cb6e2","value":"Crossref"}},{"pids":[{"scheme":"doi","value":"10.48550/arxiv.2112.05865"}],"license":"arXiv Non-Exclusive Distribution","type":"Article","urls":["https://dx.doi.org/10.48550/arxiv.2112.05865"],"publicationDate":"2021-01-01","refereed":"nonPeerReviewed","hostedBy":{"key":"openaire____::55045bd2a65019fd8e6741a755395c8c","value":"Unknown Repository"},"collectedFrom":{"key":"openaire____::9e3be59865b2c1c335d32dae2fe7b254","value":"Datacite"}},{"pids":[{"scheme":"arXiv","value":"2112.05865"}],"accessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/","openAccessRoute":null},"type":"Preprint","urls":["http://arxiv.org/abs/2112.05865"],"publicationDate":"2021-12-10","refereed":"nonPeerReviewed","hostedBy":{"key":"opendoar____::6f4922f45568161a8cdf4ad2299f6d23","value":"arXiv.org e-Print Archive"},"collectedFrom":{"key":"opendoar____::6f4922f45568161a8cdf4ad2299f6d23","value":"arXiv.org e-Print Archive"}},{"alternateIdentifiers":[{"scheme":"doi","value":"10.3847/1538-4357/ad5439"}],"accessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/","openAccessRoute":"gold"},"type":"Article","urls":["https://doaj.org/article/385751ff570147a9963398d2a2171cae"],"publicationDate":"2024-01-01","refereed":"nonPeerReviewed","hostedBy":{"key":"doajarticles::f5c883d7dea7cfa40d9bf7581df67fde","value":"The Astrophysical Journal"},"collectedFrom":{"key":"driver______::bee53aa31dc2cbb538c10c2b65fa5824","value":"DOAJ"}}],"links":[],"otherTitles":null,"green":true,"inDiamondJournal":false,"isGreen":true,"isInDiamondJournal":false},{"authors":[{"id":null,"fullName":"Zhanyu Zhou","name":"Zhanyu","surname":"Zhou","rank":1,"pid":null}],"openAccessColor":null,"publiclyFunded":false,"eoscIfGuidelines":null,"type":"publication","language":{"code":"und","label":"Undetermined"},"countries":null,"subjects":[{"subject":{"scheme":"FOS","value":"0103 physical sciences"},"provenance":null},{"subject":{"scheme":"FOS","value":"01 natural sciences"},"provenance":null}],"mainTitle":"Analysis of Galactic Rotation Curves: Newtonian Predictions vs. Observations and the Role of Dark Matter","subTitle":null,"descriptions":["<jats:p>This study examines the rotational path of spiral galaxies to test Newtonian predictions against observations, and assesses the presence of dark matter. It uses the equation of expected orbital velocity and compares to observed rotation curves for the Milky Way, Andromeda (M31), and NGC 3198, followed by an application of Virial Theorem to estimate total galactic mass from stellar velocity dispersions. The observations demonstrate that the rotation path for spiral galaxies is flat at large radii, in sharp contrast to the declining profiles predicted by Newtonian gravity. This conflict demonstrates that a dark matter halo (e.g., Navarro–Frenk–White profile) naturally produces the additional gravitational pull, resulting in flat rotation curves as observed. Lastly application of Gravitational lensing observations and Modified Newtonian Dynamics (MOND) to simulate flat rotation curves without dark matter is discussed.</jats:p>"],"publicationDate":"2025-10-23","publisher":"EWA Publishing","embargoEndDate":null,"sources":["Crossref"],"formats":null,"contributors":null,"coverages":null,"bestAccessRight":null,"container":{"name":"Theoretical and Natural Science","issnPrinted":"2753-8818","issnOnline":"2753-8826","issnLinking":null,"ep":"265","iss":null,"sp":"259","vol":"143","edition":null,"conferencePlace":null,"conferenceDate":null},"documentationUrls":null,"codeRepositoryUrl":null,"programmingLanguage":null,"contactPeople":null,"contactGroups":null,"tools":null,"size":null,"version":null,"geoLocations":null,"id":"doi_________::072e2f22917c58b095b58726b4a7a96e","originalIds":["10.54254/2753-8818/2026.hz28011","50|doiboost____|072e2f22917c58b095b58726b4a7a96e"],"pids":[{"scheme":"doi","value":"10.54254/2753-8818/2026.hz28011"}],"dateOfCollection":null,"lastUpdateTimeStamp":null,"indicators":{"citationImpact":{"citationCount":0.0,"influence":2.1746283E-9,"popularity":2.2497804E-9,"impulse":0.0,"citationClass":"C5","influenceClass":"C5","impulseClass":"C5","popularityClass":"C5"}},"projects":null,"organizations":null,"communities":null,"collectedFrom":[{"key":"openaire____::081b82f96300b6a6e3d282bad31cb6e2","value":"Crossref"}],"instances":[{"pids":[{"scheme":"doi","value":"10.54254/2753-8818/2026.hz28011"}],"type":"Article","urls":["https://doi.org/10.54254/2753-8818/2026.hz28011"],"publicationDate":"2025-10-23","refereed":"peerReviewed","hostedBy":{"key":"issn___print::f23ef25413a84c4c32dc6bdd9eb0e703","value":"Theoretical and Natural Science"},"collectedFrom":{"key":"openaire____::081b82f96300b6a6e3d282bad31cb6e2","value":"Crossref"}}],"links":null,"otherTitles":null,"green":false,"inDiamondJournal":false,"isGreen":false,"isInDiamondJournal":false},{"authors":[{"id":null,"fullName":"tARUN","name":null,"surname":"tARUN","rank":1,"pid":{"id":{"scheme":"orcid_pending","value":"0009-0003-1862-6634"},"provenance":null}}],"openAccessColor":null,"publiclyFunded":false,"eoscIfGuidelines":null,"type":"publication","language":{"code":"und","label":"Undetermined"},"countries":null,"subjects":[{"subject":{"scheme":"FOS","value":"0103 physical sciences"},"provenance":null},{"subject":{"scheme":"FOS","value":"01 natural sciences"},"provenance":null},{"subject":{"scheme":"keyword","value":"Theoretical physics"},"provenance":null}],"mainTitle":"Common-Reality: Elliptical Galaxies and the Universal Suppression Background","subTitle":null,"descriptions":["Elliptical galaxies and galaxy clusters exhibit flat or rising velocity-dispersion profiles that are conventionally attributed to massive dark-matter halos. Unlike spiral galaxies, these systems lack strong organized rotation, posing a challenge for gravity models in which rotational dynamics play a central role. In this paper, we extend the Common-Reality: Separating Time, Mass and Gravity framework by introducing a universal suppression background in the scalar field Φ. This background modifies spatial geometry at large radii independent of local rotation, producing a persistent acceleration scale in pressure-supported systems. We show that this mechanism reproduces the observed velocity-dispersion profiles of elliptical galaxies and the mass–discrepancy–acceleration relation without invoking dark matter. The results demonstrate that dark-matter phenomenology in non-rotating systems arises naturally from large-scale spatial suppression rather than unseen mass."],"publicationDate":"2025-12-28","publisher":"Zenodo","embargoEndDate":null,"sources":null,"formats":null,"contributors":["tARUN"],"coverages":null,"bestAccessRight":{"code":"c_16ec","label":"RESTRICTED","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/"},"container":null,"documentationUrls":null,"codeRepositoryUrl":null,"programmingLanguage":null,"contactPeople":null,"contactGroups":null,"tools":null,"size":null,"version":null,"geoLocations":null,"id":"doi_dedup___::01b0d316b3bda59b60662ac3da23620c","originalIds":["50|datacite____::01b0d316b3bda59b60662ac3da23620c","10.5281/zenodo.18070857","50|datacite____::a578a8b00556161fb94a3139979217cf","10.5281/zenodo.18070858","oai:zenodo.org:18070858","50|od______2659::a578a8b00556161fb94a3139979217cf"],"pids":[{"scheme":"doi","value":"10.5281/zenodo.18070857"},{"scheme":"doi","value":"10.5281/zenodo.18070858"}],"dateOfCollection":null,"lastUpdateTimeStamp":null,"indicators":{"citationImpact":{"citationCount":0.0,"influence":2.1746283E-9,"popularity":2.2497804E-9,"impulse":0.0,"citationClass":"C5","influenceClass":"C5","impulseClass":"C5","popularityClass":"C5"}},"projects":null,"organizations":null,"communities":[{"code":"eosc","label":"EOSC","provenance":null}],"collectedFrom":[{"key":"openaire____::9e3be59865b2c1c335d32dae2fe7b254","value":"Datacite"},{"key":"opendoar____::358aee4cc897452c00244351e4d91f69","value":"ZENODO"}],"instances":[{"pids":[{"scheme":"doi","value":"10.5281/zenodo.18070857"}],"license":"CC BY","type":"Article","urls":["https://dx.doi.org/10.5281/zenodo.18070857"],"publicationDate":"2025-12-28","refereed":"nonPeerReviewed","hostedBy":{"key":"opendoar____::358aee4cc897452c00244351e4d91f69","value":"ZENODO"},"collectedFrom":{"key":"openaire____::9e3be59865b2c1c335d32dae2fe7b254","value":"Datacite"}},{"pids":[{"scheme":"doi","value":"10.5281/zenodo.18070858"}],"license":"CC BY","type":"Article","urls":["https://dx.doi.org/10.5281/zenodo.18070858"],"publicationDate":"2025-12-28","refereed":"nonPeerReviewed","hostedBy":{"key":"opendoar____::358aee4cc897452c00244351e4d91f69","value":"ZENODO"},"collectedFrom":{"key":"openaire____::9e3be59865b2c1c335d32dae2fe7b254","value":"Datacite"}},{"pids":[{"scheme":"doi","value":"10.5281/zenodo.18070858"}],"alternateIdentifiers":[{"scheme":"oai","value":"oai:zenodo.org:18070858"}],"license":"CC BY","accessRight":{"code":"c_16ec","label":"RESTRICTED","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/","openAccessRoute":null},"type":"Article","urls":["http://dx.doi.org/10.5281/zenodo.18070858","https://zenodo.org/records/18070858"],"publicationDate":"2025-12-28","refereed":"nonPeerReviewed","hostedBy":{"key":"opendoar____::358aee4cc897452c00244351e4d91f69","value":"ZENODO"},"collectedFrom":{"key":"opendoar____::358aee4cc897452c00244351e4d91f69","value":"ZENODO"}}],"links":[],"otherTitles":null,"green":false,"inDiamondJournal":false,"isGreen":false,"isInDiamondJournal":false},{"authors":[{"id":null,"fullName":"Daniel Bustos","name":"Daniel","surname":"Bustos","rank":1,"pid":null},{"id":null,"fullName":"Nitya Ravi","name":"Nitya","surname":"Ravi","rank":2,"pid":{"id":{"scheme":"orcid_pending","value":"0000-0002-4248-2840"},"provenance":null}},{"id":null,"fullName":"Kelly Douglass","name":"Kelly","surname":"Douglass","rank":3,"pid":{"id":{"scheme":"orcid_pending","value":"0000-0002-9540-546x"},"provenance":null}}],"openAccessColor":null,"publiclyFunded":null,"eoscIfGuidelines":null,"type":"publication","language":{"code":"und","label":"Undetermined"},"countries":null,"subjects":[{"subject":{"scheme":"keyword","value":"Astronomical sciences"},"provenance":null}],"mainTitle":"Measuring galactic rotation curves in the DESI Peculiar Velocity Survey","subTitle":null,"descriptions":["We study the dark matter content in galaxies by estimating their total masses and comparing this to their visible masses. We calculate the rotational velocity of ~4000 spiral galaxies observed in the DESI Peculiar Velocity Survey that have at least three targets within R<sub>26</sub> . Using these rotational velocities, we fit a rotation curve to each galaxy, which allows us to estimate the total mass within R<sub>26</sub>. By using stellar masses from CIGALE and HI mass from ALFALFA, we compare the ratio of visible to total mass in these galaxies.<br>"],"publicationDate":"2026-07-28","publisher":"University of Rochester","embargoEndDate":null,"sources":null,"formats":null,"contributors":null,"coverages":null,"bestAccessRight":null,"container":null,"documentationUrls":null,"codeRepositoryUrl":null,"programmingLanguage":null,"contactPeople":null,"contactGroups":null,"tools":null,"size":null,"version":null,"geoLocations":null,"id":"doi_dedup___::97d498070b8c43e2ad5f99296d79ed8c","originalIds":["50|datacite____::97d498070b8c43e2ad5f99296d79ed8c","10.60593/ur.d.33084287.v1","50|datacite____::a52ca29a3d6b396da029e09ee3bc9f2e","10.60593/ur.d.33084287"],"pids":[{"scheme":"doi","value":"10.60593/ur.d.33084287.v1"},{"scheme":"doi","value":"10.60593/ur.d.33084287"}],"dateOfCollection":null,"lastUpdateTimeStamp":null,"indicators":{"citationImpact":{"citationCount":0.0,"influence":2.1746283E-9,"popularity":2.6085654E-9,"impulse":0.0,"citationClass":"C5","influenceClass":"C5","impulseClass":"C5","popularityClass":"C5"}},"projects":null,"organizations":null,"communities":null,"collectedFrom":[{"key":"openaire____::9e3be59865b2c1c335d32dae2fe7b254","value":"Datacite"}],"instances":[{"pids":[{"scheme":"doi","value":"10.60593/ur.d.33084287.v1"}],"license":"CC BY","type":"Conference object","urls":["https://dx.doi.org/10.60593/ur.d.33084287.v1"],"publicationDate":"2026-07-28","refereed":"nonPeerReviewed","hostedBy":{"key":"openaire____::55045bd2a65019fd8e6741a755395c8c","value":"Unknown Repository"},"collectedFrom":{"key":"openaire____::9e3be59865b2c1c335d32dae2fe7b254","value":"Datacite"}},{"pids":[{"scheme":"doi","value":"10.60593/ur.d.33084287"}],"license":"CC BY","type":"Conference object","urls":["https://dx.doi.org/10.60593/ur.d.33084287"],"publicationDate":"2026-07-28","refereed":"nonPeerReviewed","hostedBy":{"key":"openaire____::55045bd2a65019fd8e6741a755395c8c","value":"Unknown Repository"},"collectedFrom":{"key":"openaire____::9e3be59865b2c1c335d32dae2fe7b254","value":"Datacite"}}],"links":null,"otherTitles":null,"green":null,"inDiamondJournal":null,"isGreen":null,"isInDiamondJournal":null},{"authors":[{"id":"orcid_______::fce128d4d71e152eaedfd070a9078d5d","fullName":"A. N. Villano","name":"A. N.","surname":"Villano","rank":1,"pid":{"id":{"scheme":"orcid","value":"0000-0002-3893-7259"},"provenance":null}},{"id":null,"fullName":"Kitty C. Harris","name":"Kitty C.","surname":"Harris","rank":2,"pid":{"id":{"scheme":"orcid_pending","value":"0000-0001-5406-8367"},"provenance":null}},{"id":"orcid_______::60f3ff4fb1598711e2ca7d6fad221989","fullName":"Judit Bergfalk","name":"Judit","surname":"Bergfalk","rank":3,"pid":{"id":{"scheme":"orcid","value":"0000-0003-1662-0768"},"provenance":null}},{"id":null,"fullName":"Raphael Hatami","name":"Raphael","surname":"Hatami","rank":4,"pid":null},{"id":null,"fullName":"Francis Vititoe","name":"Francis","surname":"Vititoe","rank":5,"pid":null},{"id":null,"fullName":"Julia Johnston","name":"Julia","surname":"Johnston","rank":6,"pid":null}],"openAccessColor":"gold","publiclyFunded":false,"eoscIfGuidelines":null,"type":"publication","language":{"code":"und","label":"Undetermined"},"countries":null,"subjects":[{"subject":{"scheme":"keyword","value":"Cosmology and Nongalactic Astrophysics (astro-ph.CO)"},"provenance":null},{"subject":{"scheme":"keyword","value":"Physics Education (physics.ed-ph)"},"provenance":null},{"subject":{"scheme":"keyword","value":"Astrophysics of Galaxies (astro-ph.GA)"},"provenance":null},{"subject":{"scheme":"FOS","value":"0103 physical sciences"},"provenance":null},{"subject":{"scheme":"keyword","value":"Physics - Physics Education"},"provenance":null},{"subject":{"scheme":"keyword","value":"FOS: Physical sciences"},"provenance":null},{"subject":{"scheme":"FOS","value":"01 natural sciences"},"provenance":null},{"subject":{"scheme":"keyword","value":"Astrophysics - Astrophysics of Galaxies"},"provenance":null},{"subject":{"scheme":"keyword","value":"Astrophysics - Cosmology and Nongalactic Astrophysics"},"provenance":null}],"mainTitle":"The Data Behind Dark Matter: Exploring Galactic Rotation","subTitle":null,"descriptions":["Dark matter is estimated to make up ~84% of all normal/baryonic matter, but cannot be directly imaged. Despite the fact that dark matter cannot be directly observed yet, its influence on the motion of stars and gas in spiral galaxies have been detected. One way to show motion in galaxies are rotation curves that are plots of velocity measurements of how fast stars and gas move in a galaxy around the center of mass. According to Newton's Law of Gravitation, the rotational velocity is an indication of the amount of visible and non-visible mass in the galaxy. Given that the visible matter is measurable using photometry, dark matter mass can therefore be estimated, offering an insight into the size distribution in galaxies. In order to gain a greater appreciation of the research scientists' findings about dark matter, their method should be easily reproduced by any curious individual. Our interactive workshop is an excellent educational tool to investigate how dark matter impacts the rotation of visible matter by providing a guide to produce galactic rotation curves. The Python-based notebooks are set up to walk you through the whole process of producing rotation curves using an online database (SPARC) and to allow you to learn about each component of the galaxy. The three steps of the rotation curve building process is plotting the measured velocity data, constructing the rotation curves for each component, and fitting the total velocity to the measured values.","6 pages, 1 table"],"publicationDate":"2023-08-08","publisher":"The Open Journal","embargoEndDate":"2022-07-01","sources":["Crossref"],"formats":null,"contributors":null,"coverages":null,"bestAccessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/"},"container":{"name":"Journal of Open Source Education","issnPrinted":null,"issnOnline":"2577-3569","issnLinking":null,"ep":null,"iss":null,"sp":"184","vol":"6","edition":null,"conferencePlace":null,"conferenceDate":null},"documentationUrls":null,"codeRepositoryUrl":null,"programmingLanguage":null,"contactPeople":null,"contactGroups":null,"tools":null,"size":null,"version":null,"geoLocations":null,"id":"doi_dedup___::60a946ca87fe7b8d9d42696f91e2b0a8","originalIds":["10.21105/jose.00184","50|doiboost____|60a946ca87fe7b8d9d42696f91e2b0a8","50|datacite____::5867b2597ec57a102dfc2e6b92fa05ed","10.48550/arxiv.2207.11235","oai:arXiv.org:2207.11235","50|od________18::1db73c38aae5d3431ee9e56f6ebe5cad"],"pids":[{"scheme":"doi","value":"10.21105/jose.00184"},{"scheme":"doi","value":"10.48550/arxiv.2207.11235"},{"scheme":"arXiv","value":"2207.11235"}],"dateOfCollection":null,"lastUpdateTimeStamp":null,"indicators":{"citationImpact":{"citationCount":0.0,"influence":2.1746283E-9,"popularity":1.6835128E-9,"impulse":0.0,"citationClass":"C5","influenceClass":"C5","impulseClass":"C5","popularityClass":"C5"}},"projects":null,"organizations":[{"legalName":"University of Colorado Denver","acronym":"UCD","id":"openorgs____::f7df5377da3b5ac037baffd76351093d","pids":[{"scheme":"FundRef","value":"100010346"},{"scheme":"OrgRef","value":"30857385"},{"scheme":"wikidata","value":"Q1468161"},{"scheme":"ISNI","value":"0000000107903411"},{"scheme":"GRID","value":"grid.241116.1"},{"scheme":"Wikidata","value":"Q1468161"},{"scheme":"mag_id","value":"921990950"},{"scheme":"fundref","value":"100010346"},{"scheme":"ROR","value":"https://ror.org/02hh7en24"}],"countries":[{"code":"US","label":"United States"}],"websiteurl":"http://www.ucdenver.edu/pages/ucdwelcomepage.aspx"},{"legalName":"University of Colorado Boulder","acronym":"UCB","id":"openorgs____::3a46b6127ec8088efe2b9f3765eb8b2a","pids":[{"scheme":"FundRef","value":"100006473"},{"scheme":"fundref","value":"100005573"},{"scheme":"fundref","value":"100013186"},{"scheme":"mag_id","value":"188538660"},{"scheme":"ISNI","value":"0000000096214564"},{"scheme":"FundRef","value":"100013186"},{"scheme":"wikidata","value":"Q736674"},{"scheme":"FundRef","value":"100007494"},{"scheme":"RRID","value":"RRID:nlx_10266"},{"scheme":"FundRef","value":"100007493"},{"scheme":"Wikidata","value":"Q736674"},{"scheme":"FundRef","value":"100005573"},{"scheme":"fundref","value":"100007493"},{"scheme":"ROR","value":"https://ror.org/02ttsq026"},{"scheme":"fundref","value":"100006015"},{"scheme":"FundRef","value":"100008618"},{"scheme":"RRID","value":"RRID:SCR_003114"},{"scheme":"FundRef","value":"100006015"},{"scheme":"OrgRef","value":"289672"},{"scheme":"GRID","value":"grid.266190.a"},{"scheme":"fundref","value":"100007494"},{"scheme":"OrgRef","value":"8023387"},{"scheme":"fundref","value":"100008618"},{"scheme":"fundref","value":"100006473"}],"countries":[{"code":"US","label":"United States"}],"websiteurl":"http://www.colorado.edu/"}],"communities":null,"collectedFrom":[{"key":"openaire____::9e3be59865b2c1c335d32dae2fe7b254","value":"Datacite"},{"key":"openaire____::081b82f96300b6a6e3d282bad31cb6e2","value":"Crossref"},{"key":"opendoar____::6f4922f45568161a8cdf4ad2299f6d23","value":"arXiv.org e-Print Archive"}],"instances":[{"pids":[{"scheme":"doi","value":"10.21105/jose.00184"}],"license":"CC BY","accessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/","openAccessRoute":"gold"},"type":"Article","urls":["https://doi.org/10.21105/jose.00184"],"publicationDate":"2023-08-08","refereed":"peerReviewed","hostedBy":{"key":"issn__online::2719f783f895868544c83b5641af302d","value":"Journal of Open Source Education"},"collectedFrom":{"key":"openaire____::081b82f96300b6a6e3d282bad31cb6e2","value":"Crossref"}},{"pids":[{"scheme":"doi","value":"10.48550/arxiv.2207.11235"}],"license":"CC BY","type":"Article","urls":["https://dx.doi.org/10.48550/arxiv.2207.11235"],"publicationDate":"2022-01-01","refereed":"nonPeerReviewed","hostedBy":{"key":"openaire____::55045bd2a65019fd8e6741a755395c8c","value":"Unknown Repository"},"collectedFrom":{"key":"openaire____::9e3be59865b2c1c335d32dae2fe7b254","value":"Datacite"}},{"pids":[{"scheme":"arXiv","value":"2207.11235"}],"alternateIdentifiers":[{"scheme":"doi","value":"10.21105/jose.00184"}],"accessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/","openAccessRoute":null},"type":"Preprint","urls":["http://arxiv.org/abs/2207.11235"],"publicationDate":"2022-06-17","refereed":"nonPeerReviewed","hostedBy":{"key":"opendoar____::6f4922f45568161a8cdf4ad2299f6d23","value":"arXiv.org e-Print Archive"},"collectedFrom":{"key":"opendoar____::6f4922f45568161a8cdf4ad2299f6d23","value":"arXiv.org e-Print Archive"}}],"links":[],"otherTitles":null,"green":true,"inDiamondJournal":false,"isGreen":true,"isInDiamondJournal":false},{"authors":[{"id":"orcid_______::18260ded6f208ff9a8ed126aae21a767","fullName":"Miroslava Vukcevic","name":"Miroslava","surname":"Vukcevic","rank":1,"pid":{"id":{"scheme":"orcid","value":"0000-0002-6666-9327"},"provenance":null}},{"id":null,"fullName":"Djordje Savic","name":"Djordje","surname":"Savic","rank":2,"pid":null},{"id":"orcid_______::048d0bfa3d01755a6883146dbfb33461","fullName":"Predrag Jovanović","name":"Predrag","surname":"Jovanović","rank":3,"pid":{"id":{"scheme":"orcid","value":"0000-0003-4259-0101"},"provenance":null}}],"openAccessColor":"gold","publiclyFunded":false,"eoscIfGuidelines":null,"type":"publication","language":{"code":"eng","label":"English"},"countries":null,"subjects":[{"subject":{"scheme":"FOS","value":"0103 physical sciences"},"provenance":null},{"subject":{"scheme":"keyword","value":"Elementary particle physics"},"provenance":null},{"subject":{"scheme":"keyword","value":"nonlinear waves"},"provenance":null},{"subject":{"scheme":"keyword","value":"QC793-793.5"},"provenance":null},{"subject":{"scheme":"FOS","value":"01 natural sciences"},"provenance":null},{"subject":{"scheme":"keyword","value":"galaxy dynamics"},"provenance":null},{"subject":{"scheme":"keyword","value":"gravity"},"provenance":null}],"mainTitle":"Probing the Nonlinear Density Wave Theory of Spiral Galaxies by Baryonic Tully–Fisher Relation","subTitle":null,"descriptions":["<jats:p>The baryonic mass–velocity relation provides an important test of different galaxy dynamics models such as Lambda–cold dark matter (ΛCDM) and alternatives like Modified Newtonian Dynamics (MOND). Novel nonlinear density wave theory with a soliton solution gives an opportunity to test whether the derived rotational velocity expression is able to support the well known Tully–Fisher empirical relation between mass and rotation velocity in disk galaxies. Initial assumptions do not involve any larger dark matter halo that supports the stability of the very thin galactic disk nor any modified gravitational acceleration acting on galactic scales. It rather follows an important gravitational interaction between constituents of disk mass in the outer part of the disk via gravitational potential. Data are obtained by a fitting procedure applied on the sample of 81 rotational curves of late type spirals using expressions for the rotational velocity derived as an exact, a self-consistent solution of the nonlinear Schrodinger (NLS) equation for galactic surface mass density. The location of these selected objects in the baryonic mass–rotation velocity plane follows the relation logMb=3.7±0.2logVflat+2.7±0.4 in marginal agreement with the findings in the literature.</jats:p>"],"publicationDate":"2024-09-06","publisher":"MDPI AG","embargoEndDate":null,"sources":["Crossref","Universe, Vol 10, Iss 9, p 359 (2024)","Universe","Volume 10","Issue 9","Pages: 359"],"formats":["application/pdf"],"contributors":null,"coverages":null,"bestAccessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/"},"container":{"name":"Universe","issnPrinted":null,"issnOnline":"2218-1997","issnLinking":null,"ep":null,"iss":null,"sp":"359","vol":"10","edition":null,"conferencePlace":null,"conferenceDate":null},"documentationUrls":null,"codeRepositoryUrl":null,"programmingLanguage":null,"contactPeople":null,"contactGroups":null,"tools":null,"size":null,"version":null,"geoLocations":null,"id":"doi_dedup___::579bfc22c1f495a724a39ec0cdb77c57","originalIds":["universe10090359","10.3390/universe10090359","50|doiboost____|579bfc22c1f495a724a39ec0cdb77c57","oai:doaj.org/article:a1b7c0564ed74feab735bc4aa35b86e4","50|doajarticles::ae98af9cb40eb83b39b44fce52fcf5d9","oai:mdpi.com:/2218-1997/10/9/359/","50|multidiscipl::8bf6268b45b2e8a5e90fa5f2ac416ba9"],"pids":[{"scheme":"doi","value":"10.3390/universe10090359"}],"dateOfCollection":null,"lastUpdateTimeStamp":null,"indicators":{"citationImpact":{"citationCount":1.0,"influence":2.1951436E-9,"popularity":2.5804614E-9,"impulse":1.0,"citationClass":"C5","influenceClass":"C5","impulseClass":"C5","popularityClass":"C5"}},"projects":[{"id":"mestd_______::7db88cdd3c295d227680b119a479ddfb","code":"200002","acronym":null,"title":"Ministry of Education, Science and Technological Development, Republic of Serbia, Grant no. 451-03-68/2020-14/200002 (Astronomical Opservatory, Belgrade)","funder":"Ministry of Education, Science and Technological Development of Republic of Serbia","pids":null}],"organizations":null,"communities":null,"collectedFrom":[{"key":"openaire____::c2cdfa5866e03cdd07d313cbc8fb8311","value":"Multidisciplinary Digital Publishing Institute"},{"key":"driver______::bee53aa31dc2cbb538c10c2b65fa5824","value":"DOAJ"},{"key":"openaire____::081b82f96300b6a6e3d282bad31cb6e2","value":"Crossref"}],"instances":[{"pids":[{"scheme":"doi","value":"10.3390/universe10090359"}],"license":"CC BY","accessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/","openAccessRoute":"gold"},"type":"Article","urls":["https://doi.org/10.3390/universe10090359"],"publicationDate":"2024-09-06","refereed":"peerReviewed","hostedBy":{"key":"doajarticles::5aaa510983de110757b762606c02fe2e","value":"Universe"},"collectedFrom":{"key":"openaire____::081b82f96300b6a6e3d282bad31cb6e2","value":"Crossref"}},{"alternateIdentifiers":[{"scheme":"doi","value":"10.3390/universe10090359"}],"accessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/","openAccessRoute":"gold"},"type":"Article","urls":["https://doaj.org/article/a1b7c0564ed74feab735bc4aa35b86e4"],"publicationDate":"2024-09-01","refereed":"nonPeerReviewed","hostedBy":{"key":"doajarticles::5aaa510983de110757b762606c02fe2e","value":"Universe"},"collectedFrom":{"key":"driver______::bee53aa31dc2cbb538c10c2b65fa5824","value":"DOAJ"}},{"alternateIdentifiers":[{"scheme":"doi","value":"10.3390/universe10090359"}],"license":"CC BY","accessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/","openAccessRoute":"gold"},"type":"Article","urls":["https://dx.doi.org/10.3390/universe10090359"],"publicationDate":"2024-09-06","refereed":"peerReviewed","hostedBy":{"key":"doajarticles::5aaa510983de110757b762606c02fe2e","value":"Universe"},"collectedFrom":{"key":"openaire____::c2cdfa5866e03cdd07d313cbc8fb8311","value":"Multidisciplinary Digital Publishing Institute"}}],"links":[{"header":{"relationType":"resultProject","relationClass":"isProducedBy","relatedIdentifier":"mestd_______::7db88cdd3c295d227680b119a479ddfb","relatedRecordType":"project","relationProvenance":"iis","trust":"0.7348"},"collectedfrom":[{"dsId":"openaire____::5980ad22b841973d0cd0ba2bb4820c74","dsName":"Ministarstvo Prosvete, Nauke i Tehnološkog Razvoja"}],"projectTitle":"Ministry of Education, Science and Technological Development, Republic of Serbia, Grant no. 451-03-68/2020-14/200002 (Astronomical Opservatory, Belgrade)","code":"200002","funding":{"funder":{"id":"mestd_______::MESTD","shortname":"MESTD","name":"Ministry of Education, Science and Technological Development of Republic of Serbia","jurisdiction":{"code":"RS","label":"Serbia"},"pid":null},"level0":{"id":"mestd_______::MESTD::inst-2020","description":"inst-2020","name":"inst-2020"},"level1":{"id":null,"description":null,"name":null},"level2":{"id":null,"description":null,"name":null}},"startDate":"2020-01-01","endDate":"2024-12-31"}],"otherTitles":null,"green":false,"inDiamondJournal":false,"isGreen":false,"isInDiamondJournal":false},{"authors":[{"id":null,"fullName":"Mithun Ghosh","name":"Mithun","surname":"Ghosh","rank":1,"pid":null}],"openAccessColor":null,"publiclyFunded":false,"eoscIfGuidelines":null,"type":"publication","language":{"code":"eng","label":"English"},"countries":null,"subjects":[{"subject":{"scheme":"FOS","value":"0103 physical sciences"},"provenance":null},{"subject":{"scheme":"FOS","value":"01 natural sciences"},"provenance":null}],"mainTitle":"Charged perfect fluid dark matter model: Known mass density function approach","subTitle":null,"descriptions":["<jats:p> The concept of dark matter has been imported to explain the observed velocity profile of the spiral galaxies, the flat rotational velocity. Taking the flatness of rotation curves as an input and assuming that the galactic halo is filled with charged perfect fluid having known mass density function, we obtain a space time metric in the galactic halo region. The acquired solution indicates to a (nearly) flat universe, consistent with the present day cosmological observations. Various other aspects of the solution such as attractive gravity in the halo region, stability of the circular orbit, etc., are also analyzed. </jats:p>"],"publicationDate":"2021-02-18","publisher":"World Scientific Pub Co Pte Lt","embargoEndDate":null,"sources":["Crossref"],"formats":null,"contributors":null,"coverages":null,"bestAccessRight":null,"container":{"name":"Modern Physics Letters A","issnPrinted":"0217-7323","issnOnline":"1793-6632","issnLinking":null,"ep":null,"iss":null,"sp":"2150043","vol":"36","edition":null,"conferencePlace":null,"conferenceDate":null},"documentationUrls":null,"codeRepositoryUrl":null,"programmingLanguage":null,"contactPeople":null,"contactGroups":null,"tools":null,"size":null,"version":null,"geoLocations":null,"id":"doi_dedup___::2e4fb883846801dc5898fe473f82d942","originalIds":["10.1142/S0217732321500437","10.1142/s0217732321500437","50|doiboost____|2e4fb883846801dc5898fe473f82d942","3133267919"],"pids":[{"scheme":"doi","value":"10.1142/s0217732321500437"}],"dateOfCollection":null,"lastUpdateTimeStamp":null,"indicators":{"citationImpact":{"citationCount":8.0,"influence":2.3535962E-9,"popularity":6.4912546E-9,"impulse":6.0,"citationClass":"C5","influenceClass":"C5","impulseClass":"C4","popularityClass":"C4"}},"projects":null,"organizations":null,"communities":null,"collectedFrom":[{"key":"openaire____::081b82f96300b6a6e3d282bad31cb6e2","value":"Crossref"},{"key":"openaire____::5f532a3fc4f1ea403f37070f59a7a53a","value":"Microsoft Academic Graph"}],"instances":[{"pids":[{"scheme":"doi","value":"10.1142/s0217732321500437"}],"type":"Article","urls":["https://doi.org/10.1142/s0217732321500437"],"publicationDate":"2021-02-18","refereed":"peerReviewed","hostedBy":{"key":"issn___print::3c531385750c13e90e94718703a098b1","value":"Modern Physics Letters A"},"collectedFrom":{"key":"openaire____::081b82f96300b6a6e3d282bad31cb6e2","value":"Crossref"}},{"alternateIdentifiers":[{"scheme":"doi","value":"10.1142/s0217732321500437"},{"scheme":"mag_id","value":"3133267919"}],"type":"Article","urls":["https://dx.doi.org/10.1142/s0217732321500437"],"refereed":"nonPeerReviewed","hostedBy":{"key":"openaire____::55045bd2a65019fd8e6741a755395c8c","value":"Unknown Repository"},"collectedFrom":{"key":"openaire____::5f532a3fc4f1ea403f37070f59a7a53a","value":"Microsoft Academic Graph"}},{"alternateIdentifiers":[{"scheme":"mag_id","value":"3133267919"},{"scheme":"doi","value":"10.1142/s0217732321500437"}],"type":"Article","urls":["https://dx.doi.org/10.1142/s0217732321500437"],"refereed":"nonPeerReviewed","hostedBy":{"key":"openaire____::55045bd2a65019fd8e6741a755395c8c","value":"Unknown Repository"},"collectedFrom":{"key":"openaire____::5f532a3fc4f1ea403f37070f59a7a53a","value":"Microsoft Academic Graph"}}],"links":[],"otherTitles":null,"green":false,"inDiamondJournal":false,"isGreen":false,"isInDiamondJournal":false},{"authors":[{"id":"orcid_______::621867a53410325ac9b5d0851bae0705","fullName":"Nitya Ravi","name":"Nitya","surname":"Ravi","rank":1,"pid":{"id":{"scheme":"orcid","value":"0000-0002-4248-2840"},"provenance":null}},{"id":null,"fullName":"Kelly A. Douglass","name":"Kelly A.","surname":"Douglass","rank":2,"pid":{"id":{"scheme":"orcid_pending","value":"0000-0002-9540-546x"},"provenance":null}},{"id":null,"fullName":"Regina Demina","name":"Regina","surname":"Demina","rank":3,"pid":{"id":{"scheme":"orcid_pending","value":"0000-0002-7852-167x"},"provenance":null}}],"openAccessColor":"gold","publiclyFunded":false,"eoscIfGuidelines":null,"type":"publication","language":{"code":"und","label":"Undetermined"},"countries":null,"subjects":[{"subject":{"scheme":"keyword","value":"Cosmology and Nongalactic Astrophysics (astro-ph.CO)"},"provenance":null},{"subject":{"scheme":"keyword","value":"Astrophysics of Galaxies"},"provenance":null},{"subject":{"scheme":"keyword","value":"Astrophysics of Galaxies (astro-ph.GA)"},"provenance":null},{"subject":{"scheme":"FOS","value":"0103 physical sciences"},"provenance":null},{"subject":{"scheme":"keyword","value":"FOS: Physical sciences"},"provenance":null},{"subject":{"scheme":"keyword","value":"Cosmology and Nongalactic Astrophysics"},"provenance":null},{"subject":{"scheme":"FOS","value":"01 natural sciences"},"provenance":null}],"mainTitle":"The Extended Baryonic Tully–Fisher Relation for SDSS MaNGA Galaxies","subTitle":null,"descriptions":["<jats:title>Abstract</jats:title>                   <jats:p>                     The baryonic Tully–Fisher relation (BTFR), a relationship between the rotational velocity and baryonic mass in spiral galaxies, probes the relative content of baryonic and total mass in galaxies and thus provides a good test of dark matter content in galaxies. Using H                     <jats:italic>α</jats:italic>                     kinematics, we model the rotation curves of the Sloan Digital Sky Survey MaNGA DR17 spiral galaxies. To extend the BTFR to higher masses with elliptical galaxies, we estimate their total masses from their stellar velocity dispersions using the virial theorem and define the effective rotational velocity as the velocity a rotation-supported galaxy would exhibit given this mass. The baryonic mass of spiral galaxies is composed of stellar, H                     <jats:sc>i</jats:sc>                     , H                     <jats:sub>2</jats:sub>                     , and He mass, while only the stellar mass is used for the baryonic content of ellipticals. We construct joint BTFRs for 5743 MaNGA spiral and elliptical galaxies, TNG100 simulated galaxies with baryonic masses greater than 10                     <jats:sup>9</jats:sup>                     <jats:italic>M</jats:italic>                     <jats:sub>⊙</jats:sub>                     , and a cross-matched subsample between these two datasets (3149 spiral and 1423 elliptical galaxies). For the cross-matched subsample, we find agreement in the slopes between observed and simulated galaxies. We find a slope of                     <jats:inline-formula>                       <jats:tex-math>                                                </jats:tex-math>                       <mml:math xmlns:mml=\"http://www.w3.org/1998/Math/MathML\" overflow=\"scroll\">                         <mml:mn>3.8</mml:mn>                         <mml:msubsup>                           <mml:mrow>                             <mml:mn>6</mml:mn>                           </mml:mrow>                           <mml:mrow>                             <mml:mo>−</mml:mo>                             <mml:mn>0.62</mml:mn>                           </mml:mrow>                           <mml:mrow>                             <mml:mo>+</mml:mo>                             <mml:mn>0.92</mml:mn>                           </mml:mrow>                         </mml:msubsup>                       </mml:math>                     </jats:inline-formula>                     for the full MaNGA sample, which agrees well with the slope of 4.0 predicted by MOND and the fitted slope of                     <jats:inline-formula>                       <jats:tex-math>                                                </jats:tex-math>                       <mml:math xmlns:mml=\"http://www.w3.org/1998/Math/MathML\" overflow=\"scroll\">                         <mml:mn>3.5</mml:mn>                         <mml:msubsup>                           <mml:mrow>                             <mml:mn>8</mml:mn>                           </mml:mrow>                           <mml:mrow>                             <mml:mo>−</mml:mo>                             <mml:mn>0.38</mml:mn>                           </mml:mrow>                           <mml:mrow>                             <mml:mo>+</mml:mo>                             <mml:mn>0.48</mml:mn>                           </mml:mrow>                         </mml:msubsup>                       </mml:math>                     </jats:inline-formula>                     for the TNG100 galaxies. We find that a sample of lower-mass galaxies is necessary to differentiate between the two models.                   </jats:p>"],"publicationDate":"2026-05-22","publisher":"American Astronomical Society","embargoEndDate":"2025-12-01","sources":["Crossref"],"formats":null,"contributors":null,"coverages":null,"bestAccessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/"},"container":{"name":"The Astrophysical Journal","issnPrinted":"0004-637X","issnOnline":"1538-4357","issnLinking":null,"ep":null,"iss":null,"sp":"167","vol":"1003","edition":null,"conferencePlace":null,"conferenceDate":null},"documentationUrls":null,"codeRepositoryUrl":null,"programmingLanguage":null,"contactPeople":null,"contactGroups":null,"tools":null,"size":null,"version":null,"geoLocations":null,"id":"doi_dedup___::88ef0957be7daa9910bea2ff3396a58b","originalIds":["10.3847/1538-4357/ae61a6","50|doiboost____|8638b0c467264c826f74ff192e71c9f1","50|datacite____::88ef0957be7daa9910bea2ff3396a58b","10.48550/arxiv.2512.18577","oai:arXiv.org:2512.18577","50|od________18::db2feb5446bcfafd92033451b3094865"],"pids":[{"scheme":"doi","value":"10.3847/1538-4357/ae61a6"},{"scheme":"doi","value":"10.48550/arxiv.2512.18577"},{"scheme":"arXiv","value":"2512.18577"}],"dateOfCollection":null,"lastUpdateTimeStamp":null,"indicators":{"citationImpact":{"citationCount":0.0,"influence":2.1746283E-9,"popularity":2.6085654E-9,"impulse":0.0,"citationClass":"C5","influenceClass":"C5","impulseClass":"C5","popularityClass":"C5"}},"projects":null,"organizations":[{"legalName":"University of Rochester","acronym":"UR","id":"openorgs____::07cf0f86af976ed535d846745e4cbf7f","pids":[{"scheme":"GRID","value":"grid.419853.2"},{"scheme":"wikidata","value":"Q149990"},{"scheme":"Wikidata","value":"Q6983313"},{"scheme":"PIC","value":"999867562"},{"scheme":"fundref","value":"100008091"},{"scheme":"mag_id","value":"5388228"},{"scheme":"ROR","value":"https://ror.org/0224bx186"},{"scheme":"ROR","value":"https://ror.org/022kthw22"},{"scheme":"ISNI","value":"0000000404814933"},{"scheme":"ISNI","value":"0000000419369174"},{"scheme":"FundRef","value":"100008243"},{"scheme":"mag_id","value":"25093896"},{"scheme":"fundref","value":"100011125"},{"scheme":"FundRef","value":"100008091"},{"scheme":"GRID","value":"grid.430277.5"},{"scheme":"OrgRef","value":"31918"},{"scheme":"FundRef","value":"100005836"},{"scheme":"GRID","value":"grid.16416.34"},{"scheme":"wikidata","value":"Q6983313"},{"scheme":"FundRef","value":"100011125"},{"scheme":"OrgRef","value":"4952057"},{"scheme":"Wikidata","value":"Q149990"},{"scheme":"fundref","value":"100005836"},{"scheme":"mag_id","value":"2802375135"},{"scheme":"OrgRef","value":"672136"},{"scheme":"fundref","value":"100008243"}],"countries":[{"code":"US","label":"United States"}],"websiteurl":"https://www.rochester.edu/"}],"communities":null,"collectedFrom":[{"key":"openaire____::9e3be59865b2c1c335d32dae2fe7b254","value":"Datacite"},{"key":"openaire____::081b82f96300b6a6e3d282bad31cb6e2","value":"Crossref"},{"key":"opendoar____::6f4922f45568161a8cdf4ad2299f6d23","value":"arXiv.org e-Print Archive"}],"instances":[{"pids":[{"scheme":"doi","value":"10.3847/1538-4357/ae61a6"}],"license":"CC BY","accessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/","openAccessRoute":"gold"},"type":"Article","urls":["https://doi.org/10.3847/1538-4357/ae61a6"],"publicationDate":"2026-05-22","refereed":"peerReviewed","hostedBy":{"key":"doajarticles::f5c883d7dea7cfa40d9bf7581df67fde","value":"The Astrophysical Journal"},"collectedFrom":{"key":"openaire____::081b82f96300b6a6e3d282bad31cb6e2","value":"Crossref"}},{"pids":[{"scheme":"doi","value":"10.48550/arxiv.2512.18577"}],"license":"CC BY","type":"Article","urls":["https://dx.doi.org/10.48550/arxiv.2512.18577"],"publicationDate":"2025-01-01","refereed":"nonPeerReviewed","hostedBy":{"key":"openaire____::55045bd2a65019fd8e6741a755395c8c","value":"Unknown Repository"},"collectedFrom":{"key":"openaire____::9e3be59865b2c1c335d32dae2fe7b254","value":"Datacite"}},{"pids":[{"scheme":"arXiv","value":"2512.18577"}],"accessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/","openAccessRoute":null},"type":"Preprint","urls":["http://arxiv.org/abs/2512.18577"],"publicationDate":"2025-12-21","refereed":"nonPeerReviewed","hostedBy":{"key":"opendoar____::6f4922f45568161a8cdf4ad2299f6d23","value":"arXiv.org e-Print Archive"},"collectedFrom":{"key":"opendoar____::6f4922f45568161a8cdf4ad2299f6d23","value":"arXiv.org e-Print Archive"}}],"links":[],"otherTitles":null,"green":true,"inDiamondJournal":false,"isGreen":true,"isInDiamondJournal":false},{"authors":[{"id":null,"fullName":"Rippel, Jair Rippel Junior","name":"Jair Rippel Junior","surname":"Rippel","rank":1,"pid":null}],"openAccessColor":null,"publiclyFunded":false,"eoscIfGuidelines":null,"type":"publication","language":{"code":"por","label":"Portuguese"},"countries":null,"subjects":[{"subject":{"scheme":"FOS","value":"0103 physical sciences"},"provenance":null},{"subject":{"scheme":"FOS","value":"01 natural sciences"},"provenance":null},{"subject":{"scheme":"keyword","value":"rotation curves, geometric projection, blueshift illusion, stationary cosmology, no dark matter, precession drift, sinusoidal projection, galactic dynamics, alternative to dark matter, multi-epoch spectroscopy"},"provenance":null}],"mainTitle":"Geometric Projection as the Origin of Apparent Galactic Acceleration: A Stationary Interpretation of Rotation Curves Without Dark Matter","subTitle":null,"descriptions":["Observed flat rotation curves in spiral galaxies are traditionally interpreted as evidence  for massive dark matter halos or modified dynamics. In this work, we propose an alternative explanation: the apparent constancy of rotational velocity arises from a geometric  projection effect involving long-timescale angular variation in the line-of-sight component of  local velocity fields. We show that if an emitting region undergoes slow precession or angular drift, the observed velocity vobs(t) = v0 sin(θ + ϕ(t)) produces a time-averaged radial  component that is effectively constant across galactic radii. The mechanism naturally yields  velocity plateaus of 150–250 km/s without non-baryonic dark matter. We derive the formalism, quantify the geometric averaging, and identify observational tests using multi-epoch  spectroscopy and VLBI astrometry. The model is compatible with a stationary cosmological  background and complements the energy-injection framework developed in Article I."],"publicationDate":"2025-11-17","publisher":"Zenodo","embargoEndDate":null,"sources":null,"formats":null,"contributors":null,"coverages":null,"bestAccessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/"},"container":null,"documentationUrls":null,"codeRepositoryUrl":null,"programmingLanguage":null,"contactPeople":null,"contactGroups":null,"tools":null,"size":null,"version":null,"geoLocations":null,"id":"doi_dedup___::1095f48348424b2d4dbb376059205899","originalIds":["50|datacite____::1095f48348424b2d4dbb376059205899","10.5281/zenodo.17635015","50|od______2659::1095f48348424b2d4dbb376059205899","oai:zenodo.org:17635015","50|datacite____::dbc2f33be750270a3fc30241ce650aa2","10.5281/zenodo.17635014"],"pids":[{"scheme":"doi","value":"10.5281/zenodo.17635015"},{"scheme":"doi","value":"10.5281/zenodo.17635014"}],"dateOfCollection":null,"lastUpdateTimeStamp":null,"indicators":{"citationImpact":{"citationCount":0.0,"influence":2.1746283E-9,"popularity":2.2497804E-9,"impulse":0.0,"citationClass":"C5","influenceClass":"C5","impulseClass":"C5","popularityClass":"C5"}},"projects":null,"organizations":null,"communities":[{"code":"eosc","label":"EOSC","provenance":null}],"collectedFrom":[{"key":"openaire____::9e3be59865b2c1c335d32dae2fe7b254","value":"Datacite"},{"key":"opendoar____::358aee4cc897452c00244351e4d91f69","value":"ZENODO"}],"instances":[{"pids":[{"scheme":"doi","value":"10.5281/zenodo.17635015"}],"license":"CC BY","type":"Other literature type","urls":["https://dx.doi.org/10.5281/zenodo.17635015"],"publicationDate":"2025-11-17","refereed":"nonPeerReviewed","hostedBy":{"key":"opendoar____::358aee4cc897452c00244351e4d91f69","value":"ZENODO"},"collectedFrom":{"key":"openaire____::9e3be59865b2c1c335d32dae2fe7b254","value":"Datacite"}},{"pids":[{"scheme":"doi","value":"10.5281/zenodo.17635015"}],"alternateIdentifiers":[{"scheme":"oai","value":"oai:zenodo.org:17635015"}],"license":"CC BY","accessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/","openAccessRoute":null},"type":"Other literature type","urls":["https://zenodo.org/records/17635015","http://dx.doi.org/10.5281/zenodo.17635015"],"publicationDate":"2025-11-17","refereed":"nonPeerReviewed","hostedBy":{"key":"opendoar____::358aee4cc897452c00244351e4d91f69","value":"ZENODO"},"collectedFrom":{"key":"opendoar____::358aee4cc897452c00244351e4d91f69","value":"ZENODO"}},{"pids":[{"scheme":"doi","value":"10.5281/zenodo.17635014"}],"license":"CC BY","type":"Other literature type","urls":["https://dx.doi.org/10.5281/zenodo.17635014"],"publicationDate":"2025-11-17","refereed":"nonPeerReviewed","hostedBy":{"key":"opendoar____::358aee4cc897452c00244351e4d91f69","value":"ZENODO"},"collectedFrom":{"key":"openaire____::9e3be59865b2c1c335d32dae2fe7b254","value":"Datacite"}}],"links":[],"otherTitles":null,"green":true,"inDiamondJournal":false,"isGreen":true,"isInDiamondJournal":false},{"authors":[{"id":"orcid_______::7856a17ec11cdca65b526e0124909f1e","fullName":"Azeez, Jazeel H.","name":"Jazeel H.","surname":"Azeez","rank":1,"pid":{"id":{"scheme":"orcid","value":"0000-0002-4066-6443"},"provenance":null}},{"id":"orcid_______::bd9da4e74331b2474e80fdd8fea025a9","fullName":"Fadhil, Sadeem Abbas","name":"Sadeem Abbas","surname":"Fadhil","rank":2,"pid":{"id":{"scheme":"orcid","value":"0000-0003-4796-2031"},"provenance":null}},{"id":null,"fullName":"Zamri Zainal Abidin","name":null,"surname":null,"rank":3,"pid":null}],"openAccessColor":"gold","publiclyFunded":false,"eoscIfGuidelines":null,"type":"publication","language":{"code":"und","label":"Undetermined"},"countries":[{"code":"MY","label":"Malaysia","provenance":null}],"subjects":[{"subject":{"scheme":"FOS","value":"0502 economics and business"},"provenance":null},{"subject":{"scheme":"FOS","value":"05 social sciences"},"provenance":null},{"subject":{"scheme":"keyword","value":"500"},"provenance":null},{"subject":{"scheme":"keyword","value":"530"},"provenance":null}],"mainTitle":"Derivation of A Rotation Curve Model Based on Time of Events Theory and Its Application on Samples of Several Spiral Galaxies","subTitle":null,"descriptions":["<jats:p>A new model of rotation curves in spiral galaxies is derived and applied to several spiral galaxies. This model is based on a new theory called the ‘time of events’ theory, which was published elsewhere. The theory led to derive a multiscale model that applies to the problem of rotation curves in the galaxies as a non-adiabatic system. The equations of the derived multiscale model will be generalized in the current work to apply to the gases inside the galaxy to reach a general semi-empirical model that relates rotational velocity with the galaxy radius. The derived equation showed an excellent agreement with experimental results for five galaxies. The findings showed that the bulge plays a limited role for the galaxies with large extensions like IC 2574 and NGC 3198, where the dark matter in the halo region controls and determines the shape of the diagram of the rotation curves in these galaxies. Furthermore, in three bared galaxies NGC 1068, NGC 1097, and NGC 6503, the bulge has the most major role in controlling the rotation dynamics in these galaxies. </jats:p>"],"publicationDate":"2024-11-30","publisher":"Penerbit Universiti Kebangsaan Malaysia (UKM Press)","embargoEndDate":null,"sources":["Crossref"],"formats":["application/pdf"],"contributors":null,"coverages":null,"bestAccessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/"},"container":{"name":"Sains Malaysiana","issnPrinted":"0126-6039","issnOnline":"2735-0118","issnLinking":null,"ep":"3778","iss":null,"sp":"3771","vol":"53","edition":null,"conferencePlace":null,"conferenceDate":null},"documentationUrls":null,"codeRepositoryUrl":null,"programmingLanguage":null,"contactPeople":null,"contactGroups":null,"tools":null,"size":null,"version":null,"geoLocations":null,"id":"doi_dedup___::281403c91f76f8f578c4f918a852bd74","originalIds":["10.17576/jsm-2024-5311-19","50|doiboost____|281403c91f76f8f578c4f918a852bd74","50|od______2659::281403c91f76f8f578c4f918a852bd74","oai:zenodo.org:20468035","50|base_oa_____::43e0332eb6ca7a78e6d5e16cd3ef6995","ftukmalaysiajart:oai:generic.eprints.org:24655"],"pids":[{"scheme":"doi","value":"10.17576/jsm-2024-5311-19"}],"dateOfCollection":null,"lastUpdateTimeStamp":null,"indicators":{"citationImpact":{"citationCount":0.0,"influence":2.1746283E-9,"popularity":1.944044E-9,"impulse":0.0,"citationClass":"C5","influenceClass":"C5","impulseClass":"C5","popularityClass":"C5"}},"projects":null,"organizations":[{"legalName":"University of Malaya","acronym":"UM","id":"openorgs____::2cefdfb8a9fdd75b12de896b17166415","pids":[{"scheme":"fundref","value":"501100023431"},{"scheme":"fundref","value":"501100004781"},{"scheme":"mag_id","value":"33849332"},{"scheme":"ROR","value":"https://ror.org/00rzspn62"},{"scheme":"FundRef","value":"501100004781"},{"scheme":"Wikidata","value":"Q1142924"},{"scheme":"FundRef","value":"501100004386"},{"scheme":"wikidata","value":"Q1142924"},{"scheme":"fundref","value":"501100004386"},{"scheme":"PIC","value":"998557674"},{"scheme":"FundRef","value":"501100023431"},{"scheme":"GRID","value":"grid.10347.31"},{"scheme":"ISNI","value":"0000000123085949"},{"scheme":"OrgRef","value":"286853"}],"countries":[{"code":"MY","label":"Malaysia"}],"websiteurl":"https://www.um.edu.my/"},{"legalName":"National University of Malaysia","acronym":"UKM","id":"openorgs____::2979f013074f4c93ddec6c50e851fb1e","pids":[{"scheme":"ISNI","value":"0000000419371557"},{"scheme":"ROR","value":"https://ror.org/00bw8d226"},{"scheme":"fundref","value":"501100004515"},{"scheme":"wikidata","value":"Q1444125"},{"scheme":"FundRef","value":"501100004515"},{"scheme":"fundref","value":"501100011895"},{"scheme":"FundRef","value":"501100011895"},{"scheme":"GRID","value":"grid.412113.4"},{"scheme":"Wikidata","value":"Q1444125"},{"scheme":"OrgRef","value":"736714"},{"scheme":"fundref","value":"501100006550"},{"scheme":"mag_id","value":"885383172"},{"scheme":"mag_id","value":"2801594805"},{"scheme":"GRID","value":"grid.240541.6"},{"scheme":"FundRef","value":"501100006550"}],"countries":[{"code":"MY","label":"Malaysia"}],"websiteurl":"http://www.ukm.my/v6/"},{"legalName":"Nahrain University","acronym":"Nahrain University","id":"openorgs____::d32e03d5e35840c809b56522c6deb2b8","pids":[{"scheme":"wikidata","value":"Q37765"},{"scheme":"FundRef","value":"100019700"},{"scheme":"mag_id","value":"56409017"},{"scheme":"OrgRef","value":"