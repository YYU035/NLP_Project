tes"}],"websiteurl":"http://www.epri.com/Pages/Default.aspx"}],"communities":[{"code":"energy-planning","label":"Energy Planning","provenance":null}],"collectedFrom":[{"key":"openaire____::081b82f96300b6a6e3d282bad31cb6e2","value":"Crossref"},{"key":"openaire____::5f532a3fc4f1ea403f37070f59a7a53a","value":"Microsoft Academic Graph"}],"instances":[{"pids":[{"scheme":"doi","value":"10.1109/tte.2021.3113945"}],"license":"IEEE Copyright","accessRight":{"code":"c_14cb","label":"CLOSED","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/","openAccessRoute":null},"type":"Article","urls":["https://doi.org/10.1109/tte.2021.3113945"],"publicationDate":"2022-03-01","refereed":"peerReviewed","hostedBy":{"key":"openaire____::55045bd2a65019fd8e6741a755395c8c","value":"Unknown Repository"},"collectedFrom":{"key":"openaire____::081b82f96300b6a6e3d282bad31cb6e2","value":"Crossref"}},{"alternateIdentifiers":[{"scheme":"mag_id","value":"3200598543"},{"scheme":"doi","value":"10.1109/tte.2021.3113945"}],"type":"Article","urls":["https://dx.doi.org/10.1109/tte.2021.3113945"],"refereed":"nonPeerReviewed","hostedBy":{"key":"openaire____::55045bd2a65019fd8e6741a755395c8c","value":"Unknown Repository"},"collectedFrom":{"key":"openaire____::5f532a3fc4f1ea403f37070f59a7a53a","value":"Microsoft Academic Graph"}},{"alternateIdentifiers":[{"scheme":"mag_id","value":"3200598543"},{"scheme":"doi","value":"10.1109/tte.2021.3113945"}],"type":"Article","urls":["https://dx.doi.org/10.1109/tte.2021.3113945"],"refereed":"nonPeerReviewed","hostedBy":{"key":"openaire____::55045bd2a65019fd8e6741a755395c8c","value":"Unknown Repository"},"collectedFrom":{"key":"openaire____::5f532a3fc4f1ea403f37070f59a7a53a","value":"Microsoft Academic Graph"}}],"links":[],"otherTitles":null,"inDiamondJournal":false,"green":false,"isGreen":false,"isInDiamondJournal":false},{"authors":[{"id":null,"fullName":"Quy Phuong Chau","name":null,"surname":null,"rank":1,"pid":null},{"id":null,"fullName":"Thanh Liem Pham","name":null,"surname":null,"rank":2,"pid":null},{"id":null,"fullName":"Dinh Quan Nguyen","name":null,"surname":null,"rank":3,"pid":null},{"id":null,"fullName":"My Loan Phung Le","name":null,"surname":null,"rank":4,"pid":null},{"id":null,"fullName":"Van Man Tran","name":null,"surname":null,"rank":5,"pid":null},{"id":"orcid_______::0fa37654acf136036c1424f71aeb8dee","fullName":"Thien Trung Nguyen","name":null,"surname":null,"rank":6,"pid":{"id":{"scheme":"orcid","value":"0000-0003-1936-5125"},"provenance":null}}],"openAccessColor":"gold","publiclyFunded":false,"eoscIfGuidelines":null,"type":"publication","language":{"code":"und","label":"Undetermined"},"countries":null,"subjects":[{"subject":{"scheme":"keyword","value":"High concentration electrolyte, matching up full cell, Sodium-ion batteries"},"provenance":null},{"subject":{"scheme":"keyword","value":"Technology"},"provenance":null},{"subject":{"scheme":"keyword","value":"Science"},"provenance":null},{"subject":{"scheme":"keyword","value":"T"},"provenance":null},{"subject":{"scheme":"keyword","value":"Q"},"provenance":null},{"subject":{"scheme":"FOS","value":"01 natural sciences"},"provenance":null},{"subject":{"scheme":"SDG","value":"7. Clean energy"},"provenance":null},{"subject":{"scheme":"FOS","value":"0104 chemical sciences"},"provenance":null},{"subject":{"scheme":"SDG","value":"3. Good health"},"provenance":null}],"mainTitle":"Compatibility and effect of capacity ratios between Na3V2(PO4)3 and hard carbon in highly concentrated sodium bis (fluorosulfonyl) imide electrolyte","subTitle":null,"descriptions":["<jats:p>From the standpoint of preserving the Earth's resources and ensuring the long-term viability of humanity, it is imperative to transition away from lithium-ion batteries. High-performance and safe sodium-ion batteries have recently emerged as promising advanced batteries for application in stationary energy storage, attributed to their low cost and abundance of sodium ion. We demonstrate the compatibility and effect of the negative-positive capacity ratio in full-cell Na3V2(PO4)3 and hard carbon in high-concentration electrolytes. Thanks to the excellent oxidation stability of the electrolyte, during 100 cycles, the full cell with a negative-positive capacity ratio of 1.1 demonstrated a consistent capacity of around 100 mAh g-1 with a capacity retention of 90.7%, whereas the full cell with a ratio of 1.0 showed a steady discharge capacity of roughly 90 mAh g-1 with a capacity retention of approaching 100% at a current density of C/5.</jats:p>"],"publicationDate":"2024-03-25","publisher":"Can Tho University","embargoEndDate":null,"sources":["Crossref","CTU Journal of Innovation and Sustainable Development, Vol 16, Iss 1 (2024)"],"formats":null,"contributors":null,"coverages":null,"bestAccessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/"},"container":{"name":"CTU Journal of Innovation and Sustainable Development","issnPrinted":"2588-1418","issnOnline":"2815-6412","issnLinking":null,"ep":null,"iss":null,"sp":null,"vol":"16","edition":null,"conferencePlace":null,"conferenceDate":null},"documentationUrls":null,"codeRepositoryUrl":null,"programmingLanguage":null,"contactPeople":null,"contactGroups":null,"tools":null,"size":null,"version":null,"geoLocations":null,"id":"doi_dedup___::a5b62d3efa494ab3548d4f28cf9e2862","originalIds":["10.22144/ctujoisd.2024.271","50|doiboost____|a5b62d3efa494ab3548d4f28cf9e2862","oai:doaj.org/article:bd15f62754b445feab2e14d68f05c8f6","50|doajarticles::7581cd6bee47621904e12dd5895f3f70","oai:doaj.org/article:0b94897d0b234f808c3802033f6e14f9","50|doajarticles::e67ae0ea8940aad208a6b064c58e0f75"],"pids":[{"scheme":"doi","value":"10.22144/ctujoisd.2024.271"}],"dateOfCollection":null,"lastUpdateTimeStamp":null,"indicators":{"citationImpact":{"citationCount":0.0,"influence":2.1746283E-9,"popularity":1.944044E-9,"impulse":0.0,"citationClass":"C5","influenceClass":"C5","impulseClass":"C5","popularityClass":"C5"}},"projects":null,"organizations":[{"legalName":"University of Technology","acronym":"University of Technology","id":"openorgs____::192bfaacda7dbd5e5949f3dc145c629e","pids":[{"scheme":"ISNI","value":"0000000458950316"},{"scheme":"wikidata","value":"Q4233933"},{"scheme":"ROR","value":"https://ror.org/03gbw6p94"},{"scheme":"Wikidata","value":"Q4233933"},{"scheme":"GRID","value":"grid.483960.0"}],"countries":[{"code":"RU","label":"Russian Federation"}],"websiteurl":"http://unitech-mo.ru/eng/"},{"legalName":"University of the Sciences","acronym":"University of the Sciences","id":"openorgs____::9f04bc90809c06141ab1c326a54d539c","pids":[{"scheme":"wikidata","value":"Q3443159"},{"scheme":"ROR","value":"https://ror.org/048gmay44"},{"scheme":"OrgRef","value":"284987"},{"scheme":"Wikidata","value":"Q3443159"},{"scheme":"mag_id","value":"110357561"},{"scheme":"GRID","value":"grid.267627.0"},{"scheme":"ISNI","value":"0000000087947643"},{"scheme":"FundRef","value":"100018549"},{"scheme":"fundref","value":"100018549"}],"countries":[{"code":"US","label":"United States"}],"websiteurl":"http://www.usciences.edu/"},{"legalName":"Ho Chi Minh City University of Science","acronym":"HCMUS","id":"openorgs____::a71d0d38b9595b8997cfe7e08026db03","pids":[{"scheme":"OrgRef","value":"28252460"},{"scheme":"FundRef","value":"501100004692"},{"scheme":"wikidata","value":"Q5873997"},{"scheme":"ISNI","value":"0000000406428526"},{"scheme":"mag_id","value":"23582244"},{"scheme":"ROR","value":"https://ror.org/05jfbgm49"},{"scheme":"Wikidata","value":"Q5873997"},{"scheme":"GRID","value":"grid.454160.2"},{"scheme":"fundref","value":"501100004692"}],"countries":[{"code":"VN","label":"Viet Nam"}],"websiteurl":"http://www.hcmus.edu.vn/en/index.php"},{"legalName":"Vietnam National University, Ho Chi Minh City","acronym":"VNUHCM","id":"openorgs____::1243b9aeb40390246f9b9d4b4011f7e4","pids":[{"scheme":"fundref","value":"501100010712"},{"scheme":"GRID","value":"grid.444808.4"},{"scheme":"OrgRef","value":"9968958"},{"scheme":"mag_id","value":"123565023"},{"scheme":"ISNI","value":"000000012037434X"},{"scheme":"ROR","value":"https://ror.org/00waaqh38"},{"scheme":"Wikidata","value":"Q943759"},{"scheme":"wikidata","value":"Q943759"},{"scheme":"FundRef","value":"501100010712"}],"countries":[{"code":"VN","label":"Viet Nam"}],"websiteurl":"https://vnuhcm.edu.vn"}],"communities":[{"code":"energy-planning","label":"Energy Planning","provenance":null}],"collectedFrom":[{"key":"driver______::bee53aa31dc2cbb538c10c2b65fa5824","value":"DOAJ"},{"key":"openaire____::081b82f96300b6a6e3d282bad31cb6e2","value":"Crossref"}],"instances":[{"pids":[{"scheme":"doi","value":"10.22144/ctujoisd.2024.271"}],"license":"CC BY NC","accessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/","openAccessRoute":"hybrid"},"type":"Article","urls":["https://doi.org/10.22144/ctujoisd.2024.271"],"publicationDate":"2024-03-25","refereed":"peerReviewed","hostedBy":{"key":"doajarticles::ca1bd05568b90059ba4586a47d43706e","value":"CTU Journal of Innovation and Sustainable Development"},"collectedFrom":{"key":"openaire____::081b82f96300b6a6e3d282bad31cb6e2","value":"Crossref"}},{"accessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/","openAccessRoute":null},"type":"Article","urls":["https://doaj.org/article/bd15f62754b445feab2e14d68f05c8f6"],"publicationDate":"2024-03-01","refereed":"nonPeerReviewed","hostedBy":{"key":"doajarticles::ca1bd05568b90059ba4586a47d43706e","value":"CTU Journal of Innovation and Sustainable Development"},"collectedFrom":{"key":"driver______::bee53aa31dc2cbb538c10c2b65fa5824","value":"DOAJ"}},{"alternateIdentifiers":[{"scheme":"doi","value":"10.22144/ctujoisd.2024.271"}],"accessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/","openAccessRoute":null},"type":"Article","urls":["https://doaj.org/article/0b94897d0b234f808c3802033f6e14f9"],"publicationDate":"2024-03-01","refereed":"nonPeerReviewed","hostedBy":{"key":"doajarticles::ca1bd05568b90059ba4586a47d43706e","value":"CTU Journal of Innovation and Sustainable Development"},"collectedFrom":{"key":"driver______::bee53aa31dc2cbb538c10c2b65fa5824","value":"DOAJ"}}],"links":[],"otherTitles":null,"inDiamondJournal":false,"green":false,"isGreen":false,"isInDiamondJournal":false},{"authors":[{"id":null,"fullName":"WANG, Wencong","name":"Wencong","surname":"WANG","rank":1,"pid":null},{"id":null,"fullName":"HANZAWA, Hiromasa","name":"Hiromasa","surname":"HANZAWA","rank":2,"pid":null},{"id":null,"fullName":"MACHIDA, Ken-ichi","name":"Ken-ichi","surname":"MACHIDA","rank":3,"pid":null},{"id":null,"fullName":"MIYAZAKI, Kohei","name":"Kohei","surname":"MIYAZAKI","rank":4,"pid":{"id":{"scheme":"orcid_pending","value":"0000-0001-5177-3570"},"provenance":null}},{"id":null,"fullName":"ABE, Takeshi","name":"Takeshi","surname":"ABE","rank":5,"pid":{"id":{"scheme":"orcid_pending","value":"0000-0002-1515-8340"},"provenance":null}}],"openAccessColor":"gold","publiclyFunded":false,"eoscIfGuidelines":null,"type":"publication","language":{"code":"eng","label":"English"},"countries":null,"subjects":[{"subject":{"scheme":"keyword","value":"Technology"},"provenance":null},{"subject":{"scheme":"keyword","value":"T"},"provenance":null},{"subject":{"scheme":"keyword","value":"Physical and theoretical chemistry"},"provenance":null},{"subject":{"scheme":"keyword","value":"QD450-801"},"provenance":null},{"subject":{"scheme":"FOS","value":"02 engineering and technology"},"provenance":null},{"subject":{"scheme":"keyword","value":"Nanorod"},"provenance":null},{"subject":{"scheme":"keyword","value":"doping"},"provenance":null},{"subject":{"scheme":"keyword","value":"high-rate performance"},"provenance":null},{"subject":{"scheme":"FOS","value":"01 natural sciences"},"provenance":null},{"subject":{"scheme":"SDG","value":"7. Clean energy"},"provenance":null},{"subject":{"scheme":"keyword","value":"nanorod"},"provenance":null},{"subject":{"scheme":"keyword","value":"Li-rich Layered Cathodes"},"provenance":null},{"subject":{"scheme":"FOS","value":"0104 chemical sciences"},"provenance":null},{"subject":{"scheme":"keyword","value":"High-rate Performance"},"provenance":null},{"subject":{"scheme":"FOS","value":"0202 electrical engineering, electronic engineering, information engineering"},"provenance":null},{"subject":{"scheme":"keyword","value":"Doping"},"provenance":null},{"subject":{"scheme":"keyword","value":"li-rich layered cathodes"},"provenance":null}],"mainTitle":"Electrochemical Performance of Nanorod-like (La, Zr) Co-Doped Li-rich Li1.2Ni0.2Mn0.6O2 Cathodes for Use in Lithium-Ion Batteries","subTitle":null,"descriptions":["A lithium-rich layered structure in lithium-ion batteries (LIBs) has attracted much attention due to its high capacity of over 250 mAh g−1 after activation. This could satisfy the requirements of next-generation energy-storage devices. However, a spinel-like impurity phase that forms from the pristine layered structure during cycling is considered to be harmful to the structure stability and Li+ mobility, resulting in undesired electrochemical performance. In this study, nanorod-like Li1.2Ni0.2Mn0.6O2 with a three-dimensional architecture was synthesized by evaporative-crystallization with as-prepared nano-MnO2 as a hard template. The structure stability and Li+ mobility of the nanorod-like Li1.2Ni0.2Mn0.6O2 was improved by the addition of an appropriate molar ratios of (La, Zr) co-dopants. This combination exhibited outstanding capacity retention of 80.9 % with a stable discharge capacity of 102 mAh g−1 after 300 cycles under a high current density of 1000 mA g−1 (corresponding to 5 C). This study suggests that the use of a multi-prong strategy that combines morphology control and co-doping should be an effective method for improving the high-rate performance of Li-rich materials."],"publicationDate":"2022-01-01","publisher":"The Electrochemical Society of Japan","embargoEndDate":null,"sources":["Electrochemistry, Vol 90, Iss 1, Pp 017008-017008 (2022)"],"formats":null,"contributors":null,"coverages":null,"bestAccessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/"},"container":{"name":"Electrochemistry","issnPrinted":"2186-2451","issnOnline":null,"issnLinking":null,"ep":null,"iss":null,"sp":null,"vol":null,"edition":null,"conferencePlace":null,"conferenceDate":null},"documentationUrls":null,"codeRepositoryUrl":null,"programmingLanguage":null,"contactPeople":null,"contactGroups":null,"tools":null,"size":null,"version":null,"geoLocations":null,"id":"dedup_wf_002::0b2e9030d9890cdbd5f68b588fd94ea5","originalIds":["oai:doaj.org/article:463b8593dbf24b4d93686559f9083504","50|doajarticles::0a7009dca305e86d89768d9926747a30","doi:10.5796/electrochemistry.21-00115","50|efb2be5d8919::85e9f0c1dcfbf3489d8a525b62fc54f3"],"pids":null,"dateOfCollection":null,"lastUpdateTimeStamp":null,"indicators":{"citationImpact":{"citationCount":0.0,"influence":2.1746283E-9,"popularity":1.4615026E-9,"impulse":0.0,"citationClass":"C5","influenceClass":"C5","impulseClass":"C5","popularityClass":"C5"}},"projects":null,"organizations":[{"legalName":"Osaka University","acronym":"Osaka University","id":"openorgs____::ecba883a3c9132fccb04cf3d60753bae","pids":[{"scheme":"ISNI","value":"0000000403733971"},{"scheme":"Wikidata","value":"Q39650724"},{"scheme":"fundref","value":"501100004206"},{"scheme":"mag_id","value":"98285908"},{"scheme":"wikidata","value":"Q651233"},{"scheme":"OrgRef","value":"3378942"},{"scheme":"PIC","value":"991625375"},{"scheme":"wikidata","value":"Q39650724"},{"scheme":"wikidata","value":"Q11440159"},{"scheme":"GRID","value":"grid.136593.b"},{"scheme":"OrgRef","value":"1098410"},{"scheme":"Wikidata","value":"Q11440159"},{"scheme":"FundRef","value":"501100004206"},{"scheme":"ROR","value":"https://ror.org/035t8zc32"},{"scheme":"Wikidata","value":"Q651233"}],"countries":[{"code":"JP","label":"Japan"}],"websiteurl":"http://www.osaka-u.ac.jp/en"},{"legalName":"Kyoto University","acronym":"Kyoto University","id":"openorgs____::41a7efa9b4b3dbf6e5acb73e9efb22d4","pids":[{"scheme":"FundRef","value":"501100005683"},{"scheme":"ROR","value":"https://ror.org/02kpeqv85"},{"scheme":"fundref","value":"501100004094"},{"scheme":"VIAF","value":"VIAF:156538319"},{"scheme":"fundref","value":"501100007695"},{"scheme":"OrgRef","value":"187911"},{"scheme":"FundRef","value":"501100007695"},{"scheme":"RRID","value":"RRID:SCR_004108"},{"scheme":"FundRef","value":"501100013226"},{"scheme":"mag_id","value":"22299242"},{"scheme":"FundRef","value":"501100002917"},{"scheme":"fundref","value":"501100006086"},{"scheme":"fundref","value":"100016926"},{"scheme":"RRID","value":"RRID:nlx_60798"},{"scheme":"fundref","value":"501100005683"},{"scheme":"FundRef","value":"501100004094"},{"scheme":"fundref","value":"501100013226"},{"scheme":"FundRef","value":"501100006086"},{"scheme":"Wikidata","value":"Q336264"},{"scheme":"fundref","value":"501100002917"},{"scheme":"ISNI","value":"0000000403722033"},{"scheme":"wikidata","value":"Q336264"},{"scheme":"FundRef","value":"100016926"},{"scheme":"GRID","value":"grid.258799.8"}],"countries":[{"code":"JP","label":"Japan"}],"websiteurl":"http://www.kyoto-u.ac.jp/en"}],"communities":[{"code":"energy-planning","label":"Energy Planning","provenance":null}],"collectedFrom":[{"key":"openaire____::4965150f44bea971d2749c39dfdcacaf","value":"Japan Link Center"},{"key":"driver______::bee53aa31dc2cbb538c10c2b65fa5824","value":"DOAJ"}],"instances":[{"alternateIdentifiers":[{"scheme":"doi","value":"10.5796/electrochemistry.21-00115"}],"accessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/","openAccessRoute":"gold"},"type":"Article","urls":["https://doaj.org/article/463b8593dbf24b4d93686559f9083504"],"publicationDate":"2022-01-01","refereed":"nonPeerReviewed","hostedBy":{"key":"doajarticles::9445e615e726eb3d0cbd2729363eb0e3","value":"Electrochemistry"},"collectedFrom":{"key":"driver______::bee53aa31dc2cbb538c10c2b65fa5824","value":"DOAJ"}},{"alternateIdentifiers":[{"scheme":"doi","value":"10.5796/electrochemistry.21-00115"}],"accessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/","openAccessRoute":"gold"},"type":"Article","urls":["https://doi.org/10.5796/electrochemistry.21-00115"],"publicationDate":"2022-01-15","refereed":"peerReviewed","hostedBy":{"key":"doajarticles::9445e615e726eb3d0cbd2729363eb0e3","value":"Electrochemistry"},"collectedFrom":{"key":"openaire____::4965150f44bea971d2749c39dfdcacaf","value":"Japan Link Center"}}],"links":[],"otherTitles":null,"inDiamondJournal":false,"green":false,"isGreen":false,"isInDiamondJournal":false},{"authors":[{"id":null,"fullName":"Zhikun Huang","name":"Zhikun","surname":"Huang","rank":1,"pid":null},{"id":null,"fullName":"Chenghao Cui","name":"Chenghao","surname":"Cui","rank":2,"pid":null},{"id":null,"fullName":"Kai Wang","name":"Kai","surname":"Wang","rank":3,"pid":null},{"id":null,"fullName":"Hongyun Ma","name":"Hongyun","surname":"Ma","rank":4,"pid":null},{"id":null,"fullName":"Guoyu Pan","name":"Guoyu","surname":"Pan","rank":5,"pid":null},{"id":null,"fullName":"Yuanfan Gu","name":"Yuanfan","surname":"Gu","rank":6,"pid":null},{"id":null,"fullName":"Yingjie Gao","name":"Yingjie","surname":"Gao","rank":7,"pid":null},{"id":"orcid_______::d433641c53fadff8c9d1b9c24c750696","fullName":"Wujie Qiu","name":"Wujie","surname":"Qiu","rank":8,"pid":{"id":{"scheme":"orcid","value":"0000-0001-7332-9171"},"provenance":null}},{"id":null,"fullName":"Zhuang Sun","name":"Zhuang","surname":"Sun","rank":9,"pid":null},{"id":null,"fullName":"Tao Zhang","name":"Tao","surname":"Zhang","rank":10,"pid":{"id":{"scheme":"orcid_pending","value":"0000-0003-2469-699x"},"provenance":null}}],"openAccessColor":null,"publiclyFunded":false,"eoscIfGuidelines":null,"type":"publication","language":{"code":"eng","label":"English"},"countries":null,"subjects":[{"subject":{"scheme":"FOS","value":"02 engineering and technology"},"provenance":null},{"subject":{"scheme":"FOS","value":"0210 nano-technology"},"provenance":null}],"mainTitle":"Synergistic Pore Architecture and Surface Lithiation Enable Li                     <sub>3</sub>                     PO                     <sub>4</sub>                     -Dominated Interphases for Ultrahigh-Rate Graphite Anodes","subTitle":null,"descriptions":["Designing high-rate anodes for lithium-ion batteries (LIBs) remains a critical challenge due to the sluggish ion dynamics and capacity degradation of graphite-based materials under high-rate cycling. Here, we present a surface-lithiated porous graphite (LPG) anode designed through synergistic structural and interfacial modifications. Micron-scale pores introduced on graphite basal planes reduce Li+ diffusion distance while maintaining a low specific surface area (≤ 2 m2·g-1), ensuring an initial Coulombic efficiency exceeding 90%. Surface lithium-containing groups are identified as a key factor in inducing the formation of a Li3PO4-enriched solid electrolyte interface (SEI), which effectively mitigates Li+-solvent interactions and enhances desolvation kinetics. As a result, LPG anodes exhibit good high-rate capabilities, delivering a delithiated capacity of 327 mAh·g-1 at 50 C and retaining 88.9% initial capacity after 2000 cycles at 5 C. With kilogram-scale production and soft-pack battery verification, this strategy positions LPG as a scalable, high-rate anode solution for next-generation LIBs, achieving a good balance between rate performance and capacity retention. Surface-lithiated porous graphite achieves a good balance in balancing rate performance and capacity retention for lithium-ion batteries."],"publicationDate":"2025-10-29","publisher":"American Chemical Society (ACS)","embargoEndDate":null,"sources":["Crossref"],"formats":null,"contributors":null,"coverages":null,"bestAccessRight":{"code":"c_14cb","label":"CLOSED","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/"},"container":{"name":"ACS Nano","issnPrinted":"1936-0851","issnOnline":"1936-086X","issnLinking":null,"ep":"38593","iss":null,"sp":"38583","vol":"19","edition":null,"conferencePlace":null,"conferenceDate":null},"documentationUrls":null,"codeRepositoryUrl":null,"programmingLanguage":null,"contactPeople":null,"contactGroups":null,"tools":null,"size":null,"version":null,"geoLocations":null,"id":"doi_dedup___::f64c6e39c71fc3f0ac6b9c8fecd36557","originalIds":["10.1021/acsnano.5c13044","50|doiboost____|f64c6e39c71fc3f0ac6b9c8fecd36557","41160844"],"pids":[{"scheme":"doi","value":"10.1021/acsnano.5c13044"},{"scheme":"pmid","value":"41160844"}],"dateOfCollection":null,"lastUpdateTimeStamp":null,"indicators":{"citationImpact":{"citationCount":8.0,"influence":2.4290532E-9,"popularity":6.755796E-9,"impulse":8.0,"citationClass":"C5","influenceClass":"C5","impulseClass":"C4","popularityClass":"C4"}},"projects":null,"organizations":[{"legalName":"University of Chinese Academy of Sciences","acronym":"UCAS","id":"openorgs____::bd84daa73666b8ede0e886f71fde9dac","pids":[{"scheme":"OrgRef","value":"6704292"},{"scheme":"wikidata","value":"Q6544465"},{"scheme":"ISNI","value":"0000000417978419"},{"scheme":"GRID","value":"grid.410726.6"},{"scheme":"ROR","value":"https://ror.org/05qbk4x57"},{"scheme":"fundref","value":"501100015361"},{"scheme":"FundRef","value":"501100011332"},{"scheme":"fundref","value":"501100011332"},{"scheme":"Wikidata","value":"Q6544465"},{"scheme":"FundRef","value":"501100015361"}],"countries":[{"code":"CN","label":"China (People's Republic of)"}],"websiteurl":"http://www.ucas.ac.cn/"},{"legalName":"Shanghai Second Polytechnic University","acronym":