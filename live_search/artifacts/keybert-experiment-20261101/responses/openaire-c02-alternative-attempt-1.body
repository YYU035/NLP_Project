org/10.3390/batteries7040072"],"publicationDate":"2021-10-28","refereed":"peerReviewed","hostedBy":{"key":"doajarticles::25557f1fa59bf7f45023ed5cda6df7d3","value":"Batteries"},"collectedFrom":{"key":"openaire____::c2cdfa5866e03cdd07d313cbc8fb8311","value":"Multidisciplinary Digital Publishing Institute"}},{"alternateIdentifiers":[{"scheme":"doi","value":"10.18419/opus-11895"}],"accessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/","openAccessRoute":null},"type":"Article","urls":["http://elib.uni-stuttgart.de/handle/11682/11912","http://nbn-resolving.de/urn:nbn:de:bsz:93-opus-ds-119129","http://dx.doi.org/10.18419/opus-11895"],"publicationDate":"2022-01-19","refereed":"nonPeerReviewed","hostedBy":{"key":"opendoar____::9de6d14fff9806d4bcd1ef555be766cd","value":"Online Publikationen der Universität Stuttgart"},"collectedFrom":{"key":"opendoar____::9de6d14fff9806d4bcd1ef555be766cd","value":"Online Publikationen der Universität Stuttgart"}},{"alternateIdentifiers":[{"scheme":"doi","value":"10.18419/opus-11895"},{"scheme":"doi","value":"10.3390/batteries7040072"}],"accessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/","openAccessRoute":null},"type":"Article","urls":["https://doi.org/https://doi.org/10.3390/batteries7040072","https://doi.org/https://doi.org/10.18419/opus-11895"],"publicationDate":"2021-01-01","refereed":"nonPeerReviewed","hostedBy":{"key":"opendoar____::9de6d14fff9806d4bcd1ef555be766cd","value":"OPUS -  Publication Server of the University of Stuttgart"},"collectedFrom":{"key":"openaire____::df45502607927471ecf8a6ae83683ff5","value":"Bielefeld Academic Search Engine (BASE)"}},{"alternateIdentifiers":[{"scheme":"mag_id","value":"3208962854"},{"scheme":"doi","value":"10.3390/batteries7040072"}],"type":"Article","urls":["https://dx.doi.org/10.3390/batteries7040072"],"refereed":"nonPeerReviewed","hostedBy":{"key":"openaire____::55045bd2a65019fd8e6741a755395c8c","value":"Unknown Repository"},"collectedFrom":{"key":"openaire____::5f532a3fc4f1ea403f37070f59a7a53a","value":"Microsoft Academic Graph"}}],"links":[],"otherTitles":null,"inDiamondJournal":false,"green":true,"isGreen":true,"isInDiamondJournal":false},{"authors":[{"id":null,"fullName":"Wenyan Chen","name":"Wenyan","surname":"Chen","rank":1,"pid":null},{"id":null,"fullName":"Donghui Xu","name":"Donghui","surname":"Xu","rank":2,"pid":null},{"id":null,"fullName":"Yuancheng Chen","name":"Yuancheng","surname":"Chen","rank":3,"pid":null},{"id":null,"fullName":"Tang Tang","name":"Tang","surname":"Tang","rank":4,"pid":null},{"id":null,"fullName":"Shaojie Kuang","name":"Shaojie","surname":"Kuang","rank":5,"pid":null},{"id":null,"fullName":"Haikuo Fu","name":"Haikuo","surname":"Fu","rank":6,"pid":null},{"id":null,"fullName":"Wuyi Zhou","name":"Wuyi","surname":"Zhou","rank":7,"pid":null},{"id":"orcid_______::f38bdc519e9c3e98e3f88b17b2daa99f","fullName":"Xiaoyuan Yu","name":"Xiaoyuan","surname":"Yu","rank":8,"pid":{"id":{"scheme":"orcid","value":"0000-0002-9016-5671"},"provenance":null}}],"openAccessColor":"gold","publiclyFunded":false,"eoscIfGuidelines":null,"type":"publication","language":{"code":"eng","label":"English"},"countries":null,"subjects":[{"subject":{"scheme":"FOS","value":"02 engineering and technology"},"provenance":null},{"subject":{"scheme":"FOS","value":"0210 nano-technology"},"provenance":null},{"subject":{"scheme":"FOS","value":"01 natural sciences"},"provenance":null},{"subject":{"scheme":"SDG","value":"7. Clean energy"},"provenance":null},{"subject":{"scheme":"FOS","value":"0104 chemical sciences"},"provenance":null}],"mainTitle":"In Situ Electrospinning Synthesis of N‐Doped C Nanofibers with Uniform Embedding of Mn Doped MFe<sub>1−</sub><i><sub>x</sub></i>Mn<i><sub>x</sub></i>PO<sub>4</sub> (M = Li, Na) as a High Performance Cathode for Lithium/Sodium‐Ion Batteries","subTitle":null,"descriptions":["<jats:title>Abstract</jats:title><jats:p>Using polyvinyl alcohol and N‐rich polyacrylonitrile as carbon sources, uniform MFe<jats:sub>1–</jats:sub><jats:italic><jats:sub>x</jats:sub></jats:italic>Mn<jats:italic><jats:sub>x</jats:sub></jats:italic>PO<jats:sub>4</jats:sub> (M = Li, Na)/N‐doped C nanofibers are synthesized by sol–gel pretreatment and an electrospinning method followed by calcination. The as‐prepared nanofibers exhibit a 3D homogenous network with uniform distribution of MFe<jats:sub>1−</jats:sub><jats:italic><jats:sub>x</jats:sub></jats:italic>Mn<jats:italic><jats:sub>x</jats:sub></jats:italic>PO<jats:sub>4</jats:sub> nanoparticles. The lattice distorts after Mn‐doping without altering the original crystalline structure, increasing conductivity and enhancing the efficiency of Li<jats:sup>+</jats:sup>/Na<jats:sup>+</jats:sup> diffusion. When applied for lithium ion batteries, the optimized LiFe<jats:sub>0.8</jats:sub>Mn<jats:sub>0.2</jats:sub>PO<jats:sub>4</jats:sub>/C nanofibers deliver a considerable initial capacity of 169.9 mAh g<jats:sup>−1</jats:sup> with coulombic efficiency of 92.4%. It also displays the excellent cycling stability with reversible capacity of 160 mAh g<jats:sup>−1</jats:sup> after 200 cycles at 0.1 C and high rate performances with the specific capacity of 93 mAh g<jats:sup>−1</jats:sup> at 5 C. Furthermore, NaFe<jats:italic><jats:sub>x</jats:sub></jats:italic>Mn<jats:sub>1−</jats:sub><jats:italic><jats:sub>x</jats:sub></jats:italic>PO<jats:sub>4</jats:sub>/N‐doped C nanofibers are also synthesized by the same method for sodium‐ion batteries, which exhibit an initial capacity of 134 mAh g<jats:sup>−1</jats:sup> and specific capacity of 106 mAh g<jats:sup>−1</jats:sup> at 0.1 C and 90 mAh g<jats:sup>−1</jats:sup> at 1 C after 200 cycles. Owing to the facile fabrication process, these nanofibers are promising cathodes for lithium/sodium ion batteries with excellent electrochemical performances.</jats:p>"],"publicationDate":"2020-08-13","publisher":"Wiley","embargoEndDate":null,"sources":["Crossref"],"formats":null,"contributors":null,"coverages":null,"bestAccessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/"},"container":{"name":"Advanced Materials Interfaces","issnPrinted":"2196-7350","issnOnline":"2196-7350","issnLinking":null,"ep":null,"iss":null,"sp":null,"vol":"7","edition":null,"conferencePlace":null,"conferenceDate":null},"documentationUrls":null,"codeRepositoryUrl":null,"programmingLanguage":null,"contactPeople":null,"contactGroups":null,"tools":null,"size":null,"version":null,"geoLocations":null,"id":"doi_dedup___::78dd337e7da95abe77622e7ae8b2d2e9","originalIds":["10.1002/admi.202000684","50|doiboost____|78dd337e7da95abe77622e7ae8b2d2e9","3049712018"],"pids":[{"scheme":"doi","value":"10.1002/admi.202000684"}],"dateOfCollection":null,"lastUpdateTimeStamp":null,"indicators":{"citationImpact":{"citationCount":26.0,"influence":2.6120015E-9,"popularity":1.8452916E-8,"impulse":9.0,"citationClass":"C4","influenceClass":"C5","impulseClass":"C4","popularityClass":"C4"}},"projects":null,"organizations":[{"legalName":"South China Agricultural University","acronym":"SCAU","id":"openorgs____::5fd6e3b5ea9a260985419ce1c951cf48","pids":[{"scheme":"Wikidata","value":"Q7566809"},{"scheme":"ISNI","value":"0000000095465767"},{"scheme":"ROR","value":"https://ror.org/05v9jqt67"},{"scheme":"mag_id","value":"101479585"},{"scheme":"fundref","value":"501100012601"},{"scheme":"wikidata","value":"Q7566809"},{"scheme":"OrgRef","value":"13735979"},{"scheme":"GRID","value":"grid.20561.30"},{"scheme":"FundRef","value":"501100012601"},{"scheme":"PIC","value":"998347863"}],"countries":[{"code":"CN","label":"China (People's Republic of)"}],"websiteurl":"http://english.scau.edu.cn/scauen/index.asp"}],"communities":[{"code":"energy-planning","label":"Energy Planning","provenance":null}],"collectedFrom":[{"key":"openaire____::081b82f96300b6a6e3d282bad31cb6e2","value":"Crossref"},{"key":"openaire____::5f532a3fc4f1ea403f37070f59a7a53a","value":"Microsoft Academic Graph"}],"instances":[{"pids":[{"scheme":"doi","value":"10.1002/admi.202000684"}],"license":"Wiley Online Library User Agreement","accessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/","openAccessRoute":"gold"},"type":"Article","urls":["https://doi.org/10.1002/admi.202000684"],"publicationDate":"2020-08-13","refereed":"peerReviewed","hostedBy":{"key":"doajarticles::03ecd21bfb99a60b31ee4ca2b8f9905d","value":"Advanced Materials Interfaces"},"collectedFrom":{"key":"openaire____::081b82f96300b6a6e3d282bad31cb6e2","value":"Crossref"}},{"alternateIdentifiers":[{"scheme":"doi","value":"10.1002/admi.202000684"},{"scheme":"mag_id","value":"3049712018"}],"type":"Article","urls":["https://dx.doi.org/10.1002/admi.202000684"],"refereed":"nonPeerReviewed","hostedBy":{"key":"openaire____::55045bd2a65019fd8e6741a755395c8c","value":"Unknown Repository"},"collectedFrom":{"key":"openaire____::5f532a3fc4f1ea403f37070f59a7a53a","value":"Microsoft Academic Graph"}},{"alternateIdentifiers":[{"scheme":"mag_id","value":"3049712018"},{"scheme":"doi","value":"10.1002/admi.202000684"}],"type":"Article","urls":["https://dx.doi.org/10.1002/admi.202000684"],"refereed":"nonPeerReviewed","hostedBy":{"key":"openaire____::55045bd2a65019fd8e6741a755395c8c","value":"Unknown Repository"},"collectedFrom":{"key":"openaire____::5f532a3fc4f1ea403f37070f59a7a53a","value":"Microsoft Academic Graph"}}],"links":[],"otherTitles":null,"inDiamondJournal":false,"green":false,"isGreen":false,"isInDiamondJournal":false},{"authors":[{"id":null,"fullName":"Jiahui Li","name":"Jiahui","surname":"Li","rank":1,"pid":null},{"id":null,"fullName":"Jehad K. El‐Demellawi","name":"Jehad K.","surname":"El‐Demellawi","rank":2,"pid":null},{"id":null,"fullName":"Guan Sheng","name":"Guan","surname":"Sheng","rank":3,"pid":null},{"id":null,"fullName":"Jonas Björk","name":"Jonas","surname":"Björk","rank":4,"pid":null},{"id":null,"fullName":"Fanshuai Zeng","name":"Fanshuai","surname":"Zeng","rank":5,"pid":null},{"id":null,"fullName":"Jie Zhou","name":"Jie","surname":"Zhou","rank":6,"pid":null},{"id":null,"fullName":"Xiaxia Liao","name":"Xiaxia","surname":"Liao","rank":7,"pid":null},{"id":null,"fullName":"Junwei Wu","name":"Junwei","surname":"Wu","rank":8,"pid":null},{"id":null,"fullName":"Johanna Rosen","name":"Johanna","surname":"Rosen","rank":9,"pid":null},{"id":null,"fullName":"Xingjun Liu","name":"Xingjun","surname":"Liu","rank":10,"pid":null},{"id":"orcid_______::ff1ece5b4bde3cb2d087a6e89d5e601c","fullName":"Husam N. Alshareef","name":"Husam N.","surname":"Alshareef","rank":11,"pid":{"id":{"scheme":"orcid","value":"0000-0001-5029-2142"},"provenance":null}},{"id":null,"fullName":"Shaobo Tu","name":"Shaobo","surname":"Tu","rank":12,"pid":{"id":{"scheme":"orcid_pending","value":"0000-0002-8724-5638"},"provenance":null}}],"openAccessColor":"hybrid","publiclyFunded":false,"eoscIfGuidelines":null,"type":"publication","language":{"code":"eng","label":"English"},"countries":[{"code":"SE","label":"Sweden","provenance":null},{"code":"SA","label":"Saudi Arabia","provenance":null}],"subjects":[{"subject":{"scheme":"keyword","value":"Materials Chemistry"},"provenance":null},{"subject":{"scheme":"keyword","value":"2D carbon; adsorption energy; heteroatoms-doping; high capacity; long cycling life"},"provenance":null},{"subject":{"scheme":"keyword","value":"Materialkemi"},"provenance":null},{"subject":{"scheme":"FOS","value":"02 engineering and technology"},"provenance":null},{"subject":{"scheme":"FOS","value":"0210 nano-technology"},"provenance":null},{"subject":{"scheme":"FOS","value":"01 natural sciences"},"provenance":null},{"subject":{"scheme":"SDG","value":"7. Clean energy"},"provenance":null},{"subject":{"scheme":"FOS","value":"0104 chemical sciences"},"provenance":null}],"mainTitle":"Pseudocapacitive Heteroatom‐Doped Carbon Cathode for Aluminum‐Ion Batteries with Ultrahigh Reversible Stability","subTitle":null,"descriptions":["<jats:p>Aluminum (Al)‐ion batteries have emerged as a potential alternative to conventional ion batteries that rely on less abundant and costly materials like lithium. Nonetheless, given the nascent stage of advancement in Al‐ion batteries (AIBs), attaining electrode materials that can leverage both intercalation capacity and structural stability remains challenging. Herein, we demonstrate a C<jats:sub>3</jats:sub>N<jats:sub>4</jats:sub>‐derived layered N,S heteroatom−doped carbon, obtained at different pyrolysis temperatures, as a cathode material for AIBs, encompassing the diffusion−controlled intercalation and surface‐induced capacity with ultrahigh reversibility. The developed layered N,S‐doped corbon (N,S‐C) cathode, synthesized at 900 °C, delivers a specific capacity of 330 mAh g<jats:sup>−1</jats:sup> with a relatively high coulombic efficiency of ~85% after 500 cycles under a current density of 0.5 A g<jats:sup>−1</jats:sup>. Owing to its reinforced adsorption capability and enlarged interlayer spacing by doping N and S heteroatoms, the N,S‐C900 cathode demonstrates outstanding energy storage capacity with excellent rate performance (61 mAh g<jats:sup>−1</jats:sup> at 20 A g<jats:sup>−1</jats:sup>) and ultrahigh reversibility (90 mAh g<jats:sup>−1</jats:sup> at 5 A g<jats:sup>−1</jats:sup> after 10 000 cycles).</jats:p>"],"publicationDate":"2024-04-25","publisher":"Wiley","embargoEndDate":null,"sources":["Crossref"],"formats":["application/pdf"],"contributors":["KAUST Upstream Research Center (KURC), EXPEC-ARC Saudi Aramco Thuwal 23955 Saudi Arabia","Material Science and Engineering","Material Science and Engineering Program","Physical Sciences and Engineering","Physical Science and Engineering (PSE) Division","School of Physics and Materials Science Nanchang University 999 Xuefu Road, Honggutan District Nanchang Jiangxi 330031 China","School of Materials Science and Engineering, and Institute of Materials Genome and Big Data Harbin Institute of Technology Shenzhen 518055 China","Materials Design Division, Department of Physics, Chemistry and Biology (IFM) Linköping University SE-581 83 Linköping Sweden"],"coverages":null,"bestAccessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/"},"container":{"name":"ENERGY &amp; ENVIRONMENTAL MATERIALS","issnPrinted":"2575-0356","issnOnline":"2575-0356","issnLinking":null,"ep":null,"iss":null,"sp":null,"vol":"7","edition":null,"conferencePlace":null,"conferenceDate":null},"documentationUrls":null,"codeRepositoryUrl":null,"programmingLanguage":null,"contactPeople":null,"contactGroups":null,"tools":null,"size":null,"version":null,"geoLocations":null,"id":"doi_dedup___::3a61303cb5f4169e26854fc0f4044b0f","originalIds":["10.1002/eem2.12733","50|doiboost____|3a61303cb5f4169e26854fc0f4044b0f","50|od_______261::35cf34a412968efde716b2b35096894f","oai:DiVA.org:liu-203441","50|od_______681::35cf34a412968efde716b2b35096894f","ftkingabdullahun:oai:repository.kaust.edu.sa:10754/698156","50|base_oa_____::c64b09817483169d5dc5b011bead4d0e"],"pids":[{"scheme":"doi","value":"10.1002/eem2.12733"},{"scheme":"handle","value":"10754/698156"}],"dateOfCollection":null,"lastUpdateTimeStamp":null,"indicators":{"citationImpact":{"citationCount":15.0,"influence":2.4412923E-9,"popularity":1.1675749E-8,"impulse":15.0,"citationClass":"C4","influenceClass":"C5","impulseClass":"C4","popularityClass":"C4"}},"projects":[{"id":"vr__________::1e5e62235d094afd01cd56e65112fc63","code":"unidentified","acronym":null,"title":"unidentified","funder":"Swedish Research Council","pids":null}],"organizations":[{"legalName":"Harbin Institute of Technology","acronym":"HIT","id":"openorgs____::07357fdc3c6c4e22e7acb684926e715d","pids":[{"scheme":"PIC","value":"998594534"},{"scheme":"wikidata","value":"Q632558"},{"scheme":"GRID","value":"grid.19373.3f"},{"scheme":