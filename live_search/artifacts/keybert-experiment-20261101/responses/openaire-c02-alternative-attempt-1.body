e":"501100020813"},{"scheme":"PIC","value":"968978300"},{"scheme":"FundRef","value":"501100020858"},{"scheme":"Wikidata","value":"Q1463036"},{"scheme":"fundref","value":"501100020813"},{"scheme":"OrgRef","value":"11627340"},{"scheme":"fundref","value":"501100003422"},{"scheme":"ISNI","value":"0000000119265090"},{"scheme":"ROR","value":"https://ror.org/01q3tbs38"},{"scheme":"mag_id","value":"71920554"},{"scheme":"FundRef","value":"501100004052"}],"countries":[{"code":"SA","label":"Saudi Arabia"}],"websiteurl":"http://www.kaust.edu.sa/"},{"legalName":"Linköping University","acronym":"LiU","id":"openorgs____::5d1ce3b82c3db797559f48617c1eeecd","pids":[{"scheme":"OrgReg","value":"SE0006"},{"scheme":"FundRef","value":"501100010752"},{"scheme":"ROR","value":"https://ror.org/05ynxx418"},{"scheme":"fundref","value":"501100003945"},{"scheme":"PIC","value":"999852236"},{"scheme":"fundref","value":"501100010752"},{"scheme":"OrgRef","value":"165529"},{"scheme":"mag_id","value":"102134673"},{"scheme":"Wikidata","value":"Q782600"},{"scheme":"GRID","value":"grid.5640.7"},{"scheme":"ISNI","value":"0000000121629922"},{"scheme":"wikidata","value":"Q782600"},{"scheme":"FundRef","value":"501100006585"},{"scheme":"fundref","value":"501100006585"},{"scheme":"FundRef","value":"501100003945"}],"countries":[{"code":"SE","label":"Sweden"}],"websiteurl":"http://www.liu.se/?l=en"}],"communities":[{"code":"uarctic","label":"UArctic","provenance":null},{"code":"energy-planning","label":"Energy Planning","provenance":null}],"collectedFrom":[{"key":"openaire____::df45502607927471ecf8a6ae83683ff5","value":"Bielefeld Academic Search Engine (BASE)"},{"key":"opendoar____::1595af6435015c77a7149e92a551338e","value":"Digitala Vetenskapliga Arkivet - Academic Archive On-line"},{"key":"openaire____::081b82f96300b6a6e3d282bad31cb6e2","value":"Crossref"},{"key":"opendoar____::b1a59b315fc9a3002ce38bbe070ec3f5","value":"Publikationer från Linköpings universitet"}],"instances":[{"pids":[{"scheme":"doi","value":"