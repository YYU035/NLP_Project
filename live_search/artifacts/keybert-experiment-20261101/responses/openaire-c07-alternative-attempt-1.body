":"DOAJ"}},{"pids":[{"scheme":"handle","value":"2123/29088"}],"alternateIdentifiers":[{"scheme":"doi","value":"10.1136/bmjopen-2021-059075"}],"type":"Article","urls":["https://hdl.handle.net/2123/29088"],"publicationDate":"2022-01-01","refereed":"nonPeerReviewed","hostedBy":{"key":"opendoar____::53c3bce66e43be4f209556518c2fcb54","value":"Sydney eScholarship"},"collectedFrom":{"key":"opendoar____::53c3bce66e43be4f209556518c2fcb54","value":"Sydney eScholarship"}},{"pids":[{"scheme":"handle","value":"11343/307843"}],"alternateIdentifiers":[{"scheme":"doi","value":"10.1136/bmjopen-2021-059075"}],"license":"CC BY NC","accessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/","openAccessRoute":null},"type":"Article","urls":["https://doi.org/https://doi.org/10.1136/bmjopen-2021-059075"],"publicationDate":"2022-05-06","refereed":"nonPeerReviewed","hostedBy":{"key":"opendoar____::2f2b265625d76a6704b08093c652fd79","value":"The University of Melbourne: Digital Repository"},"collectedFrom":{"key":"openaire____::df45502607927471ecf8a6ae83683ff5","value":"Bielefeld Academic Search Engine (BASE)"}},{"pids":[{"scheme":"handle","value":"2123/29088"}],"alternateIdentifiers":[{"scheme":"doi","value":"10.1136/bmjopen-2021-059075"}],"type":"Article","urls":["https://doi.org/https://doi.org/10.1136/bmjopen-2021-059075"],"publicationDate":"2022-01-01","refereed":"nonPeerReviewed","hostedBy":{"key":"opendoar____::53c3bce66e43be4f209556518c2fcb54","value":"The University of Sydney: Sydney eScholarship Repository"},"collectedFrom":{"key":"openaire____::df45502607927471ecf8a6ae83683ff5","value":"Bielefeld Academic Search Engine (BASE)"}}],"links":[],"otherTitles":null,"green":true,"inDiamondJournal":false,"isGreen":true,"isInDiamondJournal":false},{"authors":[{"id":"orcid_______::8c6261375e5faaa83832e4f0441fefd8","fullName":"Olga Adriana Caliman-Sturdza","name":"Olga Adriana","surname":"Caliman-Sturdza","rank":1,"pid":{"id":{"scheme":"orcid","value":"0000-0003-2274-6439"},"provenance":null}},{"id":null,"fullName":"Roxana Elena Gheorghita","name":"Roxana Elena","surname":"Gheorghita","rank":2,"pid":null},{"id":"orcid_______::49cdb0ffb9978cb57444d4cf121b5f65","fullName":"Iuliana Soldanescu","name":"Iuliana","surname":"Soldanescu","rank":3,"pid":{"id":{"scheme":"orcid","value":"0000-0001-8625-4033"},"provenance":null}},{"id":"orcid_______::c09e8aca886f6ff97c8b51c3197b6f0b","fullName":"Mihai Dimian","name":"Mihai","surname":"Dimian","rank":4,"pid":{"id":{"scheme":"orcid","value":"0000-0002-2093-8659"},"provenance":null}},{"id":null,"fullName":"Serghei Mangul","name":"Serghei","surname":"Mangul","rank":5,"pid":null}],"openAccessColor":"gold","publiclyFunded":false,"eoscIfGuidelines":null,"type":"publication","language":{"code":"eng","label":"English"},"countries":null,"subjects":[{"subject":{"scheme":"FOS","value":"0303 health sciences"},"provenance":null},{"subject":{"scheme":"FOS","value":"03 medical and health sciences"},"provenance":null},{"subject":{"scheme":"keyword","value":"SARS-CoV-2"},"provenance":null},{"subject":{"scheme":"keyword","value":"Influenza, Human"},"provenance":null},{"subject":{"scheme":"keyword","value":"Dietary Supplements"},"provenance":null},{"subject":{"scheme":"keyword","value":"Humans"},"provenance":null},{"subject":{"scheme":"keyword","value":"COVID-19"},"provenance":null},{"subject":{"scheme":"keyword","value":"Review"},"provenance":null},{"subject":{"scheme":"keyword","value":"Vitamins"},"provenance":null},{"subject":{"scheme":"keyword","value":"Vitamin D"},"provenance":null},{"subject":{"scheme":"keyword","value":"Vitamin D Deficiency"},"provenance":null},{"subject":{"scheme":"keyword","value":"Immunity, Innate"},"provenance":null}],"mainTitle":"Vitamin D in Infectious Diseases: A Narrative Review Focusing on COVID-19, Long COVID, and Influenza","subTitle":null,"descriptions":["<jats:p>Vitamin D is a secosteroid hormone traditionally recognized for its role in bone and mineral metabolism, but it is increasingly understood to also function as an important immunomodulator influencing susceptibility to and outcomes of infectious diseases. This narrative review summarizes current evidence on the immunological, clinical, and preventive effects of vitamin D in the context of novel coronavirus disease (COVID-19), post-acute sequelae of SARS-CoV-2 infection (long COVID), and influenza. Mechanistically, vitamin D enhances innate immune defenses through the induction of antimicrobial peptides, including cathelicidin and defensins, and modulates adaptive immunity by suppressing maladaptive Th1/Th17 responses while promoting regulatory T-cell activity. Observational studies have frequently associated vitamin D deficiency with more severe COVID-19 outcomes; however, these associations may be influenced by confounding factors and reverse causality. Some meta-analyses suggest that vitamin D supplementation reduced rates of intensive care unit admission and ventilatory support, particularly among older adults and individuals with low baseline serum 25-hydroxyvitamin D concentrations. Emerging evidence also indicates that inadequate vitamin D status may be associated with an increased risk and symptom burden of long COVID, although causality has not been established. In the case of influenza, a limited number of randomized controlled trials (RCTs) and meta-analyses report a modest but statistically significant reduction in infection risk, especially with daily or weekly vitamin D supplementation in populations with low baseline vitamin D levels. Clinical guidelines consistently recommend maintaining adequate vitamin D status for general health but do not endorse high-dose vitamin D as a treatment for COVID-19 due to inconsistent trial findings. Overall, vitamin D should not be considered a standalone therapeutic agent; rather, maintaining sufficient vitamin D levels represents a low-risk, potentially beneficial strategy to support immune resilience against respiratory viral infections.</jats:p>"],"publicationDate":"2026-02-14","publisher":"MDPI AG","embargoEndDate":null,"sources":["Crossref","Nutrients"],"formats":null,"contributors":null,"coverages":null,"bestAccessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/"},"container":{"name":"Nutrients","issnPrinted":null,"issnOnline":"2072-6643","issnLinking":null,"ep":null,"iss":null,"sp":"634","vol":"18","edition":null,"conferencePlace":null,"conferenceDate":null},"documentationUrls":null,"codeRepositoryUrl":null,"programmingLanguage":null,"contactPeople":null,"contactGroups":null,"tools":null,"size":null,"version":null,"geoLocations":null,"id":"doi_dedup___::78c944c367d999797831f3c08f3cff0c","originalIds":["nu18040634","10.3390/nu18040634","50|doiboost____|78c944c367d999797831f3c08f3cff0c","od_______267::aca993609c3b45a4e3dd60f89e588ec3","41754151","PMC12943368","50|od_______267::aca993609c3b45a4e3dd60f89e588ec3","oai:pubmedcentral.nih.gov:12943368"],"pids":[{"scheme":"doi","value":"10.3390/nu18040634"},{"scheme":"pmid","value":"41754151"},{"scheme":"pmc","value":"PMC12943368"}],"dateOfCollection":null,"lastUpdateTimeStamp":null,"indicators":{"citationImpact":{"citationCount":4.0,"influence":2.2589652E-9,"popularity":5.161602E-9,"impulse":4.0,"citationClass":"C5","influenceClass":"C5","impulseClass":"C4","popularityClass":"C4"}},"projects":null,"organizations":[{"legalName":"Ştefan cel Mare University of Suceava","acronym":"Ştefan cel Mare University of Suceava","id":"openorgs____::14500f0c2fcbea1b8d270fe531bfd671","pids":[{"scheme":"ISNI","value":"0000000121636372"},{"scheme":"FundRef","value":"100020629"},{"scheme":"fundref","value":"100020629"},{"scheme":"ROR","value":"https://ror.org/035pkj773"},{"scheme":"OrgReg","value":"RO0036"},{"scheme":"mag_id","value":"12012874"},{"scheme":"OrgRef","value":"23159857"},{"scheme":"Wikidata","value":"Q653439"},{"scheme":"wikidata","val