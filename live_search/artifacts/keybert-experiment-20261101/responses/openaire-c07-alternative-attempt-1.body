itories.org/documentation/access_rights/","openAccessRoute":null},"type":"Article","urls":["https://doi.org/10.1016/j.ajcnut.2022.11.015"],"publicationDate":"2023-02-01","refereed":"peerReviewed","hostedBy":{"key":"issn___print::5a3ac5a4a74a466d0440c03ae7b490e2","value":"American Journal of Clinical Nutrition"},"collectedFrom":{"key":"openaire____::081b82f96300b6a6e3d282bad31cb6e2","value":"Crossref"}},{"pids":[{"scheme":"pmid","value":"36811576"}],"alternateIdentifiers":[{"scheme":"doi","value":"10.1016/j.ajcnut.2022.11.015"}],"type":"Article","urls":["https://pubmed.ncbi.nlm.nih.gov/36811576"],"publicationDate":"2023-03-06","refereed":"nonPeerReviewed","hostedBy":{"key":"issn___print::5a3ac5a4a74a466d0440c03ae7b490e2","value":"American Journal of Clinical Nutrition"},"collectedFrom":{"key":"opendoar____::8b6dd7db9af49e67306feb59a8bdc52c","value":"Europe PubMed Central"}},{"type":"Article","urls":["https://espace.library.uq.edu.au/view/UQ:ec58a6c"],"publicationDate":"2023-02-01","refereed":"nonPeerReviewed","hostedBy":{"key":"fairsharing_::b28d7c6b6aec04f5525b453411ff4336","value":"UQ eSpace"},"collectedFrom":{"key":"fairsharing_::b28d7c6b6aec04f5525b453411ff4336","value":"UQ eSpace"}},{"type":"Article","urls":["https://api.library.uq.edu.au/view/UQ:ec58a6c"],"publicationDate":"2023-02-01","refereed":"nonPeerReviewed","hostedBy":{"key":"fairsharing_::b28d7c6b6aec04f5525b453411ff4336","value":"UQ eSpace"},"collectedFrom":{"key":"fairsharing_::b28d7c6b6aec04f5525b453411ff4336","value":"UQ eSpace"}},{"alternateIdentifiers":[{"scheme":"doi","value":"10.1016/j.ajcnut.2022.11.015"}],"type":"Article","urls":["https://doi.org/https://doi.org/10.1016/j.ajcnut.2022.11.015"],"publicationDate":"2023-02-01","refereed":"nonPeerReviewed","hostedBy":{"key":"opendoar____::39059724f73a9969845dfe4146c5660e","value":"Queensland University of Technology: QUT ePrints"},"collectedFrom":{"key":"openaire____::df45502607927471ecf8a6ae83683ff5","value":"Bielefeld Academic Search Engine (BASE)"}}],"links":[],"otherTitles":null,"green":false,"inDiamondJournal":false,"isGreen":false,"isInDiamondJournal":false},{"authors":[{"id":null,"fullName":"Hai Pham","name":"Hai","surname":"Pham","rank":1,"pid":{"id":{"scheme":"orcid_pending","value":"0000-0002-6350-368x"},"provenance":null}}],"openAccessColor":null,"publiclyFunded":false,"eoscIfGuidelines":null,"type":"publication","language":{"code":"und","label":"Undetermined"},"countries":null,"subjects":[{"subject":{"scheme":"keyword","value":"Randomised controlled trial"},"provenance":null},{"subject":{"scheme":"keyword","value":"Serum 25-hydroxyvitamin D concentration"},"provenance":null},{"subject":{"scheme":"keyword","value":"Vitamin D supplementation"},"provenance":null},{"subject":{"scheme":"keyword","value":"4206 Public health"},"provenance":null},{"subject":{"scheme":"keyword","value":"School of Public Health"},"provenance":null},{"subject":{"scheme":"keyword","value":"Acute respiratory tract infection"},"provenance":null},{"subject":{"scheme":"keyword","value":"The gut microbiome"},"provenance":null},{"subject":{"scheme":"keyword","value":"Antibiotic use"},"provenance":null},{"subject":{"scheme":"keyword","value":"Hospitalisation for infections"},"provenance":null}],"mainTitle":"Vitamin D and infection","subTitle":null,"descriptions":["Infectious diseases are common and have a significant impact on global health and the economy, as illustrated by the COVID-19 pandemic. The burden of infectious diseases is particularly high in low- and middle-income countries, accounting for more than a third of the total disease burden in some regions such as South Asia and Sub-Saharan Africa. Death rates from infectious diseases are highest in children aged ≤5 years and older adults. Therefore, finding ways to reduce the burden of infectious diseases is a priority. Vitamin D is best known for its role in calcium homeostasis. In vitro and in vivo studies suggest that vitamin D might also play a role in the immune system, particularly in promoting the elimination of infectious pathogens and downregulating pro-inflammatory responses. Thus, vitamin D may have a beneficial effect on infections. Observational studies have consistently shown an inverse association between serum 25-hydroxy vitamin D (25(OH)D) concentration (the molecule measured to determine vitamin D status) and infectious diseases. However, these studies are limited by the potential for confounding or reverse causality. Several Mendelian randomisation studies have assessed the link between genetically predicted serum 25(OH)D concentration and risk or severity of infection; the results are inconclusive. Randomised controlled trials (RCT) provide insufficient data to support widespread supplementation with vitamin D to prevent infectious diseases. Many RCTs have assessed the effect of vitamin D supplementation on infections, mainly focusing on acute respiratory tract infections (ARTIs). There is reasonable evidence for a beneficial effect of vitamin D supplementation on ARTI, although the effect appears to be restricted to children. The benefit of vitamin D supplementation for ARTI in adults remains unclear. Current evidence is also inconclusive for the beneficial effect of vitamin D on other infections. There have been few trials that were population-based, and therefore these were unable to inform decisions about population-wide supplementation. My PhD aimed to review and meta-analyse results from observational studies to assess the non-linear link between serum 25(OH)D concentration and risk or severity of ARTI. We also investigated the effect of vitamin D supplementation on infection using data from the large population-based D-Health Trial. D-Health is a double-blind, placebo-controlled, randomised trial. The study recruited 21,315 Australians aged 60 to 84 years from the general population to receive monthly doses of 60,000 international units of supplemental vitamin D or a placebo for five years. We searched PUBMED and EMBASE databases for observational studies to be included in the systematic review and meta-analysis. Using data from the D-Health Trial, we assessed the effect of vitamin D supplementation on i) ARTI, ii) antibiotic prescription as a surrogate for infection, iii) hospitalisations for infection and iv) composition of the gut microbiome. ARTI was ascertained using self-reported annual surveys or a respiratory symptom diary. Antibiotic prescription and hospitalisation were ascertained via linkage with Pharmaceutical Benefits Scheme and hospital data. The composition of the gut microbiome was evaluated via sequencing of the stool samples. We used regression models: logistic for binary outcomes, Poisson or negative binomial for count outcomes, and linear regression for continuous outcomes. In our meta-analysis of observational studies, we found a non-linear association between serum 25(OH)D concentration and risk of ARTI, with the sharpest increase in risk in 25(OH)D concentrations <37.5 nmol/L. Analyses of the D-Health Trial did not show a beneficial effect of vitamin D supplementation on the risk of infection. However, vitamin D supplementation reduced duration and severity of ARTI, antibiotic prescriptions, and extended hospitalisations with stays in hospital >6 days, suggesting a role of vitamin D in severe infections. Vitamin D supplementation had negligible effects on composition of the gut microbiome. In conclusion, the studies included in this research found that supplementing Australian adults that are largely vitamin D replete with monthly doses of supplemental vitamin D reduced duration and severity of infection, suggesting a role of vitamin D on the immune system. This calls for a focus on public health strategies to mitigate vitamin D deficiency that have implications for bone health as well as infectious outcomes."],"publicationDate":"2023-09-20","publisher":"University of Queensland Library","embargoEndDate":null,"sources":["Crossref"],"formats":null,"contributors":null,"coverages":null,"bestAccessRight":null,"container":null,"documentationUrls":null,"codeRepositoryUrl":null,"programmingLanguage":null,"contactPeople":null,"contactGroups":null,"tools":null,"size":null,"version":null,"geoLocations":null,"id":"doi_dedup___::0f37dd237c6192c836eddf397b5c7e1b","originalIds":["10.14264/cd49ba3","50|doiboost____|0f37dd237c6192c836eddf397b5c7e1b","50|fsh_____5020::cad96a168bf6c3991505e3af42fbfa94","oai:api.library.uq.edu.au:publications:UQ:cd49ba3"],"pids":[{"scheme":"doi","value":"10.14264/cd49ba3"}],"dateOfCollection":null,"lastUpdateTimeStamp":null,"indicators":{"citationImpact":{"citationCount":0.0,"influence":2.1746283E-9,"popularity":1.6835128E-9,"impulse":0.0,"citationClass":"C5","influenceClass":"C5","impulseClass":"C5","popularityClass":"C5"}},"projects":null,"organizations":null,"communities":[{"code":"covid-19","label":"Corona Virus Disease","provenance":null}],"collectedFrom":[{"key":"fairsharing_::b28d7c6b6aec04f5525b453411ff4336","value":"UQ eSpace"},{"key":"openaire____::081b82f96300b6a6e3d282bad31cb6e2","value":"Crossref"}],"instances":[{"pids":[{"scheme":"doi","value":"10.14264/cd49ba3"}],"type":"Doctoral thesis","urls":["https://doi.org/10.14264/cd49ba3"],"publicationDate":"2023-09-20","refereed":"peerReviewed","hostedBy":{"key":"openaire____::55045bd2a65019fd8e6741a755395c8c","value":"Unknown Repository"},"collectedFrom":{"key":"openaire____::081b82f96300b6a6e3d282bad31cb6e2","value":"Crossref"}},{"type":"Thesis","urls":["https://api.library.uq.edu.au/view/UQ:cd49ba3/thumbnail_s4513333_phd_thesis_t.jpg","https://api.library.uq.edu.au/view/UQ:cd49ba3/s4513333_phd_thesis.pdf","https://api.library.uq.edu.au/view/UQ:cd49ba3"],"publicationDate":"2023-08-31","refereed":"nonPeerReviewed","hostedBy":{"key":"fairsharing_::b28d7c6b6aec04f5525b453411ff4336","value":"UQ eSpace"},"collectedFrom":{"key":"fairsharing_::b28d7c6b6aec04f5525b453411ff4336","value":"UQ eSpace"}}],"links":[],"otherTitles":null,"green":false,"inDiamondJournal":false,"isGreen":false,"isInDiamondJournal":false},{"authors":[{"id":null,"fullName":"David A Jolliffe","name":"David A","surname":"Jolliffe","rank":1,"pid":null},{"id":"orcid_______::0c202fb3b26c1a51a53d7d5e6dec5d90","fullName":"Carlos A Camargo","name":"Carlos A","surname":"Camargo","rank":2,"pid":{"id":{"scheme":"orcid","value":"0000-0002-5071-7654"},"provenance":null}},{"id":null,"fullName":"John D Sluyter","name":"John D","surname":"Sluyter","rank":3,"pid":null},{"id":null,"fullName":"Mary Aglipay","name":"Mary","surname":"Aglipay","rank":4,"pid":null},{"id":null,"fullName":"John F Aloia","name":"John F","surname":"Aloia","rank":5,"pid":null},{"id":null,"fullName":"Davaasambuu Ganmaa","name":"Davaasambuu","surname":"Ganmaa","rank":6,"pid":null},{"id":"orcid_______::89958c13a40e0298b984ec1a4b47b309","fullName":"Peter Bergman","name":"Peter","surname":"Bergman","rank":7,"pid":{"id":{"scheme":"orcid","value":"0000-0003-3306-3713"},"provenance":null}},{"id":"orcid_______::22aae0d1f3d2d359977d68b0ed1749dc","fullName":"Arturo Borzutzky","name":"Arturo","surname":"Borzutzky","rank":8,"pid":{"id":{"scheme":"orcid","value":"0000-0002-7904-262x"},"provenance":null}},{"id":null,"fullName":"Camilla T Damsgaard","name":"Camilla T","surname":"Damsgaard","rank":9,"pid":null},{"id":null,"fullName":"Gal Dubnov-Raz","name":"Gal","surname":"Dubnov-Raz","rank":10,"pid":null},{"id":null,"fullName":"Susanna Esposito","name":"Susanna","surname":"Esposito","rank":11,"pid":null},{"id":null,"fullName":"Clare Gilham","name":"Clare","surname":"Gilham","rank":12,"pid":null},{"id":null,"fullName":"Adit A Ginde","name":"Adit A","surname":"Ginde","rank":13,"pid":null},{"id":null,"fullName":"Inbal Golan-Tripto","name":"Inbal","surname":"Golan-Tripto","rank":14,"pid":null},{"id":null,"fullName":"Emma C Goodall","name":"Emma C","surname":"Goodall","rank":15,"pid":null},{"id":null,"fullName":"Cameron C Grant","name":"Cameron C","surname":"Grant","rank":16,"pid":null},{"id":null,"fullName":"Christopher J Griffiths","name":"Christopher J","surname":"Griffiths","rank":17,"pid":null},{"id":"orcid_______::0446dd728871cfaa943daa1b56f08bea","fullName":"Anna Maria Hibbs","name":"Anna Maria","surname":"Hibbs","rank":18,"pid":{"id":{"scheme":"orcid","value":"0000-0001-6773-068x"},"provenance":null}},{"id":"orcid_______::bb8c869d76aa04ca80967c2d1f681d51","fullName":"Wim Janssens","name":"Wim","surname":"Janssens","rank":19,"pid":{"id":{"scheme":"orcid","value":"0000-0003-1830-2982"},"provenance":null}},{"id":null,"fullName":"Anuradha Vaman Khadilkar","name":"Anuradha Vaman","surname":"Khadilkar","rank":20,"pid":null},{"id":null,"fullName":"Ilkka Laaksi","name":"Ilkka","surname":"Laaksi","rank":21,"pid":null},{"id":null,"fullName":"Margaret T Lee","name":"Margaret T","surname":"Lee","rank":22,"pid":null},{"id":null,"fullName":"Mark Loeb","name":"Mark","surname":"Loeb","rank":23,"pid":null},{"id":null,"fullName":"Jonathon L Maguire","name":"Jonathon L","surname":"Maguire","rank":24,"pid":null},{"id":null,"fullName":"Paweł Majak","name":"Paweł","surname":"Majak","rank":25,"pid":null},{"id":null,"fullName":"David T Mauger","name":"David T","surname":"Mauger","rank":26,"pid":null},{"id":null,"fullName":"Semira Manaseki-Holland","name":"Semira","surname":"Manaseki-Holland","rank":27,"pid":null},{"id":null,"fullName":"David R Murdoch","name":"David R","surname":"Murdoch","rank":28,"pid":null},{"id":null,"fullName":"Akio Nakashima","name":"Akio","surname":"Nakashima","rank":29,"pid":null},{"id":null,"fullName":"Rachel E Neale","name":"Rachel E","surname":"Neale","rank":30,"pid":null},{"id":null,"fullName":"Hai Pham","name":"Hai","surname":"Pham","rank":31,"pid":null},{"id":null,"fullName":"Christine Rake","name":"Christine","surname":"Rake","rank":32,"pid":null},{"id":null,"fullName":"Judy R Rees","name":"Judy R","surname":"Rees","rank":33,"pid":null},{"id":null,"fullName":"Jenni Rosendahl","name":"Jenni","surname":"Rosendahl","rank":34,"pid":null},{"id":null,"fullName":"Robert Scragg","name":"Robert","surname":"Scragg","rank":35,"pid":null},{"id":null,"fullName":"Dheeraj Shah","name":"Dheeraj","surname":"Shah","rank":36,"pid":null},{"id":null,"fullName":"Yoshiki Shimizu","name":"Yoshiki","surname":"Shimizu","rank":37,"pid":null},{"id":"orcid_______::5184e7065739f9e9a78a5f817d2e94a5","fullName":"Steve Simpson-Yap","name":"Steve","surname":"Simpson-Yap","rank":38,"pid":{"id":{"scheme":"orcid","value":"0000-0001-6521-3056"},"provenance":null}},{"id":"orcid_______::949bbcd2fb1f456ffcfc1726a29f5c15","fullName":"Geeta Trilok Kumar","name":"Geeta Trilok","surname":"Kumar","rank":39,"pid":{"id":{"scheme":"orcid","value":"0000-0001-8442-2881"},"provenance":null}},{"id":null,"fullName":"Mitsuyoshi Urashima","name":"Mitsuyoshi","surname":"Urashima","rank":40,"pid":null},{"id":null,"fullName":"Adrian R Martineau","name":"Adrian R","surname":"Martineau","rank":41,"pid":{"id":{"scheme":"orcid_pending","value":"0000-0001-5387-1721"},"provenance":null}}],"openAccessColor":null,"publiclyFunded":false,"eoscIfGuidelines":null,"type":"publication","language":{"code":"und","label":"Undetermined"},"countries":[{"code":"BE","label":"Belgium","provenance":null}],"subjects":[{"subject":{"scheme":"FOS","value":"03 medical and health sciences"},"provenance":null},{"subject":{"scheme":"FOS","value":"0302 clinical medicine"},"provenance":null},{"subject":{"scheme":"SDG","value":"16. Peace & justice"},"provenance":null},{"subject":{"scheme":"keyword","value":"Article"},"provenance":null},{"subject":{"scheme":"SDG","value":"3. Good health"},"provenance":null}],"mainTitle":"Vitamin D supplementation to prevent acute respiratory infections: systematic review and meta-analysis of aggregate data from randomised controlled trials","subTitle":null,"descriptions":["<jats:title>Abstract</jats:title>                 <jats:sec>                   <jats:title>Background</jats:title>                   <jats:p>A 2017 meta-analysis of data from 25 randomised controlled trials of vitamin D supplementation for the prevention of acute respiratory infections revealed a protective effect of the intervention. Since then, 20 new RCTs have been completed.</jats:p>                 </jats:sec>                 <jats:sec>                   <jats:title>Methods</jats:title>                   <jats:p>Systematic review and meta-analysis of data from randomised controlled trials (RCTs) of vitamin D for ARI prevention using a random effects model. Pre-specified sub-group analyses were done to determine whether effects of vitamin D on risk of ARI varied according to baseline 25-hydroxyvitamin D (25[OH]D) concentration or dosing regimen. We searched MEDLINE, EMBASE, the Cochrane Central Register of Controlled Trials (CENTRAL), Web of Science and the ClinicalTrials.gov registry from inception to 1st May 2020. Double-blind RCTs of supplementation with vitamin D or calcidiol, of any duration, were eligible if they were approved by a Research Ethics Committee and if ARI incidence was collected prospectively and pre-specified as an efficacy outcome. Aggregate data, stratified by baseline 25(OH)D concentration, were obtained from study authors. The study was registered with PROSPERO (no. CRD42020190633).</jats:p>                 </jats:sec>                 <jats:sec>                   <jats:title>Findings</jats:title>                   <jats:p>We identified 45 eligible RCTs (total 73,384 participants). Data were obtained for 46,331 (98.0%) of 47,262 participants in 42 studies, aged 0 to 95 years. For the primary comparison of vitamin D supplementation vs. placebo, the intervention reduced risk of ARI overall (Odds Ratio [OR] 0.91, 95% CI 0.84 to 0.99; P for heterogeneity 0.01). No statistically significant effect of vitamin D was seen for any of the sub-groups defined by baseline 25(OH)D concentration. However, protective effects were seen for trials in which vitamin D was given using a daily dosing regimen (OR 0.75, 95% CI 0.61 to 0.93); at daily dose equivalents of 400-1000 IU (OR 0.70, 95% CI 0.55 to 0.89); and for a duration of ≤12 months (OR 0.82, 95% CI 0.72 to 0.93). No significant interaction was seen between allocation to vitamin D vs. placebo and dose frequency, dose size, or study duration. Vitamin D did not influence the proportion of participants experiencing at least one serious adverse event (OR 0.97, 95% CI 0.86 to 1.09). Risk of bias within individual studies was assessed as being low for all but three trials. A funnel plot showed left-sided asymmetry (P=0.008, Egger’s test).</jats:p>                 </jats:sec>                 <jats:sec>                   <jats:title>Interpretation</jats:title>                   <jats:p>Vitamin D supplementation was safe and reduced risk of ARI, despite evidence of significant heterogeneity across trials. Protection was associated with administration of daily doses of 400-1000 IU vitamin D for up to 12 months. The relevance of these findings to COVID-19 is not known and requires investigation.</jats:p>                 </jats:sec>                 <jats:sec>                   <jats:title>Funding</jats:title>                   <jats:p>None</jats:p>                 </jats:sec>"],"publicationDate":"2020-07-17","publisher":"openRxiv","embargoEndDate":null,"sources":["Crossref","medRxiv"],"formats":null,"contributors":null,"coverages":null,"bestAccessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/"},"container":null,"documentationUrls":null,"codeRepositoryUrl":null,"programmingLanguage":null,"contactPeople":null,"contactGroups":null,"tools":null,"size":null,"version":null,"geoLocations":null,"id":"doi_dedup___::c6535517628a1a9ff8cbe22ca57be26a","originalIds":["10.1101/2020.07.14.20152728","50|doiboost____|c6535517628a1a9ff8cbe22ca57be26a","od_______267::154fee13ecf81dcc935f7ca9b0565fd8","33269357","PMC7709175","50|od_______267::154fee13ecf81dcc935f7ca9b0565fd8","oai:pubmedcentral.nih.gov:7709175","3043300276","oai:lirias2repo.kuleuven.be:123456789/664594","50|od______1131::1f3c17b08e5c5fb807a08f19bf436e63","50|od______9409::c6535517628a1a9ff8cbe22ca57be26a"],"pids":[{"scheme":"doi","value":"10.1101/2020.07.14.20152728"},{"scheme":"pmid","value":"33269357"},{"scheme":"pmc","value":"PMC7709175"}],"dateOfCollection":null,"lastUpdateTimeStamp":null,"indicators":{"citationImpact":{"citationCount":41.0,"influence":4.1086974E-9,"popularity":2.5627992E-8,"impulse":39.0,"citationClass":"C4","influenceClass":"C4","impulseClass":"C3","popularityClass":"C4"}},"projects":[{"id":"nhmrc_______::969b278eb7b18b97720d69ba3fe260d9","code":"1120682","acronym":null,"title":"The D-Health Trial: a large-scale population-based trial of vitamin D supplementation for improving the health of older adults","funder":"National Health and Medical Research Council (NHMRC)","pids":null},{"id":"cihr________::1e5e62235d094afd01cd56e65112fc63","code":"unidentified","acronym":null,"title":"unidentified","funder":"Canadian Institutes of Health Research","pids":null},{"id":"nih_________::2edf94de240c312154a7250f00d42a68","code":"1R01HL122624-01","acronym":null,"title":"Trial of Vitamin D Supplementation to Prevent TB Infection in Schoolchildren","funder":"National Institutes of Health","pids":null},{"id":"wt__________::9e60a4a9d0a9299a46ea761a08d05a58","code":"082476","acronym":null,"title":"The effect of vitamin D supplementation on the incidence of pnuemonia in children in Afghanistan: a randomised controlled trial.","funder":"Wellcome Trust","pids":[{"scheme":"doi","value":"10.35802/082476"}]},{"id":"nih_________::1273247f9bbf7168fb4d508423abfa90","code":"5R01CA098286-07","acronym":null,"title":"Colorectal Chemoprevention with Calcium and Vitamin D","funder":"National Institutes of Health","pids":null},{"id":"nhmrc_______::cc4d1828263447aef50fb961a6fa1974","code":"1046681","acronym":null,"title":"D-Health: A randomised trial of vitamin D for prevention of cancer and mortality","funder":"N