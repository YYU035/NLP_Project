9493109ce49","dsName":"National Health and Medical Research Council (NHMRC) - Grants Registry"}],"projectTitle":"Does vitamin D supplementation reduce mortality for older adults?: a pilot trial","code":"613655","funding":{"funder":{"id":"nhmrc_______::NHMRC","shortname":"NHMRC","name":"National Health and Medical Research Council (NHMRC)","jurisdiction":{"code":"AU","label":"Australia"},"pid":null},"level0":{"id":"nhmrc_______::NHMRC::NHMRC Project Grants","description":"NHMRC Project Grants","name":"NHMRC Project Grants"},"level1":{"id":null,"description":null,"name":null},"level2":{"id":null,"description":null,"name":null}},"startDate":"2010-01-01","endDate":"2013-12-31"},{"header":{"relationType":"resultProject","relationClass":"isProducedBy","relatedIdentifier":"nih_________::05117bf5bdf2fda87a6f78affa13339b","relatedRecordType":"project","relationProvenance":"iis","trust":"0.897"},"collectedfrom":[{"dsId":"openaire____::9e9e8c76d739212c63eff362e321ba33","dsName":"NIH - National Institutes of Health"}],"projectTitle":"Wheezing in Black Preterm Infants: Impact of Vitamin D Supplementation Strategy","code":"1R01HL109293-01A1","funding":{"funder":{"id":"nih_________::NIH","shortname":"NIH","name":"National Institutes of Health","jurisdiction":{"code":"US","label":"United States"},"pid":null},"level0":{"id":"nih_________::NIH::NATIONAL_HEART,_LUNG,_AND_BLOOD_INSTITUTE","description":"NATIONAL HEART, LUNG, AND BLOOD INSTITUTE","name":"NATIONAL HEART, LUNG, AND BLOOD INSTITUTE"},"level1":{"id":null,"description":null,"name":null},"level2":{"id":null,"description":null,"name":null}},"startDate":"2012-07-01","endDate":"2017-05-31"}],"otherTitles":null,"green":true,"inDiamondJournal":false,"isGreen":true,"isInDiamondJournal":false},{"authors":[{"id":null,"fullName":"Vid Vičič","name":"Vid","surname":"Vičič","rank":1,"pid":{"id":{"scheme":"orcid_pending","value":"0000-0003-4102-8459"},"provenance":null}}],"openAccessColor":null,"publiclyFunded":false,"eoscIfGuidelines":null,"type":"publication","language":{"code":"und","label":"Undetermined"},"countries":null,"subjects":[{"subject":{"scheme":"FOS","value":"0303 health sciences"},"provenance":null},{"subject":{"scheme":"FOS","value":"03 medical and health sciences"},"provenance":null}],"mainTitle":"Food Fortification or Individual Supplementation? Commentary on the Slovenian Guidelines for Adequate Vitamin D Status (2025)","subTitle":null,"descriptions":["<jats:p>Background: This study critically reviews the recently published “Slovenian guidelines for adequate vitamin D status (2025)”, focusing on the chapter titled Cost assessment of selected recommendations in the Slovenian guidelines for adequate vitamin D provision. Several methodological weaknesses were identified in the economic evaluation, which may lead to inefficient and inequitable public health decisions. Methods: A secondary analysis of the guideline’s cost-assessment methodology was performed, together with an independent cost comparison of vitamin D sources. Results and discussion: The guideline’s cost-effectiveness analysis for reducing acute respiratory infections (ARI) in older adults (&gt;65 years) with serum 25(OH)D &lt;25 nmol/L is based on a subgroup meta-analysis in which &gt;80% of participants were children, making extrapolation to older adults questionable. The model also assumes unrealistically high adherence to vitamin D supplementation. In contrast, population-wide food fortification is proven effective, minimizes adherence problems, is cost-effective, and ensures equitable access. Estimated annual costs for providing 20 µg vitamin D₃ daily to the total population aged ≥1 year (2.1 million people) were: 26.1 million EUR for prescription medicines; 37.3 million EUR for prescription medicines including a yearly short physician visit; 112.1 million EUR for over-the-counter medicines; 30.4 million EUR for food supplements; and 0.4 million EUR for food fortification. Conclusions: Given its demonstrated effectiveness, low cost, and ability to reduce health inequities, population-wide food fortification represents the most realistic strategy for preventing vitamin D deficiency in the entire population.</jats:p>"],"publicationDate":"2026-04-29","publisher":"Slovenian Medical Association","embargoEndDate":null,"sources":["Crossref"],"formats":null,"contributors":null,"coverages":null,"bestAccessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/"},"container":{"name":"Slovenian Medical Journal","issnPrinted":"1318-0347","issnOnline":"1581-0224","issnLinking":null,"ep":"8","iss":null,"sp":"1","vol":null,"edition":null,"conferencePlace":null,"conferenceDate":null},"documentationUrls":null,"codeRepositoryUrl":null,"programmingLanguage":null,"contactPeople":null,"contactGroups":null,"tools":null,"size":null,"version":null,"geoLocations":null,"id":"doi_________::a3c1d2a39997931a520fe29ac0186258","originalIds":["10.6016/zdravvestn.3689","50|doiboost____|a3c1d2a39997931a520fe29ac0186258"],"pids":[{"scheme":"doi","value":"10.6016/zdravvestn.3689"}],"dateOfCollection":null,"lastUpdateTimeStamp":null,"indicators":{"citationImpact":{"citationCount":0.0,"influence":2.1746283E-9,"popularity":2.6085654E-9,"impulse":0.0,"citationClass":"C5","influenceClass":"C5","impulseClass":"C5","popularityClass":"C5"}},"projects":null,"organizations":null,"communities":null,"collectedFrom":[{"key":"openaire____::081b82f96300b6a6e3d282bad31cb6e2","value":"Crossref"}],"instances":[{"pids":[{"scheme":"doi","value":"10.6016/zdravvestn.3689"}],"license":"CC BY NC","accessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/","openAccessRoute":"gold"},"type":"Article","urls":["https://doi.org/10.6016/zdravvestn.3689"],"publicationDate":"2026-04-29","refereed":"peerReviewed","hostedBy":{"key":"doajarticles::a26292a49c8668f76258904b712586b5","value":"Zdravniški Vestnik"},"collectedFrom":{"key":"openaire____::081b82f96300b6a6e3d282bad31cb6e2","value":"Crossref"}}],"links":null,"otherTitles":null,"green":false,"inDiamondJournal":true,"isGreen":false,"isInDiamondJournal":true},{"authors":[{"id":null,"fullName":"Ahmed Al Saedi","name":"Ahmed","surname":"Al Saedi","rank":1,"pid":null},{"id":"orcid_______::95327d8b20ae4e03bc901009a55b282d","fullName":"Ben Kirk","name":"Ben","surname":"Kirk","rank":2,"pid":{"id":{"scheme":"orcid","value":"0000-0002-0176-776x"},"provenance":null}},{"id":null,"fullName":"Sandra Iuliano","name":"Sandra","surname":"Iuliano","rank":3,"pid":null},{"id":"orcid_______::becafe9c455bf107c35b35883226d692","fullName":"Jesse Zanker","name":"Jesse","surname":"Zanker","rank":4,"pid":{"id":{"scheme":"orcid","value":"0000-0003-3463-6827"},"provenance":null}},{"id":"orcid_______::d6df544e6a4d4856f05afbda49d4840c","fullName":"Sara Vogrin","name":"Sara","surname":"Vogrin","rank":5,"pid":{"id":{"scheme":"orcid","value":"0000-0002-1597-9421"},"provenance":null}},{"id":null,"fullName":"Lata Jayaram","name":"Lata","surname":"Jayaram","rank":6,"pid":null},{"id":null,"fullName":"Shane Thomas","name":"Shane","surname":"Thomas","rank":7,"pid":null},{"id":null,"fullName":"Christine Golding","name":"Christine","surname":"Golding","rank":8,"pid":null},{"id":null,"fullName":"Diana Navarro-Perez","name":"Diana","surname":"Navarro-Perez","rank":9,"pid":null},{"id":null,"fullName":"Petra Marusic","name":"Petra","surname":"Marusic","rank":10,"pid":null},{"id":null,"fullName":"Sean Leng","name":"Sean","surname":"Leng","rank":11,"pid":null},{"id":null,"fullName":"Ralph Nanan","name":"Ralph","surname":"Nanan","rank":12,"pid":null},{"id":"orcid_______::4a23c453e32bddc5a14d2c8642af2c19","fullName":"Gustavo Duque","name":"Gustavo","surname":"Duque","rank":13,"pid":{"id":{"scheme":"orcid","value":"0000-0001-8126-0637"},"provenance":null}}],"openAccessColor":"gold","publiclyFunded":false,"eoscIfGuidelines":null,"type":"publication","language":{"code":"eng","label":"English"},"countries":[{"code":"AU","label":"Australia","provenance":null}],"subjects":[{"subject":{"scheme":"keyword","value":"Hand Strength"},"provenance":null},{"subject":{"scheme":"keyword","value":"SARS-CoV-2"},"provenance":null},{"subject":{"scheme":"keyword","value":"Muscles"},"provenance":null},{"subject":{"scheme":"keyword","value":"Geriatric Medicine"},"provenance":null},{"subject":{"scheme":"keyword","value":"R"},"provenance":null},{"subject":{"scheme":"keyword","value":"610"},"provenance":null},{"subject":{"scheme":"keyword","value":"COVID-19"},"provenance":null},{"subject":{"scheme":"keyword","value":"Nutrients"},"provenance":null},{"subject":{"scheme":"SDG","value":"3. Good health"},"provenance":null},{"subject":{"scheme":"keyword","value":"Coronavirus"},"provenance":null},{"subject":{"scheme":"FOS","value":"03 medical and health sciences"},"provenance":null},{"subject":{"scheme":"FOS","value":"0302 clinical medicine"},"provenance":null},{"subject":{"scheme":"keyword","value":"Treatment Outcome"},"provenance":null},{"subject":{"scheme":"keyword","value":"Immune System"},"provenance":null},{"subject":{"scheme":"keyword","value":"Dietary Supplements"},"provenance":null},{"subject":{"scheme":"keyword","value":"Quality of Life"},"provenance":null},{"subject":{"scheme":"keyword","value":"Medicine"},"provenance":null},{"subject":{"scheme":"keyword","value":"Humans"},"provenance":null},{"subject":{"scheme":"keyword","value":"Calcium"},"provenance":null},{"subject":{"scheme":"keyword","value":"Single-Blind Method"},"provenance":null},{"subject":{"scheme":"keyword","value":"Aged"},"provenance":null},{"subject":{"scheme":"keyword","value":"Randomized Controlled Trials as Topic"},"provenance":null}],"mainTitle":"Effects of 3 months of multi-nutrient supplementation on the immune system and muscle and respiratory function of older adults in aged care (The Pomerium Study): protocol for a randomised controlled trial","subTitle":null,"descriptions":["<jats:sec>                     <jats:title>Introduction</jats:title>                     <jats:p>Immunosenescence leads to increased morbidity and mortality associated with viral infections and weaker vaccine responses. This has been well documented for seasonal influenza and the current pandemic with SARS-CoV-2 (COVID-19), which disproportionately impact older adults, particularly those in residential aged care facilities. Inadequate nutrient intakes associated with impaired immunity, respiratory and muscle function are likely to augment the effects of immunosenescence. In this study, we test whether the impact of inadequate nutrition can be reversed using multi-nutrient supplementation, consequently enhancing vaccine responses, reducing the risk of viral infections and improving respiratory and muscle function.</jats:p>                   </jats:sec>                   <jats:sec>                     <jats:title>Methods and analysis</jats:title>                     <jats:p>                       The Pomerium Study is a 3-month, single-blind, randomised, controlled trial testing the effects of two daily servings of an oral multi-nutrient supplement (330 kcal, 20 g protein, 1.5 g calcium 3-hydroxy-3-methylbutyrate monohydrate (CaHMB), 449 mg calcium, 500 IU vitamin D                       <jats:sub>3</jats:sub>                       and 25 vitamins and minerals) on the immune system and muscle and respiratory function of older adults in aged care in Melbourne, Australia. 160 older adults (≥75 years old) will be recruited from aged care facilities and randomised to treatment (multi-nutrient supplement) or control (usual care). The primary outcome is a change in T-cell subsets CD8 + and CD28null counts at months 1 and 3. Secondary outcomes measured at baseline and month 3 are multiple markers of immunosenescence (also at 1 month), body composition (bioimpedance), handgrip strength (dynamometer), physical function (short physical performance battery), respiratory function (spirometry) and quality of life (EQ-5D-5L). Incidence and complications of COVID-19 and/or viral infections (ie, hospitalisation, complications or death) will be recorded throughout the trial, including 3 months after supplementation is ceased.                     </jats:p>                   </jats:sec>                   <jats:sec>                     <jats:title>Ethics and dissemination</jats:title>                     <jats:p>This study was approved by Melbourne Health Human Research Ethics Committee (Ref No. HREC/73985/MH-2021, ERM Ref No. RMH73985, Melbourne Health Site Ref No. 2021.115). Written informed consent will be obtained from participants. Results will be published in peer-reviewed journals and made available to key aged care stakeholders, including providers, residents, and government bodies.</jats:p>                   </jats:sec>                   <jats:sec>                     <jats:title>Trial registration number</jats:title>                     <jats:p>ACTRN12621000420842.</jats:p>                   </jats:sec>"],"publicationDate":"2022-05-01","publisher":"BMJ","embargoEndDate":null,"sources":["Crossref","BMJ Open","BMJ Open, Vol 12, Iss 5 (2022)"],"formats":null,"contributors":null,"coverages":null,"bestAccessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/"},"container":{"name":"BMJ Open","issnPrinted":"2044-6055","issnOnline":"2044-6055","issnLinking":null,"ep":null,"iss":null,"sp":"e059075","vol":"12","edition":null,"conferencePlace":null,"conferenceDate":null},"documentationUrls":null,"codeRepositoryUrl":null,"programmingLanguage":null,"contactPeople":null,"contactGroups":null,"tools":null,"size":null,"version":null,"geoLocations":null,"id":"doi_dedup___::b4d9df99012cc12c4b986670300c9a03","originalIds":["10.1136/bmjopen-2021-059075","50|doiboost____|b4d9df99012cc12c4b986670300c9a03","od_______267::ec2fc30572624c70e8a66ef6e201d30f","35523505","PMC9082724","50|od_______267::ec2fc