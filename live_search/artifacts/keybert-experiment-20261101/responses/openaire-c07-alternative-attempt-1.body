es":null,"green":false,"inDiamondJournal":false,"isGreen":false,"isInDiamondJournal":false},{"authors":[{"id":null,"fullName":"Pham, Hai","name":"Hai","surname":"Pham","rank":1,"pid":null},{"id":null,"fullName":"Waterhouse, Mary","name":"Mary","surname":"Waterhouse","rank":2,"pid":null},{"id":null,"fullName":"Baxter, Catherine","name":"Catherine","surname":"Baxter","rank":3,"pid":null},{"id":null,"fullName":"Romero, Briony Duarte","name":"Briony Duarte","surname":"Romero","rank":4,"pid":null},{"id":"orcid_______::97f61d93c8d37baa984f3d1742a89adb","fullName":"McLeod, Donald SA.","name":"Donald Sa","surname":"Mcleod","rank":5,"pid":{"id":{"scheme":"orcid","value":"0000-0003-1131-020x"},"provenance":null}},{"id":null,"fullName":"Armstrong, Bruce K.","name":"Bruce K.","surname":"Armstrong","rank":6,"pid":null},{"id":null,"fullName":"Ebeling, Peter R.","name":"Peter R.","surname":"Ebeling","rank":7,"pid":null},{"id":"orcid_______::e075d79c4fab2f888b66b36db19b0a95","fullName":"English, Dallas R.","name":"Dallas R.","surname":"English","rank":8,"pid":{"id":{"scheme":"orcid","value":"0000-0001-7828-8188"},"provenance":null}},{"id":"orcid_______::67452de7ac8780259b9681685e1b3bcb","fullName":"Hartel, Gunter","name":"Gunter","surname":"Hartel","rank":9,"pid":{"id":{"scheme":"orcid","value":"0000-0002-5454-6450"},"provenance":null}},{"id":null,"fullName":"O'Connell, Rachel L.","name":"Rachel L.","surname":"O Connell","rank":10,"pid":null},{"id":"orcid_______::317250b6d2ec38b7b7815285509df8d1","fullName":"van der Pols, Jolieke C.","name":"Jolieke C.","surname":"Pols","rank":11,"pid":{"id":{"scheme":"orcid","value":"0000-0003-4169-1795"},"provenance":null}},{"id":null,"fullName":"Venn, Alison J.","name":"Alison J.","surname":"Venn","rank":12,"pid":null},{"id":null,"fullName":"Webb, Penelope M","name":"Penelope M.","surname":"Webb","rank":13,"pid":null},{"id":null,"fullName":"Whiteman, David C.","name":"David C.","surname":"Whiteman","rank":14,"pid":null},{"id":null,"fullName":"Neale, Rachel E","name":"Rachel E.","surname":"Neale","rank":15,"pid":null}],"openAccessColor":null,"publiclyFunded":false,"eoscIfGuidelines":null,"type":"publication","language":{"code":"eng","label":"English"},"countries":[{"code":"AU","label":"Australia","provenance":null}],"subjects":[{"subject":{"scheme":"FOS","value":"0301 basic medicine"},"provenance":null},{"subject":{"scheme":"keyword","value":"Male"},"provenance":null},{"subject":{"scheme":"keyword","value":"Nutrition and Dietetics"},"provenance":null},{"subject":{"scheme":"keyword","value":"Australia/epidemiology"},"provenance":null},{"subject":{"scheme":"keyword","value":"3202 Clinical sciences"},"provenance":null},{"subject":{"scheme":"keyword","value":"Australia"},"provenance":null},{"subject":{"scheme":"keyword","value":"610"},"provenance":null},{"subject":{"scheme":"keyword","value":"Medicine (miscellaneous)"},"provenance":null},{"subject":{"scheme":"keyword","value":"32 Biomedical and Clinical Sciences"},"provenance":null},{"subject":{"scheme":"keyword","value":"Vitamins"},"provenance":null},{"subject":{"scheme":"keyword","value":"Hospitalization"},"provenance":null},{"subject":{"scheme":"FOS","value":"03 medical and health sciences"},"provenance":null},{"subject":{"scheme":"FOS","value":"0302 clinical medicine"},"provenance":null},{"subject":{"scheme":"keyword","value":"Double-Blind Method"},"provenance":null},{"subject":{"scheme":"keyword","value":"616"},"provenance":null},{"subject":{"scheme":"keyword","value":"Dietary Supplements"},"provenance":null},{"subject":{"scheme":"keyword","value":"Vitamins/therapeutic use"},"provenance":null},{"subject":{"scheme":"keyword","value":"Humans"},"provenance":null},{"subject":{"scheme":"keyword","value":"Female"},"provenance":null},{"subject":{"scheme":"keyword","value":"Vitamin D/therapeutic use"},"provenance":null},{"subject":{"scheme":"keyword","value":"Vitamin D"},"provenance":null},{"subject":{"scheme":"keyword","value":"Cholecalciferol/therapeutic use"},"provenance":null},{"subject":{"scheme":"keyword","value":"Aged"},"provenance":null},{"subject":{"scheme":"keyword","value":"Cholecalciferol"},"provenance":null}],"mainTitle":"Vitamin D supplementation and hospitalization for infection in older adults: A post-hoc analysis of data from the Australian D-Health Trial","subTitle":null,"descriptions":["Evidence suggests that vitamin D influences the immune system. Recent studies indicate that vitamin D supplementation may reduce the severity of infections, but this has not been confirmed.The objective of this study was to assess the effect of vitamin D supplementation on hospitalization for infection.The D-Health Trial was a randomized, double-blind, placebo-controlled trial of monthly 60,000 international units of vitamin D3 for 5 y among 21,315 Australians aged 60-84 y. Hospitalization for infection, ascertained through linkage with hospital admitted patient data, is a tertiary outcome of the trial. The primary outcome for this post-hoc analysis was hospitalization for any infection. Secondary outcomes were extended hospitalization for infection (length of stay >3 d and >6 d) and hospitalization for respiratory tract, skin, and gastrointestinal infections. We used negative binomial regression to estimate the effect of vitamin D supplementation on outcomes.Participants (46% women, mean age: 69 y), were followed up for a median of 5 y. Vitamin D supplementation had little or no effect on the incidence of hospitalization for any infection [incidence rate ratio (IRR): 0.95; 95% CI: 0.86, 1.05], respiratory tract (IRR: 0.93; 95% CI: 0.81, 1.08), skin (IRR: 0.95; 95% CI: 0.76, 1.20), gastrointestinal infections (IRR: 1.03; 95% CI: 0.84, 1.26), or hospitalizations lasting >3 d (IRR: 0.94; 95% CI: 0.81, 1.09), with all CIs consistent with a null finding. People supplemented with vitamin D had fewer hospitalizations lasting >6 d (IRR: 0.80; 95% CI: 0.65, 0.99).We did not find a protective effect of vitamin D on hospitalization for infection, but it reduced the number of extended hospitalizations. In populations where few people are vitamin D deficient, the effect of population-wide supplementation is likely to be small, but these findings support previous studies suggesting that vitamin D plays a role in infectious disease. The D-Health Trial is registered at the Australian New Zealand Clinical Trials Registry as ACTRN12613000743763."],"publicationDate":"2023-02-01","publisher":"Elsevier BV","embargoEndDate":null,"sources":["Crossref"],"formats":null,"contributors":null,"coverages":null,"bestAccessRight":{"code":"c_14cb","label":"CLOSED","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/"},"container":{"name":"The American Journal of Clinical Nutrition","issnPrinted":"0002-9165","issnOnline":null,"issnLinking":null,"ep":"356","iss":null,"sp":"350","vol":"117","edition":null,"conferencePlace":null,"conferenceDate":null},"documentationUrls":null,"codeRepositoryUrl":null,"programmingLanguage":null,"contactPeople":null,"contactGroups":null,"tools":null,"size":null,"version":null,"geoLocations":null,"id":"doi_dedup___::31befc14f54aa8a056ef261e92326c00","originalIds":["S0002916522105423","10.1016/j.ajcnut.2022.11.015","50|doiboost____|31befc14f54aa8a056ef261e92326c00","36811576","oai:espace.library.uq.edu.au:publications:UQ:ec58a6c","50|fsh_____5020::9be319a0c4aa8b5ead50ad75b68d9476","oai:api.library.uq.edu.au:publications:UQ:ec58a6c","50|fsh_____5020::d5b5d346ae6c63e26dfabfe9b81b7922","ftqueensland:oai:eprints.qut.edu.au:238573","50|base_oa_____::1b726a5fbbb4190e1020f57fab645ca7"],"pids":[{"scheme":"doi","value":"10.1016/j.ajcnut.2022.11.015"},{"scheme":"pmid","value":"36811576"}],"dateOfCollection":null,"lastUpdateTimeStamp":null,"indicators":{"citationImpact":{"citationCount":8.0,"influence":2.3558262E-9,"popularity":6.911543E-9,"impulse":8.0,"citationClass":"C5","influenceClass":"C5","impulseClass":"C4","popularityClass":"C4"}},"projects":null,"organizations":[{