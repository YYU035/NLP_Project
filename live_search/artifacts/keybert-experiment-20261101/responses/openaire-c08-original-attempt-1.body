Miru, Tang","name":"Miru","surname":"Tang","rank":1,"pid":null},{"id":"orcid_______::c44869f2fced6b2b92ad0f1e7c6ee1ce","fullName":"Baiqing, Li","name":"Baiqing","surname":"Li","rank":2,"pid":{"id":{"scheme":"orcid","value":"0000-0001-8351-8267"},"provenance":null}},{"id":null,"fullName":"Hongming, Chen","name":"Hongming","surname":"Chen","rank":3,"pid":null}],"openAccessColor":null,"publiclyFunded":false,"eoscIfGuidelines":null,"type":"publication","language":{"code":"eng","label":"English"},"countries":null,"subjects":[{"subject":{"scheme":"keyword","value":"Drug Design"},"provenance":null},{"subject":{"scheme":"FOS","value":"0202 electrical engineering, electronic engineering, information engineering"},"provenance":null},{"subject":{"scheme":"FOS","value":"02 engineering and technology"},"provenance":null},{"subject":{"scheme":"keyword","value":"Neural Networks, Computer"},"provenance":null}],"mainTitle":"Application of message passing neural networks for molecular property prediction","subTitle":null,"descriptions":["Accurate molecular property prediction, as one of the classical cheminformatics topics, plays a prominent role in the fields of computer-aided drug design. For instance, property prediction models can be used to quickly screen large molecular libraries to find lead compounds. Message-passing neural networks (MPNNs), a sub-class of Graph neural networks (GNNs), have recently been demonstrated to outperform other deep learning methods on a variety of tasks, including the prediction of molecular characteristics. In this survey, we provide a brief review of the MPNN models and their applications on molecular property prediction."],"publicationDate":"2023-08-01","publisher":"Elsevier BV","embargoEndDate":null,"sources":["Crossref"],"formats":null,"contributors":null,"coverages":null,"bestAccessRight":{"code":"c_14cb","label":"CLOSED","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/"},"container":{"name":"Current Opinion in Structural Biology","issnPrinted":"0959-440X","issnOnline":null,"issnLinking":null,"ep":null,"iss":null,"sp":"102616","vol":"81","edition":null,"conferencePlace":null,"conferenceDate":null},"documentationUrls":null,"codeRepositoryUrl":null,"programmingLanguage":null,"contactPeople":null,"contactGroups":null,"tools":null,"size":null,"version":null,"geoLocations":null,"id":"doi_dedup___::a4a3018fda736d194f93f5b370b6af31","originalIds":["S0959440X23000908","10.1016/j.sbi.2023.102616","50|doiboost____|a4a3018fda736d194f93f5b370b6af31","37267824"],"pids":[{"scheme":"doi","value":"10.1016/j.sbi.2023.102616"},{"scheme":"pmid","value":"37267824"}],"dateOfCollection":null,"lastUpdateTimeStamp":null,"indicators":{"citationImpact":{"citationCount":63.0,"influence":4.2263135E-9,"popularity":4.3051582E-8,"impulse":62.0,"citationClass":"C4","influenceClass":"C4","impulseClass":"C3","popularityClass":"C3"}},"projects":null,"organizations":[{"legalName":"Guangzhou Laboratory","acronym":"Guangzhou Laboratory","id":"pending_org_::e618553932c11d4c42d6e467785631f8","pids":[{"scheme":"ROR","value":"https://ror.org/03ybmxt82"},{"scheme":"ISNI","value":"0000000505678125"}],"countries":[{"code":"CN","label":"China (People's Republic of)"}],"websiteurl":"https://www.gzlab.ac.cn"},{"legalName":"Guangzhou Regenerative Medicine and Health Guangdong Laboratory","acronym":"GRMH-GDL","id":"openorgs____::8a91e90855dc7f6a1515db5efb986ff3","pids":[{"scheme":"wikidata","value":"Q97041075"},{"scheme":"ROR","value":"https://ror.org/01n179w26"},{"scheme":"FundRef","value":"501100018605"},{"scheme":"Wikidata","value":"Q97041075"},{"scheme":"GRID","value":"grid.508040.9"},{"scheme":"fundref","value":"501100018605"},{"scheme":"ISNI","value":"000000049415435X"}],"countries":[{"code":"CN","label":"China (People's Republic of)"}],"websiteurl":"https://www.grmh-gdl.cn/"},{"legalName":"Guangzhou Institutes of Biomedicine and Health","acronym":"GIBH","id":"openorgs____::0daf4f0c0f5c9eb51092d8691d2bc94f","pids":[