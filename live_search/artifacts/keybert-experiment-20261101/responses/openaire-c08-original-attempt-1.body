ctedFrom":[{"key":"openaire____::081b82f96300b6a6e3d282bad31cb6e2","value":"Crossref"},{"key":"opendoar____::8b6dd7db9af49e67306feb59a8bdc52c","value":"Europe PubMed Central"}],"instances":[{"pids":[{"scheme":"doi","value":"10.1016/j.sbi.2023.102616"}],"license":"Elsevier TDM","accessRight":{"code":"c_14cb","label":"CLOSED","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/","openAccessRoute":null},"type":"Article","urls":["https://doi.org/10.1016/j.sbi.2023.102616"],"publicationDate":"2023-08-01","refereed":"peerReviewed","hostedBy":{"key":"issn___print::9900c79628d2a50ddd88931ed9f6182b","value":"Current Opinion in Structural Biology"},"collectedFrom":{"key":"openaire____::081b82f96300b6a6e3d282bad31cb6e2","value":"Crossref"}},{"pids":[{"scheme":"pmid","value":"37267824"}],"alternateIdentifiers":[{"scheme":"doi","value":"10.1016/j.sbi.2023.102616"}],"type":"Article","urls":["https://pubmed.ncbi.nlm.nih.gov/37267824"],"publicationDate":"2023-08-09","refereed":"nonPeerReviewed","hostedBy":{"key":"openaire____::55045bd2a65019fd8e6741a755395c8c","value":"Unknown Repository"},"collectedFrom":{"key":"opendoar____::8b6dd7db9af49e67306feb59a8bdc52c","value":"Europe PubMed Central"}}],"links":[],"otherTitles":null,"inDiamondJournal":false,"green":false,"isGreen":false,"isInDiamondJournal":false},{"authors":[{"id":null,"fullName":"Jongmin Han","name":null,"surname":null,"rank":1,"pid":null},{"id":null,"fullName":"Seokho Kang 0001","name":null,"surname":null,"rank":2,"pid":{"id":{"scheme":"orcid_pending","value":"0000-0002-0960-0294"},"provenance":null}}],"openAccessColor":null,"publiclyFunded":false,"eoscIfGuidelines":null,"type":"publication","language":{"code":"eng","label":"English"},"countries":null,"subjects":[{"subject":{"scheme":"FOS","value":"0202 electrical engineering, electronic engineering, information engineering"},"provenance":null},{"subject":{"scheme":"FOS","value":"02 engineering and technology"},"provenance":null},{"subject":{"scheme":"keyword","value":"Neural Networks, Computer"},"provenance":null},{"subject":{"scheme":"keyword","value":"Graph Neural Networks"},"provenance":null},{"subject":{"scheme":"keyword","value":"Algorithms"},"provenance":null}],"mainTitle":"Consistency-regularized graph neural networks for molecular property prediction","subTitle":null,"descriptions":["Although graph neural networks (GNNs) have proven powerful in molecular property prediction tasks, they tend to underperform when trained on small datasets. Conventional data augmentation strategies are generally ineffective in this context, as simply perturbing molecular graphs can unintentionally alter their intrinsic properties. In this study, we propose a consistency-regularized graph neural network (CRGNN) method to better utilize molecular graph augmentation during training. We apply molecular graph augmentation to obtain strongly and weakly-augmented views for each molecular graph. By incorporating a consistency regularization loss into the learning objective, the GNN is encouraged to learn representations such that the strongly-augmented views of a molecular graph are mapped close to a weakly-augmented view of the same graph. In doing so, molecular graph augmentation can contribute to improving the prediction performance of the GNN while mitigating its negative effects. Through experimental evaluation on various molecular benchmark datasets, we demonstrate that the proposed method outperforms existing methods that leverage molecular graph augmentation, especially when the training dataset is smaller."],"publicationDate":"2026-02-01","publisher":"Elsevier BV","embargoEndDate":null,"sources":["Crossref"],"formats":null,"contributors":null,"coverages":null,"bestAccessRight":{"code":"c_14cb","label":"CLOSED","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/"},"container":{"name":"Neural Networks","issnPrinted":"0893-6080","issnOnline":null,"issnLinking":null,"ep":null,"iss":null,"sp":"108157","vol":"194","edition":null,"conferencePlace":null,"conferenceDate":null},"documentationUrls":null,"codeRepositoryUrl":null,"programmingLanguage":null,"contactPeople":null,"contactGroups":null,"tools":null,"size":null,"version":null,"geoLocations":null,"id":"doi_dedup___::df73c76970b2e4a4593d137724587fe2","originalIds":["S0893608025010378","10.1016/j.neunet.2025.108157","50|doiboost____|df73c76970b2e4a4593d137724587fe2","41056596","50|dblp________::46e39a02077b6e7fc0bd418f8dff8a52"],"pids":[{"scheme":"doi","value":"10.1016/j.neunet.2025.108157"},{"scheme":"pmid","value":"41056596"}],"dateOfCollection":null,"lastUpdateTimeStamp":null,"indicators":{"citationImpact":{"citationCount":2.0,"influence":2.4052706E-9,"popularity":3.975087E-9,"impulse":2.0,"citationClass":"C5","influenceClass":"C5","impulseClass":"C5","popularityClass":"C4"}},"projects":null,"organizations":[{"legalName":"Sungkyunkwan University","acronym":"SKKU","id":"openorgs____::cfcf62e012584eaebb0aad078990dc73","pids":[{"scheme":"GRID","value":"grid.264381.a"},{"scheme":"Wikidata","value":"Q41085"},{"scheme":"wikidata","value":"Q41085"},{"scheme":"fundref","value":"501100002647"},{"scheme":"ISNI","value":"000000012181989X"},{"scheme":"ROR","value":"https://ror.org/04q78tk20"},{"scheme":"PIC","value":"944822002"},{"scheme":"OrgRef","value":"802104"},{"scheme":"FundRef","value":"501100002647"}],"countries":[{"code":"KR","label":"Korea (Republic of)"}],"websiteurl":"http://www.skku.edu/eng_home/index.jsp"}],"communities":null,"collectedFrom":[{"key":"openaire____::081b82f96300b6a6e3d282bad31cb6e2","value":"Crossref"},{"key":"openaire____::d8b68cc0a53121f6f896883a7d60c1db","value":"DBLP"},{"key":"opendoar____::8b6dd7db9af49e67306feb59a8bdc52c","value":"Europe PubMed Central"}],"instances":[{"pids":[{"scheme":"doi","value":"10.1016/j.neunet.2025.108157"}],"license":"Elsevier TDM","accessRight":{"code":"c_14cb","label":"CLOSED","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/","openAccessRoute":null},"type":"Article","urls":["https://doi.org/10.1016/j.neunet.2025.108157"],"publicationDate":"2026-02-01","refereed":"peerReviewed","hostedBy":{"key":"issn___print::0e0caf76228e4f49588922d126eff1fe","value":"Neural Networks"},"collectedFrom":{"key":"openaire____::081b82f96300b6a6e3d282bad31cb6e2","value":"Crossref"}},{"pids":[{"scheme":"pmid","value":"41056596"}],"alternateIdentifiers":[{"scheme":"doi","value":"10.1016/j.neunet.2025.108157"}],"type":"Article","urls":["https://pubmed.ncbi.nlm.nih.gov/41056596"],"publicationDate":"2025-12-16","refereed":"nonPeerReviewed","hostedBy":{"key":"openaire____::55045bd2a65019fd8e6741a755395c8c","value":"Unknown Repository"},"collectedFrom":{"key":"opendoar____::8b6dd7db9af49e67306feb59a8bdc52c","value":"Europe PubMed Central"}},{"alternateIdentifiers":[{"scheme":"doi","value":"10.1016/j.neunet.2025.108157"}],"type":"Article","urls":["https://doi.org/10.1016/j.neunet.2025.108157","https://dblp.org/rec/journals/nn/HanK26.html"],"publicationDate":"2026-01-01","refereed":"nonPeerReviewed","hostedBy":{"key":"openaire____::d8b68cc0a53121f6f896883a7d60c1db","value":"DBLP"},"collectedFrom":{"key":"openaire____::d8b68cc0a53121f6f896883a7d60c1db","value":"DBLP"}}],"links":[],"otherTitles":null,"inDiamondJournal":false,"green":false,"isGreen":false,"isInDiamondJournal":false},{"authors":[{"id":null,"fullName":"Agnieszka Pocha","name":null,"surname":null,"rank":1,"pid":null},{"id":null,"fullName":"Tomasz Danel","name":null,"surname":null,"rank":2,"pid":null},{"id":null,"fullName":"Lukasz Maziarka","name":null,"surname":null,"rank":3,"pid":null}],"openAccessColor":null,"publiclyFunded":false,"eoscIfGuidelines":null,"type":"publication","language":{"code":"und","label":"Undetermined"},"countries":null,"subjects":[{"subject":{"scheme":"FOS","value":"0301 basic medicine"},"provenance":null},{"subject":{"scheme":"keyword","value":"Chemical Physics (physics.chem-ph)"},"provenance":null},{"subject":{"scheme":"keyword","value":"FOS: Computer and information sciences"},"provenance":null},{"subject":{"scheme":"FOS","value":"03 medical and health sciences"},"provenance":null},{"subject":{"scheme":"keyword","value":"Computer Science - Machine Learning"},"provenance":null},{"subject":{"scheme":"keyword","value":"Statistics - Machine Learning"},"provenance":null},{"subject":{"scheme":"keyword","value":"Physics - Chemical Physics"},"provenance":null},{"subject":{"scheme":"keyword","value":"FOS: Physical sciences"},"provenance":null},{"subject":{"scheme":"keyword","value":"Machine Learning (stat.ML)"},"provenance":null},{"subject":{"scheme":"FOS","value":"01 natural sciences"},"provenance":null},{"subject":{"scheme":"FOS","value":"0104 chemical sciences"},"provenance":null},{"subject":{"scheme":"keyword","value":"Machine Learning (cs.LG)"},"provenance":null}],"mainTitle":"Comparison of Atom Representations in Graph Neural Networks for Molecular Property Prediction","subTitle":null,"descriptions":["Graph neural networks have recently become a standard method for analysing chemical compounds. In the field of molecular property prediction, the emphasis is now put on designing new model architectures, and the importance of atom featurisation is oftentimes belittled. When contrasting two graph neural networks, the use of different atom features possibly leads to the incorrect attribution of the results to the network architecture. To provide a better understanding of this issue, we compare multiple atom representations for graph models and evaluate them on the prediction of free energy, solubility, and metabolic stability. To the best of our knowledge, this is the first methodological study that focuses on the relevance of atom representation to the predictive performance of graph neural networks.","Machine Learning for Molecules Workshop at NeurIPS 2020 (spotlight talk)"],"publicationDate":"2020-01-01","publisher":null,"embargoEndDate":"2020-12-01","sources":null,"formats":null,"contributors":null,"coverages":null,"bestAccessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/"},"container":{"name":"CoRR","issnPrinted":null,"issnOnline":null,"issnLinking":null,"ep":null,"iss":null,"sp":null,"vol":"abs/2012.04444","edition":null,"conferencePlace":null,"conferenceDate":null},"documentationUrls":null,"codeRepositoryUrl":null,"programmingLanguage":null,"contactPeople":null,"contactGroups":null,"tools":null,"size":null,"version":null,"geoLocations":null,"id":"doi_dedup___::ea9373e4d80f59892de49e65e1803594","originalIds":["50|datacite____::ea9373e4d80f59892de49e65e1803594","10.48550/arxiv.2012.04444","50|od________18::b69933745347f104368b56e176e6e57f","oai:arXiv.org:2012.04444","50|dblp________::87aa3c6845010e8fbe2c9312bfaf0d4d"],"pids":[{"scheme":"doi","value":"10.48550/arxiv.2012.04444"},{"scheme":"arXiv","value":"2012.04444"}],"dateOfCollection":null,"lastUpdateTimeStamp":null,"indicators":{"citationImpact":{"citationCount":0.0,"influence":2.1746283E-9,"popularity":1.1111055E-9,"impulse":0.0,"citationClass":"C5","influenceClass":"C5","impulseClass":"C5","popularityClass":"C5"}},"projects":null,"organizations":[{"legalName":"Jagiellonian University","acronym":"Jagiellonian University","id":"pending_org_::856d1ddbb1845c32184dc9d5f5f3ea8a","pids":null,"countries":[{"code":"UNKNOWN","label":"Unknown"}],"websiteurl":null},{"legalName":"Jagiellonian University","acronym":"Jagiellonian University","id":"openorgs____::0c1049b0ed1be0e267c46d0f54fe4745","pids":[{"scheme":"mag_id","value":"686019"},{"scheme":"FundRef","value":"100009045"},{"scheme":"fundref","value":"501100007088"},{"scheme":"OrgRef","value":"38078"},{"scheme":"FundRef","value":"501100007088"},{"scheme":"ISNI","value":"0000000121629631"},{"scheme":"GRID","value":"grid.9922.0"},{"scheme":"Wikidata","value":"Q189441"},{"scheme":"GRID","value":"grid.5522.0"},{"scheme":"RRID","value":"RRID:SCR_025051"},{"scheme":"ISNI","value":"0000