ositories.org/documentation/access_rights/","openAccessRoute":"gold"},"type":"Article","urls":["https://pubmed.ncbi.nlm.nih.gov/38891271"],"refereed":"nonPeerReviewed","hostedBy":{"key":"doajarticles::674f4ec17737a49b173c1bde2ca9a9c7","value":"Plants"},"collectedFrom":{"key":"opendoar____::8b6dd7db9af49e67306feb59a8bdc52c","value":"Europe PubMed Central"}},{"alternateIdentifiers":[{"scheme":"doi","value":"10.3390/plants13111462"}],"license":"CC BY","accessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/","openAccessRoute":null},"type":"Article","urls":["http://dx.doi.org/10.3390/plants13111462"],"publicationDate":"2024-05-24","refereed":"nonPeerReviewed","hostedBy":{"key":"opendoar____::eda80a3d5b344bc40f3bc04f65b7a357","value":"PubMed Central"},"collectedFrom":{"key":"opendoar____::eda80a3d5b344bc40f3bc04f65b7a357","value":"PubMed Central"}},{"alternateIdentifiers":[{"scheme":"doi","value":"10.3390/plants13111462"}],"accessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/","openAccessRoute":"gold"},"type":"Article","urls":["https://doaj.org/article/ab2bee0483fc4e2c80418d853b27fce3"],"publicationDate":"2024-05-01","refereed":"nonPeerReviewed","hostedBy":{"key":"doajarticles::674f4ec17737a49b173c1bde2ca9a9c7","value":"Plants"},"collectedFrom":{"key":"driver______::bee53aa31dc2cbb538c10c2b65fa5824","value":"DOAJ"}},{"alternateIdentifiers":[{"scheme":"doi","value":"10.3390/plants13111462"}],"license":"CC BY","accessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/","openAccessRoute":"gold"},"type":"Article","urls":["https://dx.doi.org/10.3390/plants13111462"],"publicationDate":"2024-05-24","refereed":"peerReviewed","hostedBy":{"key":"doajarticles::674f4ec17737a49b173c1bde2ca9a9c7","value":"Plants"},"collectedFrom":{"key":"openaire____::c2cdfa5866e03cdd07d313cbc8fb8311","value":"Multidisciplinary Digital Publishing Institute"}}],"links":[],"otherTitles":null,"inDiamondJournal":false,"green":true,"isGreen":true,"isInDiamondJournal":false},{"authors":[{"id":null,"fullName":"Bilal Ahmad","name":"Bilal","surname":"Ahmad","rank":1,"pid":null},{"id":null,"fullName":"Ansaar Ahmed","name":"Ansaar","surname":"Ahmed","rank":2,"pid":null},{"id":null,"fullName":"Ahmad Zubair","name":"Ahmad","surname":"Zubair","rank":3,"pid":null},{"id":null,"fullName":"Muhammad Saeed","name":"Muhammad","surname":"Saeed","rank":4,"pid":null},{"id":null,"fullName":"Zia Ullah","name":"Zia","surname":"Ullah","rank":5,"pid":null},{"id":"orcid_______::5f8b0b544a9cba63a992a579fd44bbfd","fullName":"Murad Ali","name":"Murad","surname":"Ali","rank":6,"pid":{"id":{"scheme":"orcid","value":"0000-0003-2312-8843"},"provenance":null}}],"openAccessColor":"gold","publiclyFunded":false,"eoscIfGuidelines":null,"type":"publication","language":{"code":"und","label":"Undetermined"},"countries":null,"subjects":[{"subject":{"scheme":"FOS","value":"0106 biological sciences"},"provenance":null},{"subject":{"scheme":"SDG","value":"2. Zero hunger"},"provenance":null},{"subject":{"scheme":"SDG","value":"15. Life on land"},"provenance":null},{"subject":{"scheme":"FOS","value":"01 natural sciences"},"provenance":null},{"subject":{"scheme":"SDG","value":"6. Clean water"},"provenance":null}],"mainTitle":"Impact of Irrigation on Yield Attributes of Seven Wheat Genotypes","subTitle":null,"descriptions":["<jats:p>Seven wheat genotypes i.e., PR-110, PR-112, PR-115, PR-118, PR-119, PR-120 and Pirsabak-13 were evaluated at: I0: Control, I1: irrigation at seedling stage, I2: irrigation at seedling and booting stages, I3: irrigation at seedling, tillering and booting stages and I4: irrigation at seedling, tillering, booting and grain formation stages. Among the genotypes, PR-115, PR-118 and PR-120 were found to be superior for grain yield and its related attributes under full and deficit water conditions. Irrigation at seedling + tillering + booting stages + grain formation stages (I4) produced statistically higher yield and related traits. It was also observed that in case of water shortage, irrigation at seedling and booting stages reduced the drastic losses in grain yield of wheat. The study suggested that identified promising wheat genotypes can be utilized in future breeding programs to develop drought tolerant varieties.&#x0D; Bangladesh J. Bot. 50(2): 235-243, 2021 (June)</jats:p>"],"publicationDate":"2021-06-18","publisher":"Bangladesh Journals Online (JOL)","embargoEndDate":null,"sources":["Crossref"],"formats":null,"contributors":null,"coverages":null,"bestAccessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/"},"container":{"name":"Bangladesh Journal of Botany","issnPrinted":"0253-5416","issnOnline":"2079-9926","issnLinking":null,"ep":"243","iss":null,"sp":"235","vol":"50","edition":null,"conferencePlace":null,"conferenceDate":null},"documentationUrls":null,"codeRepositoryUrl":null,"programmingLanguage":null,"contactPeople":null,"contactGroups":null,"tools":null,"size":null,"version":null,"geoLocations":null,"id":"doi_dedup___::23cbc1d747660cb2236ecf0af50c7a06","originalIds":["10.3329/bjb.v50i2.54078","50|doiboost____|23cbc1d747660cb2236ecf0af50c7a06","3173561419"],"pids":[{"scheme":"doi","value":"10.3329/bjb.v50i2.54078"}],"dateOfCollection":null,"lastUpdateTimeStamp":null,"indicators":{"citationImpact":{"citationCount":4.0,"influence":2.3201727E-9,"popularity":3.981833E-9,"impulse":4.0,"citationClass":"C5","influenceClass":"C5","impulseClass":"C4","popularityClass":"C4"}},"projects":null,"organizations":[{"legalName":"University of Padua","acronym":"UNIPD","id":"openorgs____::d6ddbed2807becaf5b096013ba158c9b","pids":[{"scheme":"RRID","value":"RRID:SCR_006374"},{"scheme":"fundref","value":"501100019106"},{"scheme":"ROR","value":"https://ror.org/00240q980"},{"scheme":"fund