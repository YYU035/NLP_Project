,"collectedFrom":[{"key":"openaire____::081b82f96300b6a6e3d282bad31cb6e2","value":"Crossref"},{"key":"opendoar____::8b6dd7db9af49e67306feb59a8bdc52c","value":"Europe PubMed Central"}],"instances":[{"pids":[{"scheme":"doi","value":"10.3758/s13421-025-01833-7"}],"license":"Springer Nature TDM","accessRight":{"code":"c_14cb","label":"CLOSED","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/","openAccessRoute":null},"type":"Article","urls":["https://doi.org/10.3758/s13421-025-01833-7"],"publicationDate":"2026-01-09","refereed":"peerReviewed","hostedBy":{"key":"issn___print::55bb9eafabc7c310adb8bb0c336f2c26","value":"Memory & Cognition"},"collectedFrom":{"key":"openaire____::081b82f96300b6a6e3d282bad31cb6e2","value":"Crossref"}},{"pids":[{"scheme":"pmid","value":"41514138"}],"alternateIdentifiers":[{"scheme":"doi","value":"10.3758/s13421-025-01833-7"}],"type":"Article","urls":["https://pubmed.ncbi.nlm.nih.gov/41514138"],"refereed":"nonPeerReviewed","hostedBy":{"key":"issn___print::55bb9eafabc7c310adb8bb0c336f2c26","value":"Memory & Cognition"},"collectedFrom":{"key":"opendoar____::8b6dd7db9af49e67306feb59a8bdc52c","value":"Europe PubMed Central"}}],"links":[],"otherTitles":null,"inDiamondJournal":false,"green":false,"isGreen":false,"isInDiamondJournal":false},{"authors":[{"id":"orcid_______::86a60ed0111315384ddbd061bb3b4b19","fullName":"Abigail Doku","name":"Abigail","surname":"Doku","rank":1,"pid":{"id":{"scheme":"orcid","value":"0000-0001-7585-7330"},"provenance":null}},{"id":null,"fullName":"Gavin T. Roupe","name":"Gavin T.","surname":"Roupe","rank":2,"pid":null},{"id":null,"fullName":"Emma Rankine","name":"Emma","surname":"Rankine","rank":3,"pid":null},{"id":null,"fullName":"Isabel Flemming","name":"Isabel","surname":"Flemming","rank":4,"pid":null},{"id":null,"fullName":"Jacob A. Provost","name":"Jacob A.","surname":"Provost","rank":5,"pid":null},{"id":null,"fullName":"Micah Zuhl","name":"Micah","surname":"Zuhl","rank":6,"pid":{"id":{"scheme":"orcid_pending","value":"0000-0001-7922-7598"},"provenance":null}},{"id":null,"fullName":"Hajime Otani","name":"Hajime","surname":"Otani","rank":7,"pid":null}],"openAccessColor":null,"publiclyFunded":false,"eoscIfGuidelines":null,"type":"publication","language":{"code":"eng","label":"English"},"countries":null,"subjects":[{"subject":{"scheme":"FOS","value":"05 social sciences"},"provenance":null},{"subject":{"scheme":"FOS","value":"0501 psychology and cognitive sciences"},"provenance":null}],"mainTitle":"Verbal Memory is Higher After Aerobic Exercise When Compared to Muscle Stretching","subTitle":null,"descriptions":["<jats:p>Acute exercise is linked to memory improvement. Several mediators may influence the effect of exercise such as the type of exercise (aerobic exercise, muscle stretching). Purpose: The primary aim was to analyze memory outcomes after a 20-min bout of aerobic exercise or muscle stretching. Methods: 42 healthy participants ages 18-35 were randomized to perform 20 min of either moderate-intensity aerobic exercise (AE) on a treadmill or muscle stretching exercise (SE). After exercise, memory was assessed using the Rey Auditory Verbal Learning Test (RAVLT). The relationship between exercise heart rate and memory outcomes were evaluated within each group. Results: Immediate learning as well as delayed recall was higher after AE compared to SE. Heart rate during exercise correlated with immediate learning in the AE group only. Conclusion: Acute exercise that elicits a heart rate response may be important for improving memory.</jats:p>"],"publicationDate":"2025-01-07","publisher":"SAGE Publications","embargoEndDate":null,"sources":["Crossref"],"formats":null,"contributors":null,"coverages":null,"bestAccessRight":{"code":"c_14cb","label":"CLOSED","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/"},"container":{"name":"American Journal of Lifestyle Medicine","issnPrinted":"1559-8276","issnOnline":"1559-8284","issnLinking":null,"ep":null,"iss":null,"sp":null,"vol":null,"edition":null,"conferencePlace":null,"conferenceDate":null},"documentationUrls":null,"codeRepositoryUrl":null,"programmingLanguage":null,"contactPeople":null,"contactGroups":null,"tools":null,"size":null,"version":null,"geoLocations":null,"id":"doi_dedup___::5657d6f756177f911e9ee31f5d93c63a","originalIds":["10.1177/15598276241313141","50|doiboost____|5657d6f756177f911e9ee31f5d93c63a","od_______267::2c3471b0ddab2481505bcb4a3bca3776","39790939","PMC11707759"],"pids":[{"scheme":"doi","value":"10.1177/15598276241313141"},{"scheme":"pmid","value":"39790939"},{"scheme":"pmc","value":"PMC11707759"}],"dateOfCollection":null,"lastUpdateTimeStamp":null,"indicators":{"citationImpact":{"citationCount":1.0,"influence":2.1987907E-9,"popularity":2.8893017E-9,"impulse":1.0,"citationClass":"C5","influenceClass":"C5","impulseClass":"C5","popularityClass":"C5"}},"projects":null,"organizations":[{"legalName":"Central Michigan University","acronym":"CMU","id":"openorgs____::05c180788dc3adf3b01e041cbd14918c","pids":[{"scheme":"GRID","value":"grid.253856.f"},{"scheme":"ROR","value":"https://ror.org/02xawj266"},{"scheme":"FundRef","value":"100008576"},{"scheme":"mag_id","value":"1629065"},{"scheme":"wikidata","value":"Q250205"},{"scheme":"Wikidata","value":"Q250205"},{"scheme":"fundref","value":"100008576"},{"scheme":"OrgRef","value":"608699"},{"scheme":"ISNI","value":"0000000121134110"}],"countries":[{"code":"US","label":"United States"}],"websiteurl":"https://www.cmich.edu/Pages/default.aspx"}],"communities":null,"collectedFrom":[{"key":"openaire____::081b82f96300b6a6e3d282bad31cb6e2","value":"Crossref"},{"key":"opendoar____::8b6dd7db9af49e67306feb59a8bdc52c","value":"Europe PubMed Central"}],"instances":[{"pids":[{"scheme":"doi","value":"10.1177/15598276241313141"}],"license":"https://journals.sagepub.com/page/policies/text-and-data-mining-license","accessRight":{"code":"c_14cb","label":"CLOSED","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/","openAccessRoute":null},"type":"Article","urls":["https://doi.org/10.1177/15598276241313141"],"publicationDate":"2025-01-07","refereed":"peerReviewed","hostedBy":{"key":"issn___print::013a7a9876dde653be7ecd16b955a768","value":"American Journal of Lifestyle Medicine"},"collectedFrom":{"key":"openaire____::081b82f96300b6a6e3d282bad31cb6e2","value":"Crossref"}},{"pids":[{"scheme":"pmid","value":"39790939"},{"scheme":"pmc","value":"PMC11707759"}],"alternateIdentifiers":[{"scheme":"doi","value":"10.1177/15598276241313141"}],"type":"Article","urls":["https://pubmed.ncbi.nlm.nih.gov/39790939"],"refereed":"nonPeerReviewed","hostedBy":{"key":"issn___print::013a7a9876dde653be7ecd16b955a768","value":"American Journal of Lifestyle Medicine"},"collectedFrom":{"key":"opendoar____::8b6dd7db9af49e67306feb59a8bdc52c","value":"Europe PubMed Central"}}],"links":[],"otherTitles":null,"inDiamondJournal":false,"green":false,"isGreen":false,"isInDiamondJournal":false},{"authors":[{"id":"orcid_______::4f0e1a7fe2c7690ba1e2d23116aa7c86","fullName":"Noriteru, Morita","name":"Noriteru","surname":"Morita","rank":1,"pid":{"id":{"scheme":"orcid","value":"0000-0003-3427-7174"},"provenance":null}},{"id":"orcid_______::78ff670b5ff5f76e52d5f162de0e19dd","fullName":"Toru, Ishihara","name":"Toru","surname":"Ishihara","rank":2,"pid":{"id":{"scheme":"orcid","value":"0000-0003-3544-6822"},"provenance":null}},{"id":"orcid_______::d6ae173c33ec1b5c2cd8385be01ee723","fullName":"Charles H, Hillman","name":"Charles H","surname":"Hillman","rank":3,"pid":{"id":{"scheme":"orcid","value":"0000-0002-3722-5612"},"provenance":null}},{"id":null,"fullName":"Keita, Kamijo","name":"Keita","surname":"Kamijo","rank":4,"pid":null}],"openAccessColor":"hybrid","publiclyFunded":false,"eoscIfGuidelines":null,"type":"publication","language":{"code":"eng","label":"English"},"countries":null,"subjects":[{"subject":{"scheme":"keyword","value":"Male"},"provenance":null},{"subject":{"scheme":"keyword","value":"Adult"},"provenance":null},{"subject":{"scheme":"keyword","value":"Young Adult"},"provenance":null},{"subject":{"scheme":"keyword","value":"Memory, Long-Term"},"provenance":null},{"subject":{"scheme":"keyword","value":"Memory, Episodic"},"provenance":null},{"subject":{"scheme":"FOS","value":"05 social sciences"},"provenance":null},{"subject":{"scheme":"keyword","value":"Mental Recall"},"provenance":null},{"subject":{"scheme":"keyword","value":"Humans"},"provenance":null},{"subject":{"scheme":"FOS","value":"0501 psychology and cognitive sciences"},"provenance":null},{"subject":{"scheme":"keyword","value":"Female"},"provenance":null},{"subject":{"scheme":"keyword","value":"Exercise"},"provenance":null}],"mainTitle":"Movement boosts memory: Investigating the effects of acute exercise on episodic long-term memory","subTitle":null,"descriptions":["Long-term memory is important for cognitive health across the lifespan. Previously research has indicated that a bout of exercise improves memory retention for approximately one week; however, its prolonged effects are unknown. This study investigated the effects of acute moderate-intensity exercise on long-term memory for 11 months. Participants engaged in the exercise intervention and seated rest control condition, followed by a word encoding memory task. Word retention in the exercise intervention was better than in the control condition at 6- and 8-weeks post-encoding. These findings suggest that exercise before encoding enhances long-term episodic memory recall for at least eight weeks."],"publicationDate":"2025-03-01","publisher":"Elsevier BV","embargoEndDate":null,"sources":["Crossref"],"formats":null,"contributors":null,"coverages":null,"bestAccessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/"},"container":{"name":"Journal of Science and Medicine in Sport","issnPrinted":"1440-2440","issnOnline":null,"issnLinking":null,"ep":"259"