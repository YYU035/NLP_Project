":"http://vocabularies.coar-repositories.org/documentation/access_rights/","openAccessRoute":"gold"},"type":"Article","urls":["https://doaj.org/article/e7d0b8bb260b480a85c78bf371d69973"],"publicationDate":"2024-04-01","refereed":"nonPeerReviewed","hostedBy":{"key":"doajarticles::fd2b87fcc70bef845c7cd8850a742c8b","value":"Frontiers in Cognition"},"collectedFrom":{"key":"driver______::bee53aa31dc2cbb538c10c2b65fa5824","value":"DOAJ"}},{"license":"CC BY","accessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/","openAccessRoute":null},"type":"Article","urls":["https://eprints.leedsbeckett.ac.uk/id/eprint/11487/"],"publicationDate":"2024-04-04","refereed":"nonPeerReviewed","hostedBy":{"key":"opendoar____::4e6cd95227cb0c280e99a195be5f6615","value":"Leeds Beckett University Repository"},"collectedFrom":{"key":"opendoar____::4e6cd95227cb0c280e99a195be5f6615","value":"Leeds Beckett University Repository"}}],"links":[],"otherTitles":null,"inDiamondJournal":false,"green":false,"isGreen":false,"isInDiamondJournal":false},{"authors":[{"id":null,"fullName":"Schmitter, M.","name":"M.","surname":"Schmitter","rank":1,"pid":null},{"id":null,"fullName":"Vrijsen, J.N.","name":"J. N.","surname":"Vrijsen","rank":2,"pid":null}],"openAccessColor":null,"publiclyFunded":false,"eoscIfGuidelines":null,"type":"publication","language":{"code":"eng","label":"English"},"countries":[{"code":"NL","label":"Netherlands","provenance":null}],"subjects":[{"subject":{"scheme":"keyword","value":"Experimental Psychopathology and Treatment"},"provenance":null},{"subject":{"scheme":"keyword","value":"Cognitive Affective Neuroscience"},"provenance":null},{"subject":{"scheme":"keyword","value":"Psychiatry - Radboud University Medical Center - DCMN"},"provenance":null},{"subject":{"scheme":"keyword","value":"Memory"},"provenance":null},{"subject":{"scheme":"FOS","value":"05 social sciences"},"provenance":null},{"subject":{"scheme":"keyword","value":"Current Topics in Behavioral Neurosciences"},"provenance":null},{"subject":{"scheme":"keyword","value":"Humans"},"provenance":null},{"subject":{"scheme":"FOS","value":"0501 psychology and cognitive sciences"},"provenance":null},{"subject":{"scheme":"keyword","value":"Exercise"},"provenance":null}],"mainTitle":"Exercise and Memory","subTitle":null,"descriptions":["Our memory is crucial to our daily functioning, our identity, and how we interact with the world around us. Maintaining memory functioning is therefore important in many ways. Exercise positively affects our memory. Even a single exercise session can directly boost different memory types, including working, procedural, and episodic memory. Due to these benefits, exercise has great potential as an intervention in different settings, such as schools or rehabilitation centers, and as a prevention strategy. In this chapter, we first give an overview of what memory is and why it is so relevant to our mental health. Next, we briefly discuss how, for whom, and under which circumstances exercise improves memory functioning. Then, we will summarize the literature of experimental studies investigating the direct effect of exercise on different memory types, while acknowledging current limitations and potential future directions. Finally, we briefly highlight the potential of exercise as intervention to preserve and improve memory."],"publicationDate":"2024-01-01","publisher":"Springer International Publishing","embargoEndDate":null,"sources":["Crossref","Current Topics in Behavioral Neurosciences ISBN: 9783031689765","Cisler, J.M.; Crombie, K.M.; Adams, T.G. (ed.), Exercise and mental health, pp. 141-154"],"formats":null,"contributors":["Cisler, J.M.","Crombie, K.M.","Adams, T.G."],"coverages":null,"bestAccessRight":{"code":"c_16ec","label":"RESTRICTED","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/"},"container":null,"documentationUrls":null,"codeRepositoryUrl":null,"programmingLanguage":null,"contactPeople":null,"contactGroups":null,"tools":null,"size":null,"version":null,"geoLocations":null,"id":"doi_dedup___::1b38ec5f71c4a2b75239dc0aa04de54c","originalIds":["10.1007/7854_2024_495","50|doiboost____|1b38ec5f71c4a2b75239dc0aa04de54c","39083174","oai:repository.ubn.ru.nl:2066/311709","50|od______1236::ff76694901db982b73250ede21811fdc"],"pids":[{"scheme":"doi","value":"10.1007/7854_2024_495"},{"scheme":"pmid","value":"39083174"},{"scheme":"handle","value":"2066/311709"}],"dateOfCollection":null,"lastUpdateTimeStamp":null,"indicators":{"citationImpact":{"citationCount":1.0,"influence":2.1855013E-9,"popularity":2.577189E-9,"impulse":1.0,"citationClass":"C5","influenceClass":"C5","impulseClass":"C5","popularityClass":"C5"}},"projects":null,"organizations":[{"legalName":"Radboud University Nijmegen","acronym":"Radboud University Nijmegen","id":"openorgs____::a3af79fec4d09764e56cd6d4df1d976a","pids":[{"scheme":"OrgReg","value":"NL0009"},{"scheme":"Wikidata","value":"Q632004"},{"scheme":"wikidata","value":"Q2525766"},{"scheme":"RRID","value":"RRID:nlx_79396"},{"scheme":"fundref","value":"501100008459"},{"scheme":"FundRef","value":"501100001832"},{"scheme":"FundRef","value":"501100008459"},{"scheme":"Wikidata","value":"Q2525766"},{"scheme":"OrgRef","value":"956504"},{"scheme":"wikidata","value":"Q632004"},{"scheme":"GRID","value":"grid.5590.9"},{"scheme":"ROR","value":"https://ror.org/016xsfp80"},{"scheme":"RRID","value":"RRID:SCR_011489"},{"scheme":"ISNI","value":"0000000122931605"},{"scheme":"mag_id","value":"145872427"},{"scheme":"fundref","value":"501100001832"}],"countries":[{"code":"NL","label":"Netherlands"}],"websiteurl":"http://www.ru.nl/english/"},{"legalName":"Radboud University Nijmegen Medical Centre","acronym":"RUNMC","id":"openorgs____::6c50ead5f8f9cac29c4c3066df9fba45","pids":[{"scheme":"OrgReg","value":"NL2004"},{"scheme":"FundRef","value":"501100003297"},{"scheme":"OrgRef","value":"10637965"},{"scheme":"mag_id","value":"2802934949"},{"scheme":"GRID","value":"grid.10417.33"},{"scheme":"Wikidata","value":"Q2594321"},{"scheme":"fundref","value":"501100006209"},{"scheme":"ROR","value":"https://ror.org/05wg1m734"},{"scheme":"wikidata","value":"Q2594321"},{"scheme":"FundRef","value":"501100006209"},{"scheme":"fundref","value":"501100003297"},{"scheme":"ISNI","value":"0000000404449382"}],"countries":[{"code":"NL","label":"Netherlands"}],"websiteurl":"https://www.radboudumc.nl/EN/Pages/default.aspx"}],"communities":[{"code":"netherlands","label":"Netherlands Research Portal","provenance":null}],"collectedFrom":[{"key":"opendoar____::7bccfde7714a1ebadf06c5f4cea752c1","value":"Radboud Repository"},{"key":"openaire____::081b82f96300b6a6e3d282bad31cb6e2","value":"Crossref"},{"key":"opendoar____::8b6dd7db9af49e67306feb59a8bdc52c","value":"Europe PubMed Central"}],"instances":[{"pids":[{"scheme":"doi","value":"10.1007/7854_2024_495"}],"license":"Springer Nature TDM","accessRight":{"code":"c_14cb","label":"CLOSED","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/","openAccessRoute":null},"type":"Part of book or chapter of book","urls":["https://doi.org/10.1007/7854_2024_495"],"publicationDate":"2024-01-01","refereed":"peerReviewed","hostedBy":{"key":"openaire____::55045bd2a65019fd8e6741a755395c8c","value":"Unknown Repository"},"collectedFrom":{"key":"openaire____::081b82f96300b6a6e3d282bad31cb6e2","value":"Crossref"}},{"pids":[{"scheme":"pmid","value":"39083174"}],"alternateIdentifiers":[{"scheme":"doi","value":"10.1007/7854_2024_495"}],"type":"Article","urls":["https://pubmed.ncbi.nlm.nih.gov/39083174"],"publicationDate":"2024-11-05","refereed":"nonPeerReviewed","hostedBy":{"key":"openaire____::55045bd2a65019fd8e6741a755395c8c","value":"Unknown Repository"},"collectedFrom":{"key":"opendoar____::8b6dd7db9af49e67306feb59a8bdc52c","value":"Europe PubMed Central"}},{"pids":[{"scheme":"handle","value":"2066/311709"}],"alternateIdentifiers":[{"scheme":"doi","value":"10.1007/7854_2024_495"}],"accessRight":{"code":"c_16ec","label":"RESTRICTED","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/","openAccessRoute":null},"type":"Part of book or chapter of book","urls":["https://hdl.handle.net/2066/311709"],"publicationDate":"2024-01-01","refereed":"nonPeerReviewed","hostedBy":{"key":"opendoar____::7bccfde7714a1ebadf06c5f4cea752c1","value":"Radboud Repository"},"collectedFrom":{"key":"opendoar____::7bccfde7714a1ebadf06c5f4cea752c1","value":"Radboud Repository"}}],"links":[],"otherTitles":null,"inDiamondJournal":false,"green":false,"isGreen":false,"isInDiamondJournal":false},{"authors":[{"id":null,"fullName":"Paul D Loprinzi","name":"Paul D","surname":"Loprinzi","rank":1,"pid":{"id":{"scheme":"orcid_pending","value":"0000-0001-7711-4741"},"provenance":null}},{"id":null,"fullName":"Jeremy P Loenneke","name":"Jeremy P","surname":"Loenneke","rank":2,"pid":null},{"id":null,"fullName":"Benjamin C Storm","name":"Benjamin C","surname":"Storm","rank":3,"pid":null}],"openAccessColor":null,"publiclyFunded":false,"eoscIfGuidelines":null,"type":"publication","language":{"code":"eng","label":"English"},"countries":null,"subjects":[{"subject":{"scheme":"FOS","value":"03 medical and health sciences"},"provenance":null},{"subject":{"scheme":"keyword","value":"Young Adult"},"provenance":null},{"subject":{"scheme":"FOS","value":"0302 clinical medicine"},"provenance":null},{"subject":{"scheme":"keyword","value":"Cognition"},"provenance":null},{"subject":{"scheme":"keyword","value":"Memory, Episodic"},"provenance":null},{"subject":{"scheme":"keyword","value":"Humans"},"provenance":null},{"subject":{"scheme":"keyword","value":"Learning"},"provenance":null},{"subject":{"scheme":"keyword","value":"Resistance Training"},"provenance":null},{"subject":{"scheme":"keyword","value":"Exercise"},"provenance":null}],"mainTitle":"Effects of acute aerobic and resistance exercise on episodic memory function","subTitle":null,"descriptions":["<jats:p>Accumulating research provides suggestive evidence that acute aerobic exercise may, potentially, enhance episodic memory function post-exercise. Limited research has evaluated whether acute resistance exercise may also enhance episodic memory post-exercise. Furthermore, whether these two exercise modalities have a differential effect on post-exercise episodic memory is relatively unknown. To address these research questions, three experimental studies were conducted ( N = 104) among young adults (18–25 years). The experiments implemented acute bouts of aerobic or resistance exercise for 15 min. Episodic memory was comprehensively evaluated post-exercise with a list-learning paradigm and a computerised assessment of what-where-when aspects of episodic memory. Various manipulations (e.g., between vs. within-group) of the study design were implemented across the experiments. Across these three experiments, we failed to find consistent evidence of either type of acute exercise affecting episodic memory performance post-exercise.</jats:p>"],"publicationDate":"2021-02-23","publisher":"SAGE Publications","embargoEndDate":null,"sources":["Crossref"],"formats":null,"contributors":null,"coverages":null,"bestAccessRight":{"code":"c_14cb","label":"CLOSED","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/"},"container":{"name":"Quarterly Journal of Experimental Psychology","issnPrinted":"1747-0218","issnOnline":"1747-0226","issnLinking":null,"ep":"1283","iss":null,"sp":"1264","vol":"74","edition":null,"conferencePlace":null,"conferenceDate":null},"documentationUrls":null,"codeRepositoryUrl":null,"programmingLanguage":null,"contactPeople":null,"contactGroups":null,"tools":null,"size":null,"version":null,"geoLocations":null,"id":"doi_dedup___::55b18fefb6a29b98a7bfb220b863db82","originalIds":["10.1177/1747021821994576","50|doiboost____|55b18fefb6a29b98a7bfb220b863db82","33535923","3126593853"],"pids":[{"scheme":"doi","value":"10.1177/1747021821994576"},{"scheme":"pmid","value":"33535923"}],"dateOfCollection":null,"lastUpdateTimeStamp":null,"indicators":{"citationImpact":{"citationCount":13.0,"influence":2.4230926E-9,"popularity":9.75726E-9,"impulse":9.0,"citationClass":"C4","influenceClass":"C5","impulseClass":"C4","popularityClass":"C4"}},"projects":null,"organizations":[{"legalName":"University of California, Santa Cruz","acronym":"UCSC","id":"openorgs____::e4be060d29cd98ee65d421677ef67c00","pids":[{"scheme":"FundRef","value":"100006440"},{"scheme":"Wikidata","value":"Q1047293"},{"scheme":"FundRef","value":"100006358"},{"scheme":"GRID","value":"grid.205975.c"},{"scheme":"ROR","value":"https://ror.org/03s65by71"},{"scheme":"fundref","value":"100006358"},{"scheme":"wikidata","value":"Q7419417"},{"scheme":"wikidata","value":"Q1047293"},{"scheme":"ISNI","value":"0000000107406917"},{"scheme":"RRID","value":"RRID:SCR_011624"},{"scheme":"RRID","value":"RRID:nlx_63906"},{"scheme":"ROR","value":"https://ror.org/03f6h9044"},{"scheme":"mag_id","value":"185103710"},{"scheme":"Wikidata","value":"Q7419417"},{"scheme":"OrgRef","value":"31923"},{"scheme":"fundref","value":"100006440"}],"countries":[{"code":"US","label":"United States"}],"websiteurl":"http://www.ucsc.edu/"},{"legalName":"University of Mississippi","acronym":"University of Mississippi","id":"openorgs____::079ba973bec14d5d19423a79e16ee0bf","pids":[{"scheme":"wikidata","value":"Q1138384"},{"scheme":"fundref","value":"100006804"},{"scheme":"FundRef","value":"100006940"},{"scheme":"GRID","value":"grid.251313.7"},{"scheme":"fundref","value":"100006940"},{"scheme":"FundRef","value":"100006804"},{"scheme":"Wikidata","value":"Q1138384"},{"scheme":"ISNI","value":"0000000121692489"},{"scheme":"mag_id","value":"368840534"},{"scheme":"OrgRef","value":"65542"},{"scheme":"ROR","value":"https://ror.org/02teq1165"}],"countries":[{"code":"US","label":"United States"}],"websiteurl":"http://www.olemiss.edu/"}],"communities":[{"code":"neuroscience","label":"Neuroscience","provenance":null}],"collectedFrom":[{"key":"openaire____::081b82f96300b6a6e3d282bad31cb6e2","value":"Crossref"},{"key":"openaire____::5f532a3fc4f1ea403f37070f59a7a53a","value":"Microsoft Academic Graph"},{"key":"opendoar____::8b6dd7db9af49e67306feb59a8bdc52c","value":"Europe PubMed Central"}],"instances":[{"pids":[{"scheme":"doi","value":"10.1177/1747021821994576"}],"license":"https://journals.sagepub.com/page/policies/text-and-data-mining-license","accessRight":{"code":"c_14cb","label":"CLOSED","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/","openAccessRoute":null},"type":"Article","urls":["https://doi.org/10.1177/1747021821994576"],"publicationDate":"2021-02-23","refereed":"peerReviewed","hostedBy":{"key":"issn___print::7534bba1cc45405e84aa4ef0e27038a5","value":"Quarterly Journal of Experimental Psychology"},"collectedFrom":{"key":"openaire____::081b82f96300b6a6e3d282bad31cb6e2","value":"Crossref"}},{"pids":[{"scheme":"pmid","value":"33535923"}],"alternateIdentifiers":[{"scheme":"doi","value":"10.1177/1747021821994576"}],"type":"Article","urls":["https://pubmed.ncbi.nlm.nih.gov/33535923"],"publicationDate":"2021-08-18","refereed":"nonPeerReviewed","hostedBy":{"key":"issn___print::7534bba1cc45405e84aa4ef0e27038a5","value":"Quarterly Journal of Experimental Psychology"},"collectedFrom":{"key":"opendoar____::8b6dd7db9af49e67306feb59a8bdc52c","value":"Europe PubMed Central"}},{"alternateIdentifiers":[{"scheme":"doi","value":"10.1177/1747021821994576"},{"scheme":"mag_id","value":"3126593853"}],"type":"Article","urls":["https://dx.doi.org/10.1177/1747021821994576"],"refereed":"nonPeerReviewed","hostedBy":{"key":"openaire____::55045bd2a65019fd8e6741a755395c8c","value":"Unknown Repository"},"collectedFrom":{"key":"openaire____::5f532a3fc4f1ea403f37070f59a7a53a","value":"Microsoft Academic Graph"}},{"alternateIdentifiers":[{"scheme":"mag_id","value":"3126593853"},{"scheme":"doi","value":"10.1177/1747021821994576"}],"type":"Article","urls":["https://dx.doi.org/10.1177/1747021821994576"],"refereed":"nonPeerReviewed","hostedBy":{"key":"openaire____::55045bd2a65019fd8e6741a755395c8c","value":"Unknown Repository"},"collectedFrom":{"key":"openaire____::5f532a3fc4f1ea403f37070f59a7a53a","value":"Microsoft Academic Graph"}}],"links":[],"otherTitles":null,"inDiamondJournal":false,"green":false,"isGreen":false,"isInDiamondJournal":false},{"authors":[{"id":null,"fullName":"Paul D. Loprinzi","name":"Paul D.","surname":"Loprinzi","rank":1,"pid":null},{"id":null,"fullName":"Sierra Day","name":null,"surname":null,"rank":2,"pid":null},{"id":null,"fullName":"Rebecca Hendry","name":null,"surname":null,"rank":3,"pid":null},{"id":"orcid_______::11811f20436a3bbad2d5d7833ebfeead","fullName":"Sara Hoffman","name":null,"surname":null,"rank":4,"pid":{"id":{"scheme":"orcid","value":"0000-0002-2753-7989"},"provenance":null}},{"id":null,"fullName":"Alexis Love","name":null,"surname":null,"rank":5,"pid":null},{"id":null,"fullName":"Sarah Marable","name":null,"surname":null,"rank":6,"pid":null},{"id":null,"fullName":"Elizabeth McKee","name":null,"surname":null,"rank":7,"pid":null},{"id":null,"fullName":"Sydney Stec","name":null,"surname":null,"rank":8,"pid":null},{"id":null,"fullName":"Hanna Watson","name":null,"surname":null,"rank":9,"pid":null},{"id":null,"fullName":"Brittney Gilliland","name":null,"surname":null,"rank":10,"pid":null}],"openAccessColor":null,"publiclyFunded":false,"eoscIfGuidelines":null,"type":"publication","language":{"code":"und","label":"Undetermined"},"countries":null,"subjects":[{"subject":{"scheme":"keyword","value":"cognition"},"provenance":null},{"subject":{"scheme":"keyword","value":"physiscal activity"},"provenance":null},{"subject":{"scheme":"FOS","value":"03 medical and health sciences"},"provenance":null},{"subject":{"scheme":"FOS","value":"0302 clinical medicine"},"provenance":null},{"subject":{"scheme":"keyword","value":"exercise"},"provenance":null},{"subject":{"scheme":"FOS","value":"05 social sciences"},"provenance":null},{"subject":{"scheme":"keyword","value":"150"},"provenance":null},{"subject":{"scheme":"keyword","value":"Psychology"},"provenance":null},{"subject":{"scheme":"FOS","value":"0501 psychology and cognitive sciences"},"provenance":null},{"subject":{"scheme":"keyword","value":"Research Reports"},"provenance":null},{"subject":{"scheme":"keyword","value":"cognitive function"},"provenance":null},{"subject":{"scheme":"keyword","value":"long-term potentiation"},"provenance":null},{"subject":{"scheme":"keyword","value":"BF1-990"},"provenance":null}],"mainTitle":"The effects of acute exercise on short- and long-term memory: Considerations for the timing of exercise and phases of memory","subTitle":null,"descriptions":["<jats:p>The specific questions addressed from this research include: (1) Does high-intensity acute exercise improve memory?, (2) If so, do the mechanisms occur via encoding, consolidation, or retrieval? and (3) If acute exercise occurs in multiple phases of memory (e.g., before encoding and during consolidation), does this have an additive effect on memory? Three experimental, within-subject, counterbalanced studies were conducted among young adults. High-intensity exercise involved a 20-minutes bout of exercise at 75% of heart rate reserve. Memory was evaluated from a word-list task, including multiple evaluations out to 24-hours post-encoding. The timing of the exercise and memory assessments were carefully positioned to evaluate whether any improvements in memory were driven by mechanisms related to encoding, consolidation, and/or retrieval. We demonstrated that high-intensity acute exercise enhanced memory. This effect was robust (repeatable) and occurred through encoding, consolidation and retrieval-based mechanisms. Further, incorporating acute exercise into multiple phases of memory additively enhanced memory function.</jats:p>"],"publicationDate":"2021-02-26","publisher":"Leibniz Institute for Psychology (ZPID)","embargoEndDate":"20