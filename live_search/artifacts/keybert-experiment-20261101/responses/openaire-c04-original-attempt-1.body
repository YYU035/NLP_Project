":"Q961982"},{"scheme":"OrgRef","value":"1271733"},{"scheme":"Wikidata","value":"Q961982"},{"scheme":"ISNI","value":"000000040487459X"},{"scheme":"ROR","value":"https://ror.org/029ycp228"},{"scheme":"GRID","value":"grid.7119.e"},{"scheme":"mag_id","value":"16465266"}],"countries":[{"code":"CL","label":"Chile"}],"websiteurl":"https://www.uach.cl/"}],"communities":[{"code":"uarctic","label":"UArctic","provenance":null},{"code":"enermaps","label":"Energy Research","provenance":null}],"collectedFrom":[{"key":"openaire____::081b82f96300b6a6e3d282bad31cb6e2","value":"Crossref"},{"key":"opendoar____::8b6dd7db9af49e67306feb59a8bdc52c","value":"Europe PubMed Central"}],"instances":[{"pids":[{"scheme":"doi","value":"10.1016/j.scitotenv.2024.174006"}],"license":"Elsevier TDM","accessRight":{"code":"c_14cb","label":"CLOSED","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/","openAccessRoute":null},"type":"Article","urls":["https://doi.org/10.1016/j.scitotenv.2024.174006"],"publicationDate":"2024-10-01","refereed":"peerReviewed","hostedBy":{"key":"issn___print::00f0daec9ef6ecfa16d5915fba4dc271","value":"The Science of The Total Environment"},"collectedFrom":{"key":"openaire____::081b82f96300b6a6e3d282bad31cb6e2","value":"Crossref"}},{"pids":[{"scheme":"pmid","value":"38889822"}],"alternateIdentifiers":[{"scheme":"doi","value":"10.1016/j.scitotenv.2024.174006"}],"type":"Article","urls":["https://pubmed.ncbi.nlm.nih.gov/38889822"],"publicationDate":"2024-07-06","refereed":"nonPeerReviewed","hostedBy":{"key":"openaire____::55045bd2a65019fd8e6741a755395c8c","value":"Unknown Repository"},"collectedFrom":{"key":"opendoar____::8b6dd7db9af49e67306feb59a8bdc52c","value":"Europe PubMed Central"}}],"links":[],"otherTitles":null,"inDiamondJournal":false,"green":false,"isGreen":false,"isInDiamondJournal":false},{"authors":[{"id":"orcid_______::4bd521e3f11519a4e1242d8aa34fd313","fullName":"Junri Zhao","name":"Junri","surname":"Zhao","rank":1,"pid":{"id":{"scheme":"orcid","value":"0000-0001-5464-8660"},"provenance":null}},{"id":"orcid_______::55b792fa292515914919ab1cc36f7dba","fullName":"Yan Zhang","name":"Yan","surname":"Zhang","rank":2,"pid":{"id":{"scheme":"orcid","value":"0000-0003-3087-326x"},"provenance":null}},{"id":null,"fullName":"Shujun Bie","name":"Shujun","surname":"Bie","rank":3,"pid":null},{"id":null,"fullName":"Kelsey R. Bilsback","name":"Kelsey R.","surname":"Bilsback","rank":4,"pid":null},{"id":"orcid_______::9d040fb472d2c818f2c83d46dfee2c43","fullName":"Jeffrey R. Pierce","name":"Jeffrey R.","surname":"Pierce","rank":5,"pid":{"id":{"scheme":"orcid","value":"0000-0002-4241-838x"},"provenance":null}},{"id":null,"fullName":"Ying Chen","name":"Ying","surname":"Chen","rank":6,"pid":null}],"openAccessColor":"gold","publiclyFunded":false,"eoscIfGuidelines":null,"type":"publication","language":{"code":"eng","label":"English"},"countries":[{"code":"FR","label":"France","provenance":null}],"subjects":[{"subject":{"scheme":"keyword","value":"Environmental impact"},"provenance":null},{"subject":{"scheme":"keyword","value":"Environmental sciences"},"provenance":null},{"subject":{"scheme":"SDG","value":"13. Climate action"},"provenance":null},{"subject":{"scheme":"keyword","value":"Meteorology. Climatology"},"provenance":null},{"subject":{"scheme":"keyword","value":"GE1-350"},"provenance":null},{"subject":{"scheme":"SDG","value":"14. Life underwater"},"provenance":null},{"subject":{"scheme":"keyword","value":"QC851-999"},"provenance":null},{"subject":{"scheme":"SDG","value":"15. Life on land"},"provenance":null},{"subject":{"scheme":"FOS","value":"01 natural sciences"},"provenance":null},{"subject":{"scheme":"FOS","value":"0105 earth and related environmental sciences"},"provenance":null},{"subject":{"scheme":"keyword","value":"Projection and prediction"},"provenance":null}],"mainTitle":"Changes in global DMS production driven by increased CO2 levels and its impact on radiative forcing","subTitle":null,"descriptions":["<jats:title>Abstract</jats:title><jats:p>Our study highlights the importance of understanding the future changes in dimethyl-sulfide (DMS), the largest natural sulfur source, in the context of ocean acidification driven by elevated CO<jats:sub>2</jats:sub> levels. We found a strong negative correlation (<jats:italic>R</jats:italic><jats:sup>2</jats:sup> = 0.89) between the partial pressure of carbon dioxide (pCO<jats:sub>2</jats:sub>) and sea-surface DMS concentrations based on global observational datasets, not adequately captured by the Coupled Model Intercomparison Project Phase 6 (CMIP6) Earth System Models (ESMs). Using this relationship, we refined projections of future sea-surface DMS concentrations in CMIP6 ESMs. Our study reveals a decrease in global sea-surface DMS concentrations and the associated aerosol radiative forcing compared to ESMs’ results. These reductions represent ~9.5% and 11.1% of the radiative forcings resulting from aerosol radiation and cloud interactions in 2100 reported by the Intergovernmental Panel on Climate Change Sixth Assessment Report. Thus, future climate projections should account for the climate implications of changes in DMS production due to ocean acidification.</jats:p>"],"publicationDate":"2024-01-12","publisher":"Springer Science and Business Media LLC","embargoEndDate":null,"sources":["Crossref","npj Climate and Atmospheric Science, Vol 7, Iss 1, Pp 1-8 (2024)","Npj Climate And Atmospheric Science (2397-3722) (Nature Portfolio), 2024-01 , Vol. 7 , N. 1 , P. 18 (8p.)"],"formats":["application/pdf"],"contributors":null,"coverages":null,"bestAccessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/"},"container":{"name":"npj Climate and Atmospheric Science","issnPrinted":null,"issnOnline":"2397-3722","issnLinking":null,"ep":null,"iss":null,"sp":null,"vol":"7","edition":null,"conferencePlace":null,"conferenceDate":null},"documentationUrls":null,"codeRepositoryUrl":null,"programmingLanguage":null,"contactPeople":null,"contactGroups":null,"tools":null,"size":null,"version":null,"geoLocations":null,"id":"doi_dedup___::1cd796c4889d5f02210a11b1d0e132ef","originalIds":["563","10.1038/s41612-024-00563-y","50|doiboost____|1cd796c4889d5f02210a11b1d0e132ef","50|doajarticles::564fe2dae7723a141c18d2ee1a187d8f","oai:doaj.org/article:983d67c4bdd7450ea625d15e730bfdce","50|od_________7::b231b8bfb83d2c3cface2d82fd4c166c","oai:archimer.ifremer.fr:105277"],"pids":[{"scheme":"doi","value":"10.1038/s41612-024-00563-y"}],"dateOfCollection":null,"lastUpdateTimeStamp":null,"indicators":{"citationImpact":{"citationCount":13.0,"influence":2.3834454E-9,"popularity":1.0309154E-8,"impulse":13.0,"citationClass":"C4","influenceClass":"C5","impulseClass":"C4","popularityClass":"C4"}},"projects":null,"organizations":[{"legalName":"Fudan University","acronym":"Fudan University","id":"openorgs____::2182af9559d9bac2b1b23f04e5ae8ff9","pids":[{"scheme":"GRID","value":"grid.8547.e"},{"scheme":"fundref","value":"501100003347"},{"scheme":"OrgRef","value":"72599"},{"scheme":"ISNI","value":"0000000101252443"},{"scheme":"FundRef","value":"501100003347"},{"scheme":"mag_id","value":"24943067"},{"scheme":"fundref","value":"100007836"},{"scheme":"FundRef","value":"501100007848"},{"scheme":"PIC","value":"999899863"},{"scheme":"fundref","value":"501100006698"},{"scheme":"wikidata","value":"Q495015"},{"scheme":"fundref","value":"501100007848"},{"scheme":"ROR","value":"https://ror.org/013q1eq08"},{"scheme":"FundRef","value":"501100006698"},{"scheme":"FundRef","value":"100007836"},{"scheme":"Wikidata","value":"Q495015"}],"countries":[{"code":"CN","label":"China (People's Republic of)"}],"websiteurl":"http://www.fudan.edu.cn/en/"},{"legalName":"Colorado State University","acronym":"CSU","id":"openorgs____::28658af4b407069169f10f51fa1c31e7","pids":[{"scheme":"RRID","value":"RRID:SCR_011163"},{"scheme":"GRID","value":"grid.47894.36"},{"scheme":"fundref","value":"100007235"}