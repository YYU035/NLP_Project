s.org/documentation/access_rights/","openAccessRoute":null},"type":"Article","urls":["https://doi.org/10.1039/d5ya00303b","https://ora.ox.ac.uk/objects/uuid:02da62e3-cd55-4a87-ae90-4e28ebc0f6f0"],"publicationDate":"2026-01-21","refereed":"nonPeerReviewed","hostedBy":{"key":"opendoar____::2290a7385ed77cc5592dc2153229f082","value":"Oxford University Research Archive"},"collectedFrom":{"key":"opendoar____::2290a7385ed77cc5592dc2153229f082","value":"Oxford University Research Archive"}},{"license":"CC BY NC","accessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/","openAccessRoute":null},"type":"Article","urls":["https://eprints.whiterose.ac.uk/id/eprint/236841/"],"publicationDate":"2026-04-01","refereed":"nonPeerReviewed","hostedBy":{"key":"opendoar____::ffd52f3c7e12435a724a8f30fddadd9c","value":"White Rose Research Online"},"collectedFrom":{"key":"opendoar____::ffd52f3c7e12435a724a8f30fddadd9c","value":"White Rose Research Online"}}],"links":[{"header":{"relationType":"resultProject","relationClass":"isProducedBy","relatedIdentifier":"ukri________::28a0727dd69d2434ce9d6b62879067ce","relatedRecordType":"project","relationProvenance":"sysimport:actionset","trust":"0.91"},"collectedfrom":[{"dsId":"openaire____::92ed35af5f7f859de570d1d2919c09a4","dsName":"UK Research and Innovation"}],"projectTitle":"DTP 2020-2021 University College London","code":"EP/T517793/1","funding":{"funder":{"id":"ukri________::UKRI","shortname":"UKRI","name":"UK Research and Innovation","jurisdiction":{"code":"GB","label":"United Kingdom"},"pid":null},"level0":{"id":"ukri________::UKRI::EPSRC","description":"EPSRC","name":"EPSRC"},"level1":{"id":null,"description":null,"name":null},"level2":{"id":null,"description":null,"name":null}},"startDate":"2020-09-30","endDate":"2025-09-29"}],"otherTitles":null,"inDiamondJournal":false,"green":true,"isGreen":true,"isInDiamondJournal":false},{"authors":[{"id":null,"fullName":"Shouji Usuda","name":"Shouji","surname":"Usuda","rank":1,"pid":null},{"id":null,"fullName":"Moh Moh Win Shwe","name":"Moh Moh Win","surname":"Shwe","rank":2,"pid":null},{"id":null,"fullName":"Wunna Swe","name":"Wunna","surname":"Swe","rank":3,"pid":null}],"openAccessColor":null,"publiclyFunded":false,"eoscIfGuidelines":null,"type":"publication","language":{"code":"und","label":"Undetermined"},"countries":null,"subjects":null,"mainTitle":"Research for Lithium-Ion Battery with Li-ion Pre-Doped Negative Electrode","subTitle":null,"descriptions":["<jats:p>Abstract: The lithium-ion battery has excellent performance and characteristics as compared with other secondary batteries. Small lithium-ion batteries are used in portable devices, mobile devices, digital cameras, etc., while large lithium-ion batteries are used in commercial devices, plug-in hybrids, electric vehicles, etc., and recently MaaS (Mobility as a Service) is expected to be applied. In addition, a large-capacity secondary battery such as a lithium-ion battery is also desired in a coordinated operation (Battery Energy Storage System) with an electric power system. With much demand for batteries expected in the future, development to increase the battery capacity of lithium-ion batteries is being promoted.</jats:p>"],"publicationDate":"2020-08-30","publisher":"Academic Star Publishing Company","embargoEndDate":null,"sources":["Crossref"],"formats":null,"contributors":null,"coverages":null,"bestAccessRight":null,"container":{"name":"Modern Environmental Science and Engineering","issnPrinted":"2333-2581","issnOnline":null,"issnLinking":null,"ep":null,"iss":null,"sp":"811","vol":null,"edition":null,"conferencePlace":null,"conferenceDate":null},"documentationUrls":null,"codeRepositoryUrl":null,"programmingLanguage":null,"contactPeople":null,"contactGroups":null,"tools":null,"size":null,"version":null,"geoLocations":null,"id":"doi_________::6e3dfe9034f027a13d8469d6a25b09bd","originalIds":["10.15341/mese(2333-2581)/08.06.2020