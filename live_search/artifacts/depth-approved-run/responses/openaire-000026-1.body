{"header":{"numFound":13,"maxScore":15.546751,"queryTime":658,"page":1,"pageSize":30},"results":[{"authors":[{"id":null,"fullName":"Chuhan Dai","name":"Chuhan","surname":"Dai","rank":1,"pid":null},{"id":null,"fullName":"Ruirui Wang","name":"Ruirui","surname":"Wang","rank":2,"pid":null},{"id":null,"fullName":"Shouyu Yao","name":"Shouyu","surname":"Yao","rank":3,"pid":null},{"id":null,"fullName":"Qianqian Liu","name":"Qianqian","surname":"Liu","rank":4,"pid":null},{"id":"orcid_______::5bbd802eb78a0a1c018c62ed3683dfa4","fullName":"Hongyuan Yang","name":"Hongyuan","surname":"Yang","rank":5,"pid":{"id":{"scheme":"orcid","value":"0009-0007-7683-043x"},"provenance":null}},{"id":null,"fullName":"Wanfei Li","name":"Wanfei","surname":"Li","rank":6,"pid":null},{"id":null,"fullName":"Miao Cheng","name":"Miao","surname":"Cheng","rank":7,"pid":null},{"id":"orcid_______::8d0ff32c15795f15f57c530661b5e206","fullName":"Ziliang Chen","name":"Ziliang","surname":"Chen","rank":8,"pid":{"id":{"scheme":"orcid","value":"0000-0001-5307-7309"},"provenance":null}},{"id":null,"fullName":"Jing Hu","name":"Jing","surname":"Hu","rank":9,"pid":null},{"id":"orcid_______::921405465e4f4763bde7cdb3cb5d4a93","fullName":"Tao Wei","name":"Tao","surname":"Wei","rank":10,"pid":{"id":{"scheme":"orcid","value":"0000-0001-6369-1505"},"provenance":null}},{"id":null,"fullName":"Yun Ling","name":"Yun","surname":"Ling","rank":11,"pid":null},{"id":null,"fullName":"Prashanth W. Menezes","name":"Prashanth W.","surname":"Menezes","rank":12,"pid":{"id":{"scheme":"orcid_pending","value":"0000-0002-0665-7690"},"provenance":null}},{"id":null,"fullName":"Bo Liu","name":"Bo","surname":"Liu","rank":13,"pid":null}],"openAccessColor":"hybrid","publiclyFunded":false,"eoscIfGuidelines":null,"type":"publication","language":{"code":"eng","label":"English"},"countries":[{"code":"DE","label":"Germany","provenance":null}],"subjects":[{"subject":{"scheme":"keyword","value":"platinum-based electrocatalysts"},"provenance":null},{"subject":{"scheme":"keyword","value":"Catalysts ; Diffraction"},"provenance":null},{"subject":{"scheme":"keyword","value":"HER"},"provenance":null},{"subject":{"scheme":"keyword","value":"500 Naturwissenschaften und Mathematik::540 Chemie::540 Chemie und zugeordnete Wissenschaften"},"provenance":null},{"subject":{"scheme":"FOS","value":"01 natural sciences"},"provenance":null},{"subject":{"scheme":"keyword","value":"heterostructured nanomaterials"},"provenance":null},{"subject":{"scheme":"FOS","value":"0104 chemical sciences"},"provenance":null},{"subject":{"scheme":"keyword","value":"hydrogen evolution reaction"},"provenance":null},{"subject":{"scheme":"keyword","value":"pH-universal catalysis"},"provenance":null}],"mainTitle":"Cobalt Nanoclusters-Modulated Platinum–Tin Intermetallic for pH-Universal Hydrogen Evolution Electrocatalysis","subTitle":null,"descriptions":["Achieving satisfactory electrocatalytic activity and stability of platinum (Pt)-based catalysts for hydrogen evolution reaction (HER) in wide-pH media remains a formidable challenge. In this context, a heterostructure composed of platinum–tin intermetallic nanoparticles and cobalt nanoclusters, evenly confined in a nitrogen-doped carbon mesh (Pt3Sn/Co@N-CM), is designed that acts as an efficient HER catalyst. Alloying Sn effectively reduces Pt usage and ensures high electrical conductivity during catalysis. Notably, the Co clusters not only accelerate water dissociation in the HER process but also form strong coupling with ordered Pt3Sn particles, thus optimizing the Gibbs free energy for pH-universal HER intermediates. Consequently, Pt3Sn/Co@N-CM attains 10 mA cm–2 current densities at low overpotentials of ∼8, ∼20, and ∼41 mV in acidic, alkaline, and neutral solutions, respectively, outperforming most reported Pt-based counterparts. Additionally, excellent structural and operational stability is achieved, displaying its promising prospects. This study paves a simple avenue for developing high-performance, pH-universal HER electrocatalysts."],"publicationDate":"2025-04-07","publisher":"American Chemical Society (ACS)","embargoEndDate":"2025-07-29","sources":["Crossref","ACS Materials Letters 7 2025 , p. 1760 1767"],"formats":["application/pdf"],"contributors":null,"coverages":null,"bestAccessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/"},"container":{"name":"ACS Materials Letters","issnPrinted":"2639-4979","issnOnline":"2639-4979","issnLinking":null,"ep":"1767","iss":null,"sp":"1760","vol":"7","edition":null,"conferencePlace":null,"conferenceDate":null},"documentationUrls":null,"codeRepositoryUrl":null,"programmingLanguage":null,"contactPeople":null,"contactGroups":null,"tools":null,"size":null,"version":null,"geoLocations":null,"id":"doi_dedup___::561809b449ad053a7d9dbeeb1a699f1f","originalIds":["10.1021/acsmaterialslett.5c00363","50|doiboost____|561809b449ad053a7d9dbeeb1a699f1f","50|datacite____::c58b477db4adb1c8638fc6a4024ccbdf","10.14279/depositonce-23895","oai:helmholtz.HZB:115340","50|od______3680::1512c5b493da728a43a731f4814f7297","oai:depositonce.tu-berlin.de:11303/25077","50|od_______793::cf85094eaa652f9a3e81616d96c5cba7"],"pids":[{"scheme":"doi","value":"10.1021/acsmaterialslett.5c00363"},{"scheme":"doi","value":"10.14279/depositonce-23895"}],"dateOfCollection":null,"lastUpdateTimeStamp":null,"indicators":{"citationImpact":{"citationCount":2.0,"influence":2.2180213E-9,"popularity":3.5288634E-9,"impulse":2.0,"citationClass":"C5","influenceClass":"C5","impulseClass":"C5","popularityClass":"C4"}},"projects":null,"organizations":[{"legalName":"Soochow University","acronym":"Soochow University","id":"openorgs____::4c5606c144362c5111b4a216d5fd4082","pids":[{"scheme":"fundref","value":"501100007824"},{"scheme":"FundRef","value":"501100007824"},{"scheme":"OrgRef","value":"20122483"},{"scheme":"GRID","value":"grid.263761.7"},{"scheme":"ROR","value":"https://ror.org/05t8y2r12"},{"scheme":"mag