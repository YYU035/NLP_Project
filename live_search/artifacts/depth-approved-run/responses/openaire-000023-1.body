{"header":{"numFound":3,"maxScore":15.220353,"queryTime":696,"page":1,"pageSize":30},"results":[{"authors":[{"id":"orcid_______::46a5239ac63045db5ef54f0373996bcc","fullName":"Hosein Fooladi","name":null,"surname":null,"rank":1,"pid":{"id":{"scheme":"orcid","value":"0000-0002-3124-2761"},"provenance":null}},{"id":"orcid_______::dc92eed2f21609600aa307cf3bf01005","fullName":"Thi Ngoc Lan Vu","name":null,"surname":null,"rank":2,"pid":{"id":{"scheme":"orcid","value":"0000-0003-4855-3627"},"provenance":null}},{"id":"orcid_______::bf8aace22aeb22023ba68fbfe0094c9a","fullName":"Miriam Mathea","name":null,"surname":null,"rank":3,"pid":{"id":{"scheme":"orcid","value":"0000-0002-3214-1487"},"provenance":null}},{"id":"orcid_______::bf51bf20b8e62d65244819b12e786573","fullName":"Johannes Kirchmair","name":null,"surname":null,"rank":4,"pid":{"id":{"scheme":"orcid","value":"0000-0003-2667-5877"},"provenance":null}}],"openAccessColor":"hybrid","publiclyFunded":false,"eoscIfGuidelines":null,"type":"publication","language":{"code":"eng","label":"English"},"countries":[{"code":"AT","label":"Austria","provenance":null}],"subjects":[{"subject":{"scheme":"keyword","value":"Machine Learning"},"provenance":null},{"subject":{"scheme":"keyword","value":"Computer"},"provenance":null},{"subject":{"scheme":"keyword","value":"Neural Networks"},"provenance":null},{"subject":{"scheme":"keyword","value":"102001 Artificial intelligence"},"provenance":null},{"subject":{"scheme":"FOS","value":"0202 electrical engineering, electronic engineering, information engineering"},"provenance":null},{"subject":{"scheme":"keyword","value":"102001 Artificial Intelligence"},"provenance":null},{"subject":{"scheme":"FOS","value":"02 engineering and technology"},"provenance":null},{"subject":{"scheme":"keyword","value":"Neural Networks, Computer"},"provenance":null},{"subject":{"scheme":"keyword","value":"102004 Bioinformatik"},"provenance":null},{"subject":{"scheme":"keyword","value":"102004 Bioinformatics"},"provenance":null},{"subject":{"scheme":"keyword","value":"301207 Pharmazeutische Chemie"},"provenance":null},{"subject":{"scheme":"keyword","value":"Article"},"provenance":null},{"subject":{"scheme":"keyword","value":"301207 Pharmaceutical chemistry"},"provenance":null}],"mainTitle":"Evaluating Machine Learning Models for Molecular Property Prediction: Performance and Robustness on Out-of-Distribution Data","subTitle":null,"descriptions":["Today, machine learning models are employed extensively to predict the physicochemical and biological properties of molecules. Their performance is typically evaluated on in-distribution (ID) data, i.e., data originating from the same distribution as the training data. However, the real-world applications of such models often involve molecules that are more distant from the training data, necessitating the assessment of their performance on out-of-distribution (OOD) data. In this work, we investigate and evaluate the performance of 14 machine learning models, including classical approaches like random forests, as well as graph neural network (GNN) methods, such as message-passing graph neural networks, across eight data sets using ten splitting strategies for OOD data generation. First, we investigate what constitutes OOD data in the molecular domain for bioactivity and ADMET prediction tasks. In contrast to the common point of view, we show that both classical machine learning and GNN models work well (not substantially different from random splitting) on data split based on Bemis-Murcko scaffolds. Splitting based on chemical similarity clustering (UMAP-based clustering using ECFP4 fingerprints) poses the most challenging task for both types of models. Second, we investigate the extent to which ID and OOD performance have a positive linear relationship. If a positive correlation holds, models with the best performance on the ID data can be selected with the promise of having the best performance on OOD data. We show that the strength of this linear relationship is strongly related to how the OOD data is generated, i.e., which splitting strategies are used for generating OOD data. While the correlation between ID and OOD performance for scaffold splitting is strong (Pearson's r ∼ 0.9), this correlation decreases significantly for all the cluster-based splitting (Pearson's r ∼ 0.4). Therefore, the relationship can be more nuanced, and a strong positive correlation is not guaranteed for all OOD scenarios. These findings suggest that OOD performance evaluation and model selection should be carefully aligned with the intended application domain."],"publicationDate":"2025-09-15","publisher":"American Chemical Society (ACS)","embargoEndDate":null,"sources":["Crossref","J Chem Inf Model"],"formats":null,"contributors":null,"coverages":null,"bestAccessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/"},"container":{"name":"Journal of Chemical Information and Modeling","issnPrinted":"1549-9596","issnOnline":"1549-960X","issnLinking":null,"ep":"9891","iss":null,"sp":"9871","vol":"65","edition":null,"conferencePlace":null,"conferenceDate":null},"documentationUrls":null,"codeRepositoryUrl":null,"programmingLanguage":null,"contactPeople":null,"contactGroups":null,"tools":null,"size":null,"version":null,"geoLocations":null,"id":"doi_dedup___::002e41efa24befd7d9276a9700eea0d5","originalIds":["10.1021/acs.jcim.5c00475","50|doiboost____|002e41efa24befd7d9276a9700eea0d5","od_______267::397ca3628447a7317228f78627c7da28","40947919","PMC12529777","50|od_______267::397ca3628447a7317228f78627c7da28","oai:pubmedcentral.nih.gov:12529777","50|dblp________::096a22a75697edcfd437942f02d65fdc","50|dris___00911::9cea2222f53a3ebf694f3d26447e944b","oai:ucris.univie.ac.at:openaire_cris_publications/61f34cdd-e1b3-4f7b-9c23-c36ce03137e1"],"pids":[{"scheme":"doi","value":"10.1021/acs.jcim.5c00475"},{"scheme":"pmid","value":"40947919"},{"scheme":"pmc","value":"PMC12529777"}],"dateOfCollection":null,"lastUpdateTimeStamp":null,"indicators":{"citationImpact":{"citationCount":22.0,"influence":2.9429217E-9,"popularity":1.6450144E-8,"impulse":22.0,"citationClass":"C4","influenceClass":"C4","impulseClass":"C4","popularityClass":"C4"}},"projects":null,"organizations":[{"legalName":"University of Vienna","acronym":"University of Vienna","id":"openorgs____::64badd35233ba2cd4946368ef2f4cf57","pids":[{"scheme":"FundRef","value":"501100003065"},{"scheme":"OrgReg","value":"AT0001"},{"scheme":"Wikidata","value":"Q165980"},{"scheme":"RingGold","value":"RingGold:199399"},{"scheme":"wikidata","value":"Q165980"},{"scheme":"Wikidata","value":"Q1362780"},{"scheme":"fundref","value":"501100003065"},{"scheme":"NIF","value":"NIF:512017050"},{"scheme":"PIC","value":"999866883"},{"scheme":"RRID","value":"RRID:SCR_011741"},{"scheme":"wikidata","value":"Q1362780"},{"scheme":"ROR","value":"https://ror.org/03prydq77"},{"scheme":"RRID","value":"RRID:nlx_52021"},{"scheme":"OrgRef","value":"53049"},{"scheme":"mag_id","value":"129774422"},{"scheme":"ISNI","value":"0000000122861424"},{"scheme":"fundref","value":"501100012540"},{"scheme":"fundref","value":"501100003066"},{"scheme":"FundRef","value":"501100003066"},{"scheme":"FundRef","value":"501100012540"},{"scheme":"GRID","value":"grid.10420.37"}],"countries":[{"code":"AT","label":"Austria"}],"websiteurl":"https://www.univie.ac.at/"},{"legalName":"BASF (United States)","acronym":"BASF (United States)","id":"openorgs____::804478f650b4a290bec9e02016c44384","pids":[{"scheme":"mag_id","value":"3019562804"},{"scheme":"GRID","value":"grid.418235.9"},{"scheme":"FundRef","value":"100007487"},{"scheme":"fundref","value":"100007487"},{"scheme":"wikidata","value":"Q29000277"},{"scheme":"ROR","value":"https://ror.org/002yzpx87"},{"scheme":"ISNI","value":"0000000446484928"},{"scheme":"Wikidata","value":"Q29000277"}],"countries":[{"code":"US","label":"United States"}],"websiteurl":"https://www.basf.com/en.html"}],"communities":null,"collectedFrom":[{"key":"eurocrisdris::303de629d5e632ad8cccf8222b4733a3","value":"u:cris"},{"key":"openaire____::081b82f96300b6a6e3d282bad31cb6e2","value":"Crossref"},{"key":"openaire____::d8b68cc0a53121f6f896883a7d60c1db","value":"DBLP"},{"key":"opendoar____::8b6dd7db9af49e67306feb59a8bdc52c","value":"Europe PubMed Central"},{"key":"opendoar____::eda80a3d5b344bc40f3bc04f65b7a357","value":"PubMed Central"}],"instances":[{"pids":[{"scheme":"doi","value":"10.1021/acs.jcim.5c00475"}],"license":"CC BY","accessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/","openAccessRoute":"hybrid"},"type":"Article","urls":["https://doi.org/10.1021/acs.jcim.5c00475"],"publicationDate":"2025-09-15","refereed":"peerReviewed","hostedBy":{"key":"issn___print::0c66c03ff206d62dbde8b84c35ac1ffa","value":"Journal of Chemical Information and Modeling"},"collectedFrom":{"key":"openaire____::081b82f96300b6a6e3d282bad31cb6e2","value":"Crossref"}},{"pids":[{"scheme":"pmid","value":"40947919"},{"scheme":"pmc","value":"PMC12529777"}],"alternateIdentifiers":[{"scheme":"doi","value":"10.1021/acs.jcim.5c00475"}],"type":"Article","urls":["https://pubmed.ncbi.nlm.nih.gov/40947919"],"publicationDate":"2025-10-13","refereed":"nonPeerReviewed","hostedBy":{"key":"issn___print::0c66c03ff206d62dbde8b84c35ac1ffa","value":"Journal of Chemical Information and Modeling"},"collectedFrom":{"key":"opendoar____::8b6dd7db9af49e67306feb59a8bdc52c","value":"Europe PubMed Central"}},{"alternateIdentifiers":[{"scheme":"doi","value":"10.1021/acs.jcim.5c00475"}],"license":"CC BY","accessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/","openAccessRoute":null},"type":"Article","urls":["https://pubmed.ncbi.nlm.nih.gov/40947919/","https://pmc.ncbi.nlm.nih.gov/articles/PMC12529777/","https://doi.org/10.1021/acs.jcim.5c00475"],"publicationDate":"2025-09-15","refereed":"nonPeerReviewed","hostedBy":{"key":"opendoar____::eda80a3d5b344bc40f3bc04f65b7a357","value":"PubMed Central"},"collectedFrom":{"key":"opendoar____::eda80a3d5b344bc40f3bc04f65b7a357","value":"PubMed Central"}},{"alternateIdentifiers":[{"scheme":"doi","value":"10.1021/acs.jcim.5c00475"}],"type":"Article","urls":["https://dblp.org/rec/journals/jcisd/FooladiVMK25.html","https://doi.org/10.1021/acs.jcim.5c00475"],"publicationDate":"2025-01-01","refereed":"nonPeerReviewed","hostedBy":{"key":"openaire____::d8b68cc0a53121f6f896883a7d60c1db","value":"DBLP"},"collectedFrom":{"key":"openaire____::d8b68cc0a53121f6f896883a7d60c1db","value":"DBLP"}},{"alternateIdentifiers":[{"scheme":"doi","value":"10.1021/acs.jcim.5c00475"}],"type":"Article","urls":["https://ucrisportal.univie.ac.at/de/publications/61f34cdd-e1b3-4f7b-9c23-c36ce03137e1","https://doi.org/10.1021/acs.jcim.5c00475"],"publicationDate":"2025-10-13","refereed":"nonPeerReviewed","hostedBy":{"key":"issn___print::0c66c03ff206d62dbde8b84c35ac1ffa","value":"Journal of Chemical Information and Modeling"},"collectedFrom":{"key":"eurocrisdris::303de629d5e632ad8cccf8222b4733a3","value":"u:cris"}}],"links":[],"otherTitles":["Performance and Robustness on Out-of-Distribution Data"],"green":true,"inDiamondJournal":false,"isGreen":true,"isInDiamondJournal":false},{"authors":[{"id":"orcid_______::46a5239ac63045db5ef54f0373996bcc","fullName":"Hosein Fooladi","name":"Hosein","surname":"Fooladi","rank":1,"pid":{"id":{"scheme":"orcid","value":"0000-0002-3124-2761"},"provenance":null}},{"id":"orcid_______::dc92eed2f21609600aa307cf3bf01005","fullName":"Thi Ngoc Lan Vu","name":"Thi Ngoc Lan","surname":"Vu","rank":2,"pid":{"id":{"scheme":"orcid","value":"0000-0003-4855-3627"},"provenance":null}},{"id":null,"fullName":"Johannes Kirchmair","name":"Johannes","surname":"Kirchmair","rank":3,"pid":{"id":{"scheme":"orcid_pending","value":"0000-0003-2667-5877"},"provenance":null}}],"openAccessColor":"hybrid","publiclyFunded":false,"eoscIfGuidelines":null,"type":"publication","language":{"code":"und","label":"Undetermined"},"countries":null,"subjects":[{"subject":{"scheme":"FOS","value":"0202 electrical engineering, electronic engineering, information engineering"},"provenance":null},{"subject":{"scheme":"FOS","value":"02 engineering and technology"},"provenance":null}],"mainTitle":"Evaluating Machine Learning Models for Molecular Property Prediction: Performance and Robustness on Out-of-Distribution Data","subTitle":null,"descriptions":["<jats:p>Today, machine learning models are employed extensively to predict the physicochemical and biological properties of molecules. Their performance is typically evaluated on in-distribution (ID) data, i.e., data originating from the same distribution as the training data. However, the real-world applications of such models often involve molecules that are more distant from the training data, which necessitates assessing their performance on out-of-distribution (OOD) data. In this work, we investigate and evaluate the performance of twelve machine learning models, including classical approaches like random forests, as well as graph neural network (GNN) methods, such as message-passing graph neural networks, across eight data sets using seven splitting strategies for OOD data generation. First, we investigate what constitutes OOD data in the molecular domain for bioactivity and ADMET prediction tasks. In contrast to the common point of view, we show that both classical machine learning and GNN models work well (not substantially different from random splitting) on data split based on Bemis-Murcko scaffolds. Splitting based on chemical similarity clustering (K-means clustering using ECFP4 fingerprints) poses the hardest challenge for both types of models. Second, we investigate the extent to which ID and OOD performance have a positive linear relationship. If a positive correlation holds, models with the best performance on the ID data can be selected with the promise of having the best performance on OOD data. We show that the strength of this linear relationship is strongly related to how the OOD data is generated, i.e., which splitting strategies are used for generating OOD data. While the correlation between ID and OOD performance for scaffold splitting is strong (Pearson r ∼ 0.9), this correlation decreases significantly for cluster-based splitting (Pearson r ∼ 0.4). Therefore, the relationship can be more nuanced, and a strong positive correlation is not guaranteed for all OOD scenarios. These findings suggest that OOD performance evaluation and model selection should be carefully aligned with the intended application domain.</jats:p>"],"publicationDate":"2025-02-28","publisher":"American Chemical Society (ACS)","embargoEndDate":null,"sources":["Crossref"],"formats":null,"contributors":null,"coverages":null,"bestAccessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/"},"container":null,"documentationUrls":null,"codeRepositoryUrl":null,"programmingLanguage":null,"contactPeople":null,"contactGroups":null,"tools":null,"size":null,"version":null,"geoLocations":null,"id":"doi_dedup___::be946b1d1c8824e567c51d9c6f48723f","originalIds":["10.26434/chemrxiv-2025-g1vjf-v2","50|doiboost____|00aedd201f3b06c4cfca0c3c294d281c","10.26434/chemrxiv-2025-g1vjf","50|doiboost____|be946b1d1c8824e567c51d9c6f48723f"],"pids":[{"scheme":"doi","value":"10.26434/chemrxiv-2025-g1vjf-v2"},{"scheme":"doi","value":"10.26434/chemrxiv-2025-g1vjf"}],"dateOfCollection":null,"lastUpdateTimeStamp":null,"indicators":{"citationImpact":{"citationCount":1.0,"influence":2.1799151E-9,"popularity":2.8936846E-9,"impulse":1.0,"citationClass":"C5","influenceClass":"C5","impulseClass":"C5","popularityClass":"C5"}},"projects":null,"organizations":[{"legalName":"University of Vienna","acronym":"University of Vienna","id":"openorgs____::64badd35233ba2cd4946368ef2f4cf57","pids":[{"scheme":"FundRef","value":"501100003065"},{"scheme":"OrgReg","value":"AT0001"},{"scheme":"Wikidata","value":"Q165980"},{"scheme":"RingGold","value":"RingGold:199399"},{"scheme":"wikidata","value":"Q165980"},{"scheme":"Wikidata","value":"Q1362780"},{"scheme":"fundref","value":"501100003065"},{"scheme":"NIF","value":"NIF:512017050"},{"scheme":"PIC","value":"999866883"},{"scheme":"RRID","value":"RRID:SCR_011741"},{"scheme":"wikidata","value":"Q1362780"},{"scheme":"ROR","value":"https://ror.org/03prydq77"},{"scheme":"RRID","value":"RRID:nlx_52021"},{"scheme":"OrgRef","value":"53049"},{"scheme":"mag_id","value":"129774422"},{"scheme":"ISNI","value":"0000000122861424"},{"scheme":"fundref","value":"501100012540"},{"scheme":"fundref","value":"501100003066"},{"scheme":"FundRef","value":"501100003066"},{"scheme":"FundRef","value":"501100012540"},{"scheme":"GRID","value":"grid.10420.37"}],"countries":[{"code":"AT","label":"Austria"}],"websiteurl":"https://www.univie.ac.at/"},{"legalName":"MEDIZINISCHE UNIVERSITAT GRAZ","acronym":"MUG","id":"pending_org_::c5c0b668e90261051842f1b5ec0e8657","pids":[{"scheme":"PIC","value":"999836231"},{"scheme":"ROR","value":"https://ror.org/054pv6659"},{"scheme":"ROR","value":"https://ror.org/01faaaf77"},{"scheme":"ROR","value":"https://ror.org/05gs8cd61"},{"scheme":"PIC","value":"999892976"}],"countries":[{"code":"AT","label":"Austria"}],"websiteurl":"http://www.medunigraz.at"},{"legalName":"Universität Wien","acronym":"Universität Wien","id":"pending_org_::82a98c1bdef53fada17f2b084616d087","pids":null,"countries":[{"code":"AT","label":"Austria"}],"websiteurl":null},{"legalName":"Universität Wien","acronym":"Universität Wien","id":"pending_org_::67249336ab0b0dadc89b8cf31dd371a6","pids":null,"countries":[{"code":"AT","label":"Austria"}],"websiteurl":null}],"communities":null,"collectedFrom":[{"key":"openaire____::081b82f96300b6a6e3d282bad31cb6e2","value":"Crossref"}],"instances":[{"pids":[{"scheme":"doi","value":"10.26434/chemrxiv-2025-g1vjf-v2"}],"license":"CC BY","accessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/","openAccessRoute":"hybrid"},"type":"Article","urls":["https://doi.org/10.26434/chemrxiv-2025-g1vjf-v2"],"publicationDate":"2025-03-06","refereed":"peerReviewed","hostedBy":{"key":"openaire____::55045bd2a65019fd8e6741a755395c8c","value":"Unknown Repository"},"collectedFrom":{"key":"openaire____::081b82f96300b6a6e3d282bad31cb6e2","value":"Crossref"}},{"pids":[{"scheme":"doi","value":"10.26434/chemrxiv-2025-g1vjf"}],"license":"CC BY","accessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/","openAccessRoute":"hybrid"},"type":"Article","urls":["https://doi.org/10.26434/chemrxiv-2025-g1vjf"],"publicationDate":"2025-02-28","refereed":"peerReviewed","hostedBy":{"key":"openaire____::55045bd2a65019fd8e6741a755395c8c","value":"Unknown Repository"},"collectedFrom":{"key":"openaire____::081b82f96300b6a6e3d282bad31cb6e2","value":"Crossref"}}],"links":[],"otherTitles":null,"green":false,"inDiamondJournal":false,"isGreen":false,"isInDiamondJournal":false},{"authors":[{"id":null,"fullName":"Bhuvaneshwari S Baranwal","name":"Bhuvaneshwari S","surname":"Baranwal","rank":1,"pid":null},{"id":"orcid_______::d249e16fab715d88fac2a67136450dc0","fullName":"Leighton O Jones","name":"Leighton O","surname":"Jones","rank":2,"pid":{"id":{"scheme":"orcid","value":"0000-0001-6657-2632"},"provenance":null}},{"id":null,"fullName":"Ankush Maind","name":"Ankush","surname":"Maind","rank":3,"pid":null},{"id":null,"fullName":"Umesh T Balande","name":"Umesh T","surname":"Balande","rank":4,"pid":null},{"id":null,"fullName":"Dipratn G Khandare","name":"Dipratn G","surname":"Khandare","rank":5,"pid":null},{"id":"orcid_______::081d5cbb2e5634265495d25036bcb92a","fullName":"Hina Z Goyal","name":"Hina Z","surname":"Goyal","rank":6,"pid":{"id":{"scheme":"orcid","value":"0000-0003-4757-2703"},"provenance":null}},{"id":null,"fullName":"Leilani M Lotti Diaz","name":"Leilani M","surname":"Lotti Diaz","rank":7,"pid":null},{"id":null,"fullName":"Julian M Ivanov","name":"Julian M","surname":"Ivanov","rank":8,"pid":null},{"id":"orcid_______::c6e535df389bd42c78ded51ae96b56ce","fullName":"Qiongqiong zhou","name":"Qiongqiong","surname":"zhou","rank":9,"pid":{"id":{"scheme":"orcid","value":"0000-0001-6711-369x"},"provenance":null}}],"openAccessColor":"hybrid","publiclyFunded":false,"eoscIfGuidelines":null,"type":"publication","language":{"code":"und","label":"Undetermined"},"countries":null,"subjects":null,"mainTitle":"The AI Revolution in Chemistry: Shaping the Future of Materials and Biomedical Sciences","subTitle":null,"descriptions":["<jats:p>Artificial intelligence (AI) is reshaping scientific research by accelerating discovery and enabling the analysis of complex data that traditional methods struggle to handle. This review examines over 310,000 journal articles and patents from the CAS Content Collection (2015–2025), with a focus on, biomedical research, and materials science.  Our data-supported trend analysis finds that since 2020, AI-related publications have surged across both academic and industrial domains. Traditional machine learning (ML) methods, such as decision trees, random forests, and support vector machines, remain foundational, particularly in molecular property prediction and classification tasks. However, there is an increased adoption of advanced neural network architectures, including graph neural networks for molecular representation and generative models for de novo compound design. Hybrid and ensemble approaches that integrate traditional algorithms with deep learning are increasingly favored for their robustness and adaptability. Large Language Models (LLMs) like GPT, BERT, and GEMINI are transforming literature mining, hypothesis generation, and experimental planning. Domain-specific models such as AlphaFold and chemical language models enable breakthroughs in protein structure prediction and reaction outcome forecasting.  Industrial chemistry and chemical engineering are increasingly contributing to AI-driven academic publications, while biochemistry patents have grown eightfold, reflecting AI’s dual impact on discovery and commercialization. Despite these advances, challenges remain, particularly in data privacy, quality, interpretability of black-box models, and uncertainty quantification. These findings highlight AI’s transition from descriptor-based approaches to end-to-end learning systems, offering essential insights for researchers and policymakers navigating its transformative role in science.</jats:p>"],"publicationDate":"2025-08-25","publisher":"American Chemical Society (ACS)","embargoEndDate":null,"sources":["Crossref"],"formats":null,"contributors":null,"coverages":null,"bestAccessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/"},"container":null,"documentationUrls":null,"codeRepositoryUrl":null,"programmingLanguage":null,"contactPeople":null,"contactGroups":null,"tools":null,"size":null,"version":null,"geoLocations":null,"id":"doi_________::46581e0a55599c8788ffd4c33dbcbe72","originalIds":["10.26434/chemrxiv-2025-8lrf0","50|doiboost____|46581e0a55599c8788ffd4c33dbcbe72"],"pids":[{"scheme":"doi","value":"10.26434/chemrxiv-2025-8lrf0"}],"dateOfCollection":null,"lastUpdateTimeStamp":null,"indicators":{"citationImpact":{"citationCount":0.0,"influence":2.1746283E-9,"popularity":2.2497804E-9,"impulse":0.0,"citationClass":"C5","influenceClass":"C5","impulseClass":"C5","popularityClass":"C5"}},"projects":null,"organizations":[{"legalName":"American Chemical Society","acronym":"ACS","id":"openorgs____::1571f3022b0b7b8f7acd1943d244a7c0","pids":[{"scheme":"wikidata","value":"Q911173"},{"scheme":"FundRef","value":"100006770"},{"scheme":"fundref","value":"100008038"},{"scheme":"FundRef","value":"100008038"},{"scheme":"mag_id","value":"190567190"},{"scheme":"ROR","value":"https://ror.org/059dqb057"},{"scheme":"GRID","value":"grid.286879.a"},{"scheme":"Wikidata","value":"Q911173"},{"scheme":"wikidata","value":"Q247556"},{"scheme":"fundref","value":"100005300"},{"scheme":"FundRef","value":"100005300"},{"scheme":"fundref","value":"100006770"},{"scheme":"ISNI","value":"0000000110900879"},{"scheme":"Wikidata","value":"Q247556"}],"countries":[{"code":"US","label":"United States"}],"websiteurl":"http://www.acs.org/content/acs/en.html"}],"communities":null,"collectedFrom":[{"key":"openaire____::081b82f96300b6a6e3d282bad31cb6e2","value":"Crossref"}],"instances":[{"pids":[{"scheme":"doi","value":"10.26434/chemrxiv-2025-8lrf0"}],"license":"CC BY","accessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/","openAccessRoute":"hybrid"},"type":"Article","urls":["https://doi.org/10.26434/chemrxiv-2025-8lrf0"],"publicationDate":"2025-08-25","refereed":"peerReviewed","hostedBy":{"key":"openaire____::55045bd2a65019fd8e6741a755395c8c","value":"Unknown Repository"},"collectedFrom":{"key":"openaire____::081b82f96300b6a6e3d282bad31cb6e2","value":"Crossref"}}],"links":[],"otherTitles":null,"green":false,"inDiamondJournal":false,"isGreen":false,"isInDiamondJournal":false}]}