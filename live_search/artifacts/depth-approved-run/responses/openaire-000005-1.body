"scheme":"FundRef","value":"100013438"},{"scheme":"FundRef","value":"100020384"},{"scheme":"mag_id","value":"130769515"},{"scheme":"OrgRef","value":"21188109"},{"scheme":"wikidata","value":"Q739627"}],"countries":[{"code":"US","label":"United States"}],"websiteurl":"http://www.psu.edu/"},{"legalName":"Materials Research Institute (United States)","acronym":"MRI","id":"openorgs____::e3cea43f14674ca2cd3a4ae8565b4e10","pids":[{"scheme":"GRID","value":"grid.455784.f"},{"scheme":"ROR","value":"https://ror.org/04md8p839"}],"countries":[{"code":"US","label":"United States"}],"websiteurl":"http://materialsri.squarespace.com/"}],"communities":[{"code":"energy-planning","label":"Energy Planning","provenance":null}],"collectedFrom":[{"key":"openaire____::081b82f96300b6a6e3d282bad31cb6e2","value":"Crossref"},{"key":"openaire____::5f532a3fc4f1ea403f37070f59a7a53a","value":"Microsoft Academic Graph"}],"instances":[{"pids":[{"scheme":"doi","value":"10.35848/1347-4065/abdd4c"}],"license":"CC BY","accessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/","openAccessRoute":"hybrid"},"type":"Article","urls":["https://doi.org/10.35848/1347-4065/abdd4c"],"publicationDate":"2021-02-08","refereed":"peerReviewed","hostedBy":{"key":"issn___print::17a3ba754d63b3ca71d437a2ae239750","value":"Japanese Journal of Applied Physics"},"collectedFrom":{"key":"openaire____::081b82f96300b6a6e3d282bad31cb6e2","value":"Crossref"}},{"pids":[{"scheme":"doi","value":"10.2139/ssrn.3646482"}],"type":"Article","urls":["https://doi.org/10.2139/ssrn.3646482"],"publicationDate":"2020-01-01","refereed":"peerReviewed","hostedBy":{"key":"issn__online::40ce99e275066b606ac04ff2dc8de65a","value":"SSRN Electronic Journal"},"collectedFrom":{"key":"openaire____::081b82f96300b6a6e3d282bad31cb6e2","value":"Crossref"}},{"alternateIdentifiers":[{"scheme":"mag_id","value":"3125917406"},{"scheme":"doi","value":"10.35848/1347-4065/abdd4c"}],"type":"Article","urls":["https://dx.doi.org/10.35848/1347-4065/abdd4c"],"refereed":"nonPeerReviewed","hostedBy":{"key":"openaire____::55045bd2a65019fd8e6741a755395c8c","value":"Unknown Repository"},"collectedFrom":{"key":"openaire____::5f532a3fc4f1ea403f37070f59a7a53a","value":"Microsoft Academic Graph"}},{"alternateIdentifiers":[{"scheme":"mag_id","value":"3125917406"},{"scheme":"doi","value":"10.35848/1347-4065/abdd4c"}],"type":"Article","urls":["https://dx.doi.org/10.35848/1347-4065/abdd4c"],"refereed":"nonPeerReviewed","hostedBy":{"key":"openaire____::55045bd2a65019fd8e6741a755395c8c","value":"Unknown Repository"},"collectedFrom":{"key":"openaire____::5f532a3fc4f1ea403f37070f59a7a53a","value":"Microsoft Academic Graph"}}],"links":[],"otherTitles":null,"inDiamondJournal":false,"green":false,"isGreen":false,"isInDiamondJournal":false},{"authors":[{"id":"orcid_______::6ebfae6ca7f1fb744181d4123babd40c","fullName":"Louise M. McGrath","name":"Louise M.","surname":"McGrath","rank":1,"pid":{"id":{"scheme":"orcid","value":"0000-0002-1595-4531"},"provenance":null}},{"id":"orcid_______::64ba6da22ffafc1047d637c0fbedd9b1","fullName":"James F. Rohan","name":"James F.","surname":"Rohan","rank":2,"pid":{"id":{"scheme":"orcid","value":"0000-0003-0415-1140"},"provenance":null}}],"openAccessColor":null,"publiclyFunded":true,"eoscIfGuidelines":null,"type":"publication","language":{"code":"eng","label":"English"},"countries":null,"subjects":[{"subject":{"scheme":"FOS","value":"02 engineering and technology"},"provenance":null},{"subject":{"scheme":"FOS","value":"0210 nano-technology"},"provenance":null},{"subject":{"scheme":"FOS","value":"01 natural sciences"},"provenance":null},{"subject":{"scheme":"SDG","value":"7. Clean energy"},"provenance":null},{"subject":{"scheme":"FOS","value":"0104 chemical sciences"},"provenance":null},{"subject":{"scheme":"SDG","value":"3. Good health"},"provenance":null}],"mainTitle":"High‐Rate Lithium‐Ion Cycling in Electrodeposited Binder‐Free Thin‐Film Vanadium Oxide Cathodes with Lithium Metal Anodes in Ionic Liquid and Polymer Gel Analogue Electrolytes","subTitle":null,"descriptions":["<jats:title>Abstract</jats:title><jats:p>High rate and long cycle life performance for electrodeposited, binder‐free V<jats:sub>2</jats:sub>O<jats:sub>5</jats:sub> thin film cathodes and lithium metal anodes is described using liquid and polymer gel electrolytes of the pyrrolidinium based (C<jats:sub>4</jats:sub>mpyrTFSI) ionic liquid (IL). Sharp well‐defined voltammetric peaks typically seen with nanostructured V<jats:sub>2</jats:sub>O<jats:sub>5</jats:sub> materials in organic electrolytes, support the fast kinetics observed. The addition of vinylene carbonate (VC) stabilises the electrolyte interface leading to higher electrode capacities than for the additive‐free electrolyte, ∼120 versus ∼90 mAh g<jats:sup>−1</jats:sup> at 0.75 C. Polymer gel electrolytes based on the IL yield similar electrode capacities, coulombic efficiencies and high rate performances without the VC‐additive. The polymer gel option delivers the better long‐term stability up to 400 cycles with lithium metal anodes with minimal capacity fade at elevated charge and discharge rates up to 5 C.</jats:p>"],"publicationDate":"2020-11-20","publisher":"Wiley","embargoEndDate":null,"sources":["Crossref","Batteries &amp; Supercaps"],"formats":null,"contributors":null,"coverages":null,"bestAccessRight":{"code":"c_14cb","label":"CLOSED","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/"},"container":{"name":"Batteries &amp; Supercaps","issnPrinted":"2566-6223","issnOnline":"2566-6223","issnLinking":null,"ep":"492","iss":null,"sp":"485","vol":"4","edition":null,"conferencePlace":null,"conferenceDate":null},"documentationUrls":null,"codeRepositoryUrl":null,"programmingLanguage":null,"contactPeople":null,"contactGroups":null,"tools":null,"size":null,"version":null,"geoLocations":null,"id":"doi_dedup___::f24e745d479b005c19aef077703705db","originalIds":["10.1002/batt.202000236","50|doiboost____|f24e745d479b005c19aef077703705db","3096979027","50|r3c4b2081b22::f24e745d479b005c19aef077703705db","50|sygma_______::f24e745d479b005c19aef077703705db"],"pids":[{"scheme":"doi","value":"10.1002/batt.202000236"}],"dateOfCollection":null,"lastUpdateTimeStamp":null,"indicators":{"citationImpact":{"citationCount":6.0,"influence":2.2702624E-9,"popularity":4.381877E-9,"impulse":4.0,"citationClass":"C5","influenceClass":"C5","impulseClass":"C4","popularityClass":"C4"}},"projects":[{"id":"corda__h2020::97ed3c7aa706c3a377a507a3092e717d","code":"730957","acronym":"EnABLES","title":"European Infrastructure Powering the Internet of Things","funder":"European Commission","pids":[{"scheme":"doi","value":"10.3030/730957"}]}],"organizations":[{"legalName":"Tyndall National Institute (TNI)","acronym":"Tyndall National Institute (TNI)","id":"openorgs____::e3704dcf3ce3044b24afc877b8b8bd98","pids":[{"scheme":"Wikidata","value":"Q16902157"},{"scheme":"mag_id","value":"55513165"},{"scheme":"ISNI","value":"0000000095696776"},{"scheme":"ROR","value":"https://ror.org/007ecwd34"},{"scheme":"wikidata","value":"Q16902157"}],"countries":[{"code":"IE","label":"Ireland"}],"websiteurl":null},{"legalName":"University College Cork","acronym":"UCC","id":"openorgs____::b8b8ca674452579f3f593d9f5e557483","pids":[{"scheme":"Wikidata","value":"Q16902157"},{"scheme":"fundref","value":"501100001636"},{"scheme":"mag_id","value":"27577105"},{"scheme":"ISNI","value":"0000000123318773"},{"scheme":"PIC","value":"999975717"},{"scheme":"OrgRef","value":"738094"},{"scheme":"Wikidata","value":"Q1574185"},{"scheme":"OrgReg","value":"IE0002"},{"scheme":"FundRef","value":"501100001636"},{"scheme":"GRID","value":"grid.7872.a"},{"scheme":"wikidata","value":"Q16902157"},{"scheme":"ROR","value":"https://ror.org/03265fv13"},{"scheme":"wikidata","value":"Q1574185"}],"countries":[{"code":"IE","label":"Ireland"}],"websiteurl":"http://www.ucc.ie/en/"}],"communities":[{"code":"energy-planning",