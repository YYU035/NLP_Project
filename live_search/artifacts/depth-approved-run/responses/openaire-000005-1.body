undRef","value":"501100000728"},{"scheme":"fundref","value":"501100015505"},{"scheme":"fundref","value":"100010351"},{"scheme":"FundRef","value":"501100000744"},{"scheme":"OrgRef","value":"128344"},{"scheme":"fundref","value":"100010356"},{"scheme":"FundRef","value":"100010363"},{"scheme":"FundRef","value":"100010371"},{"scheme":"fundref","value":"501100006558"},{"scheme":"FundRef","value":"501100000666"},{"scheme":"fundref","value":"501100013389"},{"scheme":"OrgRef","value":"128386"}],"countries":[{"code":"GB","label":"United Kingdom"}],"websiteurl":"http://www.ox.ac.uk/"}],"communities":[{"code":"uarctic","label":"UArctic","provenance":null},{"code":"energy-planning","label":"Energy Planning","provenance":null}],"collectedFrom":[{"key":"opendoar____::2290a7385ed77cc5592dc2153229f082","value":"Oxford University Research Archive"},{"key":"openaire____::081b82f96300b6a6e3d282bad31cb6e2","value":"Crossref"},{"key":"opendoar____::8b6dd7db9af49e67306feb59a8bdc52c","value":"Europe PubMed Central"}],"instances":[{"pids":[{"scheme":"doi","value":"10.1002/ange.202408246"}],"license":"CC BY","accessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/","openAccessRoute":"hybrid"},"type":"Article","urls":["https://doi.org/10.1002/ange.202408246"],"publicationDate":"2024-07-11","refereed":"peerReviewed","hostedBy":{"key":"issn___print::5ea46ea96b0f6934828a28df414e2270","value":"Angewandte Chemie"},"collectedFrom":{"key":"openaire____::081b82f96300b6a6e3d282bad31cb6e2","value":"Crossref"}},{"pids":[{"scheme":"doi","value":"10.1002/anie.202408246"}],"license":"CC BY","accessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/","openAccessRoute":"hybrid"},"type":"Article","urls":["https://doi.org/10.1002/anie.202408246"],"publicationDate":"2024-07-11","refereed":"peerReviewed","hostedBy":{"key":"issn___print::dd2030b7aba11d41a00c450642d64148","value":"Angewandte Chemie International Edition"},"collectedFrom":{"key":"openaire____::081b82f96300b6a6e3d282bad31cb6e2","value":"Crossref"}},{"pids":[{"scheme":"pmid","value":"38819775"}],"alternateIdentifiers":[{"scheme":"doi","value":"10.1002/anie.202408246"}],"type":"Article","urls":["https://pubmed.ncbi.nlm.nih.gov/38819775"],"refereed":"nonPeerReviewed","hostedBy":{"key":"issn___print::dd2030b7aba11d41a00c450642d64148","value":"Angewandte Chemie International Edition"},"collectedFrom":{"key":"opendoar____::8b6dd7db9af49e67306feb59a8bdc52c","value":"Europe PubMed Central"}},{"alternateIdentifiers":[{"scheme":"pmid","value":"38819775"},{"scheme":"doi","value":"10.1002/anie.202408246"}],"license":"CC BY","accessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/","openAccessRoute":null},"type":"Article","urls":["https://doi.org/10.1002/anie.202408246","https://ora.ox.ac.uk/objects/uuid:02f6acbc-68f1-4cd3-997e-556d2da9aeac"],"publicationDate":"2025-06-27","refereed":"nonPeerReviewed","hostedBy":{"key":"opendoar____::2290a7385ed77cc5592dc2153229f082","value":"Oxford University Research Archive"},"collectedFrom":{"key":"opendoar____::2290a7385ed77cc5592dc2153229f082","value":"Oxford University Research Archive"}}],"links":[],"otherTitles":null,"inDiamondJournal":false,"green":true,"isGreen":true,"isInDiamondJournal":false},{"authors":[{"id":null,"fullName":"Shirin Mohamadzade","name":"Shirin","surname":"Mohamadzade","rank":1,"pid":null},{"id":null,"fullName":"Seyedeh‐Arefeh Safavi‐Mirmahalleh","name":"Seyedeh‐Arefeh","surname":"Safavi‐Mirmahalleh","rank":2,"pid":null},{"id":null,"fullName":"Hossein Roghani‐Mamaqani","name":"Hossein","surname":"Roghani‐Mamaqani","rank":3,"pid":null},{"id":null,"fullName":"Mehdi Salami‐Kalajahi","name":"Mehdi","surname":"Salami‐Kalajahi","rank":4,"pid":{"id":{"scheme":"orcid_pending","value":"0000-0002-8897-0997"},"provenance":null}}],"openAccessColor":"gold","publiclyFunded":false,"eoscIfGuidelines":null,"type":"publication","language":{"code":"eng","label":"English"},"countries":null,"subjects":[{"subject":{"scheme":"keyword","value":"Chemistry"},"provenance":null},{"subject":{"scheme":"keyword","value":"Nanocomposite"},"provenance":null},{"subject":{"scheme":"keyword","value":"Industrial electrochemistry"},"provenance":null},{"subject":{"scheme":"keyword","value":"Polymer electrolyte"},"provenance":null},{"subject":{"scheme":"keyword","value":"Lithium-ion battery"},"provenance":null},{"subject":{"scheme":"keyword","value":"Cellulose"},"provenance":null},{"subject":{"scheme":"keyword","value":"Poly(vinylidene fluoride)"},"provenance":null},{"subject":{"scheme":"FOS","value":"01 natural sciences"},"provenance":null},{"subject":{"scheme":"keyword","value":"QD1-999"},"provenance":null},{"subject":{"scheme":"FOS","value":"0104 chemical sciences"},"provenance":null},{"subject":{"scheme":"keyword","value":"TP250-261"},"provenance":null}],"mainTitle":"Effect of SiO<sub>2</sub> on the Performance of Cellulose/Poly(Vinylidene Fluoride) Films as Polymer Electrolytes for Lithium Ion Battery","subTitle":null,"descriptions":["<jats:title>Abstract</jats:title><jats:p>Polymer electrolytes serve as highly efficient alternatives to liquid electrolytes, especially in terms of safety in lithium ion batteries. Among various polymers, Cellulose contains electron‐donating atoms which can coordinate with lithium salts and be used as polymer electrolyte. Also, cellulose can be blended with other polymers to improve their properties. Polymer electrolytes suffer from poor mechanical properties. Adding nanoparticles not only surmounts the drawback of poor mechanical properties but also improves physical and electrochemical properties. In this study, different weight ratios of PVDF/cellulose blend films containing silicon dioxide (SiO<jats:sub>2</jats:sub>) are prepared <jats:italic>via</jats:italic> solution casting method. The results explored ionic conductivity in order of 10<jats:sup>−4</jats:sup> S cm<jats:sup>−1</jats:sup>. In addition, high transfer numbers (0.74&lt;t<jats:sup>+</jats:sup>&lt;0.98), wide electrochemical window (up to 6 V), acceptable charge capacity, and long cycle stability are attained. In details, for 90/10 (wt./wt.) cellulose/PVDF, the ionic conductivity reached 4.4×10<jats:sup>−</jats:sup>⁴ S cm<jats:sup>−1</jats:sup>, and the ion transfer number was obtained 0.98. Additionally, the electrochemical stability window for these gel polymer electrolytes exceeded 5 V. The sample containing 90 % cellulose achieved an optimal charge capacity of 225.3, with 93.4 % capacity retention after 200 cycles at 0.2 C.</jats:p>"],"publicationDate":"2024-10-22","publisher":"Wiley","embargoEndDate":null,"sources":["Crossref","ChemElectroChem, Vol 11, Iss 23, Pp n/a-n/a (2024)"],"formats":null,"contributors":null,"coverages":null,"bestAccessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/"},"container":{"name":"ChemElectroChem","issnPrinted":"2196-0216","issnOnline":"2196-0216","issnLinking":null,"ep":null,"iss":null,"sp":null,"vol":"11","edition":null,"conferencePlace":null,"conferenceDate":null},"documentationUrls":null,"codeRepositoryUrl":null,"programmingLanguage":null,"contactPeople":null,"contactGroups":null,"tools":null,"size":null,"version":null,"geoLocations":null,"id":"doi_dedup___::7defede592787396987c51e3a4e64f04","originalIds":["10.1002/celc.202400420","50|doiboost____|7defede592787396987c51e3a4e64f04","oai:doaj.org/article:5181b1c68c154a03b967aef7c7c6dc62","50|doajarticles::811a23aaeac7e08933f6a3e54c3cb682"],"pids":[{"scheme":"doi","value":"10.1002/celc.202400420"}],"dateOfCollection":null,"lastUpdateTimeStamp":null,"indicators":{"citationImpact":{"citationCount":2.0,"influence":2.2177158E-9,"popularity":3.2226608E-9,"impulse":2.0,"citationClass":"C5","influenceClass":"C5","impulseClass":"C5","popularityClass":"C4"}},"projects":null,"organizations":[{"legalName":"Sahand University of Technology","acronym":"SUT","id":"openorgs____::57975caa764f9e11e628110f86b9188f","pids":[{"scheme":"wikidata","value":"Q3875219"},{"scheme":"ROR","value":"https://ror.org/03wdrmh81"},{"scheme":"FundRef","value":"501100011702"},{"scheme":"fundref","value":"501100011702"},{"scheme":"ISNI","value":"0000000090129027"},{"scheme":"GRID","value":"grid.412345.5"},{"scheme":"Wikidata","value":"Q3875219"},{"scheme":"mag_id","value":"107853901"},{"scheme":"OrgRef","value":"5741914"}],"countries":[{"code":"IR","label":"Iran (Islamic Republic of)"}],"websiteurl":"http://www.sut.ac.ir/en/"}],"communities":null,"collectedFrom":[{"key":"driver______::bee53aa31dc2cbb538c10c2b65fa5824","value":"DOAJ"},{"key":"openaire____::081b82f96300b6a6e3d282bad31cb6e2","value":"Crossref"}],"instances":[{"pids":[{"scheme":"doi","value":"10.1002/celc.202400420"}],"license":"CC BY","accessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/","openAccessRoute":"gold"},"type":"Article","urls":["https://doi.org/10.1002/celc.202400420"],"publicationDate":"2024-10-22","refereed":"peerReviewed","hostedBy":{"key":"doajarticles::452aa4fbd96eeabcbbc859931adff1b8","value":"ChemElectroChem"},"collectedFrom":{"key":"openaire____::081b82f96300b6a6e3d282bad31cb6e2","value":"Crossref"}},{"alternateIdentifiers":[{"scheme":"doi","value":"10.1002/celc.202400420"}],"accessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/","openAccessRoute":"gold"},"type":"Article","urls":["https://doaj.org/article/5181b1c68c154a03b967aef7c7c6dc62"],"publicationDate":"2024-12-01","refereed":"nonPeerReviewed","hostedBy":{"key":"doajarticles::452aa4fbd96eeabcbbc859931adff1b8","value":"ChemElectroChem"},"collectedFrom":{"key":"driver______::bee53aa31dc2cbb538c10c2b65fa5824","value":"DOAJ"}}],"links":[],"otherTitles":null,"inDiamondJournal":false,"green":false,"isGreen":false,"isInDiamondJournal":false},{"authors":[{"id":null,"fullName":"Joo-Hwan Seo","name":"Joo-Hwan","surname":"Seo","rank":1,"pid":null},{"id":null,"fullName":"Zhongming Fan","name":"Zhongming","surname":"Fan","rank":2,"pid":null},{"id":null,"fullName":"Hiroto Nakaya","name":"Hiroto","surname":"Nakaya","rank":3,"pid":null},{"id":"orcid_______::36e65f068f27bff5374383c9809284e2","fullName":"Ramakrishnan Rajagopalan","name":"Ramakrishnan","surname":"Rajagopalan","rank":4,"pid":{"id":{"scheme":"orcid","value":"0000-0002-2509-5056"},"provenance":null}},{"id":null,"fullName":"Enrique D. Gomez","name":"Enrique D.","surname":"Gomez","rank":5,"pid":null},{"id":null,"fullName":"Masato Iwasaki","name":"Masato","surname":"Iwasaki","rank":6,"pid":null},{"id":null,"fullName":"Clive A. Randall","name":"Clive A.","surname":"Randall","rank":7,"pid":null}],"openAccessColor":"hybrid","publiclyFunded":false,"eoscIfGuidelines":null,"type":"publication","language":{"code":"und","label":"Undetermined"},"countries":null,"subjects":[{"subject":{"scheme":"FOS","value":"02 engineering and technology"},"provenance":null},{"subject":{"scheme":"FOS","value":"0210 nano-technology"},"provenance":null},{"subject":{"scheme":"FOS","value":"01 natural sciences"},"provenance":null},{"subject":{"scheme":"SDG","value":"7. Clean energy"},"provenance":null},{"subject":{"scheme":"FOS","value":"0104 chemical sciences"},"provenance":null}],"mainTitle":"Cold sintering, enabling a route to co-sinter an all-solid-state lithium-ion battery","subTitle":null,"descriptions":["<jats:title>Abstract</jats:title>                <jats:p>All-solid-state Li-ion batteries (ASSB) are one of the most attractive next generation batteries for large scale application due to improved safety and higher energy density. However, the high temperature process required for densification of the solid-state electrolytes and for co-sintering of the multilayered ASSB is still a major challenge for large scale fabrication. In this study, a low temperature process, named cold sintering process, is applied to co-sinter all the layers in the ASSB at a low temperature. The cold sintered ASSB, a full-cell of Li<jats:sub>4</jats:sub>Ti<jats:sub>5</jats:sub>O<jats:sub>12</jats:sub>/Li<jats:sub>7</jats:sub>La<jats:sub>3</jats:sub>Zr<jats:sub>2</jats:sub>O<jats:sub>12</jats:sub>/LiFePO<jats:sub>4,</jats:sub> has densified microstructures and exhibits impressive electrochemical performance. The ASSB delivers high capacity of 140 mAh g<jats:sup>−1</jats:sup> at 0.1 C, rate capability of up to 2 C with 85 mAh g<jats:sup>−1</jats:sup>, and 90% capacity retention over 100 cycles at room temperature under a current density of 0.2 C.</jats:p>"],"publicationDate":"2020-01-01","publisher":"IOP Publishing","embargoEndDate":null,"sources":["Crossref"],"formats":null,"contributors":null,"coverages":null,"bestAccessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/"},"container":{"name":"Japanese Journal of Applied Physics","issnPrinted":"0021-4922","issnOnline":"1347-4065","issnLinking":null,"ep":null,"iss":null,"sp":"037001","vol":"60","edition":null,"conferencePlace":null,"conferenceDate":null},"documentationUrls":null,"codeRepositoryUrl":null,"programmingLanguage":null,"contactPeople":null,"contactGroups":null,"tools":null,"size":null,"version":null,"geoLocations":null,"id":"doi_dedup___::700ba684f1f200433b556008e2017fad","originalIds":["10.35848/1347-4065/abdd4c","50|doiboost____|0f8922c0a4601871e9e0ebdd030d8416","10.2139/ssrn.3646482","50|doiboost____|700ba684f1f200433b556008e2017fad","3125917406"],"pids":[{"scheme":"doi","value":"10.35848/1347-4065/abdd4c"},{"scheme":"doi","value":"10.2139/ssrn.3646482"}],"dateOfCollection":null,"lastUpdateTimeStamp":null,"indicators":{"citationImpact":{"citationCount":36.0,"influence":2.9458425E-9,"popularity":2.4868124E-8,"impulse":19.0,"citationClass":"C4","influenceClass":"C4","impulseC