lue":"0000-0002-4984-5157"},"provenance":null}},{"id":"orcid_______::667801378483eb2b4635609b51f9be38","fullName":"Cedric Müller","name":"Cedric","surname":"Müller","rank":2,"pid":{"id":{"scheme":"orcid","value":"0000-0002-6426-9282"},"provenance":null}},{"id":"orcid_______::70de03309c74e0628b544c569e72275e","fullName":"Julian Klemens","name":"Julian","surname":"Klemens","rank":3,"pid":{"id":{"scheme":"orcid","value":"0000-0002-0257-1910"},"provenance":null}},{"id":null,"fullName":"Philip Scharfer","name":"Philip","surname":"Scharfer","rank":4,"pid":null},{"id":null,"fullName":"Wilhelm Schabel","name":"Wilhelm","surname":"Schabel","rank":5,"pid":null},{"id":"orcid_______::c764055b176f4d9af592aee892b9b069","fullName":"Marcel Häringer","name":"Marcel","surname":"Häringer","rank":6,"pid":{"id":{"scheme":"orcid","value":"0000-0002-1531-4526"},"provenance":null}},{"id":null,"fullName":"Joachim R. Binder","name":"Joachim R.","surname":"Binder","rank":7,"pid":{"id":{"scheme":"orcid_pending","value":"0000-0003-2237-1411"},"provenance":null}},{"id":"orcid_______::9b433f0ab83c13f887fd0448dab1eacb","fullName":"Andreas Hofmann","name":"Andreas","surname":"Hofmann","rank":8,"pid":{"id":{"scheme":"orcid","value":"0000-0002-9102-7641"},"provenance":null}},{"id":"orcid_______::2593602d2a72c29d68eef56899e0f799","fullName":"Anna Smith","name":"Anna","surname":"Smith","rank":9,"pid":{"id":{"scheme":"orcid","value":"0000-0002-3329-248x"},"provenance":null}}],"openAccessColor":"hybrid","publiclyFunded":false,"eoscIfGuidelines":null,"type":"publication","language":{"code":"eng","label":"English"},"countries":[{"code":"DE","label":"Germany","provenance":null}],"subjects":[{"subject":{"scheme":"FOS","value":"02 engineering and technology"},"provenance":null},{"subject":{"scheme":"FOS","value":"0210 nano-technology"},"provenance":null},{"subject":{"scheme":"FOS","value":"01 natural sciences"},"provenance":null},{"subject":{"scheme":"SDG","value":"7. Clean energy"},"provenance":null},{"subject":{"scheme":"FOS","value":"0104 chemical sciences"},"provenance":null}],"mainTitle":"Enabling Long‐term Cycling Stability of Na                     <sub>3</sub>                     V                     <sub>2</sub>                     (PO                     <sub>4</sub>                     )                     <sub>3</sub>                     /C                     <i>vs</i>                     . Hard Carbon Full‐cells","subTitle":null,"descriptions":["<jats:title>Abstract</jats:title>                   <jats:p>                     Sodium‐ion batteries are becoming an increasingly important complement to lithium‐ion batteries. However, while extensive knowledge on the preparation of Li‐ion batteries with excellent cycling behavior exists, studies on applicable long‐lasting sodium‐ion batteries are still limited. Therefore, this study focuses on the cycling stability of batteries composed of Na                     <jats:sub>3</jats:sub>                     V                     <jats:sub>2</jats:sub>                     (PO                     <jats:sub>4</jats:sub>                     )                     <jats:sub>3</jats:sub>                     /C based cathodes and hard carbon anodes. It is shown that full‐cells with a decent stability are obtained for ethylene carbonate/propylene carbonate electrolyte and the conducting salt NaPF                     <jats:sub>6</jats:sub>                     . With cathode loadings of 1.2 mAh/cm                     <jats:sup>2</jats:sup>                     , after cell formation discharge capacities up to 92.6 mAh/g are obtained, and capacity retentions &gt;90 % over 1000 charge/discharge cycles at 0.5 C/0.5 C are observed. It is shown that both, the additive fluoroethylene carbonate and impurities in the electrolyte, negatively affect the overall discharge capacity and cycling stability and should therefore be avoided. Remarkably, the internal resistances of well‐balanced and well‐built cells did not increase over 1500 cycles and 5 months of testing, which is a very promising result regarding the possible lifespan of the cells. The initial loss of active sodium ions in hard carbon remains a major problem, which can only be partially reduced by proper balancing.                   </jats:p>"],"publicationDate":"2023-12-11","publisher":"Wiley","embargoEndDate":null,"sources":["Crossref"],"formats":null,"contributors":null,"coverages":null,"bestAccessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/"},"container":{"name":"Batteries &amp; Supercaps","issnPrinted":"2566-6223","issnOnline":"2566-6223","issnLinking":null,"ep":null,"iss":null,"sp":null,"vol":"7","edition":null,"conferencePlace":null,"conferenceDate":null},"documentationUrls":null,"codeRepositoryUrl":null,"programmingLanguage":null,"contactPeople":null,"contactGroups":null,"tools":null,"size":null,"version":null,"geoLocations":null,"id":"doi_________::df90cc32e714eefd416a8c1feebf0ffd","originalIds":["10.1002/batt.202300375","50|doiboost____|df90cc32e714eefd416a8c1feebf0ffd"],"pids":[{"scheme":"doi","value":"10.1002/batt.202300375"}],"dateOfCollection":null,"lastUpdateTimeStamp":null,"indicators":{"citationImpact":{"citationCount":24.0,"influence":2.8001939E-9,"popularity":1.7356761E-8,"impulse":24.0,"citationClass":"C4","influenceClass":"C4","impulseClass":"C4","popularityClass":"C4"}},"projects":null,"organizations":[{"legalName":"Karlsruhe Institute of Technology","acronym":"KIT","id":"openorgs____::eeeeee00563ed0908fb396a26358e2fc","pids":[{"scheme":"wikidata","value":"Q11161114"},{"scheme":"ISNI","value":"0000000100755874"},{"scheme":"FundRef","value":"100009133"},{"scheme":"ROR","value":"https://ror.org/04t3en479"},{"scheme":"Wikidata","value":"Q309988"},{"scheme":"OrgRef","value":"5977314"},{"scheme":"RRID","value":"RRID:nlx_48421"},{"scheme":"mag_id","value":"102335020"},{"scheme":"GRID","value":"grid.7892.4"},{"scheme":"fundref","value":"100009133"},{"scheme":"Wikidata","value":"Q11161114"},{"scheme":"RRID","value":"RRID:SCR_001552"},{"scheme":"PIC","value":"990797674"},{"scheme":"wikidata","value":"Q309988"},{"scheme":"PIC","value":"999907332"},{"scheme":"PIC","value":"999981440"}],"countries":[{"code":"DE","label":"Germany"}],"websiteurl":"http://www.kit.edu/english/"}],"communities":[{"code":"energy-planning","label":"Energy Planning","provenance":null}],"collectedFrom":[{"key":"openaire____::081b82f96300b6a6e3d282bad31cb6e2","value":"Crossref"}],"instances":[{"pids":[{"scheme":"doi","value":"10.1002/batt.202300375"}],"license":"CC BY NC ND","accessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/","openAccessRoute":"hybrid"},"type":"Article","urls":["https://doi.org/10.1002/batt.202300375"],"publicationDate":"2023-12-11","refereed":"peerReviewed","hostedBy":{"key":"issn___print::20516cf76964013dac3e2459ef2440c8","value":"Batteries & Supercaps"},"collectedFrom":{"key":"openaire____::081b82f96300b6a6e3d282bad31cb6e2","value":"Crossref"}}],"links":[],"otherTitles":null,"inDiamondJournal":false,"green":false,"isGreen":false,"isInDiamondJournal":false},{"authors":[{"id":null,"fullName":"Charlesworth, T","name":"T.","surname":"Charlesworth","rank":1,"pid":null},{"id":null,"fullName":"Yiamsawat, K","name":"K.","surname":"Yiamsawat","rank":2,"pid":null},{"id":null,"fullName":"Gao, H","name":"H.","surname":"Gao","rank":3,"pid":null},{"id":null,"fullName":"Rees, GJ","name":"Gj","surname":"Rees","rank":4,"pid":{"id":{"scheme":"orcid_pending","value":"0000-0002-7514-1516"},"provenance":null}},{"id":null,"fullName":"Williams, CK","name":"Ck","surname":"Williams","rank":5,"pid":{"id":{"scheme":"orcid_pending","value":"0000-0002-0734-1575"},"provenance":null}},{"id":null,"fullName":"Bruce, PG","name":"Pg","surname":"Bruce","rank":6,"pid":{"id":{"scheme":"orcid_pending","value":"0000-0001-6748-3084"},"provenance":null}},{"id":"orcid_______::d8013d042418917cfc355ec2f68deec6","fullName":"Pasta, M","name":"M.","surname":"Pasta","rank":7,"pid":{"id":{"scheme":"orcid","value":"0000-0002-2613-4555"},"provenance":null}},{"id":null,"fullName":"Gregory, GL","name":"Gl","surname":"Gregory","rank":8,"pid":{"id":{"scheme":"orcid_pending","value":"0000-0002-4688-9269"},"provenance":null}}],"openAccessColor":"hybrid","publiclyFunded":false,"eoscIfGuidelines":null,"type":"publication","language":{"code":"eng","label":"English"},"countries":[{"code":"GB","label":"United Kingdom","provenance":null}],"subjects":[{"subject":{"scheme":"FOS","value":"02 engineering and technology"},"provenance":null},{"subject":{"scheme":"FOS","value":"0210 nano-technology"},"provenance":null},{"subject":{"scheme":"FOS","value":"01 natural sciences"},"provenance":null},{"subject":{"scheme":"SDG","value":"7. Clean energy"},"provenance":null},{"subject":{"scheme":"FOS","value":"0104 chemical sciences"},"provenance":null}],"mainTitle":"Lithium Borate Polycarbonates for High‐Capacity Solid‐State Composite Cathodes","subTitle":null,"descriptions":["<jats:title>Abstract</jats:title><jats:p>Improving composite cathode function is key to the success of the solid‐state battery. Maximizing attainable cathode capacity and retention requires integrating suitable polymeric binders that retain a sufficiently high ionic conductivity and long‐term chemo‐mechanical stability of the cathode active material‐solid‐electrolyte‐carbon mixture. Herein, we report block copolymer networks composed of lithium borate polycarbonates and poly(ethylene oxide) that improved the capacity (200 mAh g<jats:sup>−1</jats:sup> at 1.75 mA cm<jats:sup>−2</jats:sup>) and capacity retention (94 % over 300 cycles) of all‐solid‐state composite cathodes with nickel‐rich LiNi<jats:sub>0.8</jats:sub>Co<jats:sub>0.1</jats:sub>Mn<jats:sub>0.1</jats:sub>O<jats:sub>2</jats:sub> cathode active material, Li<jats:sub>6</jats:sub>PS<jats:sub>5</jats:sub>Cl solid electrolyte, and carbon. Tetrahedral B(OR)<jats:sub>2</jats:sub>(OH)<jats:sub>2</jats:sub><jats:sup>−</jats:sup> anions immobilized on the polycarbonate segments provide hydrogen‐bonding chain crosslinking and selective Li‐counterion conductivity, parameterized by Li‐ion transference numbers close to unity (<jats:italic>t</jats:italic><jats:sub>Li+</jats:sub>~0.94). With 90 wt % polycarbonate content and a flexible low glass transition temperature backbone, the single‐ion conductors achieved high Li‐ion conductivities of 0.2 mS cm<jats:sup>−1</jats:sup> at 30 °C. The work should inform future binder design for improving the processability of cathode composites towards commercializing solid‐state batteries, and allow use in other cell configurations, such as lithium‐sulphur cathode designs.</jats:p>"],"publicationDate":"2024-07-11","publisher":"Wiley","embargoEndDate":null,"sources":["Crossref"],"formats":null,"contributors":null,"coverages":null,"bestAccessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/"},"container":{"name":"Angewandte Chemie","issnPrinted":"0044-8249","issnOnline":"1521-3757","issnLinking":null,"ep":null,"iss":null,"sp":null,"vol":"136","edition":null,"conferencePlace":null,"conferenceDate":null},"documentationUrls":null,"codeRepositoryUrl":null,"programmingLanguage":null,"contactPeople":null,"contactGroups":null,"tools":null,"size":null,"version":null,"geoLocations":null,"id":"doi_dedup___::212c23e1e9dc8adc08698edc374ff882","originalIds":["10.1002/ange.202408246","50|doiboost____|212c23e1e9dc8adc08698edc374ff882","10.1002/anie.202408246","50|doiboost____|b2e8ce6f5dfec59a712182485a549f13","38819775","oai:ora.ox.ac.uk:uuid:02f6acbc-68f1-4cd3-997e-556d2da9aeac","50|od______1064::6af5867e156f22c1df24d7164864b788"],"pids":[{"scheme":"doi","value":"10.1002/ange.202408246"},{"scheme":"doi","value":"10.1002/anie.202408246"},{"scheme":"pmid","value":"38819775"}],"dateOfCollection":null,"lastUpdateTimeStamp":null,"indicators"