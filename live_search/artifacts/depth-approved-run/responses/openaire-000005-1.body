positories.org/documentation/access_rights/","openAccessRoute":null},"type":"Article","urls":["https://doi.org/https://doi.org/10.1002/eem2.12733"],"publicationDate":"2024-04-25","refereed":"nonPeerReviewed","hostedBy":{"key":"opendoar____::9457fc28ceb408103e13533e4a5b6bd1","value":"King Abdullah University of Science and Technology: KAUST Repository"},"collectedFrom":{"key":"openaire____::df45502607927471ecf8a6ae83683ff5","value":"Bielefeld Academic Search Engine (BASE)"}}],"links":[{"header":{"relationType":"resultProject","relationClass":"isProducedBy","relatedIdentifier":"vr__________::1e5e62235d094afd01cd56e65112fc63","relatedRecordType":"project","relationProvenance":"sysimport:actionset","trust":"0.91"},"collectedfrom":[{"dsId":"eurocrisdris::03a10eeb2f877394accb0ab51b53f84a","dsName":"SweCRIS"}],"projectTitle":"unidentified","code":"unidentified","funding":{"funder":{"id":"vr__________::VR","shortname":"VR","name":"Swedish Research Council","jurisdiction":{"code":"SE","label":"Sweden"},"pid":null},"level0":{"id":null,"description":null,"name":null},"level1":{"id":null,"description":null,"name":null},"level2":{"id":null,"description":null,"name":null}}}],"otherTitles":null,"inDiamondJournal":false,"green":true,"isGreen":true,"isInDiamondJournal":false},{"authors":[{"id":null,"fullName":"Wu, Qichao","name":"Qichao","surname":"Wu","rank":1,"pid":null},{"id":null,"fullName":"Jiang, Rongli","name":"Rongli","surname":"Jiang","rank":2,"pid":null},{"id":null,"fullName":"Liu, Huaiwen","name":"Huaiwen","surname":"Liu","rank":3,"pid":null},{"id":null,"fullName":"Li, Xiaojiang","name":"Xiaojiang","surname":"Li","rank":4,"pid":null},{"id":null,"fullName":"Xie, Dan","name":"Dan","surname":"Xie","rank":5,"pid":null}],"openAccessColor":"gold","publiclyFunded":false,"eoscIfGuidelines":null,"type":"publication","language":{"code":"eng","label":"English"},"countries":null,"subjects":[{"subject":{"scheme":"keyword","value":"Lithium-ion batteries"},"provenance":null},{"subject":{"scheme":"keyword","value":"Fe$_{{3}}$O$_{{4}}$"},"provenance":null},{"subject":{"scheme":"keyword","value":"Porous core–shell structures"},"provenance":null},{"subject":{"scheme":"keyword","value":"Physical and theoretical chemistry"},"provenance":null},{"subject":{"scheme":"keyword","value":"QD450-801"},"provenance":null},{"subject":{"scheme":"keyword","value":"QA1-939"},"provenance":null},{"subject":{"scheme":"FOS","value":"02 engineering and technology"},"provenance":null},{"subject":{"scheme":"keyword","value":"QD415-436"},"provenance":null},{"subject":{"scheme":"FOS","value":"0210 nano-technology"},"provenance":null},{"subject":{"scheme":"keyword","value":"Biochemistry"},"provenance":null},{"subject":{"scheme":"keyword","value":"Carbon"},"provenance":null},{"subject":{"scheme":"keyword","value":"Mathematics"},"provenance":null}],"mainTitle":"Facile synthesis of core–shell porous Fe$_{{3}}$O$_{{4}}$@carbon microspheres with high lithium storage performance","subTitle":null,"descriptions":["Core–shell porous Fe3O4@C (CP-Fe3O4@C) microspheres were synthesized using an environmentally viable hydrothermal method. Carbonization can reduce Fe2O3 and provide a conductive coating simultaneously. CP-Fe3O4@C microspheres as an active material for Lithium-ion batteries demonstrate pseudocapacity for improved rate performance. With a distinct nanostructure and pseudocapacitive effect, the CP-Fe3O4@C microspheres show excellent electrochemical performance (${\\sim }785~\\mathrm{mAh}{\\cdot }\\mathrm{g}^{-1}$ at $0.3~\\mathrm{A}{\\cdot }\\mathrm{g}^{-1}$ after 200 cycles). Capacity measurements of CP-Fe3O4@C microspheres suggest near 90% pseudocapacitance at relatively low scan rates ($5~\\mathrm{mV}{\\cdot }\\mathrm{s}^{-1}$)."],"publicationDate":"2020-09-01","publisher":"Académie des sciences","embargoEndDate":null,"sources":["Comptes Rendus. Chimie, Vol 23, Iss 4-5, Pp 279-289 (2020)"],"formats":null,"contributors":null,"coverages":null,"bestAccessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/"},"container":{"name":"Comptes Rendus. Chimie","issnPrinted":"1878-1543","issnOnline":null,"issnLinking":null,"ep":null,"iss":null,"sp":null,"vol":null,"edition":null,"conferencePlace":null,"conferenceDate":null},"documentationUrls":null,"codeRepositoryUrl":null,"programmingLanguage":null,"contactPeople":null,"contactGroups":null,"tools":null,"size":null,"version":null,"geoLocations":null,"id":"doajarticles::205cd0617c6bf94f880089d65547977b","originalIds":["oai:doaj.org/article:d4c5931c51b04b81ab08d65e6b150f2a","50|doajarticles::205cd0617c6bf94f880089d65547977b"],"pids":null,"dateOfCollection":null,"lastUpdateTimeStamp":null,"indicators":{"citationImpact":{"citationCount":0.0,"influence":2.1746283E-9,"popularity":1.1111055E-9,"impulse":0.0,"citationClass":"C5","influenceClass":"C5","impulseClass":"C5","popularityClass":"C5"}},"projects":null,"organizations":null,"communities":null,"collectedFrom":[{"key":"driver______::bee53aa31dc2cbb538c10c2b65fa5824","value":"DOAJ"}],"instances":[{"alternateIdentifiers":[{"scheme":"doi","value":"10.5802/crchim.18"}],"accessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/","openAccessRoute":"gold"},"type":"Article","urls":["https://doaj.org/article/d4c5931c51b04b81ab08d65e6b150f2a"],"publicationDate":"2020-09-01","refereed":"nonPeerReviewed","hostedBy":{"key":"doajarticles::a19477f8e90e7c4bc9e7c9a7c253a8e3","value":"Comptes Rendus. Chimie"},"collectedFrom":{"key":"driver______::bee53aa31dc2cbb538c10c2b65fa5824","value":"DOAJ"}}],"links":null,"otherTitles":null,"inDiamondJournal":false,"green":false,"isGreen":false,"isInDiamondJournal":false},{"authors":[{"id":"orcid_______::05dc31e78cf78a5325055f95ffbfba1c","fullName":"Binayak Roy","name":"Binayak","surname":"Roy","rank":1,"pid":{"id":{"scheme":"orcid","value":"0000-0003-1204-9808"},"provenance":null}},{"id":null,"fullName":"Urbi Pal","name":"Urbi","surname":"Pal","rank":2,"pid":{"id":{"scheme":"orcid_pending","value":"0000-0001-5962-5185"},"provenance":null}},{"id":null,"fullName":"Darcy Simondson","name":"Darcy","surname":"Simondson","rank":3,"pid":null},{"id":null,"fullName":"Cuong Nguyen","name":"Cuong","surname":"Nguyen","rank":4,"pid":null},{"id":"orcid_______::19953f75c0b7f7297929de1aebbd65d1","fullName":"Brittany V. Kerr","name":"Brittany V.","surname":"Kerr","rank":5,"pid":{"id":{"scheme":"orcid","value":"0009-0005-8123-7310"},"provenance":null}},{"id":null,"fullName":"Rosalie K. Hocking","name":"Rosalie K.","surname":"Hocking","rank":6,"pid":null},{"id":null,"fullName":"Danah Al‐Masri","name":"Danah","surname":"Al‐Masri","rank":7,"pid":null},{"id":null,"fullName":"Patrick C. Howlett","name":"Patrick C.","surname":"Howlett","rank":8,"pid":{"id":{"scheme":"orcid_pending","value":"0000-0002-2151-2932"},"provenance":null}},{"id":null,"fullName":"Maria Forsyth","name":"Maria","surname":"Forsyth","rank":9,"pid":{"id":{"scheme":"orcid_pending","value":"0000-0002-4273-8105"},"provenance":null}},{"id":"orcid_______::11c9cc31036fe3ad80c307d979b9c334","fullName":"Mega Kar","name":"Mega","surname":"Kar","rank":10,"pid":{"id":{"scheme":"orcid","value":"0000-0003-4927-6254"},"provenance":null}},{"id":null,"fullName":"Douglas R. MacFarlane","name":"Douglas R.","surname":"MacFarlane","rank":11,"pid":{"id":{"scheme":"orcid_pending","value":"0000-0001-5963-9659"},"provenance":null}}],"openAccessColor":"hybrid","publiclyFunded":false,"eoscIfGuidelines":null,"type":"publication","language":{"code":"eng","label":"English"},"countries":null,"subjects":[{"subject":{"scheme":"FOS","value":"01 natural sciences"},"provenance":null},{"subject":{"scheme":"FOS","value":"0104 chemical sciences"},"provenance":null}],"mainTitle":"Extreme Fast Charging and Stable Cycling of Lithium Manganese Oxide Batteries by Suppression of Cathode Phase Changes","subTitle":null,"descriptions":["<jats:title>Abstract</jats:title>                   <jats:p>                     Extreme fast charging (XFC, i.e., 80% state of charge within 15 min, 4C rate) remains a high‐desirability criterion for next‐generation lithium batteries. While the anodes, such as, graphite and lithium are historically acknowledged as the critical hurdles toward XFC of Li‐ion batteries, the stability of cathodes under such sustained high rate cycling has not been addressed in literature. In this work, for the first time, the XFC and 4C cycling of cobalt‐free LiMn                     <jats:sub>2</jats:sub>                     O                     <jats:sub>4</jats:sub>                     (LMO) batteries with practical areal capacity (1 mAh cm                     <jats:sup>−2</jats:sup>                     ) are investigated. This work demonstrates that the high rate cycling of LMO brings forth a cascade of irreversible phase changes in the bulk of the cathode, which initiates the electrolyte degradation. The electrolyte degradation and cathode irreversibility play a compounding role in the capacity loss during cycling, even with high‐rate compatible anodes, e.g., Li                     <jats:sub>4</jats:sub>                     Ti                     <jats:sub>5</jats:sub>                     O                     <jats:sub>12</jats:sub>                     (LTO). This capacity loss is overcome by combining a micro‐structured LMO cathode and a novel electrolyte containing a novel lithium salt, lithium 1,1,1,3,3,3 (tetrakis) hexafluoroisopropoxy borate. Cycling of the LMO|LTO cells shows 98 mAh g                     <jats:sup>−1</jats:sup>                     initial discharge capacity at 4C‐4D cycling and 91% capacity retention after 1500 cycles while charging to 90% of total capacity in 10 min.                   </jats:p>"],"publicationDate":"2025-01-07","publisher":"Wiley","embargoEndDate":null,"sources":["Crossref"],"formats":null,"contributors":null,"coverages":null,"bestAccessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/"},"container":{"name":"Advanced Functional Materials","issnPrinted":"1616-301X","issnOnline":"1616-3028","issnLinking":null,"ep":null,"iss":null,"sp":null,"vol":"35","edition":null,"conferencePlace":null,"conferenceDate":null},"documentationUrls":null,"codeRepositoryUrl":null,"programmingLanguage":null,"contactPeople":null,"contactGroups":null,"tools":null,"size":null,"version":null,"geoLocations":null,"id":"doi_________::4c55894c80239f5134ed16ee8b20a9bd","originalIds":["10.1002/adfm.202417317","50|doiboost____|4c55894c80239f5134ed16ee8b20a9bd"],"pids":[{"scheme":"doi","value":"10.1002/adfm.202417317"}],"dateOfCollection":null,"lastUpdateTimeStamp":null,"indicators":{"citationImpact":{"citationCount":7.0,"influence":2.4333933E-9,"popularity":6.8251906E-9,"impulse":7.0,"citationClass":"C5","influenceClass":"C5","impulseClass":"C4","popularityClass":"C4"}},"projects":null,"organizations":[{"legalName":"Deakin University","acronym":"Deakin University","id":"openorgs____::4e180668ce100cfd9873ab37a9289071","pids":[{"scheme":"FundRef","value":"501100003028"},{"scheme":"GRID","value":"grid.1021.2"},{"scheme":"fundref","value":"100015144"},{"scheme":"PIC","value":"999524279"},{"scheme":"FundRef","value":"501100001778"},{"scheme":"Wikidata","value":"Q1180978"},{"scheme":"wikidata","value":"Q21973208"},{"scheme":"fundref","value":"501100003028"},{"scheme":"OrgRef","value":"619887"},{"scheme":"FundRef","value":"501100017029"},{"scheme":"wikidata","value":"Q1180978"},{"scheme":"FundRef","value":"100015144"},{"scheme":"fundref","value":"501100001778"},{"scheme":"ISNI","value":"0000000105267079"},{"scheme":"fundref","value":"501100017029"},{"scheme":"Wikidata","value":"Q21973208"},{"scheme":"ROR","value":"https://ror.org/02czsnj07"},{"scheme":"mag_id","value":"149704539"}],"countries":[{"code":"AU","label":"Australia"}],"websiteurl":"http://www.deakin.edu.au/"},{"legalName":"Swinburne University of Technology","acronym":"Swinburne University of Technology","id":"openorgs____::322dccbffacd4eea9ed49be3ff7bc92b","pids":[{"scheme":"FundRef","value":"501100001781"},{"scheme":"ROR","value":"https://ror.org/031rekg67"},{"scheme":"GRID","value":"grid.1027.4"},{"scheme":"wikidata","value":"Q787234"},{"scheme":"fundref","value":"501100001781"},{"scheme":"mag_id","value":"57093077"},{"scheme":"fundref","value":"501100007916"},{"scheme":"ISNI","value":"0000000404092862"},{"scheme":"OrgRef","value":"247041"},{"scheme":"fundref","value":"501100001135"},{"scheme":"Wikidata","value":"Q787234"},{"scheme":"FundRef","value":"501100001135"},{"scheme":"FundRef","value":"501100007916"}],"countries":[{"code":"AU","label":"Australia"}],"websiteurl":"http://www.swinburne.edu.au/"},{"legalName":"Monash University","acronym":"Monash University","id":"openorgs____::639fc2398fd45606ada087e30168287b","pids":[{"scheme":"Wikidata","value":"Q598841"},{"scheme":"FundRef","value":"501100001198"},{"scheme":"ISNI","value":"0000000419367857"},{"scheme":"FundRef","value":"501100001779"},{"scheme":"mag_id","value":"56590836"},{"scheme":"GRID","value":"grid.1002.3"},{"scheme":"fundref","value":"501100007917"},{"scheme":"fundref","value":"501100000991"},{"scheme":"FundRef","value":"501100006532"},{"scheme":"fundref","value":"501100006532"},{"scheme":"fundref","value":"501100001144"},{"scheme":"wikidata","value":"Q598841"},{"scheme":"FundRef","value":"501100020821"},{"scheme":"FundRef","value":"501100001144"},{"scheme":"fundref","value":"501100001779"},{"scheme":"RRID","value":"RRID:SCR_001088"},{"scheme":"RRID","value":"RRID:nlx_77388"},{"scheme":"PIC","value":"999880269"},{"scheme":"fundref","value":"501100020821"},{"scheme":"fundref","value":"501100001198"},{"scheme":"ROR","value":"https://ror.org/02bfwt286"},{"scheme":"FundRef","value":"501100011670"},{"scheme":"fundref","value":"501100011670"},{"scheme":"FundRef","value":"501100007917"},{"scheme":"OrgRef","value":"149620"},{"scheme":"FundRef","value":"501100000991"}],"countries":[{"code":"AU","label":"Australia"}],"websiteurl":"http://www.monash.edu/"}],"communities":null,"collectedFrom":[{"key":"openaire____::081b82f96300b6a6e3d282bad31cb6e2","value":"Crossref"}],"instances":[{"pids":[{"scheme":"doi","value":"10.1002/adfm.202417317"}],"license":"CC BY","accessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/","openAccessRoute":"hybrid"},"type":"Article","urls":["https://doi.org/10.1002/adfm.202417317"],"publicationDate":"2025-01-07","refereed":"peerReviewed","hostedBy":{"key":"issn___print::36c8a97a86fef38572a907e61eb640cf","value":"Advanced Functional Materials"},"collectedFrom":{"key":"openaire____::081b82f96300b6a6e3d282bad31cb6e2","value":"Crossref"}}],"links":[],"otherTitles":null,"inDiamondJournal":false,"green":false,"isGreen":false,"isInDiamondJournal":false},{"authors":[{"id":null,"fullName":"Zhongxiaobang Hu","name":"Zhongxiaobang","surname":"Hu","rank":1,"pid":null},{"id":"orcid_______::055653c6eb9dcf661b3e95256d9fd0c9","fullName":"Yang Li","name":"Yang","surname":"Li","rank":2,"pid":{"id":{"scheme":"orcid","value":"0000-0002-9497-3051"},"provenance":null}},{"id":"orcid_______::90e07fc42614f4f837b832f5a74741ad","fullName":"Furong Liu","name":"Furong","surname":"Liu","rank":3,"pid":{"id":{"scheme":"orcid","value":"0000-0001-5695-7635"},"provenance":null}},{"id":null,"fullName":"Bo Zhao","name":"Bo","surname":"Zhao","rank":4,"pid":{"id":{"scheme":"orcid_pending","value":"0000-0003-4958-7802"},"provenance":null}},{"id":null,"fullName":"Weibo Li","name":"Weibo","surname":"Li","rank":5,"pid":null},{"id":null,"fullName":"Ruixin Yang","name":"Ruixin","surname":"Yang","rank":6,"pid":null},{"id":"orcid_______::a393175314d54f4e384cadfb1ae3829d","fullName":"Changjun Xie","name":"Changjun","surname":"Xie","rank":7,"pid":{"id":{"scheme":"orcid","value":"0000-0002-9626-0813"},"provenance":null}},{"id":null,"fullName":"Ying Shi","name":"Ying","surname":"Shi","rank":8,"pid":null}],"openAccessColor":null,"publiclyFunded":false,"eoscIfGuidelines":null,"type":"publication","language":{"code":"und","label":"Undetermined"},"countries":null,"subjects":[{"subject":{"scheme":"FOS","value":"0202 electrical engineering, electronic engineering, information engineering"},"provenance":null},{"subject":{"scheme":"FOS","value":"02 engineering and technology"},"provenance":null},{"subject":{"scheme":"FOS","value":"0210 nano-technology"},"provenance":null},{"subject":{"scheme":"SDG","value":"7. Clean energy"},"provenance":null}],"mainTitle":"Thermal Characteristics Investigation of Lithium-Ion Battery Under High-Frequency AC Excitation in Low-Temperature Environment","subTitle":null,"descriptions":["At low operating temperatures, the power capability and charging/discharging capacity of lithium-ion (Li-ion) batteries can decay rapidly. Therefore, it is essential to preheat the Li-ion batteries in advance of the normal operations of a battery electric vehicle. High-frequency AC preheating methods are advantageous to achieve a miniaturized and lightweight design. In this paper, a self-heating circuit topology is used for studying the characteristics of Li-ion batteries at low temperatures and under high-frequency AC excitation. The thermal behaviors of Li-ion batteries under high-frequency AC excitations are comprehensively analyzed with an improved heat generation model. Experimental results exhibit that heat generation due to electrochemical reactions has a significant influence on self-heating rates under the high-frequency AC excitation, and the heating rate is positively correlated with the current frequency and root-mean-square (RMS) value. Specifically, when the current frequency is 90 kHz and the RMS value is 3.51 A or 1.17C, validated by experiment and numerical simulation, a 2.9Ah 18650 Li-ion cell can be heated up from -20 °C to 5 °C in 7.33 min with an average electrochemical heat generation of 2.962 W."],"publicationDate":"2022-03-01","publisher":"Institute of Electrical and Electronics Engineers (IEEE)","embargoEndDate":null,"sources":["Crossref"],"formats":null,"contributors":null,"coverages":null,"bestAccessRight":{"code":"c_14cb","label":"CLOSED","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/"},"container":{"name":"IEEE Transactions on Transportation Electrification","issnPrinted":null,"issnOnline":"2372-2088","issnLinking":null,"ep":"419","iss":null,"sp":"407","vol":"8","edition":null,"conferencePlace":null,"conferenceDate":null},"documentationUrls":null,"codeRepositoryUrl":null,"programmingLanguage":null,"contactPeople":null,"contactGroups":null,"tools":null,"size":null,"version":null,"geoLocations":null,"id":"doi_dedup___::931c9e912f7de3e801c30179dee12a7a","originalIds":["10.1109/tte.2021.3113945","50|doiboost____|931c9e912f7de3e801c30179dee12a7a","3200598543"],"pids":[{"scheme":"doi","value":"10.1109/tte.2021.3113945"}],"dateOfCollection":null,"lastUpdateTimeStamp":null,"indicators":{"citationImpact":{"citationCount":34.0,"influence":3.27552E-9,"popularity":2.409468E-8,"impulse":32.0,"citationClass":"C4","influenceClass":"C4","impulseClass":"C3","popularityClass":"C4"}},"projects":null,"organizations":[{"legalName":"Beijing Institute of Technology","acronym":"BIT","id":"openorgs____::702a658f9208947ed97c158f4373edba","pids":[{"scheme":"wikidata","value":"Q23101"},{"scheme":"fundref","value":"501100012236"},{"scheme":"FundRef","value":"501100012236"},{"scheme":"Wikidata","value":"Q23101"},{"scheme":"GRID","value":"grid.43555.32"},{"scheme":"OrgRef","value":"342924"},{"scheme":"PIC","value":"997714744"},{"scheme":"fundref","value":"501100005085"},{"scheme":"ISNI","value":"0000000088416246"},{"scheme":"ROR","value":"https://ror.org/01skt4w74"},{"scheme":"FundRef","value":"501100005085"},{"scheme":"mag_id","value":"125839683"}],"countries":[{"code":"CN","label":"China (People's Republic of)"}],"websiteurl":"http://engl