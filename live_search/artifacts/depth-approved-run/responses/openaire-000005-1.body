ates"}],"websiteurl":"http://www.epri.com/Pages/Default.aspx"}],"communities":[{"code":"energy-planning","label":"Energy Planning","provenance":null}],"collectedFrom":[{"key":"openaire____::081b82f96300b6a6e3d282bad31cb6e2","value":"Crossref"},{"key":"openaire____::5f532a3fc4f1ea403f37070f59a7a53a","value":"Microsoft Academic Graph"}],"instances":[{"pids":[{"scheme":"doi","value":"10.1109/tte.2021.3113945"}],"license":"IEEE Copyright","accessRight":{"code":"c_14cb","label":"CLOSED","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/","openAccessRoute":null},"type":"Article","urls":["https://doi.org/10.1109/tte.2021.3113945"],"publicationDate":"2022-03-01","refereed":"peerReviewed","hostedBy":{"key":"openaire____::55045bd2a65019fd8e6741a755395c8c","value":"Unknown Repository"},"collectedFrom":{"key":"openaire____::081b82f96300b6a6e3d282bad31cb6e2","value":"Crossref"}},{"alternateIdentifiers":[{"scheme":"mag_id","value":"3200598543"},{"scheme":"doi","value":"10.1109/tte.2021.3113945"}],"type":"Article","urls":["https://dx.doi.org/10.1109/tte.2021.3113945"],"refereed":"nonPeerReviewed","hostedBy":{"key":"openaire____::55045bd2a65019fd8e6741a755395c8c","value":"Unknown Repository"},"collectedFrom":{"key":"openaire____::5f532a3fc4f1ea403f37070f59a7a53a","value":"Microsoft Academic Graph"}},{"alternateIdentifiers":[{"scheme":"mag_id","value":"3200598543"},{"scheme":"doi","value":"10.1109/tte.2021.3113945"}],"type":"Article","urls":["https://dx.doi.org/10.1109/tte.2021.3113945"],"refereed":"nonPeerReviewed","hostedBy":{"key":"openaire____::55045bd2a65019fd8e6741a755395c8c","value":"Unknown Repository"},"collectedFrom":{"key":"openaire____::5f532a3fc4f1ea403f37070f59a7a53a","value":"Microsoft Academic Graph"}}],"links":[],"otherTitles":null,"inDiamondJournal":false,"green":false,"isGreen":false,"isInDiamondJournal":false},{"authors":[{"id":null,"fullName":"Quy Phuong Chau","name":null,"surname":null,"rank":1,"pid":null},{"id":null,"fullName":"Thanh Liem Pham","name":null,"surname":null,"rank":2,"pid":null},{"id":null,"fullName":"Dinh Quan Nguyen","name":null,"surname":null,"rank":3,"pid":null},{"id":null,"fullName":"My Loan Phung Le","name":null,"surname":null,"rank":4,"pid":null},{"id":null,"fullName":"Van Man Tran","name":null,"surname":null,"rank":5,"pid":null},{"id":"orcid_______::0fa37654acf136036c1424f71aeb8dee","fullName":"Thien Trung Nguyen","name":null,"surname":null,"rank":6,"pid":{"id":{"scheme":"orcid","value":"0000-0003-1936-5125"},"provenance":null}}],"openAccessColor":"gold","publiclyFunded":false,"eoscIfGuidelines":null,"type":"publication","language":{"code":"und","label":"Undetermined"},"countries":null,"subjects":[{"subject":{"scheme":"keyword","value":"High concentration electrolyte, matching up full cell, Sodium-ion batteries"},"provenance":null},{"subject":{"scheme":"keyword","value":"Technology"},"provenance":null},{"subject":{"scheme":"keyword","value":"Science"},"provenance":null},{"subject":{"scheme":"keyword","value":"T"},"provenance":null},{"subject":{"scheme":"keyword","value":"Q"},"provenance":null},{"subject":{"scheme":"FOS","value":"01 natural sciences"},"provenance":null},{"subject":{"scheme":"SDG","value":"7. Clean energy"},"provenance":null},{"subject":{"scheme":"FOS","value":"0104 chemical sciences"},"provenance":null},{"subject":{"scheme":"SDG","value":"3. Good health"},"provenance":null}],"mainTitle":"Compatibility and effect of capacity ratios between Na3V2(PO4)3 and hard carbon in highly concentrated sodium bis (fluorosulfonyl) imide electrolyte","subTitle":null,"descriptions":["<jats:p>From the standpoint of preserving the Earth's resources and ensuring the long-term viability of humanity, it is imperative to transition away from lithium-ion batteries. High-performance and safe sodium-ion batteries have recently emerged as promising advanced batteries for application in stationary energy storage, attributed to their low cost and abundance of sodium ion. We demonstrate the compatibility and effect of the negative-positive capacity ratio in full-cell Na3V2(PO4)3 and hard carbon in high-concentration electrolytes. Thanks to the excellent oxidation stability of the electrolyte, during 100 cycles, the full cell with a negative-positive capacity ratio of 1.1 demonstrated a consistent capacity of around 100 mAh g-1 with a capacity retention of 90.7%, whereas the full cell with a ratio of 1.0 showed a steady discharge capacity of roughly 90 mAh g-1 with a capacity retention of approaching 100% at a current density of C/5.</jats:p>"],"publicationDate":"2024-03-25","publisher":"Can Tho University","embargoEndDate":null,"sources":["Crossref","CTU Journal of Innovation and Sustainable Development, Vol 16, Iss 1 (2024)"],"formats":null,"contributors":null,"coverages":null,"bestAccessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/"},"container":{"name":"CTU Journal of Innovation and Sustainable Development","issnPrinted":"2588-1418","issnOnline":"2815-6412","issnLinking":null,"ep":null,"iss":null,"sp":null,"vol":"16","edition":null,"conferencePlace":null,"conferenceDate":null},"documentationUrls":null,"codeRepositoryUrl":null,"programmingLanguage":null,"contactPeople":null,"contactGroups":null,"tools":null,"size":null,"version":null,"geoLocations":null,"id":"doi_dedup___::a5b62d3efa494ab3548d4f28cf9e2862","originalIds":["10.22144/ctujoisd.2024.271","50|doiboost____|a5b62d3efa494ab3548d4f28cf9e2862","oai:doaj.org/article:bd15f62754b445feab2e14d68f05c8f6","50|doajarticles::7581cd6bee47621904e12dd5895f3f70","oai:doaj.org/article:0b94897d0b234f808c3802033f6e14f9","50|doajarticles::e67ae0ea8940aad208a6b064c58e0f75"],"pids":[{"scheme":"doi","value":"10.22144/ctujoisd.2024.271"}],"dateOfCollection":null,"lastUpdateTimeStamp":null,"indicators":{"citationImpact":{"citationCount":0.0,"influence":2.1746283E-9,"popularity":1.944044E-9,"impulse":0.0,"citationClass":"C5","influenceClass":"C5","impulseClass":"C5","popularityClass":"C5"}},"projects":null,"organizations":[{"legalName":"University of Technology","acronym":"University of Technology","id":"openorgs____::192bfaacda7dbd5e5949f3dc145c629e","pids":[{"scheme":"ISNI","value":"0000000458950316"},{"scheme":"wikidata","value":"Q4233933"},{"scheme":"ROR","value":"https://ror.org/03gbw6p94"},{"scheme":"Wikidata","value":"Q4233933"},{"scheme":"GRID","value":"grid.483960.0"}],"countries":[{"code":"RU","label":"Russian Federation"}],"websiteurl":"http://unitech-mo.ru/eng/"},{"legalName":"University of the Sciences","acronym":"University of the Sciences","id":"openorgs____::9f04bc90809c06141ab1c326a54d539c","pids":[{"scheme":"wikidata","value":"Q3443159"},{"scheme":"ROR","value":"https://ror.org/048gmay44"},{"scheme":"OrgRef","value":"284987"},{"scheme":"Wikidata","value":"Q3443159"},{"scheme":"mag_id","value":"110357561"},{"scheme":"GRID","value":"grid.267627.0"},{"scheme":"ISNI","value":"0000000087947643"},{"scheme":"FundRef","value":"100018549"},{"scheme":"fundref","value":"100018549"}],"countries":[{"code":"US","label":"United States"}],"websiteurl":"http://www.usciences.edu/"},{"legalName":"Ho Chi Minh City University of Science","acronym":"HCMUS","id":"openorgs____::a71d0d38b9595b8997cfe7e08026db03","pids":[{"scheme":"OrgRef","value":"28252460"},{"scheme":"FundRef","value":"501100004692"},{"scheme":"wikidata","value":"Q5873997"},{"scheme":"ISNI","value":"0000000406428526"},{"scheme":"mag_id","value":"23582244"},{"scheme":"ROR","value":"https://ror.org/05jfbgm49"},{"scheme":"Wikidata","value":"Q5873997"},{"scheme":"GRID","value":"grid.454160.2"},{"scheme":"fundref","value":"501100004692"}],"countries":[{"code":"VN","label":"Viet Nam"}],"websiteurl":"http://www.hcmus.edu.vn/en/index.php"},{"legalName":"Vietnam National University, Ho Chi Minh City","acronym":"VNUHCM","id":"openorgs____::1243b9aeb40390246f9b9d4b4011f7e4","pids":[{"scheme":"fundref","value":"501100010712"},{"scheme":"GRID","value":"grid.444808.4"},{"scheme":"OrgRef","value":"9968958"},{"scheme":"mag_id","value":"123565023"},{"scheme":"ISNI","value":"000000012037434X"},{"scheme":"ROR","value":"https://ror.org/00waaqh38"},{"scheme":"Wikidata","value":"Q943759"},{"scheme":"wikidata","value":"Q943759"},{"scheme":"FundRef","value":"501100010712"}],"countries":[{"code":"VN","label":"Viet Nam"}],"websiteurl":"https://vnuhcm.edu.vn"}],"communities":[{"code":"energy-planning","label":"Energy Planning","provenance":null}],"collectedFrom":[{"key":"driver______::bee53aa31dc2cbb538c10c2b65fa5824","value":"DOAJ"},{"key":"openaire____::081b82f96300b6a6e3d282bad31cb6e2","value":"Crossref"}],"instances":[{"pids":[{"scheme":"doi","value":"10.22144/ctujoisd.2024.271"}],"license":"CC BY NC","accessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/","openAccessRoute":"hybrid"},"type":"Article","urls":["https://doi.org/10.22144/ctujoisd.2024.271"],"publicationDate":"2024-03-25","refereed":"peerReviewed","hostedBy":{"key":"doajarticles::ca1bd05568b90059ba4586a47d43706e","value":"CTU Journal of Innovation and Sustainable Development"},"collectedFrom":{"key":"openaire____::081b82f96300b6a6e3d282bad31cb6e2","value":"Crossref"}},{"accessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/","openAccessRoute":null},"type":"Article","urls":["https://doaj.org/article/bd15f62754b445feab2e14d68f05c8f6"],"publicationDate":"2024-03-01","refereed":"nonPeerReviewed","hostedBy":{"key":"doajarticles::ca1bd05568b90059ba4586a47d43706e","value":"CTU Journal of Innovation and Sustainable Development"},"collectedFrom":{"key":"driver______::bee53aa31dc2cbb538c10c2b65fa5824","value":"DOAJ"}},{"alternateIdentifiers":[{"scheme":"doi","value":"10.22144/ctujoisd.2024.271"}],"accessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/","openAccessRoute":null},"type":"Article","urls":["https://doaj.org/article/0b94897d0b234f808c3802033f6e14f9"],"publicationDate":"2024-03-01","refereed":"nonPeerReviewed","hostedBy":{"key":"doajarticles::ca1bd05568b90059ba4586a47d43706e","value":"CTU Journal of Innovation and Sustainable Development"},"collectedFrom":{"key":"driver______::bee53aa31dc2cbb538c10c2b65fa5824","value":"DOAJ"}}],"links":[],"otherTitles":null,"inDiamondJournal":false,"green":false,"isGreen":false,"isInDiamondJournal":false},{"authors":[{"id":null,"fullName":"WANG, Wencong","name":"Wencong","surname":"WANG","rank":1,"pid":null},{"id":null,"fullName":"HANZAWA, Hiromasa","name":"Hiromasa","surname":"HANZAWA","rank":2,"pid":null},{"id":null,"fullName":"MACHIDA, Ken-ichi","name":"Ken-ichi","surname":"MACHIDA","rank":3,"pid":null},{"id":null,"fullName":"MIYAZAKI, Kohei","name":"Kohei","surname":"MIYAZAKI","rank":4,"pid":{"id":{"scheme":"orcid_pending","value":"0000-0001-5177-3570"},"provenance":null}},{"id":null,"fullName":"ABE, Takeshi","name":"Takeshi","surname":"ABE","rank":5,"pid":{"id":{"scheme":"orcid_pending","value":"0000-0002-1515-8340"},"provenance":null}}],"openAccessColor":"gold","publiclyFunded":false,"eoscIfGuidelines":null,"type":"publication","language":{"code":"eng","label":"English"},"countries":null,"subjects":[{"subject":{"scheme":"keyword","value":"Technology"},"provenance":null},{"subject":{"scheme":"keyword","value":"T"},"provenance":null},{"subject":{"scheme":"keyword","value":"Physical and theoretical chemistry"},"provenance":null},{"subject":{"scheme":"keyword","value":"QD450-801"},"provenance":null},{"subject":{"scheme":"FOS","value":"02 engineering and technology"},"provenance":null},{"subject":{"scheme":"keyword","value":"Nanorod"},"provenance":null},{"subject":{"scheme":"keyword","value":"doping"},"provenance":null},{"subject":{"scheme":"keyword","value":"high-rate performance"},"provenance":null},{"subject":{"scheme":"FOS","value":"01 natural sciences"},"provenance":null},{"subject":{"scheme":"SDG","value":"7. Clean energy"},"provenance":null},{"subject":{"scheme":"keyword","value":"nanorod"},"provenance":null},{"subject":{"scheme":"keyword","value":"Li-rich Layered Cathodes"},"provenance":null},{"subject":{"scheme":"FOS","value":"0104 chemical sciences"},"provenance":null},{"subject":{"scheme":"keyword","value":"High-rate Performance"},"provenance":null},{"subject":{"scheme":"FOS","value":"0202 electrical engineering, electronic engineering, information engineering"},"provenance":null},{"subject":{"scheme":"keyword","value":"Doping"},"provenance":null},{"subject":{"scheme":"keyword","value":"li-rich layered cathodes"},"provenance":null}],"mainTitle":"Electrochemical Performance of Nanorod-like (La, Zr) Co-Doped Li-rich Li1.2Ni0.2Mn0.6O2 Cathodes for Use in Lithium-Ion Batteries","subTitle":null,"descriptions":["A lithium-rich layered structure in lithium-ion batteries (LIBs) has attracted much attention due to its high capacity of over 250 mAh g−1 after activation. This could satisfy the requirements of next-generation energy-storage devices. However, a spinel-like impurity phase that forms from the pristine layered structure during cycling is considered to be harmful to the structure stability and Li+ mobility, resulting in undesired electrochemical performance. In this study, nanorod-like Li1.2Ni0.2Mn0.6O2 with a three-dimensional architecture was synthesized by evaporative-crystallization with as-prepared nano-MnO2 as a hard template. The structure stability and Li+ mobility of the nanorod-like Li1.2Ni0.2Mn0.6O2 was improved by the addition of an appropriate molar ratios of (La, Zr) co-dopants. This combination exhibited outstanding capacity retention of 80.9 % with a stable discharge capacity of 102 mAh g−1 after 300 cycles under a high current density of 1000 mA g−1 (corresponding to 5 C). This study suggests that the use of a multi-prong strategy that combines morphology control and co-doping should be an effective method for improving the high-rate performance of Li-rich materials."],"publicationDate":"2022-01-01","publisher":"The Electrochemical Society of Japan","embargoEndDate":null,"sources":["Electrochemistry, Vol 90, Iss 1, Pp 017008-017008 (2022)"],"formats":null,"contributors":null,"coverages":null,"bestAccessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/"},"container":{"name":"Electrochemistry","issnPrinted":"2186-2451","issnOnline":null,"issnLinking":null,"ep":null,"iss":null,"sp":null,"vol":null,"edition":null,"conferencePlace":null,"conferenceDate":null},"documentationUrls":null,"codeRepositoryUrl":null,"programmingLanguage":null,"contactPeople":null,"contactGroups":null,"tools":null,"size":null,"version":null,"geoLocations":null,"id":"dedup_wf_002::0b2e9030d9890cdbd5f68b588fd94ea5","originalIds":["oai:doaj.org/article:463b8593dbf24b4d93686559f9083504","50|doajarticles::0a7009dca305e86d89768d9926747a30","doi:10.5796/electrochemistry.21-00115","50|efb2be5d8919::85e9f0c1dcfbf3489d8a525b62fc54f3"],"pids":null,"dateOfCollection":null,"lastUpdateTimeStamp":null,"indicators":{"citationImpact":{"citationCount":0.0,"influence":2.1746283E-9,"popularity":1.4615026E-9,"impulse":0.0,"citationClass":"C5","influenceClass":"C5","impulseClass":"C5","popularityClass":"C5"}},"projects":null,"organizations":[{"legalName":"Osaka University","acronym":"Osaka University","id":"openorgs____::ecba883a3c9132fccb04cf3d60753bae","pids":[{"scheme":"ISNI","value":"0000000403733971"},{"scheme":"Wikidata","value":"Q39650724"},{"scheme":"fundref","value":"501100004206"},{"scheme":"mag_id","value":"98285908"},{"scheme":"wikidata","value":"Q651233"},{"scheme":"OrgRef","value":"3378942"},{"scheme":"PIC","value":"991625375"},{"scheme":"wikidata","value":"Q39650724"},{"scheme":"wikidata","value":"Q11440159"},{"scheme":"GRID","value":"grid.136593.b"},{"scheme":"OrgRef","value":"1098410"},{"scheme":"Wikidata","value":"Q11440159"},{"scheme":"FundRef","value":"501100004206"},{"scheme":"ROR","value":"https://ror.org/035t8zc32"},{"scheme":"Wikidata","value":"Q651233"}],"countries":[{"code":"JP","label":"Japan"}],"websiteurl":"http://www.osaka-u.ac.jp/en"},{"legalName":"Kyoto University","acronym":"Kyoto University","id":"openorgs____::41a7efa9b4b3dbf6e5acb73e9efb22d4","pids":[{"scheme":"FundRef","value":"501100005683"},{"scheme":"ROR","value":"https://ror.org/02kpeqv85"},{"scheme":"fundref","value":"501100004094"},{"scheme":"VIAF","value":"VIAF:156538319"},{"scheme":"fundref","value":"501100007695"},{"scheme":"OrgRef","value":"187911"},{"scheme":"FundRef","value":"501100007695"},{"scheme":"RRID","value":"RRID:SCR_004108"},{"scheme":"FundRef","value":"501100013226"},{"scheme":"mag_id","value":"22299242"},{"scheme":"FundRef","value":"501100002917"},{"scheme":"fundref","value":"501100006086"},{"scheme":"fundref","value":"100016926"},{"scheme":"RRID","value":"RRID:nlx_60798"},{"scheme":"fundref","value":"501100005683"},{"scheme":"FundRef","value":"501100004094"},{"scheme":"fundref","value":"501100013226"},{"scheme":"FundRef","value":"501100006086"},{"scheme":"Wikidata","value":"Q336264"},{"scheme":"fundref","value":"501100002917"},{"scheme":"ISNI","value":"0000000403722033"},{"scheme":"wikidata","value":"Q336264"},{"scheme":"FundRef","value":"100016926"},{"scheme":"GRID","value":"grid.258799.8"}],"countries":[{"code":"JP","label":"Japan"}],"websiteurl":"http://www.kyoto-u.ac.jp/en"}],"communities":[{"code":"energy-planning","label":"Energy Planning","provenance":null}],"collectedFrom":[{"key":"openaire____::4965150f44bea971d2749c39dfdcacaf","value":"Japan Link Center"},{"key":"driver______::bee53aa31dc2cbb538c10c2b65fa5824","value":"DOAJ"}],"instances":[{"alternateIdentifiers":[{"scheme":"doi","value":"10.5796/electrochemistry.21-00115"}],"accessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/","openAccessRoute":"gold"},"type":"Article","urls":["https://doaj.org/article/463b8593dbf24b4d93686559f9083504"],"publicationDate":"2022-01-01","refereed":"nonPeerReviewed","hostedBy":{"key":"doajarticles::9445e615e726eb3d0cbd2729363eb0e3","value":"Electrochemistry"},"collectedFrom":{"key":"driver______::bee53aa31dc2cbb538c10c2b65fa5824","value":"DOAJ"}},{"alternateIdentifiers":[{"scheme":"doi","value":"10.5796/electrochemistry.21-00115"}],"accessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/","openAccessRoute":"gold"},"type":"Article","urls":["https://doi.org/10.5796/electrochemistry.21-00115"],"publicationDate":"2022-01-15","refereed":"peerReviewed","hostedBy":{"key":"doajarticles::9445e615e726eb3d0cbd2729363eb0e3","value":"Electrochemistry"},"collectedFrom":{"key":"openaire____::4965150f44bea971d2749c39dfdcacaf","value":"Japan Link Center"}}],"links":[],"otherTitles":null,"inDiamondJournal":false,"green":false,"isGreen":false,"isInDiamondJournal":false},{"authors":[{"id":null,"fullName":"Zhikun Huang","name":"Zhikun","surname":"Huang","rank":1,"pid":null},{"id":null,"fullName":"Chenghao Cui","name":"Chenghao","surname":"Cui","rank":2,"pid":null},{"id":null,"fullName":"Kai Wang","name":"Kai","surname":"Wang","rank":3,"pid":null},{"id":null,"fullName":"Hongyun Ma","name":"Hongyun","surname":"Ma","rank":4,"pid":null},{"id":null,"fullName":"Guoyu Pan","name":"Guoyu","surname":"Pan","rank":5,"pid":null},{"id":null,"fullName":"Yuanfan Gu","name":"Yuanfan","surname":"Gu","rank":6,"pid":null},{"id":null,"fullName":"Yingjie Gao","name":"Yingjie","surname":"Gao","rank":7,"pid":null},{"id":"orcid_______::d433641c53fadff8c9d1b9c24c750696","fullName":"Wujie Qiu","name":"Wujie","surname":"Qiu","rank":8,"pid":{"id":{"scheme":"orcid","value":"0000-0001-7332-9171"},"provenance":null}},{"id":null,"fullName":"Zhuang Sun","name":"Zhuang","surname":"Sun","rank":9,"pid":null},{"id":null,"fullName":"Tao Zhang","name":"Tao","surname":"Zhang","rank":10,"pid":{"id":{"scheme":"orcid_pending","value":"0000-0003-2469-699x"},"provenance":null}}],"openAccessColor":null,"publiclyFunded":false,"eoscIfGuidelines":null,"type":"publication","language":{"code":"eng","label":"English"},"countries":null,"subjects":[{"subject":{"scheme":"FOS","value":"02 engineering and technology"},"provenance":null},{"subject":{"scheme":"FOS","value":"0210 nano-technology"},"provenance":null}],"mainTitle":"Synergistic Pore Architecture and Surface Lithiation Enable Li                     <sub>3</sub>                     PO                     <sub>4</sub>                     -Dominated Interphases for Ultrahigh-Rate Graphite Anodes","subTitle":null,"descriptions":["Designing high-rate anodes for lithium-ion batteries (LIBs) remains a critical challenge due to the sluggish ion dynamics and capacity degradation of graphite-based materials under high-rate cycling. Here, we present a surface-lithiated porous graphite (LPG) anode designed through synergistic structural and interfacial modifications. Micron-scale pores introduced on graphite basal planes reduce Li+ diffusion distance while maintaining a low specific surface area (≤ 2 m2·g-1), ensuring an initial Coulombic efficiency exceeding 90%. Surface lithium-containing groups are identified as a key factor in inducing the formation of a Li3PO4-enriched solid electrolyte interface (SEI), which effectively mitigates Li+-solvent interactions and enhances desolvation kinetics. As a result, LPG anodes exhibit good high-rate capabilities, delivering a delithiated capacity of 327 mAh·g-1 at 50 C and retaining 88.9% initial capacity after 2000 cycles at 5 C. With kilogram-scale production and soft-pack battery verification, this strategy positions LPG as a scalable, high-rate anode solution for next-generation LIBs, achieving a good balance between rate performance and capacity retention. Surface-lithiated porous graphite achieves a good balance in balancing rate performance and capacity retention for lithium-ion batteries."],"publicationDate":"2025-10-29","publisher":"American Chemical Society (ACS)","embargoEndDate":null,"sources":["Crossref"],"formats":null,"contributors":null,"coverages":null,"bestAccessRight":{"code":"c_14cb","label":"CLOSED","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/"},"container":{"name":"ACS Nano","issnPrinted":"1936-0851","issnOnline":"1936-086X","issnLinking":null,"ep":"38593","iss":null,"sp":"38583","vol":"19","edition":null,"conferencePlace":null,"conferenceDate":null},"documentationUrls":null,"codeRepositoryUrl":null,"programmingLanguage":null,"contactPeople":null,"contactGroups":null,"tools":null,"size":null,"version":null,"geoLocations":null,"id":"doi_dedup___::f64c6e39c71fc3f0ac6b9c8fecd36557","originalIds":["10.1021/acsnano.5c13044","50|doiboost____|f64c6e39c71fc3f0ac6b9c8fecd36557","41160844"],"pids":[{"scheme":"doi","value":"10.1021/acsnano.5c13044"},{"scheme":"pmid","value":"41160844"}],"dateOfCollection":null,"lastUpdateTimeStamp":null,"indicators":{"citationImpact":{"citationCount":8.0,"influence":2.4290532E-9,"popularity":6.755796E-9,"impulse":8.0,"citationClass":"C5","influenceClass":"C5","impulseClass":"C4","popularityClass":"C4"}},"projects":null,"organizations":[{"legalName":"University of Chinese Academy of Sciences","acronym":"UCAS","id":"openorgs____::bd84daa73666b8ede0e886f71fde9dac","pids":[{"scheme":"OrgRef","value":"6704292"},{"scheme":"wikidata","value":"Q6544465"},{"scheme":"ISNI","value":"0000000417978419"},{"scheme":"GRID","value":"grid.410726.6"},{"scheme":"ROR","value":"https://ror.org/05qbk4x57"},{"scheme":"fundref","value":"501100015361"},{"scheme":"FundRef","value":"501100011332"},{"scheme":"fundref","value":"501100011332"},{"scheme":"Wikidata","value":"Q6544465"},{"scheme":"FundRef","value":"501100015361"}],"countries":[{"code":"CN","label":"China (People's Republic of)"}],"websiteurl":"http://www.ucas.ac.cn/"},{"legalName":"Shanghai Second Polytechnic University","acronym":"SSPU","id":"openorgs____::a7a0bf932126d36b78aab913738193d7","pids":[{"scheme":"fundref","value":"501100015604"},{"scheme":"GRID","value":"grid.412535.4"},{"scheme":"wikidata","value":"Q17013222"},{"scheme":"Wikidata","value":"Q17013222"},{"scheme":"mag_id","value":"61388159"},{"scheme":"FundRef","value":"501100015604"},{"scheme":"ROR","value":"https://ror.org/02as5yg64"},{"scheme":"mag_id","value":"135905480"},{"scheme":"mag_id","value":"157183634"},{"scheme":"ISNI","value":"0000000091947697"}],"countries":[{"code":"CN","label":"China (People's Republic of)"}],"websiteurl":"http://www.sspu.edu.cn/"},{"legalName":"State Key Laboratory of High Performance Ceramics and Superfine Microstructure","acronym":"State Key Laboratory of High Performance Ceramics and Superfine Microstructure","id":"pending_org_::2dbabfcca9119121fd73baec8ce8fec1","pids":[{"scheme":"fundref","value":"501100011413"},{"scheme":"FundRef","value":"501100011413"},{"scheme":"ROR","value":"https://ror.org/03yvpw311"}],"countries":[{"code":"CN","label":"China (People's Republic of)"}],"websiteurl":"http://www.skl.sic.cas.cn"},{"legalName":"Shanghai Institute of Ceramics","acronym":"SICCAS","id":"openorgs____::33b96cbbdc18f10152ad8dc645a070db","pids":[{"scheme":"ROR","value":"https://ror.org/05etnz140"},{"scheme":"fundref","value":"501100010875"},{"scheme":"ISNI","value":"0000000119576294"},{"scheme":"GRID","value":"grid.454856.e"},{"scheme":"FundRef","value":"501100010875"}],"countries":[{"code":"CN","label":"China (People's Republic of)"}],"websiteurl":"http://english.sic.cas.cn/"},{"legalName":"Chinese Academy of Sciences","acronym":"CAS","id":"openorgs____::5529875fee5e1f070225a154ae69437b","pids":[{"scheme":"FundRef","value":"501100003165"},{"scheme":"ROR","value":"https://ror.org/034t30j35"},{"scheme":"fundref","value":"501100012430"},{"scheme":"OrgRef","value":"377856"},{"scheme":"fundref","value":"501100003165"},{"scheme":"Wikidata","value":"Q530471"},{"scheme":"fundref","value":"501100013494"},{"scheme":"fundref","value":"501100002367"},{"scheme":"fundref","value":"501100018527"},{"scheme":"fundref","value":"501100005151"},{"scheme":"RRID","value":"RRID:SCR_012797"},{"scheme":"ISNI","value":"0000000119573309"},{"scheme":"FundRef","value":"501100005151"},{"scheme":"mag_id","value":"19820366"},{"scheme":"GRID","value":"grid.9227.e"},{"scheme":"wikidata","value":"Q530471"},{"scheme":"FundRef","value":"501100018527"},{"scheme":"FundRef","value":"501100002367"},{"scheme":"FundRef","value":"501100012430"},{"scheme":"FundRef","value":"501100013494"}],"countries":[{"code":"CN","label":"China (People's Republic of)"}],"websiteurl":"http://english.cas.cn/"}],"communities":null,"collectedFrom":[{"key":"openaire____::081b82f96300b6a6e3d282bad31cb6e2","value":"Crossref"},{"key":"opendoar____::8b6dd7db9af49e67306feb59a8bdc52c","value":"Europe PubMed Central"}],"instances":[{"pids":[{"scheme":"doi","value":"10.1021/acsnano.5c13044"}],"license":"STM Policy #29","accessRight":{"code":"c_14cb","label":"CLOSED","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/","openAccessRoute":null},"type":"Article","urls":["https://doi.org/10.1021/acsnano.5c13044"],"publicationDate":"2025-10-29","refereed":"peerReviewed","hostedBy":{"key":"issn___print::562bcc1bdcb1981919f148a40ecb3f67","value":"ACS Nano"},"collectedFrom":{"key":"openaire____::081b82f96300b6a6e3d282bad31cb6e2","value":"Crossref"}},{"pids":[{"scheme":"pmid","value":"41160844"}],"alternateIdentifiers":[{"scheme":"doi","value":"10.1021/acsnano.5c13044"}],"type":"Article","urls":["https://pubmed.ncbi.nlm.nih.gov/41160844"],"refereed":"nonPeerReviewed","hostedBy":{"key":"issn___print::562bcc1bdcb1981919f148a40ecb3f67","value":"ACS Nano"},"collectedFrom":{"key":"opendoar____::8b6dd7db9af49e67306feb59a8bdc52c","value":"Europe PubMed Central"}}],"links":[],"otherTitles":null,"inDiamondJournal":false,"green":false,"isGreen":false,"isInDiamondJournal":false},{"authors":[{"id":"orcid_______::0089cf424d77474d975fc2faef0796c1","fullName":"Pirmin Stüble","name":"Pirmin","surname":"Stüble","rank":1,"pid":{"id":{"scheme":"orcid","value":"0000-0002-4984-5157"},"provenance":null}},{"id":null,"fullName":"Cedric Müller","name":"Cedric","surname":"Müller","rank":2,"pid":null},{"id":null,"fullName":"Julian Klemens","name":"Julian","surname":"Klemens","rank":3,"pid":null},{"id":null,"fullName":"Philip Scharfer","name":"Philip","surname":"Scharfer","rank":4,"pid":null},{"id":null,"fullName":"Wilhelm Schabel","name":"Wilhelm","surname":"Schabel","rank":5,"pid":null},{"id":null,"fullName":"Marcel Häringer","name":"Marcel","surname":"Häringer","rank":6,"pid":null},{"id":null,"fullName":"Joachim R. Binder","name":"Joachim R.","surname":"Binder","rank":7,"pid":null},{"id":null,"fullName":"Andreas Hofmann","name":"Andreas","surname":"Hofmann","rank":8,"pid":null},{"id":null,"fullName":"Anna Smith","name":"Anna","surname":"Smith","rank":9,"pid":null}],"openAccessColor":"hybrid","publiclyFunded":false,"eoscIfGuidelines":null,"type":"publication","language":{"code":"und","label":"Undetermined"},"countries":null,"subjects":[{"subject":{"scheme":"FOS","value":"01 natural sciences"},"provenance":null},{"subject":{"scheme":"SDG","value":"7. Clean energy"},"provenance":null},{"subject":{"scheme":"FOS","value":"0104 chemical sciences"},"provenance":null}],"mainTitle":"Enabling Long-term Cycling Stability of Na3V2(PO4)3/C vs. Hard Carbon Full-cells","subTitle":null,"descriptions":["<jats:p>Sodium-ion batteries are becoming an increasingly important complement to lithium-ion batteries. However, while extensive knowledge on the preparation of Li-ion batteries with excellent cycling behavior exists, studies on applicable long-lasting sodium-ion batteries are still limited. Therefore, this study focuses on the cycling stability of batteries composed of Na3V2(PO4)3/C based cathodes and hard carbon anodes. It is shown that full cells with a decent stability are obtained for ethylene carbonate / propylene carbonate electrolyte and the conducting salt NaPF6. With cathode loadings of 1.2 mAh/cm², after cell formation discharge capacities up to 92.6 mAh/g are obtained, and capacity retentions &gt; 90 % over 1000 charge / discharge cycles at 0.5 C / 0.5 C are observed. It is shown that both, the additive fluoroethylene carbonate and traces of water in the cell, negatively affect the overall discharge capacity and cycling stability and should therefore be avoided. Remarkably, the internal resistances of well-balanced and wellbuilt cells did not increase over 1500 cycles and 5 months of testing, which is a very promising result regarding the possible lifespan of the cells. The initial loss of active sodium in hard carbon remains a major problem, which can only be partially reduced by proper balancing.</jats:p>"],"publicationDate":"2023-08-17","publisher":"American Chemical Society (ACS)","embargoEndDate":null,"sources":["Crossref"],"formats":null,"contributors":null,"coverages":null,"bestAccessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/"},"container":null,"documentationUrls":null,"codeRepositoryUrl":null,"programmingLanguage":null,"contactPeople":null,"contactGroups":null,"tools":null,"size":null,"version":null,"geoLocations":null,"id":"doi_________::5d7f92072622750d1b2744f894d2dd15","originalIds":["10.26434/chemrxiv-2023-jf6mq","50|doiboost____|5d7f92072622750d1b2744f894d2dd15"],"pids":[{"scheme":"doi","value":"10.26434/chemrxiv-2023-jf6mq"}],"dateOfCollection":null,"lastUpdateTimeStamp":null,"indicators":{"citationImpact":{"citationCount":2.0,"influence":2.239586E-9,"popularity":3.05195E-9,"impulse":2.0,"citationClass":"C5","influenceClass":"C5","impulseClass":"C5","popularityClass":"C4"}},"projects":null,"organizations":[{"legalName":"Karlsruhe Institute of Technology","acronym":"KIT","id":"openorgs____::eeeeee00563ed0908fb396a26358e2fc","pids":[{"scheme":"wikidata","value":"Q11161114"},{"scheme":"ISNI","value":"0000000100755874"},{"scheme":"FundRef","value":"100009133"},{"scheme":"ROR","value":"https://ror.org/04t3en479"},{"scheme":"Wikidata","value":"Q309988"},{"scheme":"OrgRef","value":"5977314"},{"scheme":"RRID","value":"RRID:nlx_48421"},{"scheme":"mag_id","value":"102335020"},{"scheme":"GRID","value":"grid.7892.4"},{"scheme":"fundref","value":"100009133"},{"scheme":"Wikidata","value":"Q11161114"},{"scheme":"RRID","value":"RRID:SCR_001552"},{"scheme":"PIC","value":"990797674"},{"scheme":"wikidata","value":"Q309988"},{"scheme":"PIC","value":"999907332"},{"scheme":"PIC","value":"999981440"}],"countries":[{"code":"DE","label":"Germany"}],"websiteurl":"http://www.kit.edu/english/"}],"communities":[{"code":"energy-planning","label":"Energy Planning","provenance":null}],"collectedFrom":[{"key":"openaire____::081b82f96300b6a6e3d282bad31cb6e2","value":"Crossref"}],"instances":[{"pids":[{"scheme":"doi","value":"10.26434/chemrxiv-2023-jf6mq"}],"license":"CC BY NC ND","accessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/","openAccessRoute":"hybrid"},"type":"Article","urls":["https://doi.org/10.26434/chemrxiv-2023-jf6mq"],"publicationDate":"2023-08-17","refereed":"peerReviewed","hostedBy":{"key":"openaire____::55045bd2a65019fd8e6741a755395c8c","value":"Unknown Repository"},"collectedFrom":{"key":"openaire____::081b82f96300b6a6e3d282bad31cb6e2","value":"Crossref"}}],"links":[],"otherTitles":null,"inDiamondJournal":false,"green":false,"isGreen":false,"isInDiamondJournal":false},{"authors":[{"id":null,"fullName":"Shiyu Zhang","name":"Shiyu","surname":"Zhang","rank":1,"pid":null},{"id":"orcid_______::8701a2bd298027b21e7b469526d9d45d","fullName":"Jiantao Li","name":"Jiantao","surname":"Li","rank":2,"pid":{"id":{"scheme":"orcid","value":"0000-0003-2277-849x"},"provenance":null}},{"id":"orcid_______::1f799e64316bdef1c4dd6621eb56566f","fullName":"Benli Jiang","name":"Benli","surname":"Jiang","rank":3,"pid":{"id":{"scheme":"orcid","value":"0000-0003-1916-8383"},"provenance":null}},{"id":"orcid_______::f3ec9c1f4bfde360d65adf0712f6476f","fullName":"Guanyi Wang","name":"Guanyi","surname":"Wang","rank":4,"pid":{"id":{"scheme":"orcid","value":"0000-0002-2751-5843"},"provenance":null}},{"id":null,"fullName":"Chengkun Zhang","name":"Chengkun","surname":"Zhang","rank":5,"pid":null},{"id":null,"fullName":"Chengyu Wang","name":"Chengyu","surname":"Wang","rank":6,"pid":null},{"id":null,"fullName":"Xinchao Hu","name":"Xinchao","surname":"Hu","rank":7,"pid":null},{"id":null,"fullName":"Jie Shen","name":"Jie","surname":"Shen","rank":8,"pid":null},{"id":null,"fullName":"Ziyi Fang","name":"Ziyi","surname":"Fang","rank":9,"pid":null},{"id":null,"fullName":"Liang Lin","name":"Liang","surname":"Lin","rank":10,"pid":null},{"id":null,"fullName":"Guiyang Gao","name":"Guiyang","surname":"Gao","rank":11,"pid":null},{"id":null,"fullName":"Yuming Jin","name":"Yuming","surname":"Jin","rank":12,"pid":null},{"id":null,"fullName":"Baisheng Sa","name":"Baisheng","surname":"Sa","rank":13,"pid":{"id":{"scheme":"orcid_pending","value":"0000-0002-9455-7795"},"provenance":null}},{"id":null,"fullName":"Laisen Wang","name":"Laisen","surname":"Wang","rank":14,"pid":null},{"id":null,"fullName":"Jie Lin","name":"Jie","surname":"Lin","rank":15,"pid":{"id":{"scheme":"orcid_pending","value":"0000-0002-1281-9713"},"provenance":null}},{"id":null,"fullName":"Qingshui Xie","name":"Qingshui","surname":"Xie","rank":16,"pid":{"id":{"scheme":"orcid_pending","value":"0000-0003-2105-6962"},"provenance":null}},{"id":null,"fullName":"Dong-Liang Peng","name":"Dong-Liang","surname":"Peng","rank":17,"pid":{"id":{"scheme":"orcid_pending","value":"0000-0003-4155-4766"},"provenance":null}}],"openAccessColor":"gold","publiclyFunded":false,"eoscIfGuidelines":null,"type":"publication","language":{"code":"eng","label":"English"},"countries":null,"subjects":[{"subject":{"scheme":"FOS","value":"01 natural sciences"},"provenance":null},{"subject":{"scheme":"FOS","value":"0104 chemical sciences"},"provenance":null}],"mainTitle":"Tailoring electrolyte phase separation for high-rate solid-state lithium metal batteries","subTitle":null,"descriptions":["<jats:title>Abstract</jats:title>                   <jats:p>                     Solid polymer electrolytes are attractive for solid-state lithium metal batteries due to their flexibility and safety but suffer from low ionic conductivity and unstable interfaces. Conventional polymerization-induced phase separation strategies enhance ion transport yet rely on external components such as deep eutectic solvents or ionic liquids, increasing cost and complexity. Here, a LiTFSI-mediated in-situ polymerization strategy is developed to induce controllable phase separation in a poly(vinylene carbonate) matrix using a single solvent. Electrostatic interactions between lithium salts and the polymer drive self-organized dual phases that combine mechanical robustness with efficient ion transport. The resulting PVC electrolyte achieves a tunable ionic conductivity from 0.20 to 0.92 mS/cm at 25 °C and a high lithium-ion transference number of 0.78. Li|PVC-24h | LiFePO                     <jats:sub>4</jats:sub>                     cells achieve 121.4 mAh/g at 5 C (12 min) with 90% capacity retention after 4000 cycles, demonstrating a scalable approach for high-performance polymer electrolytes.                   </jats:p>"],"publicationDate":"2026-06-08","publisher":"Springer Science and Business Media LLC","embargoEndDate":null,"sources":["Crossref"],"formats":null,"contributors":null,"coverages":null,"bestAccessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/"},"container":{"name":"Nature Communications","issnPrinted":null,"issnOnline":"2041-1723","issnLinking":null,"ep":null,"iss":null,"sp":null,"vol":"17","edition":null,"conferencePlace":null,"conferenceDate":null},"documentationUrls":null,"codeRepositoryUrl":null,"programmingLanguage":null,"contactPeople":null,"contactGroups":null,"tools":null,"size":null,"version":null,"geoLocations":null,"id":"doi_________::1ceae6ece04be9474db480be36ed3b67","originalIds":["74094","10.1038/s41467-026-74094-w","50|doiboost____|1ceae6ece04be9474db480be36ed3b67"],"pids":[{"scheme":"doi","value":"10.1038/s41467-026-74094-w"}],"dateOfCollection":null,"lastUpdateTimeStamp":null,"indicators":{"citationImpact":{"citationCount":0.0,"influence":2.1746283E-9,"popularity":2.6085654E-9,"impulse":0.0,"citationClass":"C5","influenceClass":"C5","impulseClass":"C5","popularityClass":"C5"}},"projects":null,"organizations":null,"communities":null,"collectedFrom":[{"key":"openaire____::081b82f96300b6a6e3d282bad31cb6e2","value":"Crossref"}],"instances":[{"pids":[{"scheme":"doi","value":"10.1038/s41467-026-74094-w"}],"license":"CC BY","accessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/","openAccessRoute":"gold"},"type":"Article","urls":["https://doi.org/10.1038/s41467-026-74094-w"],"publicationDate":"2026-06-08","refereed":"peerReviewed","hostedBy":{"key":"openaire____::d9b7be21c63bb885703f2a24ff2938cf","value":"Nature Communications"},"collectedFrom":{"key":"openaire____::081b82f96300b6a6e3d282bad31cb6e2","value":"Crossref"}}],"links":null,"otherTitles":null,"inDiamondJournal":false,"green":false,"isGreen":false,"isInDiamondJournal":false},{"authors":[{"id":"orcid_______::3eef29903ac9b7dbe8d17f86b59f45dc","fullName":"Md Adil","name":"Md","surname":"Adil","rank":1,"pid":{"id":{"scheme":"orcid","value":"0000-0001-5552-677x"},"provenance":null}},{"id":null,"fullName":"Maximilian Schmidt","name":"Maximilian","surname":"Schmidt","rank":2,"pid":null},{"id":null,"fullName":"Julia Vogt","name":"Julia","surname":"Vogt","rank":3,"pid":null},{"id":null,"fullName":"Thomas Diemant","name":"Thomas","surname":"Diemant","rank":4,"pid":null},{"id":null,"fullName":"Martin Oschatz","name":"Martin","surname":"Oschatz","rank":5,"pid":null},{"id":"orcid_______::b002ed33f5d6b68f4d3f55bf56fe20de","fullName":"Birgit Esser","name":"Birgit","surname":"Esser","rank":6,"pid":{"id":{"scheme":"orcid","value":"0000-0002-2430-1380"},"provenance":null}}],"openAccessColor":"hybrid","publiclyFunded":false,"eoscIfGuidelines":null,"type":"publication","language":{"code":"und","label":"Undetermined"},"countries":null,"subjects":[{"subject":{"scheme":"FOS","value":"01 natural sciences"},"provenance":null},{"subject":{"scheme":"SDG","value":"7. Clean energy"},"provenance":null},{"subject":{"scheme":"FOS","value":"0104 chemical sciences"},"provenance":null},{"subject":{"scheme":"SDG","value":"3. Good health"},"provenance":null}],"mainTitle":"Pillarquinone-based sodium-ion batteries using a highly concentrated electrolyte","subTitle":null,"descriptions":["<jats:p>Sodium-ion batteries using organic electrode materials are a promising alternative to state-of-the-art lithium-ion batteries. However, their practical viability is hindered by challenges such as a low specific capacity of the organic electrode materials, suboptimal interfacial compatibility, the availability of suitable electrolytes, or intrinsic dissolution issues associated with the organic materials. Previous research primarily addressed dissolution mitigation through electrode or materials engineering, often neglecting the substantial influence of the electrolyte. Herein, we use a highly concentrated electrolyte with a small-molecule organic positive electrode based on pillar[5]quinone (P5Q) with a high theoretical specific capacity of 446 mAh g−1, encapsulated within CMK-3 as mesoporous carbon, achieving record cycling performance with improved cycling stability even at elevated temperature (40 °C). Using 5 M sodium bis(fluorosulfonyl)imide in succinonitrile as electrolyte, the P5Q@CMK-3 composite electrode delivers 430 mAh g−1 specific discharge capacity at 0.2C and retains 90% of this value over 200 cycles. This corresponds to an impressive energy density of 831 Wh kg−1 (based on P5Q mass) and surpasses previous reports based on pillarquinones as electrode material. When operated at 40 °C, the P5Q@CMK-3 composite electrodes deliver a record-specific discharge capacity of 438 mAh g−1 with 88% capacity retention over 500 cycles, which translates to a minimal capacity decay of only 0.02% per cycle, and with ca. 100% Coulombic efficiency. This study underscores the crucial role of the electrolyte in advancing the prospect of organic sodium batteries for large-scale energy storage applications, offering a promising avenue for the future of sustainable energy technologies.</jats:p>"],"publicationDate":"2024-01-29","publisher":"American Chemical Society (ACS)","embargoEndDate":null,"sources":["Crossref"],"formats":null,"contributors":null,"coverages":null,"bestAccessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/"},"container":null,"documentationUrls":null,"codeRepositoryUrl":null,"programmingLanguage":null,"contactPeople":null,"contactGroups":null,"tools":null,"size":null,"version":null,"geoLocations":null,"id":"doi_________::a259e0f87c4a5d57331c16d01cdf3fb8","originalIds":["10.26434/chemrxiv-2024-v9znj","50|doiboost____|a259e0f87c4a5d57331c16d01cdf3fb8"],"pids":[{"scheme":"doi","value":"10.26434/chemrxiv-2024-v9znj"}],"dateOfCollection":null,"lastUpdateTimeStamp":null,"indicators":{"citationImpact":{"citationCount":0.0,"influence":2.1746283E-9,"popularity":1.944044E-9,"impulse":0.0,"citationClass":"C5","influenceClass":"C5","impulseClass":"C5","popularityClass":"C5"}},"projects":null,"organizations":[{"legalName":"Helmholtz-Institute Ulm","acronym":"HIU","id":"openorgs____::24502860b347f68bf63bfd426b918c8e","pids":[{"scheme":"GRID","value":"grid.461900.a"},{"scheme":"ISNI","value":"0000000480043173"},{"scheme":"ROR","value":"https://ror.org/034rhsb33"}],"countries":[{"code":"DE","label":"Germany"}],"websiteurl":"http://www.hiu-batteries.de/battery-research-center-in-germany/"},{"legalName":"Helmholtz Association of German Research Centres","acronym":"Helmholtz Association of German Research Centres","id":"openorgs____::4dee7ea0d1fd1b48c199ee744e21dc13","pids":[{"scheme":"FundRef","value":"501100009318"},{"scheme":"mag_id","value":"1305996414"},{"scheme":"ISNI","value":"0000000119425154"},{"scheme":"ROR","value":"https://ror.org/0281dp749"},{"scheme":"OrgRef","value":"734041"},{"scheme":"fundref","value":"501100009318"},{"scheme":"fundref","value":"501100001656"},{"scheme":"FundRef","value":"501100001656"},{"scheme":"OrgReg","value":"DE1061"},{"scheme":"GRID","value":"grid.211011.2"},{"scheme":"wikidata","value":"Q679913"},{"scheme":"Wikidata","value":"Q679913"}],"countries":[{"code":"DE","label":"Germany"}],"websiteurl":"http://www.helmholtz.de/en/"},{"legalName":"Friedrich Schiller University Jena","acronym":"FSU","id":"openorgs____::f729b2897d3163c51a6fd5c9867c6dce","pids":[{"scheme":"ISNI","value":"0000000119392794"},{"scheme":"Wikidata","value":"Q154561"},{"scheme":"OrgRef","value":"356844"},{"scheme":"wikidata","value":"Q154561"},{"scheme":"fundref","value":"100012957"},{"scheme":"OrgReg","value":"DE0110"},{"scheme":"FundRef","value":"100012957"},{"scheme":"mag_id","value":"76198965"},{"scheme":"RRID","value":"RRID:SCR_011249"},{"scheme":"GRID","value":"grid.9613.d"},{"scheme":"ROR","value":"https://ror.org/05qpz1x62"},{"scheme":"PIC","value":"999868726"}],"countries":[{"code":"DE","label":"Germany"}],"websiteurl":"https://www.uni-jena.de/en/start.html"},{"legalName":"University of Ulm","acronym":"University of Ulm","id":"openorgs____::bebf21d464a16875edbb788b6f24577a","pids":[{"scheme":"GRID","value":"grid.6582.9"},{"scheme":"PIC","value":"999882209"},{"scheme":"OrgReg","value":"DE0009"},{"scheme":"ROR","value":"https://ror.org/032000t02"},{"scheme":"fundref","value":"501100013812"},{"scheme":"mag_id","value":"196349391"},{"scheme":"FundRef","value":"501100013812"},{"scheme":"wikidata","value":"Q835662"},{"scheme":"Wikidata","value":"Q835662"},{"scheme":"FundRef","value":"501100019218"},{"scheme":"fundref","value":"501100008977"},{"scheme":"FundRef","value":"501100008977"},{"scheme":"ISNI","value":"0000000419369748"},{"scheme":"OrgRef","value":"5290513"},{"scheme":"fundref","value":"501100019218"}],"countries":[{"code":"DE","label":"Germany"}],"websiteurl":"https://www.uni-ulm.de/en/homepage.html"}],"communities":[{"code":"energy-planning","label":"Energy Planning","provenance":null}],"collectedFrom":[{"key":"openaire____::081b82f96300b6a6e3d282bad31cb6e2","value":"Crossref"}],"instances":[{"pids":[{"scheme":"doi","value":"10.26434/chemrxiv-2024-v9znj"}],"license":"CC BY NC","accessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/","openAccessRoute":"hybrid"},"type":"Article","urls":["https://doi.org/10.26434/chemrxiv-2024-v9znj"],"publicationDate":"2024-01-29","refereed":"peerReviewed","hostedBy":{"key":"openaire____::55045bd2a65019fd8e6741a755395c8c","value":"Unknown Repository"},"collectedFrom":{"key":"openaire____::081b82f96300b6a6e3d282bad31cb6e2","value":"Crossref"}}],"links":[],"otherTitles":null,"inDiamondJournal":false,"green":false,"isGreen":false,"isInDiamondJournal":false},{"authors":[{"id":null,"fullName":"Kwon, SeYi","name":"Seyi","surname":"Kwon","rank":1,"pid":null},{"id":null,"fullName":"Lee, Jun-Ki","name":"Jun-Ki","surname":"Lee","rank":2,"pid":null}],"openAccessColor":"gold","publiclyFunded":false,"eoscIfGuidelines":null,"type":"publication","language":{"code":"eng","label":"English"},"countries":null,"subjects":[{"subject":{"scheme":"keyword","value":"porous Si/SiO<sub>2</sub>"},"provenance":null},{"subject":{"scheme":"keyword","value":"single-walled carbon nanotube"},"provenance":null},{"subject":{"scheme":"keyword","value":"core–shell nanostructure"},"provenance":null},{"subject":{"scheme":"keyword","value":"silicon anode"},"provenance":null},{"subject":{"scheme":"keyword","value":"magnesiothermic reduction"},"provenance":null},{"subject":{"scheme":"FOS","value":"02 engineering and technology"},"provenance":null},{"subject":{"scheme":"keyword","value":"lithium-ion battery"},"provenance":null},{"subject":{"scheme":"FOS","value":"0210 nano-technology"},"provenance":null}],"mainTitle":"Single-Walled Carbon Nanotube Templated Three-Dimensional Porous Si/SiO2 Core–Shell Cylindrical Hybrid Anode Material for Lithium-Ion Batteries","subTitle":null,"descriptions":["<jats:p>Silicon (Si) is a leading anode candidate for next-generation lithium-ion batteries owing to its high theoretical capacity (~4200 mAh/g), but its &gt;300% volumetric expansion during lithiation causes particle pulverization, loss of electrical contact, and continuous solid electrolyte interphase (SEI) reformation, resulting in rapid capacity fade. Here, we report a single-walled carbon nanotube (SWNT)-templated porous Si/SiO2 core–shell cylindrical hybrid anode synthesized by combining block copolymer-directed sol–gel assembly with controlled magnesiothermic reduction. SWNT bundles act as a three-dimensional structural template that directs the formation of a continuously interconnected cylindrical porous network, a geometry difficult to obtain by conventional particle-based compositing. The controlled, partial magnesiothermic reduction intentionally preserves residual amorphous SiO2 within the porous shell as an electrochemically inactive mechanical buffer that suppresses Si volume expansion and stabilizes the electrode. A side-by-side comparison with a fully reduced, SiO2-free counterpart of identical architecture isolates the role of the SiO2 buffer in achieving long-term cycling stability. The SWNT-porous Si/SiO2 hybrid delivers a reversible capacity of 1133 mAh/g in the first cycle and retains 90% of its initial capacity after 200 cycles at 1 C with 99.7% Coulombic efficiency, together with a rate capability of 482 mAh/g at 5 C. Post-cycling cross-sectional analysis confirms minimal electrode-level swelling (~2 μm) after 200 cycles, demonstrating the structural efficacy of the SWNT-templated porous architecture combined with the SiO2 buffer for structurally stable Si anodes.</jats:p>"],"publicationDate":"2026-06-18","publisher":"MDPI AG","embargoEndDate":null,"sources":["Crossref","Batteries","Volume 12","Issue 6","Pages: 220"],"formats":["application/pdf"],"contributors":null,"coverages":null,"bestAccessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/"},"container":{"name":"Batteries","issnPrinted":null,"issnOnline":"2313-0105","issnLinking":null,"ep":null,"iss":null,"sp":"220","vol":"12","edition":null,"conferencePlace":null,"conferenceDate":null},"documentationUrls":null,"codeRepositoryUrl":null,"programmingLanguage":null,"contactPeople":null,"contactGroups":null,"tools":null,"size":null,"version":null,"geoLocations":null,"id":"doi_dedup___::0796cc9eec8714100a544d00dfa2575d","originalIds":["batteries12060220","10.3390/batteries12060220","50|doiboost____|0796cc9eec8714100a544d00dfa2575d","50|multidiscipl::6b2c8318e9639898070bc406228eb7aa","oai:mdpi.com:/2313-0105/12/6/220/"],"pids":[{"scheme":"doi","value":"10.3390/batteries12060220"}],"dateOfCollection":null,"lastUpdateTimeStamp":null,"indicators":{"citationImpact":{"citationCount":0.0,"influence":2.1746283E-9,"popularity":2.6085654E-9,"impulse":0.0,"citationClass":"C5","influenceClass":"C5","impulseClass":"C5","popularityClass":"C5"}},"projects":null,"organizations":null,"communities":[{"code":"enermaps","label":"Energy Research","provenance":null}],"collectedFrom":[{"key":"openaire____::c2cdfa5866e03cdd07d313cbc8fb8311","value":"Multidisciplinary Digital Publishing Institute"},{"key":"openaire____::081b82f96300b6a6e3d282bad31cb6e2","value":"Crossref"}],"instances":[{"pids":[{"scheme":"doi","value":"10.3390/batteries12060220"}],"license":"CC BY","accessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/","openAccessRoute":"gold"},"type":"Article","urls":["https://doi.org/10.3390/batteries12060220"],"publicationDate":"2026-06-18","refereed":"peerReviewed","hostedBy":{"key":"doajarticles::25557f1fa59bf7f45023ed5cda6df7d3","value":"Batteries"},"collectedFrom":{"key":"openaire____::081b82f96300b6a6e3d282bad31cb6e2","value":"Crossref"}},{"alternateIdentifiers":[{"scheme":"doi","value":"10.3390/batteries12060220"}],"license":"CC BY","accessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/","openAccessRoute":"gold"},"type":"Article","urls":["https://dx.doi.org/10.3390/batteries12060220"],"publicationDate":"2026-06-18","refereed":"peerReviewed","hostedBy":{"key":"doajarticles::25557f1fa59bf7f45023ed5cda6df7d3","value":"Batteries"},"collectedFrom":{"key":"openaire____::c2cdfa5866e03cdd07d313cbc8fb8311","value":"Multidisciplinary Digital Publishing Institute"}}],"links":[],"otherTitles":null,"inDiamondJournal":false,"green":false,"isGreen":false,"isInDiamondJournal":false},{"authors":[{"id":null,"fullName":"Guoqiang Zhang","name":"Guoqiang","surname":"Zhang","rank":1,"pid":null},{"id":null,"fullName":"Kui Lin","name":"Kui","surname":"Lin","rank":2,"pid":null},{"id":null,"fullName":"Xianying Qin","name":"Xianying","surname":"Qin","rank":3,"pid":{"id":{"scheme":"orcid_pending","value":"0000-0001-7563-4719"},"provenance":null}},{"id":null,"fullName":"Lihan Zhang","name":"Lihan","surname":"Zhang","rank":4,"pid":null},{"id":null,"fullName":"Tong Li","name":"Tong","surname":"Li","rank":5,"pid":null},{"id":null,"fullName":"Fengzheng Lv","name":"Fengzheng","surname":"Lv","rank":6,"pid":null},{"id":null,"fullName":"Yue Xia","name":"Yue","surname":"Xia","rank":7,"pid":null},{"id":null,"fullName":"Wenjie Han","name":"Wenjie","surname":"Han","rank":8,"pid":null},{"id":"orcid_______::0b9a3577ffd72da9f4b9992e67fcaea7","fullName":"Feiyu Kang","name":"Feiyu","surname":"Kang","rank":9,"pid":{"id":{"scheme":"orcid","value":"0000-0002-3704-4379"},"provenance":null}},{"id":null,"fullName":"Baohua Li","name":"Baohua","surname":"Li","rank":10,"pid":{"id":{"scheme":"orcid_pending","value":"0000-0001-5559-5767"},"provenance":null}}],"openAccessColor":null,"publiclyFunded":false,"eoscIfGuidelines":null,"type":"publication","language":{"code":"eng","label":"English"},"countries":null,"subjects":[{"subject":{"scheme":"FOS","value":"02 engineering and technology"},"provenance":null},{"subject":{"scheme":"FOS","value":"0210 nano-technology"},"provenance":null},{"subject":{"scheme":"FOS","value":"01 natural sciences"},"provenance":null},{"subject":{"scheme":"SDG","value":"7. Clean energy"},"provenance":null},{"subject":{"scheme":"FOS","value":"0104 chemical sciences"},"provenance":null}],"mainTitle":"Electrosprayed Robust Graphene Layer Constructing Ultrastable Electrode Interface for High-Voltage Lithium-Ion Batteries","subTitle":null,"descriptions":["Aluminum (Al) foil serving as the most widely used cathode current collector for lithium-ion batteries (LIBs) is still not flawless to fulfill the increasing demand of rechargeable energy storage systems. The limited contact area and weak adhesion to cathode material as well as local corrosion during long-term operations could deteriorate the performance of LIBs with a higher working voltage. Herein, a reduced graphene oxide (RGO)-modified Al foil (RGO/Al) is developed via electrospraying to increase interfacial adhesion and inhibit anodic corrosion as a functional current collector. Valid corrosion resistance to electrolyte and strengthened adhesion of electrode particles to current collectors are beneficial to improve the interfacial reaction dynamics. The RGO/Al-based LiNi0.5Mn1.5O4 cells (LNMO-RGO/Al) exhibit better electrochemical performances in terms of long-term cycling discharge capacity retention (90% after 840 cycles at 1 C), rate capability (101.8 mAh g-1 at 5 C), and interfacial resistance, prominently superior to bare Al-based cells (LNMO-Al). This work not only contributes to long-term stable operation of high-voltage LIBs but also brings new opportunities for the development of next-generation 5 V LIBs."],"publicationDate":"2020-07-29","publisher":"American Chemical Society (ACS)","embargoEndDate":null,"sources":["Crossref"],"formats":null,"contributors":null,"coverages":null,"bestAccessRight":{"code":"c_14cb","label":"CLOSED","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/"},"container":{"name":"ACS Applied Materials &amp; Interfaces","issnPrinted":"1944-8244","issnOnline":"1944-8252","issnLinking":null,"ep":"37046","iss":null,"sp":"37034","vol":"12","edition":null,"conferencePlace":null,"conferenceDate":null},"documentationUrls":null,"codeRepositoryUrl":null,"programmingLanguage":null,"contactPeople":null,"contactGroups":null,"tools":null,"size":null,"version":null,"geoLocations":null,"id":"doi_dedup___::7498a5cad551ee3152cdf1a215928973","originalIds":["10.1021/acsami.0c06698","50|doiboost____|7498a5cad551ee3152cdf1a215928973","32814379","3045970669"],"pids":[{"scheme":"doi","value":"10.1021/acsami.0c06698"},{"scheme":"pmid","value":"32814379"}],"dateOfCollection":null,"lastUpdateTimeStamp":null,"indicators":{"citationImpact":{"citationCount":21.0,"influence":2.626646E-9,"popularity":1.5190384E-8,"impulse":14.0,"citationClass":"C4","influenceClass":"C5","impulseClass":"C4","popularityClass":"C4"}},"projects":null,"organizations":[{"legalName":"Tsinghua University","acronym":"THU","id":"openorgs____::343e897b3a9e6f6facaf57aec940ed2a","pids":[{"scheme":"FundRef","value":"501100004407"},{"scheme":"FundRef","value":"501100005150"},{"scheme":"Wikidata","value":"Q16955"},{"scheme":"mag_id","value":"99065089"},{"scheme":"ISNI","value":"0000000106623178"},{"scheme":"PIC","value":"999855631"},{"scheme":"fundref","value":"501100004407"},{"scheme":"OrgRef","value":"869246"},{"scheme":"fundref","value":"501100005150"},{"scheme":"wikidata","value":"Q16955"},{"scheme":"GRID","value":"grid.12527.33"},{"scheme":"ROR","value":"https://ror.org/03cve4549"},{"scheme":"fundref","value":"501100004147"},{"scheme":"OrgRef","value":"72595"},{"scheme":"FundRef","value":"501100004147"}],"countries":[{"code":"CN","label":"China (People's Republic of)"}],"websiteurl":"http://www.tsinghua.edu.cn/publish/newthuen/"}],"communities":[{"code":"energy-planning","label":"Energy Planning","provenance":null}],"collectedFrom":[{"key":"openaire____::081b82f96300b6a6e3d282bad31cb6e2","value":"Crossref"},{"key":"openaire____::5f532a3fc4f1ea403f37070f59a7a53a","value":"Microsoft Academic Graph"},{"key":"opendoar____::8b6dd7db9af49e67306feb59a8bdc52c","value":"Europe PubMed Central"}],"instances":[{"pids":[{"scheme":"doi","value":"10.1021/acsami.0c06698"}],"license":"STM Policy #29","accessRight":{"code":"c_14cb","label":"CLOSED","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/","openAccessRoute":null},"type":"Article","urls":["https://doi.org/10.1021/acsami.0c06698"],"publicationDate":"2020-07-29","refereed":"peerReviewed","hostedBy":{"key":"issn___print::5b25957e9ed002ddda51b8e62d068ec3","value":"ACS Applied Materials & Interfaces"},"collectedFrom":{"key":"openaire____::081b82f96300b6a6e3d282bad31cb6e2","value":"Crossref"}},{"pids":[{"scheme":"pmid","value":"32814379"}],"alternateIdentifiers":[{"scheme":"doi","value":"10.1021/acsami.0c06698"}],"type":"Article","urls":["https://pubmed.ncbi.nlm.nih.gov/32814379"],"refereed":"nonPeerReviewed","hostedBy":{"key":"issn___print::5b25957e9ed002ddda51b8e62d068ec3","value":"ACS Applied Materials & Interfaces"},"collectedFrom":{"key":"opendoar____::8b6dd7db9af49e67306feb59a8bdc52c","value":"Europe PubMed Central"}},{"alternateIdentifiers":[{"scheme":"mag_id","value":"3045970669"},{"scheme":"doi","value":"10.1021/acsami.0c06698"}],"type":"Article","urls":["https://dx.doi.org/10.1021/acsami.0c06698"],"refereed":"nonPeerReviewed","hostedBy":{"key":"openaire____::55045bd2a65019fd8e6741a755395c8c","value":"Unknown Repository"},"collectedFrom":{"key":"openaire____::5f532a3fc4f1ea403f37070f59a7a53a","value":"Microsoft Academic Graph"}},{"alternateIdentifiers":[{"scheme":"mag_id","value":"3045970669"},{"scheme":"doi","value":"10.1021/acsami.0c06698"}],"type":"Article","urls":["https://dx.doi.org/10.1021/acsami.0c06698"],"refereed":"nonPeerReviewed","hostedBy":{"key":"openaire____::55045bd2a65019fd8e6741a755395c8c","value":"Unknown Repository"},"collectedFrom":{"key":"openaire____::5f532a3fc4f1ea403f37070f59a7a53a","value":"Microsoft Academic Graph"}}],"links":[],"otherTitles":null,"inDiamondJournal":false,"green":false,"isGreen":false,"isInDiamondJournal":false},{"authors":[{"id":null,"fullName":"Xiaoyan Wang","name":"Xiaoyan","surname":"Wang","rank":1,"pid":null},{"id":null,"fullName":"Le Yang","name":"Le","surname":"Yang","rank":2,"pid":null},{"id":"orcid_______::641e36233b4091b18a23a7529c5cdffe","fullName":"Niaz Ahmad","name":"Niaz","surname":"Ahmad","rank":3,"pid":{"id":{"scheme":"orcid","value":"0000-0002-4490-4947"},"provenance":null}},{"id":null,"fullName":"Leguan Ran","name":"Leguan","surname":"Ran","rank":4,"pid":null},{"id":null,"fullName":"Ruiwen Shao","name":"Ruiwen","surname":"Shao","rank":5,"pid":null},{"id":"orcid_______::6c88aeb56fd7f0690a7adf7d0df0d1a5","fullName":"Wen Yang","name":"Wen","surname":"Yang","rank":6,"pid":{"id":{"scheme":"orcid","value":"0000-0003-2444-3300"},"provenance":null}}],"openAccessColor":null,"publiclyFunded":false,"eoscIfGuidelines":null,"type":"publication","language":{"code":"eng","label":"English"},"countries":null,"subjects":[{"subject":{"scheme":"FOS","value":"01 natural sciences"},"provenance":null},{"subject":{"scheme":"SDG","value":"7. Clean energy"},"provenance":null},{"subject":{"scheme":"FOS","value":"0104 chemical sciences"},"provenance":null},{"subject":{"scheme":"SDG","value":"3. Good health"},"provenance":null}],"mainTitle":"Colloid Electrolyte with Changed Li<sup>+</sup> Solvation Structure for High‐Power, Low‐Temperature Lithium‐Ion Batteries","subTitle":null,"descriptions":["<jats:title>Abstract</jats:title><jats:p>Lithium‐ion batteries currently suffer from low capacity and fast degradation under fast charging and/or low temperatures. In this work, a colloid liquid electrolyte (CLE) is designed, where the trace amount of lithium thiocarbonate (LTC) colloids in commercial carbonate electrolyte (1 <jats:sc>m</jats:sc> LiPF<jats:sub>6</jats:sub> in ethylene carbonate/dimethyl carbonate) not only boosts up σ<jats:sub>Li+</jats:sub> but also improves the Li<jats:sup>+</jats:sup> transfer kinetics at LiNi<jats:sub>0.8</jats:sub>Co<jats:sub>0.15</jats:sub>Al<jats:sub>0.05</jats:sub>O<jats:sub>2</jats:sub> (NCA) cathode/electrolyte interface. The competitive coordination of LTCs with anions and solvents facilitates the dissociation of lithium salts and Li<jats:sup>+</jats:sup> decoupling, dramatically enhancing the σ<jats:sub>Li+</jats:sub> (15 to 4.5 mS cm<jats:sup>−1</jats:sup> at 30 and −20 °C, respectively); meanwhile, the desolvation process is accelerated. It demonstrates that LTC colloids induce an ≈5 nm ultrathin Li<jats:sub>2</jats:sub>CO<jats:sub>3</jats:sub>‐rich cathode electrolyte interface and infuse the grain boundary of NCA particles, enhancing interfacial Li<jats:sup>+</jats:sup> transfer and inhibiting the particle cracks during cycling. Consequently, the Li||CLE||NCA battery delivers a maximum capacity of 135 mAh g<jats:sup>−1</jats:sup> at a 10 C rate with 80% retention after 2000 cycles. Moreover, the fast‐charging capability under a sub‐zero environment is proved (122 mAh g<jats:sup>−1</jats:sup> with 90% retention after 400 cycles at 2 C and −10 °C). This strategy for tailoring the interfacial charge transfer appears generalizable and can practically be extended to next‐generation energy‐storage systems.</jats:p>"],"publicationDate":"2023-02-13","publisher":"Wiley","embargoEndDate":null,"sources":["Crossref"],"formats":null,"contributors":null,"coverages":null,"bestAccessRight":{"code":"c_14cb","label":"CLOSED","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/"},"container":{"name":"Advanced Materials","issnPrinted":"0935-9648","issnOnline":"1521-4095","issnLinking":null,"ep":null,"iss":null,"sp":null,"vol":"35","edition":null,"conferencePlace":null,"conferenceDate":null},"documentationUrls":null,"codeRepositoryUrl":null,"programmingLanguage":null,"contactPeople":null,"contactGroups":null,"tools":null,"size":null,"version":null,"geoLocations":null,"id":"doi_dedup___::7092c7ea2b91702d344b6ecb7cbbd824","originalIds":["10.1002/adma.202209140","50|doiboost____|7092c7ea2b91702d344b6ecb7cbbd824","36634272"],"pids":[{"scheme":"doi","value":"10.1002/adma.202209140"},{"scheme":"pmid","value":"36634272"}],"dateOfCollection":null,"lastUpdateTimeStamp":null,"indicators":{"citationImpact":{"citationCount":58.0,"influence":3.452461E-9,"popularity":4.1017685E-8,"impulse":58.0,"citationClass":"C4","influenceClass":"C4","impulseClass":"C3","popularityClass":"C3"}},"projects":null,"organizations":[{"legalName":"Hainan University","acronym":"Hainan University","id":"openorgs____::350a6963d5b17ad3d8946f4c64b6fdad","pids":[{"scheme":"fundref","value":"501100005693"},{"scheme":"OrgRef","value":"21276744"},{"scheme":"FundRef","value":"501100005693"},{"scheme":"ROR","value":"https://ror.org/03q648j11"},{"scheme":"GRID","value":"grid.428986.9"},{"scheme":"wikidata","value":"Q5639382"},{"scheme":"mag_id","value":"20942203"},{"scheme":"Wikidata","value":"Q5639382"},{"scheme":"ISNI","value":"0000000103736302"}],"countries":[{"code":"CN","label":"China (People's Republic of)"}],"websiteurl":"http://www.hainu.edu.cn/"},{"legalName":"Beijing Institute of Technology","acronym":"BIT","id":"openorgs____::702a658f9208947ed97c158f4373edba","pids":[{"scheme":"wikidata","value":"Q23101"},{"scheme":"fundref","value":"501100012236"},{"scheme":"FundRef","value":"501100012236"},{"scheme":"Wikidata","value":"Q23101"},{"scheme":"GRID","value":"grid.43555.32"},{"scheme":"OrgRef","value":"342924"},{"scheme":"PIC","value":"997714744"},{"scheme":"fundref","value":"501100005085"},{"scheme":"ISNI","value":"0000000088416246"},{"scheme":"ROR","value":"https://ror.org/01skt4w74"},{"scheme":"FundRef","value":"501100005085"},{"scheme":"mag_id","value":"125839683"}],"countries":[{"code":"CN","label":"China (People's Republic of)"}],"websiteurl":"http://english.bit.edu.cn/"},{"legalName":"Contemporary Amperex Technology Co., Limited.","acronym":"CATL","id":"pending_org_::dc3a3e6fb70b146708cf6c228a29d5ea","pids":[{"scheme":"ISNI","value":"0000000508268877"},{"scheme":"wikidata","value":"Q18653563"},{"scheme":"ROR","value":"https://ror.org/00tr9az64"},{"scheme":"fundref","value":"100020746"}],"countries":[{"code":"CN","label":"China (People's Republic of)"}],"websiteurl":"https://www.catl.com"}],"communities":[{"code":"energy-planning","label":"Energy Planning","provenance":null}],"collectedFrom":[{"key":"openaire____::081b82f96300b6a6e3d282bad31cb6e2","value":"Crossref"},{"key":"opendoar____::8b6dd7db9af49e67306feb59a8bdc52c","value":"Europe PubMed Central"}],"instances":[{"pids":[{"scheme":"doi","value":"10.1002/adma.202209140"}],"license":"Wiley Online Library User Agreement","accessRight":{"code":"c_14cb","label":"CLOSED","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/","openAccessRoute":null},"type":"Article","urls":["https://doi.org/10.1002/adma.202209140"],"publicationDate":"2023-02-13","refereed":"peerReviewed","hostedBy":{"key":"issn___print::3d027b094c149a3baa8f0b024bc789a2","value":"Advanced Materials"},"collectedFrom":{"key":"openaire____::081b82f96300b6a6e3d282bad31cb6e2","value":"Crossref"}},{"pids":[{"scheme":"pmid","value":"36634272"}],"alternateIdentifiers":[{"scheme":"doi","value":"10.1002/adma.202209140"}],"type":"Article","urls":["https://pubmed.ncbi.nlm.nih.gov/36634272"],"publicationDate":"2023-03-23","refereed":"nonPeerReviewed","hostedBy":{"key":"issn___print::3d027b094c149a3baa8f0b024bc789a2","value":"Advanced Materials"},"collectedFrom":{"key":"opendoar____::8b6dd7db9af49e67306feb59a8bdc52c","value":"Europe PubMed Central"}}],"links":[],"otherTitles":null,"inDiamondJournal":false,"green":false,"isGreen":false,"isInDiamondJournal":false},{"authors":[{"id":"orcid_______::0e1dfebe09b0cd9bb76f784ae7247a3d","fullName":"Vincenzo J. Musicó","name":"Vincenzo J.","surname":"Musicó","rank":1,"pid":{"id":{"scheme":"orcid","value":"0000-0002-0282-9926"},"provenance":null}},{"id":"orcid_______::46869fd3ae7db85009105bccf1c0697b","fullName":"Noah P. Holzapfel","name":"Noah P.","surname":"Holzapfel","rank":2,"pid":{"id":{"scheme":"orcid","value":"0000-0002-4566-4033"},"provenance":null}},{"id":null,"fullName":"R. Blake Nuwayhid","name":"R. Blake","surname":"Nuwayhid","rank":3,"pid":null},{"id":null,"fullName":"Jeffrey W. Long","name":"Jeffrey W.","surname":"Long","rank":4,"pid":null},{"id":null,"fullName":"Ryan H. DeBlock","name":"Ryan H.","surname":"DeBlock","rank":5,"pid":null},{"id":"orcid_______::43c8a2ac58fef32f7c3313e716a8734f","fullName":"Veronica Augustyn","name":"Veronica","surname":"Augustyn","rank":6,"pid":{"id":{"scheme":"orcid","value":"0000-0001-9885-2882"},"provenance":null}}],"openAccessColor":"hybrid","publiclyFunded":false,"eoscIfGuidelines":null,"type":"publication","language":{"code":"eng","label":"English"},"countries":null,"subjects":[{"subject":{"scheme":"FOS","value":"01 natural sciences"},"provenance":null},{"subject":{"scheme":"FOS","value":"0104 chemical sciences"},"provenance":null}],"mainTitle":"Niobium Tungsten Oxides as Anodes for High-Power and Low-Temperature Li-Ion Batteries","subTitle":null,"descriptions":["<jats:p>Space-limited and low-temperature environments demand battery materials with both high volumetric capacity and fast charge-storage kinetics. To address this need, we investigate the electrochemical Li⁺-insertion behavior of high-density niobium–tungsten oxide (NWO) Wadsley–Roth compounds at room temperature and 0 °C. These compounds contain orthogonal crystallographic shear planes that form an m × n block structure around a corner-sharing network. We compare three NWO materials: Nb12WO33 (3 × 4), Nb14W3O44 (4 × 4), and Nb16W5O55 (4 × 5). Operando electrochemical X-ray diffraction shows that structural evolution during Li⁺ insertion becomes more complex as block size increases. At a C/10 rate and 25 °C, all three compounds store more than 1 Li⁺/e⁻ per transition metal (T.M.), with Nb14W3O44 (4 × 4) and Nb16W5O55 (4 × 5) reaching volumetric capacities of 1,315 mAh/cm³ and 1,247 mAh/cm³, respectively. Rate-capability measurements at 25 °C and 0 °C show that larger block sizes maintain higher capacity at slow (dis)charge rates, whereas asymmetric block sizes (m ≠ n) deliver greater rate capability. All three materials outperform a commercial graphite anode in volumetric capacity, rate capability, and long-term cycling with each material retaining over 90% of capacity at 25 °C and 95% at 0 °C after 500 cycles. These results highlight NWO phases as promising candidates for lithium-ion batteries that require high volumetric energy density, high power, and reliable low-temperature operation.</jats:p>"],"publicationDate":"2025-10-29","publisher":"American Chemical Society (ACS)","embargoEndDate":null,"sources":["Crossref"],"formats":null,"contributors":null,"coverages":null,"bestAccessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/"},"container":{"name":"Chemistry of Materials","issnPrinted":"0897-4756","issnOnline":"1520-5002","issnLinking":null,"ep":"3265","iss":null,"sp":"3256","vol":"38","edition":null,"conferencePlace":null,"conferenceDate":null},"documentationUrls":null,"codeRepositoryUrl":null,"programmingLanguage":null,"contactPeople":null,"contactGroups":null,"tools":null,"size":null,"version":null,"geoLocations":null,"id":"doi_dedup___::0b0a814d6ea78df5b9e0903ae8d72288","originalIds":["10.1021/acs.chemmater.5c02852","50|doiboost____|064fc63050176301727ed81246019e47","10.26434/chemrxiv-2025-f4vqf","50|doiboost____|0b0a814d6ea78df5b9e0903ae8d72288"],"pids":[{"scheme":"doi","value":"10.1021/acs.chemmater.5c02852"},{"scheme":"doi","value":"10.26434/chemrxiv-2025-f4vqf"}],"dateOfCollection":null,"lastUpdateTimeStamp":null,"indicators":{"citationImpact":{"citationCount":0.0,"influence":2.1746283E-9,"popularity":2.2497804E-9,"impulse":0.0,"citationClass":"C5","influenceClass":"C5","impulseClass":"C5","popularityClass":"C5"}},"projects":null,"organizations":[{"legalName":"Matériaux Ingénierie et Science","acronym":"MATEIS","id":"openorgs____::0f9a54c49e25849e979c0e5d63eb71db","pids":[{"scheme":"wikidata","value":"Q30261510"},{"scheme":"GRID","value":"grid.462614.3"},{"scheme":"ISNI","value":"0000000102922242"},{"scheme":"ROR","value":"https://ror.org/01rnfhz46"},{"scheme":"CNRS","value":"UMR5510"}],"countries":[{"code":"FR","label":"France"}],"websiteurl":"http://mateis.insa-lyon.fr/"},{"legalName":"North Carolina Agricultural and Technical State University","acronym":"North Carolina Agricultural and Technical State University","id":"openorgs____::8841c6c7c06e0f4a4257b0ce10c2ffbd","pids":[{"scheme":"GRID","value":"grid.40803.3f"},{"scheme":"fundref","value":"100011938"},{"scheme":"FundRef","value":"100010541"},{"scheme":"Wikidata","value":"Q1476484"},{"scheme":"ROR","value":"https://ror.org/04tj63d06"},{"scheme":"fundref","value":"100005904"},{"scheme":"ISNI","value":"0000000121736074"},{"scheme":"fundref","value":"100006446"},{"scheme":"FundRef","value":"100005904"},{"scheme":"FundRef","value":"100002260"},{"scheme":"fundref","value":"100011484"},{"scheme":"wikidata","value":"Q1132346"},{"scheme":"FundRef","value":"100005568"},{"scheme":"FundRef","value":"100011490"},{"scheme":"fundref","value":"100010541"},{"scheme":"GRID","value":"grid.261037.1"},{"scheme":"ISNI","value":"0000000102874439"},{"scheme":"fundref","value":"100007703"},{"scheme":"mag_id","value":"35777872"},{"scheme":"FundRef","value":"100003203"},{"scheme":"FundRef","value":"100011938"},{"scheme":"fundref","value":"100014459"},{"scheme":"fundref","value":"100003203"},{"scheme":"fundref","value":"100002260"},{"scheme":"FundRef","value":"100011484"},{"scheme":"ISNI","value":"000000041936818X"},{"scheme":"OrgRef","value":"524231"},{"scheme":"FundRef","value":"100007703"},{"scheme":"ROR","value":"https://ror.org/02aze4h65"},{"scheme":"fundref","value":"100011490"},{"scheme":"Wikidata","value":"Q1132346"},{"scheme":"FundRef","value":"100014459"},{"scheme":"wikidata","value":"Q1476484"},{"scheme":"OrgRef","value":"72544"},{"scheme":"fundref","value":"100005568"},{"scheme":"FundRef","value":"100008521"},{"scheme":"fundref","value":"100008521"},{"scheme":"fundref","value":"100009591"},{"scheme":"FundRef","value":"100006446"},{"scheme":"FundRef","value":"100009591"}],"countries":[{"code":"US","label":"United States"}],"websiteurl":"http://www.ncat.edu/"},{"legalName":"Naval Research Laboratory Chemistry Division","acronym":"Naval Research Laboratory Chemistry Division","id":"pending_org_::28a49aeb3a65a32fc03dcaa1d2c1df28","pids":[{"scheme":"ISNI","value":"0000000449060987"},{"scheme":"ROR","value":"https://ror.org/025vw1435"}],"countries":[{"code":"US","label":"United States"}],"websiteurl":"https://www.nrl.navy.mil/chemistry/"},{"legalName":"Institut National des Sciences Appliquées de Lyon","acronym":"INSA","id":"openorgs____::6e23b6f3a5f9768d19cc49c0ff176f47","pids":[{"scheme":"wikidata","value":"Q1633859"},{"scheme":"ISNI","value":"0000000417655089"},{"scheme":"Wikidata","value":"Q1633859"},{"scheme":"ROR","value":"https://ror.org/050jn9y42"},{"scheme":"FundRef","value":"501100009081"},{"scheme":"PIC","value":"999886089"},{"scheme":"GRID","value":"grid.15399.37"},{"scheme":"fundref","value":"501100009081"},{"scheme":"OrgRef","value":"10828425"}],"countries":[{"code":"FR","label":"France"}],"websiteurl":"http://www.insa-lyon.fr/"}],"communities":null,"collectedFrom":[{"key":"openaire____::081b82f96300b6a6e3d282bad31cb6e2","value":"Crossref"}],"instances":[{"pids":[{"scheme":"doi","value":"10.1021/acs.chemmater.5c02852"}],"license":"STM Policy #29","accessRight":{"code":"c_14cb","label":"CLOSED","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/","openAccessRoute":null},"type":"Article","urls":["https://doi.org/10.1021/acs.chemmater.5c02852"],"publicationDate":"2026-03-30","refereed":"peerReviewed","hostedBy":{"key":"issn___print::c7566808350a754cb7643d4207ef4c05","value":"Chemistry of Materials"},"collectedFrom":{"key":"openaire____::081b82f96300b6a6e3d282bad31cb6e2","value":"Crossref"}},{"pids":[{"scheme":"doi","value":"10.26434/chemrxiv-2025-f4vqf"}],"license":"CC BY NC ND","accessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/","openAccessRoute":"hybrid"},"type":"Article","urls":["https://doi.org/10.26434/chemrxiv-2025-f4vqf"],"publicationDate":"2025-10-29","refereed":"peerReviewed","hostedBy":{"key":"openaire____::55045bd2a65019fd8e6741a755395c8c","value":"Unknown Repository"},"collectedFrom":{"key":"openaire____::081b82f96300b6a6e3d282bad31cb6e2","value":"Crossref"}}],"links":[],"otherTitles":null,"inDiamondJournal":false,"green":false,"isGreen":false,"isInDiamondJournal":false},{"authors":[{"id":null,"fullName":"Peichao Ning","name":"Peichao","surname":"Ning","rank":1,"pid":null},{"id":null,"fullName":"Qi Meng","name":"Qi","surname":"Meng","rank":2,"pid":null},{"id":null,"fullName":"Peng Dong","name":"Peng","surname":"Dong","rank":3,"pid":null},{"id":null,"fullName":"Jianguo Duan","name":"Jianguo","surname":"Duan","rank":4,"pid":null},{"id":null,"fullName":"Mingli Xu","name":"Mingli","surname":"Xu","rank":5,"pid":null},{"id":null,"fullName":"Yan Lin","name":"Yan","surname":"Lin","rank":6,"pid":null},{"id":null,"fullName":"Yingjie Zhang","name":"Yingjie","surname":"Zhang","rank":7,"pid":{"id":{"scheme":"orcid_pending","value":"0000-0002-5936-1025"},"provenance":null}}],"openAccessColor":null,"publiclyFunded":false,"eoscIfGuidelines":null,"type":"publication","language":{"code":"eng","label":"English"},"countries":null,"subjects":[{"subject":{"scheme":"keyword","value":"Electric Power Supplies"},"provenance":null},{"subject":{"scheme":"keyword","value":"Malates"},"provenance":null},{"subject":{"scheme":"keyword","value":"Recycling"},"provenance":null},{"subject":{"scheme":"keyword","value":"Hydrogen Peroxide"},"provenance":null},{"subject":{"scheme":"keyword","value":"Lithium"},"provenance":null},{"subject":{"scheme":"FOS","value":"01 natural sciences"},"provenance":null},{"subject":{"scheme":"keyword","value":"Electrodes"},"provenance":null},{"subject":{"scheme":"SDG","value":"7. Clean energy"},"provenance":null},{"subject":{"scheme":"FOS","value":"0105 earth and related environmental sciences"},"provenance":null},{"subject":{"scheme":"SDG","value":"12. Responsible consumption"},"provenance":null}],"mainTitle":"Recycling of cathode material from spent lithium ion batteries using an ultrasound-assisted DL-malic acid leaching system","subTitle":null,"descriptions":["Herein, a novel process involving ultrasound-assisted leaching developed for recovering Ni, Li, Co, and Mn from spent lithium-ion batteries (LIBs) is reported. Carbonate coprecipitation was utilized to regenerate LiNi0.6Co0.2Mn0.2O2 from the leachate. Spent cathode materials were leached in DL-malic acid and hydrogen peroxide (H2O2). The leaching efficiency was investigated by determining the contents of metal elements such as Li, Ni, Co, and Mn in the leachate using atomic absorption spectrometry (AAS). The filter residue and the spent cathode materials were examined using Fourier transform infrared (FTIR) and scanning electronic microscopy. The leaching efficiencies were 97.8% for Ni, 97.6% for Co, 97.3% for Mn, and 98% for Li under the optimized conditions (90 W ultrasound power, 1.0 mol/L DL-malic acid, 5 g/L pulp density, 80 °C, 4 vol% H2O2, and 30 min). The leaching kinetics of the cathode in DL-malic acid are in accordance with the log rate law model. The electrochemical analysis indicates that the LiNi0.6Co0.2Mn0.2O2 regenerated at pH 8.5 has good electrochemical performance. The specific capacity of the first discharge at 0.1 C is 168.32 mA h g-1 at 1 C after 50 cycles with a capacity retention of 85.0%. A novel closed-loop process to recycle spent cathode materials was developed, and it has potential value for practical application and for contributing to resource recycling and environmental protection."],"publicationDate":"2020-02-01","publisher":"Elsevier BV","embargoEndDate":null,"sources":["Crossref"],"formats":null,"contributors":null,"coverages":null,"bestAccessRight":{"code":"c_14cb","label":"CLOSED","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/"},"container":{"name":"Waste Management","issnPrinted":"0956-053X","issnOnline":null,"issnLinking":null,"ep":"60","iss":null,"sp":"52","vol":"103","edition":null,"conferencePlace":null,"conferenceDate":null},"documentationUrls":null,"codeRepositoryUrl":null,"programmingLanguage":null,"contactPeople":null,"contactGroups":null,"tools":null,"size":null,"version":null,"geoLocations":null,"id":"doi_dedup___::281dd293e10078d8c7cde35c78c83fc5","originalIds":["S0956053X19307433","10.1016/j.wasman.2019.12.002","50|doiboost____|281dd293e10078d8c7cde35c78c83fc5","31865035","2996074985"],"pids":[{"scheme":"doi","value":"10.1016/j.wasman.2019.12.002"},{"scheme":"pmid","value":"31865035"}],"dateOfCollection":null,"lastUpdateTimeStamp":null,"indicators":{"citationImpact":{"citationCount":171.0,"influence":7.122572E-9,"popularity":1.1976624E-7,"impulse":78.0,"citationClass":"C3","influenceClass":"C4","impulseClass":"C3","popularityClass":"C3"}},"projects":null,"organizations":[{"legalName":"Kunming University of Science and Technology","acronym":"KUST","id":"openorgs____::ad3550f5a7895a973bb5f9331a3ebd6c","pids":[{"scheme":"FundRef","value":"501100007301"},{"scheme":"ROR","value":"https://ror.org/00xyeez13"},{"scheme":"wikidata","value":"Q6444900"},{"scheme":"GRID","value":"grid.218292.2"},{"scheme":"fundref","value":"501100007301"},{"scheme":"fundref","value":"501100005194"},{"scheme":"mag_id","value":"10660446"},{"scheme":"ISNI","value":"000000008571108X"},{"scheme":"Wikidata","value":"Q6444900"},{"scheme":"FundRef","value":"501100005194"},{"scheme":"OrgRef","value":"17889702"}],"countries":[{"code":"CN","label":"China (People's Republic of)"}],"websiteurl":"http://english.kmust.edu.cn/"}],"communities":[{"code":"energy-planning","label":"Energy Planning","provenance":null}],"collectedFrom":[{"key":"openaire____::081b82f96300b6a6e3d282bad31cb6e2","value":"Crossref"},{"key":"openaire____::5f532a3fc4f1ea403f37070f59a7a53a","value":"Microsoft Academic Graph"},{"key":"opendoar____::8b6dd7db9af49e67306feb59a8bdc52c","value":"Europe PubMed Central"}],"instances":[{"pids":[{"scheme":"doi","value":"10.1016/j.wasman.2019.12.002"}],"license":"Elsevier TDM","accessRight":{"code":"c_14cb","label":"CLOSED","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/","openAccessRoute":null},"type":"Article","urls":["https://doi.org/10.1016/j.wasman.2019.12.002"],"publicationDate":"2020-02-01","refereed":"peerReviewed","hostedBy":{"key":"issn___print::270b0085afbed253a069fe76508dbf4d","value":"Waste Management"},"collectedFrom":{"key":"openaire____::081b82f96300b6a6e3d282bad31cb6e2","value":"Crossref"}},{"pids":[{"scheme":"pmid","value":"31865035"}],"alternateIdentifiers":[{"scheme":"doi","value":"10.1016/j.wasman.2019.12.002"}],"type":"Article","urls":["https://pubmed.ncbi.nlm.nih.gov/31865035"],"publicationDate":"2020-05-19","refereed":"nonPeerReviewed","hostedBy":{"key":"openaire____::55045bd2a65019fd8e6741a755395c8c","value":"Unknown Repository"},"collectedFrom":{"key":"opendoar____::8b6dd7db9af49e67306feb59a8bdc52c","value":"Europe PubMed Central"}},{"alternateIdentifiers":[{"scheme":"doi","value":"10.1016/j.wasman.2019.12.002"},{"scheme":"mag_id","value":"2996074985"}],"type":"Article","urls":["https://dx.doi.org/10.1016/j.wasman.2019.12.002"],"refereed":"nonPeerReviewed","hostedBy":{"key":"openaire____::55045bd2a65019fd8e6741a755395c8c","value":"Unknown Repository"},"collectedFrom":{"key":"openaire____::5f532a3fc4f1ea403f37070f59a7a53a","value":"Microsoft Academic Graph"}},{"alternateIdentifiers":[{"scheme":"mag_id","value":"2996074985"},{"scheme":"doi","value":"10.1016/j.wasman.2019.12.002"}],"type":"Article","urls":["https://dx.doi.org/10.1016/j.wasman.2019.12.002"],"refereed":"nonPeerReviewed","hostedBy":{"key":"openaire____::55045bd2a65019fd8e6741a755395c8c","value":"Unknown Repository"},"collectedFrom":{"key":"openaire____::5f532a3fc4f1ea403f37070f59a7a53a","value":"Microsoft Academic Graph"}}],"links":[],"otherTitles":null,"inDiamondJournal":false,"green":false,"isGreen":false,"isInDiamondJournal":false},{"authors":[{"id":null,"fullName":"Saldarriaga Saldarriaga, Oriana Camila","name":"Oriana Camila","surname":"Saldarriaga Saldarriaga","rank":1,"pid":null}],"openAccessColor":null,"publiclyFunded":false,"eoscIfGuidelines":null,"type":"publication","language":{"code":"eng","label":"English"},"countries":[{"code":"CO","label":"Colombia","provenance":null}],"subjects":[{"subject":{"scheme":"keyword","value":"620 - Ingeniería y operaciones afines"},"provenance":null},{"subject":{"scheme":"keyword","value":"Modelo térmico 0D"},"provenance":null},{"subject":{"scheme":"keyword","value":"Baterias de ION- litio"},"provenance":null},{"subject":{"scheme":"keyword","value":"Modelo eléctrico equivalente"},"provenance":null},{"subject":{"scheme":"keyword","value":"Estado de carga (SoC"},"provenance":null},{"subject":{"scheme":"keyword","value":"Ingeniería mecánica"},"provenance":null},{"subject":{"scheme":"keyword","value":"2. Ingeniería y Tecnología::2C. Ingeniería Mecánica"},"provenance":null},{"subject":{"scheme":"keyword","value":"ODS 4: Educación de calidad. Garantizar una educación inclusiva y equitativa de calidad y promover oportunidades de aprendizaje permanente para todos"},"provenance":null},{"subject":{"scheme":"keyword","value":"Gestión térmica"},"provenance":null}],"mainTitle":"Identification of thermal models for lithium-ion batteries","subTitle":null,"descriptions":["1 Literature Review -- 3 1.1 Lithium-Ion Batteries -- 3 1.2 Battery fundamental concepts -- 7 1.3 Battery Modeling -- 9 1.3.1 Electrical Model -- 10 1.3.2 0D Thermal Model -- 13 1.3.3 Interactions Between the Electrical and Thermal Models -- 16 1.4 Applications and Technical Challenges -- 18 1.4.1 Applications of Lithium-ion Batteries -- 18 1.4.2 Technical Barriers -- 19 2 Dataset Description and Models Characterization 23 2.1 Dataset Description -- 24 2.1.1 Tested Battery Cells -- 24 2.1.2 Experiments Description -- 27 2.2 Models Characterization and Implementation -- 30 2.2.1 Data Pre-processing -- 31 2.2.2 Electrical Model Parameters Fitting -- 35 2.2.3 Thermal Model Parameters Fitting -- 46 2.2.4 Alternative Heat Generation Formulations -- 51 2.2.5 Results with different Heat Generation -- 51 2.2.6 Electro-Thermal Coupling Methodology -- 53 2.2.7 Model Validation -- 53 3 Results and Discussion -- 57 3.1 Electrical Model Characterization -- 57 3.1.1 Voltage Relaxation Dynamics Fitting -- 57 3.1.2 Parameter Identification and State of Charge Dependency -- 58 3.2 Thermal Model Validation in Selected Experiments -- 65 3.2.1 Thermal Response at Moderate Temperature (5°C) -- 65 3.2.2 Thermal Response at Elevated Temperature (35°C) -- 67 3.2.3 Thermal Response at Reduced Temperature (-10°C) -- 68 3.2.4 Comparative Analysis of Thermal Generation Formulations -- 69 3.3 Model Validation Results -- 71 3.3.1 Representative Case Analysis -- 71 3.3.2 Global Model Evaluation -- 80 4 Conclusions and Recommendation -- 83 4.1 Conclusions -- 83 4.1.1 Observations for Future Research -- 84 4.2 Recommendations -- 86 A Experimental Equipment and Technical Specifications -- 89 A.0.1 Electrochemical Workstation -- 90 A.0.2 Battery Testing System -- 92 Bibliography -- 95","Lithium-ion batteries have experienced exponential growth in adoption over the past decade [1], primarily driven by transportation electrification and the global energy transition. According to the International Energy Agency, the global stock of electric vehicles increased from less than one million in 2011 to over 25 million in 2022, representing a year-on-year increase of nearly 60% [2]. This accelerated expansion has made lithium-ion batteries critical components for multiple industrial sectors, from consumer electronics to large-scale storage systems. Despite their advantages in energy storage and efficiency, lithium-ion batteries face major challenges related to their thermal and electrical behavior. Temperature changes strongly affect how these batteries work, impacting their internal resistance, capacity, and stability [3]. Overheating can lead to accelerated degradation and even potentially safety risks like thermal runaway. The non-uniform temperature distribution within battery packs additionally generates thermal gradients that compromise both the performance and durability of the entire system [4]...","Ingeniero(a) Mecánico(a)",": figuras, tablas","Pregrado"],"publicationDate":"2025-06-10","publisher":"Universidad Tecnológica de Pereira","embargoEndDate":null,"sources":null,"formats":["106 páginas","application/pdf"],"contributors":["Tristancho-Reyes, Jose Luis","Zamboni, Walter","Mattia, Luigi","Tristancho-Reyes, José Luis"],"coverages":null,"bestAccessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/"},"container":null,"documentationUrls":null,"codeRepositoryUrl":null,"programmingLanguage":null,"contactPeople":null,"contactGroups":null,"tools":null,"size":null,"version":null,"geoLocations":null,"id":"od______2144::a6902dc4591b6b7eacf66ac32327c72e","originalIds":["50|od______2144::a6902dc4591b6b7eacf66ac32327c72e","oai:repositorio.utp.edu.co:11059/15907"],"pids":[{"scheme":"handle","value":"11059/15907"}],"dateOfCollection":null,"lastUpdateTimeStamp":null,"indicators":{"citationImpact":{"citationCount":0.0,"influence":2.1746283E-9,"popularity":2.2497804E-9,"impulse":0.0,"citationClass":"C5","influenceClass":"C5","impulseClass":"C5","popularityClass":"C5"}},"projects":null,"organizations":[{"legalName":"Technological University of Pereira","acronym":"Technological University of Pereira","id":"openorgs____::eba5c92eabe5857e92475f6eb0d56f76","pids":[{"scheme":"mag_id","value":"200183955"},{"scheme":"ROR","value":"https://ror.org/01d981710"},{"scheme":"OrgRef","value":"22577085"},{"scheme":"FundRef","value":"501100013367"},{"scheme":"GRID","value":"grid.412256.6"},{"scheme":"wikidata","value":"Q2441962"},{"scheme":"ISNI","value":"0000000121761069"},{"scheme":"fundref","value":"501100013367"},{"scheme":"Wikidata","value":"Q2441962"}],"countries":[{"code":"CO","label":"Colombia"}],"websiteurl":"http://www.utp.edu.co/"}],"communities":null,"collectedFrom":[{"key":"opendoar____::7dc1c7653ac42a05642a667959c12239","value":"Repositorio academico de la Universidad Tecnológica de Pereira"}],"instances":[{"pids":[{"scheme":"handle","value":"11059/15907"}],"license":"CC BY NC ND","accessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/","openAccessRoute":null},"type":"Bachelor thesis","urls":["https://hdl.handle.net/11059/15907","https://repositorio.utp.edu.co/home"],"publicationDate":"2025-06-10","refereed":"nonPeerReviewed","hostedBy":{"key":"opendoar____::7dc1c7653ac42a05642a667959c12239","value":"Repositorio academico de la Universidad Tecnológica de Pereira"},"collectedFrom":{"key":"opendoar____::7dc1c7653ac42a05642a667959c12239","value":"Repositorio academico de la Universidad Tecnológica de Pereira"}}],"links":[],"otherTitles":null,"inDiamondJournal":false,"green":true,"isGreen":true,"isInDiamondJournal":false},{"authors":[{"id":null,"fullName":"Stüble, Pirmin","name":"Pirmin","surname":"Stüble","rank":1,"pid":null},{"id":null,"fullName":"Müller, Cedric","name":"Cedric","surname":"Müller","rank":2,"pid":null},{"id":null,"fullName":"Klemens, Julian","name":"Julian","surname":"Klemens","rank":3,"pid":null},{"id":null,"fullName":"Scharfer, Philip","name":"Philip","surname":"Scharfer","rank":4,"pid":null},{"id":null,"fullName":"Schabel, Wilhelm","name":"Wilhelm","surname":"Schabel","rank":5,"pid":null},{"id":null,"fullName":"Häringer, Marcel","name":"Marcel","surname":"Häringer","rank":6,"pid":null},{"id":null,"fullName":"Binder, Joachim R.","name":"Joachim R.","surname":"Binder","rank":7,"pid":null},{"id":null,"fullName":"Hofmann, Andreas","name":"Andreas","surname":"Hofmann","rank":8,"pid":null},{"id":null,"fullName":"Smith, Anna","name":"Anna","surname":"Smith","rank":9,"pid":null}],"openAccessColor":null,"publiclyFunded":false,"eoscIfGuidelines":null,"type":"publication","language":{"code":"eng","label":"English"},"countries":[{"code":"DE","label":"Germany","provenance":null}],"subjects":[{"subject":{"scheme":"keyword","value":"Technology"},"provenance":null},{"subject":{"scheme":"keyword","value":"ddc:600"},"provenance":null},{"subject":{"scheme":"keyword","value":"info:eu-repo/classification/ddc/600"},"provenance":null},{"subject":{"scheme":"keyword","value":"600"},"provenance":null},{"subject":{"scheme":"FOS","value":"01 natural sciences"},"provenance":null},{"subject":{"scheme":"SDG","value":"7. Clean energy"},"provenance":null},{"subject":{"scheme":"FOS","value":"0104 chemical sciences"},"provenance":null}],"mainTitle":"Enabling Long‐term Cycling Stability of Na₃V₂(PO₄)₃ /C vs . Hard Carbon Full‐cells","subTitle":null,"descriptions":["Sodium-ion batteries are becoming an increasingly important complement to lithium-ion batteries. However, while extensive knowledge on the preparation of Li-ion batteries with excellent cycling behavior exists, studies on applicable long-lasting sodium-ion batteries are still limited. Therefore, this study focuses on the cycling stability of batteries composed of Na3V2(PO4)3/C based cathodes and hard carbon anodes. It is shown that full-cells with a decent stability are obtained for ethylene carbonate/propylene carbonate electrolyte and the conducting salt NaPF6. With cathode loadings of 1.2 mAh/cm2, after cell formation discharge capacities up to 92.6 mAh/g are obtained, and capacity retentions &gt;90 % over 1000 charge/discharge cycles at 0.5 C/0.5 C are observed. It is shown that both, the additive fluoroethylene carbonate and impurities in the electrolyte, negatively affect the overall discharge capacity and cycling stability and should therefore be avoided. Remarkably, the internal resistances of well-balanced and well-built cells did not increase over 1500 cycles and 5 months of testing, which is a very promising result regarding the possible lifespan of the cells. The initial loss of active sodium ions in hard carbon remains a major problem, which can only be partially reduced by proper balancing."],"publicationDate":"2023-12-21","publisher":"John Wiley and Sons","embargoEndDate":null,"sources":["Batteries and Supercaps, 7 (2), Art.-Nr. e202300375","ISSN: 2566-6223"],"formats":["application/pdf"],"contributors":null,"coverages":null,"bestAccessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/"},"container":null,"documentationUrls":null,"codeRepositoryUrl":null,"programmingLanguage":null,"contactPeople":null,"contactGroups":null,"tools":null,"size":null,"version":null,"geoLocations":null,"id":"doi_dedup___::0cff647f13e3dd3eb89eae627b4a1ca6","originalIds":["50|datacite____::0cff647f13e3dd3eb89eae627b4a1ca6","10.5445/ir/1000165980","50|od______3596::8e2e0a6f92f786c60aca75a14e696056","oai:EVASTAR-Karlsruhe.de:1000165980","50|base_oa_____::1f18a42311ffd58ce15840efa64acf30","ftubkarlsruhe:oai:EVASTAR-Karlsruhe.de:1000165980"],"pids":[{"scheme":"doi","value":"10.5445/ir/1000165980"}],"dateOfCollection":null,"lastUpdateTimeStamp":null,"indicators":{"citationImpact":{"citationCount":0.0,"influence":2.1746283E-9,"popularity":1.6835128E-9,"impulse":0.0,"citationClass":"C5","influenceClass":"C5","impulseClass":"C5","popularityClass":"C5"}},"projects":null,"organizations":[{"legalName":"Karlsruhe Institute of Technology","acronym":"KIT","id":"openorgs____::eeeeee00563ed0908fb396a26358e2fc","pids":[{"scheme":"wikidata","value":"Q11161114"},{"scheme":"ISNI","value":"0000000100755874"},{"scheme":"FundRef","value":"100009133"},{"scheme":"ROR","value":"https://ror.org/04t3en479"},{"scheme":"Wikidata","value":"Q309988"},{"scheme":"OrgRef","value":"5977314"},{"scheme":"RRID","value":"RRID:nlx_48421"},{"scheme":"mag_id","value":"102335020"},{"scheme":"GRID","value":"grid.7892.4"},{"scheme":"fundref","value":"100009133"},{"scheme":"Wikidata","value":"Q11161114"},{"scheme":"RRID","value":"RRID:SCR_001552"},{"scheme":"PIC","value":"990797674"},{"scheme":"wikidata","value":"Q309988"},{"scheme":"PIC","value":"999907332"},{"scheme":"PIC","value":"999981440"}],"countries":[{"code":"DE","label":"Germany"}],"websiteurl":"http://www.kit.edu/english/"}],"communities":[{"code":"energy-planning","label":"Energy Planning","provenance":null}],"collectedFrom":[{"key":"openaire____::9e3be59865b2c1c335d32dae2fe7b254","value":"Datacite"},{"key":"openaire____::df45502607927471ecf8a6ae83683ff5","value":"Bielefeld Academic Search Engine (BASE)"},{"key":"opendoar____::52c409f1571f500e28f490a302a12540","value":"KITopen"}],"instances":[{"pids":[{"scheme":"doi","value":"10.5445/ir/1000165980"}],"license":"CC BY NC ND","accessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/","openAccessRoute":null},"type":"Article","urls":["https://dx.doi.org/10.5445/ir/1000165980"],"publicationDate":"2024-01-01","refereed":"nonPeerReviewed","hostedBy":{"key":"openaire____::55045bd2a65019fd8e6741a755395c8c","value":"Unknown Repository"},"collectedFrom":{"key":"openaire____::9e3be59865b2c1c335d32dae2fe7b254","value":"Datacite"}},{"alternateIdentifiers":[{"scheme":"doi","value":"10.5445/ir/1000165980"},{"scheme":"doi","value":"10.1002/batt.202300375"}],"license":"CC BY NC ND","accessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/","openAccessRoute":null},"type":"Article","urls":["https://publikationen.bibliothek.kit.edu/1000165980/151969997","https://doi.org/10.5445/IR/1000165980","https://publikationen.bibliothek.kit.edu/1000165980"],"publicationDate":"2023-12-21","refereed":"nonPeerReviewed","hostedBy":{"key":"opendoar____::52c409f1571f500e28f490a302a12540","value":"KITopen"},"collectedFrom":{"key":"opendoar____::52c409f1571f500e28f490a302a12540","value":"KITopen"}},{"alternateIdentifiers":[{"scheme":"doi","value":"10.5445/ir/1000165980"},{"scheme":"doi","value":"10.1002/batt.202300375"}],"license":"CC BY NC ND","accessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/","openAccessRoute":null},"type":"Article","urls":["https://doi.org/https://doi.org/10.5445/IR/1000165980","https://doi.org/https://doi.org/10.1002/batt.202300375"],"publicationDate":"2023-12-21","refereed":"nonPeerReviewed","hostedBy":{"key":"opendoar____::950a4152c2b4aa3ad78bdd6b366cc179","value":"KITopen (Karlsruhe Institute of Technologie)"},"collectedFrom":{"key":"openaire____::df45502607927471ecf8a6ae83683ff5","value":"Bielefeld Academic Search Engine (BASE)"}}],"links":[],"otherTitles":null,"inDiamondJournal":false,"green":true,"isGreen":true,"isInDiamondJournal":false},{"authors":[{"id":null,"fullName":"Mingqiang Gao","name":"Mingqiang","surname":"Gao","rank":1,"pid":null},{"id":null,"fullName":"Yisheng Yang","name":"Yisheng","surname":"Yang","rank":2,"pid":null},{"id":null,"fullName":"Mingjuan Fan","name":"Mingjuan","surname":"Fan","rank":3,"pid":null},{"id":null,"fullName":"Fenglei Wang","name":"Fenglei","surname":"Wang","rank":4,"pid":null},{"id":null,"fullName":"Song Liu","name":"Song","surname":"Liu","rank":5,"pid":{"id":{"scheme":"orcid_pending","value":"0000-0003-4247-1778"},"provenance":null}},{"id":null,"fullName":"Maoqin Qiu","name":"Maoqin","surname":"Qiu","rank":6,"pid":null},{"id":null,"fullName":"Zhongying Wu","name":"Zhongying","surname":"Wu","rank":7,"pid":null},{"id":null,"fullName":"Wenming Li","name":"Wenming","surname":"Li","rank":8,"pid":{"id":{"scheme":"orcid_pending","value":"0009-0001-6692-8149"},"provenance":null}}],"openAccessColor":null,"publiclyFunded":false,"eoscIfGuidelines":null,"type":"publication","language":{"code":"und","label":"Undetermined"},"countries":null,"subjects":[{"subject":{"scheme":"FOS","value":"01 natural sciences"},"provenance":null},{"subject":{"scheme":"FOS","value":"0104 chemical sciences"},"provenance":null}],"mainTitle":"Design and preparation of medium-nickel super fast-charging pouch lithium-ion batteries","subTitle":null,"descriptions":["<jats:p>The increasing demand for 15‑min grade fast charging in electric vehicles (EVs) calls for lithium‑ion batteries with high rate capability, high energy density, long cycle life, and high safety. To address this challenge, this work focuses on cathode material optimization and electrode preparation. Single‑crystal LiNi0.6Co0.1Mn0.3O2 (NCM613) is synthesized via a solid‑state sintering method. The cathode is fabricated using this NCM613 together with Super P, polyvinylidene fluoride (PVDF), and oil‑dispersed carbon nanotubes (CNTC‑P09) to form an efficient and continuous conductive network. The anode uses a graphite‑silicon/carbon composite with Super P, styrene-butadiene rubber (SBR), and water‑based carbon nanotubes (CNTCS‑N08) to buffer the severe volume expansion of silicon during lithiation. Slurry formulations and key processing parameters, including stepwise temperature‑controlled dispersion, gradient drying, and precision calendaring, are systematically optimized to achieve a uniform electrode microstructure. Electrochemical tests on half‑cells confirm the excellent reversibility and stability of both NCM613 and the composite anode. The assembled pouch cells exhibit low overpotential, a total impedance of 0.11 Ω after 150 cycles at 5 C, and 93% capacity retention after 500 cycles at 5 C. Moreover, the cells retain no less than 90% of their capacity at 10 C, fully meeting the requirements of 15‑minute super‑fast charging. This work establishes a comprehensive design and preparation system for medium‑nickel fast‑charging batteries and provides important experimental and technical support for the development of 15‑min grade fast‑charging power batteries.</jats:p>"],"publicationDate":"2026-01-01","publisher":"Elsevier BV","embargoEndDate":null,"sources":["Crossref"],"formats":null,"contributors":null,"coverages":null,"bestAccessRight":null,"container":null,"documentationUrls":null,"codeRepositoryUrl":null,"programmingLanguage":null,"contactPeople":null,"contactGroups":null,"tools":null,"size":null,"version":null,"geoLocations":null,"id":"doi_________::7b6dab107644aff0754c40637fec65f7","originalIds":["10.2139/ssrn.6865421","50|doiboost____|7b6dab107644aff0754c40637fec65f7"],"pids":[{"scheme":"doi","value":"10.2139/ssrn.6865421"}],"dateOfCollection":null,"lastUpdateTimeStamp":null,"indicators":{"citationImpact":{"citationCount":0.0,"influence":2.1746283E-9,"popularity":2.6085654E-9,"impulse":0.0,"citationClass":"C5","influenceClass":"C5","impulseClass":"C5","popularityClass":"C5"}},"projects":null,"organizations":null,"communities":null,"collectedFrom":[{"key":"openaire____::081b82f96300b6a6e3d282bad31cb6e2","value":"Crossref"}],"instances":[{"pids":[{"scheme":"doi","value":"10.2139/ssrn.6865421"}],"type":"Article","urls":["https://doi.org/10.2139/ssrn.6865421"],"publicationDate":"2026-01-01","refereed":"peerReviewed","hostedBy":{"key":"openaire____::55045bd2a65019fd8e6741a755395c8c","value":"Unknown Repository"},"collectedFrom":{"key":"openaire____::081b82f96300b6a6e3d282bad31cb6e2","value":"Crossref"}}],"links":null,"otherTitles":null,"inDiamondJournal":false,"green":false,"isGreen":false,"isInDiamondJournal":false},{"authors":[{"id":null,"fullName":"Govinda Ghimire","name":"Govinda","surname":"Ghimire","rank":1,"pid":null},{"id":null,"fullName":"Archana Loganathan","name":"Archana","surname":"Loganathan","rank":2,"pid":null},{"id":null,"fullName":"Osama Awadallah","name":"Osama","surname":"Awadallah","rank":3,"pid":null},{"id":null,"fullName":"Bilal El-Zahab","name":"Bilal","surname":"El-Zahab","rank":4,"pid":null}],"openAccessColor":null,"publiclyFunded":false,"eoscIfGuidelines":null,"type":"publication","language":{"code":"und","label":"Undetermined"},"countries":null,"subjects":[{"subject":{"scheme":"FOS","value":"01 natural sciences"},"provenance":null},{"subject":{"scheme":"SDG","value":"7. Clean energy"},"provenance":null},{"subject":{"scheme":"FOS","value":"0104 chemical sciences"},"provenance":null},{"subject":{"scheme":"SDG","value":"3. Good health"},"provenance":null}],"mainTitle":"Sulfurized Electrolyte Additives for Stable Lithium Metal Anodes","subTitle":null,"descriptions":["<jats:p>   Researchers around the world are striving to develop new materials for energy-efficient and high energy density lithium-ion batteries [1]. Lithium metal with a theoretical specific capacity of 3860 mAh/g, low density (0.534 g/cm<jats:sup>3</jats:sup>), and the lowest potential (−3.040 V vs. standard hydrogen electrode) is consider the ultimate anode material for high specific energy batteries [2]. However, various issues remain to be address that hinder its use in commercial batteries, namely, cycling stability, Coulombic efficiency, and safety aspects associated with dendritic growth [3]. Inactive lithium, also known as “dead lithium,” originating from the dendrites that become separated from the surface over prolonged cycling contribute to anode capacity loss and require high negative to positive electrode capacity ratio (N/P). In addition, due to the extremely low standard redox potential of lithium, electrolytes readily react with the lithium metal surface even without any potential polarization. These reactions lead to the formation of mostly insoluble species in a layer often referred to as solid electrolyte interface, SEI. Ideally, the SEI layer is self-terminating; however, as fresh lithium gets exposed via dendritic growth, SEI formation continues. The steady and uncontrollable growth of SEI throughout the functional life of the battery leads to gradual resistant growth responsible for the capacity fade and eventual “death” of the battery.</jats:p>                <jats:p>In previous art, alternative electrolytes, electrolyte additives, and artificial SEIs were studied [4] [5]. For example, the electrolyte additive lithium fluoride (LiF) was used in carbonate electrolytes and provided a strong protective layer that reduced side reactions and improved the life capacity of the battery [6]. Recently, 3-dimensional design of the anode’s current collector was shown to accommodate Li deposition resulting in suppressed SEI growth and volume expansion during cycling [7].</jats:p>                <jats:p>In the present work, we use sulfur-containing compounds as additives at a very low concentration (1 – 50 mM) in standard 1M LiPF<jats:sub>6</jats:sub> EC:DMC (v:v = 1:1). Coin cells (2032) were assembled using lithium foil (100 mm thick), separator (Celgard), and NMC811 cathode (&gt; 10 mg/cm<jats:sup>2</jats:sup>). Cells were first rested and activated at a slow rate then cycled at C/3 and 1C for charge and discharge respectively in prescribed voltage cutoff window. As shown in Figure 1, the sulfur-containing cell had more than 300 cycles before 90% capacity retention relative to the beginning of life (BOL) capacity. The sulfur-free control cell lasted less than 150 cycles above the 90% retention line. Electrochemical impedance spectroscopy (EIS) measurements for cycled cells showed lower interfacial resistance for cells with sulfur-containing additives compared to control cells. The reason for the improved cycle stability can be attributed to the stability afforded by the additives to the SEI layer.</jats:p>                <jats:p>                   <jats:bold>Figure 1: A comparison of cell performance between control (black) and sulfur-containing additive (green). The Red line indicates the 90% retention of the battery. </jats:bold>                </jats:p>                <jats:p/>                <jats:p>                   <jats:bold>References</jats:bold>                    <jats:list list-type=\"roman-lower\">                      <jats:list-item>                         <jats:p>Yoshio, Masaki, Ralph J. Brodd, and Akiya Kozawa. <jats:italic>Lithium-ion batteries</jats:italic>. Vol. 1. New York: Springer, 2009.</jats:p>                      </jats:list-item>                      <jats:list-item>                         <jats:p>Liu, Bin, Ji-Guang Zhang, and Wu Xu. \"Advancing lithium metal batteries.\" <jats:italic>Joule</jats:italic>2, no. 5 (2018): 833-845.</jats:p>                      </jats:list-item>                      <jats:list-item>                         <jats:p>Xiao, Jie, Qiuyan Li, Yujing Bi, Mei Cai, Bruce Dunn, Tobias Glossmann, Jun Liu et al. \"Understanding and applying coulombic efficiency in lithium metal batteries.\" <jats:italic>Nature Energy</jats:italic>5, no. 8 (2020): 561-568.</jats:p>                      </jats:list-item>                      <jats:list-item>                         <jats:p>Tikekar, Mukul D., Snehashis Choudhury, Zhengyuan Tu, and Lynden A. Archer. \"Design principles for electrolytes and interfaces for stable lithium-metal batteries.\" <jats:italic>Nature Energy</jats:italic>1, no. 9 (2016): 1-7.</jats:p>                      </jats:list-item>                      <jats:list-item>                         <jats:p>Wang, Qian, Chengkai Yang, Jijin Yang, Kai Wu, Cejun Hu, Jing Lu, Wen Liu, Xiaoming Sun, Jingyi Qiu, and Henghui Zhou. \"Dendrite‐free lithium deposition via a superfilling mechanism for high‐performance Li‐metal batteries.\" <jats:italic>Advanced Materials</jats:italic>31, no. 41 (2019): 1903248.</jats:p>                      </jats:list-item>                      <jats:list-item>                         <jats:p>Choudhury, Snehashis. \"Lithium fluoride additives for stable cycling of lithium batteries at high current densities.\" In <jats:italic>Rational Design of Nanostructured Polymer Electrolytes and Solid–Liquid Interphases for Lithium Batteries</jats:italic>, pp. 81-94. Springer, Cham, 2019.</jats:p>                      </jats:list-item>                      <jats:list-item>                         <jats:p>Yun, Qinbai, Yan‐Bing He, Wei Lv, Yan Zhao, Baohua Li, Feiyu Kang, and Quan‐Hong Yang. \"Chemical dealloying derived 3D porous current collector for Li metal anodes.\" <jats:italic>Advanced Materials</jats:italic>28, no. 32 (2016): 6932-6939.</jats:p>                      </jats:list-item>                   </jats:list>                </jats:p>                <jats:p>                   <jats:inline-formula>                      <jats:inline-graphic xmlns:xlink=\"http://www.w3.org/1999/xlink\" xlink:href=\"187fig1.jpg\" xlink:type=\"simple\"/>                   </jats:inline-formula>                </jats:p>                <jats:p>Figure 1</jats:p>                <jats:p/>"],"publicationDate":"2022-10-09","publisher":"The Electrochemical Society","embargoEndDate":null,"sources":["Crossref"],"formats":null,"contributors":null,"coverages":null,"bestAccessRight":{"code":"c_14cb","label":"CLOSED","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/"},"container":{"name":"ECS Meeting Abstracts","issnPrinted":null,"issnOnline":"2151-2043","issnLinking":null,"ep":"187","iss":null,"sp":"187","vol":"MA2022-02","edition":null,"conferencePlace":null,"conferenceDate":null},"documentationUrls":null,"codeRepositoryUrl":null,"programmingLanguage":null,"contactPeople":null,"contactGroups":null,"tools":null,"size":null,"version":null,"geoLocations":null,"id":"doi_________::affd3e6bd3d623d745f311636d60dce4","originalIds":["10.1149/ma2022-023187mtgabs","50|doiboost____|affd3e6bd3d623d745f311636d60dce4"],"pids":[{"scheme":"doi","value":"10.1149/ma2022-023187mtgabs"}],"dateOfCollection":null,"lastUpdateTimeStamp":null,"indicators":{"citationImpact":{"citationCount":0.0,"influence":2.1746283E-9,"popularity":1.4615026E-9,"impulse":0.0,"citationClass":"C5","influenceClass":"C5","impulseClass":"C5","popularityClass":"C5"}},"projects":null,"organizations":[{"legalName":"Florida International University","acronym":"FIU","id":"openorgs____::89a79904beee10780df6a9b83ad7ae56","pids":[{"scheme":"OrgRef","value":"1468069"},{"scheme":"OrgRef","value":"387849"},{"scheme":"ISNI","value":"0000000121101845"},{"scheme":"FundRef","value":"100008034"},{"scheme":"FundRef","value":"100007681"},{"scheme":"GRID","value":"grid.65456.34"},{"scheme":"PIC","value":"969054057"},{"scheme":"mag_id","value":"19700959"},{"scheme":"Wikidata","value":"Q1065809"},{"scheme":"fundref","value":"100007681"},{"scheme":"fundref","value":"100008034"},{"scheme":"wikidata","value":"Q1065809"},{"scheme":"ROR","value":"https://ror.org/02gz6gg07"}],"countries":[{"code":"US","label":"United States"}],"websiteurl":"http://www.fiu.edu/"}],"communities":[{"code":"energy-planning","label":"Energy Planning","provenance":null}],"collectedFrom":[{"key":"openaire____::081b82f96300b6a6e3d282bad31cb6e2","value":"Crossref"}],"instances":[{"pids":[{"scheme":"doi","value":"10.1149/ma2022-023187mtgabs"}],"license":"IOP Copyright Policies","accessRight":{"code":"c_14cb","label":"CLOSED","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/","openAccessRoute":null},"type":"Article","urls":["https://doi.org/10.1149/ma2022-023187mtgabs"],"publicationDate":"2022-10-09","refereed":"peerReviewed","hostedBy":{"key":"issn__online::c7ac16dbd33cbcea777b0866d25bbc00","value":"ECS Meeting Abstracts"},"collectedFrom":{"key":"openaire____::081b82f96300b6a6e3d282bad31cb6e2","value":"Crossref"}}],"links":[],"otherTitles":null,"inDiamondJournal":false,"green":false,"isGreen":false,"isInDiamondJournal":false},{"authors":[{"id":null,"fullName":"Bohao Zhang","name":"Bohao","surname":"Zhang","rank":1,"pid":null},{"id":null,"fullName":"Yulong Liu","name":"Yulong","surname":"Liu","rank":2,"pid":null},{"id":null,"fullName":"Xiumei Pan","name":"Xiumei","surname":"Pan","rank":3,"pid":null},{"id":null,"fullName":"Jia Liu","name":"Jia","surname":"Liu","rank":4,"pid":null},{"id":null,"fullName":"Kieran Doyle-Davis","name":"Kieran","surname":"Doyle-Davis","rank":5,"pid":null},{"id":"orcid_______::b872880848e0f0038370b76c584649a8","fullName":"Liqun Sun","name":"Liqun","surname":"Sun","rank":6,"pid":{"id":{"scheme":"orcid","value":"0000-0002-5449-8612"},"provenance":null}},{"id":null,"fullName":"Jun Liu","name":"Jun","surname":"Liu","rank":7,"pid":null},{"id":null,"fullName":"Xuefeng Jiao","name":"Xuefeng","surname":"Jiao","rank":8,"pid":null},{"id":null,"fullName":"Jing Jie","name":"Jing","surname":"Jie","rank":9,"pid":null},{"id":null,"fullName":"Haiming Xie","name":"Haiming","surname":"Xie","rank":10,"pid":null},{"id":"orcid_______::eab9c604677d1bdf1c94eeda06a26de3","fullName":"Xueliang Sun","name":"Xueliang","surname":"Sun","rank":11,"pid":{"id":{"scheme":"orcid","value":"0000-0003-0374-1245"},"provenance":null}}],"openAccessColor":null,"publiclyFunded":false,"eoscIfGuidelines":null,"type":"publication","language":{"code":"eng","label":"English"},"countries":null,"subjects":[{"subject":{"scheme":"FOS","value":"02 engineering and technology"},"provenance":null},{"subject":{"scheme":"FOS","value":"0210 nano-technology"},"provenance":null},{"subject":{"scheme":"FOS","value":"01 natural sciences"},"provenance":null},{"subject":{"scheme":"SDG","value":"7. Clean energy"},"provenance":null},{"subject":{"scheme":"FOS","value":"0104 chemical sciences"},"provenance":null},{"subject":{"scheme":"SDG","value":"3. Good health"},"provenance":null}],"mainTitle":"Dendrite-free lithium metal solid battery with a novel polyester based triblock copolymer solid-state electrolyte","subTitle":null,"descriptions":["Abstract   Solid-state polymer Li metal batteries have been regarded as a promising candidate for next-generation batteries due to their high-energy densities provided by the Li metal and the improved safety provided by the solid electrolyte. Polyester is one attractive polymer host, which could be an alternative to polyether-based solid electrolyte due to its excellent lithium ion transport ability and wide electrochemical stability window. Here, a BAB-type triblock copolymer is synthesized with poly (propylene carbonate) as A-block and poly (e-caprolactone) as B-block. The triblock copolymer electrolyte exhibits a high ionic conductivity of 3 × 10−5 S cm−1 at 30 °C with a high lithium ion transference number (0.4) and an extremely wide electrochemical window (5 V). A highly stable interface against Li metal is maintained for more than 760 h at a current density of 0.1 mA cm−2. A LiFePO4 cathode based solid state battery delivers a high discharge capacity of 142 mA h g−1 at 0.05C, room temperature, and 161 mA h g−1 at 0.1C, 70 °C with a capacity retention of 90% after 200 cycles. To understand the excellent electrochemical performance, the morphology and chemical information at both anode and cathode interface are characterized and analyzed. The synthesis of this triblock copolymer demonstrates a new direction in developing high ionic conductivity solid polymer electrolyte for solid-state polymer batteries."],"publicationDate":"2020-06-01","publisher":"Elsevier BV","embargoEndDate":null,"sources":["Crossref"],"formats":null,"contributors":null,"coverages":null,"bestAccessRight":{"code":"c_14cb","label":"CLOSED","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/"},"container":{"name":"Nano Energy","issnPrinted":"2211-2855","issnOnline":null,"issnLinking":null,"ep":null,"iss":null,"sp":"104690","vol":"72","edition":null,"conferencePlace":null,"conferenceDate":null},"documentationUrls":null,"codeRepositoryUrl":null,"programmingLanguage":null,"contactPeople":null,"contactGroups":null,"tools":null,"size":null,"version":null,"geoLocations":null,"id":"doi_dedup___::0d6fb101edb869d1d622d50e2e13b18e","originalIds":["S2211285520302470","10.1016/j.nanoen.2020.104690","50|doiboost____|0d6fb101edb869d1d622d50e2e13b18e","3011701198"],"pids":[{"scheme":"doi","value":"10.1016/j.nanoen.2020.104690"}],"dateOfCollection":null,"lastUpdateTimeStamp":null,"indicators":{"citationImpact":{"citationCount":99.0,"influence":4.5248556E-9,"popularity":6.856777E-8,"impulse":70.0,"citationClass":"C4","influenceClass":"C4","impulseClass":"C3","popularityClass":"C3"}},"projects":null,"organizations":[{"legalName":"Western University","acronym":"UWO","id":"openorgs____::2744820824ea7c74a5c72e691d6138c5","pids":[{"scheme":"FundRef","value":"501100004381"},{"scheme":"OrgRef","value":"2738098"},{"scheme":"mag_id","value":"125749732"},{"scheme":"fundref","value":"501100008093"},{"scheme":"RRID","value":"RRID:SCR_011778"},{"scheme":"FundRef","value":"501100008093"},{"scheme":"FundRef","value":"501100007705"},{"scheme":"GRID","value":"grid.39381.30"},{"scheme":"wikidata","value":"Q1144262"},{"scheme":"OrgRef","value":"169136"},{"scheme":"ISNI","value":"0000000419368884"},{"scheme":"ROR","value":"https://ror.org/02grkyz14"},{"scheme":"OrgRef","value":"828841"},{"scheme":"fundref","value":"501100004381"},{"scheme":"OrgRef","value":"5224022"},{"scheme":"Wikidata","value":"Q1144262"},{"scheme":"PIC","value":"988059752"}],"countries":[{"code":"CA","label":"Canada"}],"websiteurl":"http://www.uwo.ca/"},{"legalName":"Northeast Normal University","acronym":"NENU","id":"openorgs____::603fec6d375306dcd5685703d2e3d67e","pids":[{"scheme":"ISNI","value":"0000000417899163"},{"scheme":"GRID","value":"grid.412260.3"},{"scheme":"fundref","value":"100012898"},{"scheme":"wikidata","value":"Q4393424"},{"scheme":"PIC","value":"998351549"},{"scheme":"OrgRef","value":"919180"},{"scheme":"GRID","value":"grid.27446.33"},{"scheme":"FundRef","value":"100012898"},{"scheme":"Wikidata","value":"Q4393424"},{"scheme":"mag_id","value":"68986083"},{"scheme":"ROR","value":"https://ror.org/02rkvz144"},{"scheme":"mag_id","value":"184983240"}],"countries":[{"code":"CN","label":"China (People's Republic of)"}],"websiteurl":"http://en.nenu.edu.cn/"}],"communities":[{"code":"energy-planning","label":"Energy Planning","provenance":null}],"collectedFrom":[{"key":"openaire____::081b82f96300b6a6e3d282bad31cb6e2","value":"Crossref"},{"key":"openaire____::5f532a3fc4f1ea403f37070f59a7a53a","value":"Microsoft Academic Graph"}],"instances":[{"pids":[{"scheme":"doi","value":"10.1016/j.nanoen.2020.104690"}],"license":"Elsevier TDM","accessRight":{"code":"c_14cb","label":"CLOSED","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/","openAccessRoute":null},"type":"Article","urls":["https://doi.org/10.1016/j.nanoen.2020.104690"],"publicationDate":"2020-06-01","refereed":"peerReviewed","hostedBy":{"key":"issn___print::aefb30c1cb3b6ba356ba6fc5168bfeb8","value":"Nano Energy"},"collectedFrom":{"key":"openaire____::081b82f96300b6a6e3d282bad31cb6e2","value":"Crossref"}},{"alternateIdentifiers":[{"scheme":"mag_id","value":"3011701198"},{"scheme":"doi","value":"10.1016/j.nanoen.2020.104690"}],"type":"Article","urls":["https://dx.doi.org/10.1016/j.nanoen.2020.104690"],"refereed":"nonPeerReviewed","hostedBy":{"key":"openaire____::55045bd2a65019fd8e6741a755395c8c","value":"Unknown Repository"},"collectedFrom":{"key":"openaire____::5f532a3fc4f1ea403f37070f59a7a53a","value":"Microsoft Academic Graph"}},{"alternateIdentifiers":[{"scheme":"mag_id","value":"3011701198"},{"scheme":"doi","value":"10.1016/j.nanoen.2020.104690"}],"type":"Article","urls":["https://dx.doi.org/10.1016/j.nanoen.2020.104690"],"refereed":"nonPeerReviewed","hostedBy":{"key":"openaire____::55045bd2a65019fd8e6741a755395c8c","value":"Unknown Repository"},"collectedFrom":{"key":"openaire____::5f532a3fc4f1ea403f37070f59a7a53a","value":"Microsoft Academic Graph"}}],"links":[],"otherTitles":null,"inDiamondJournal":false,"green":false,"isGreen":false,"isInDiamondJournal":false},{"authors":[{"id":"orcid_______::3eef29903ac9b7dbe8d17f86b59f45dc","fullName":"Adil, Md.","name":"Md","surname":"Adil","rank":1,"pid":{"id":{"scheme":"orcid","value":"0000-0001-5552-677x"},"provenance":null}},{"id":"orcid_______::571a26856b9729ea17ac00f0378f4d68","fullName":"Schmidt, Maximilian","name":"Maximilian","surname":"Schmidt","rank":2,"pid":{"id":{"scheme":"orcid","value":"0000-0002-4833-5606"},"provenance":null}},{"id":null,"fullName":"Vogt, Julia","name":"Julia","surname":"Vogt","rank":3,"pid":null},{"id":"orcid_______::47d2f666213760ecd8cb8dd0112f559d","fullName":"Diemant, Thomas","name":"Thomas","surname":"Diemant","rank":4,"pid":{"id":{"scheme":"orcid","value":"0000-0001-9701-9995"},"provenance":null}},{"id":null,"fullName":"Oschatz, Martin","name":"Martin","surname":"Oschatz","rank":5,"pid":{"id":{"scheme":"orcid_pending","value":"0000-0003-2377-1214"},"provenance":null}},{"id":"orcid_______::b002ed33f5d6b68f4d3f55bf56fe20de","fullName":"Esser, Birgit","name":"Birgit","surname":"Esser","rank":6,"pid":{"id":{"scheme":"orcid","value":"0000-0002-2430-1380"},"provenance":null}}],"openAccessColor":"hybrid","publiclyFunded":false,"eoscIfGuidelines":null,"type":"publication","language":{"code":"eng","label":"English"},"countries":[{"code":"DE","label":"Germany","provenance":null}],"subjects":[{"subject":{"scheme":"keyword","value":"Technology"},"provenance":null},{"subject":{"scheme":"keyword","value":"ddc:600"},"provenance":null},{"subject":{"scheme":"keyword","value":"info:eu-repo/classification/ddc/540"},"provenance":null},{"subject":{"scheme":"keyword","value":"Dissolution mitigation"},"provenance":null},{"subject":{"scheme":"keyword","value":"600"},"provenance":null},{"subject":{"scheme":"keyword","value":"High temperature"},"provenance":null},{"subject":{"scheme":"FOS","value":"01 natural sciences"},"provenance":null},{"subject":{"scheme":"SDG","value":"7. Clean energy"},"provenance":null},{"subject":{"scheme":"FOS","value":"0104 chemical sciences"},"provenance":null},{"subject":{"scheme":"SDG","value":"3. Good health"},"provenance":null},{"subject":{"scheme":"keyword","value":"Concentrated electrolytes"},"provenance":null},{"subject":{"scheme":"keyword","value":"Small-molecule organic electrodes"},"provenance":null},{"subject":{"scheme":"keyword","value":"info:eu-repo/classification/ddc/600"},"provenance":null},{"subject":{"scheme":"keyword","value":"Electrochemical Energy Storage"},"provenance":null},{"subject":{"scheme":"keyword","value":"Sodium-ion batteries"},"provenance":null}],"mainTitle":"Mitigating Dissolution to Enhance the Performance of Pillar[5]quinone in Sodium Batteries","subTitle":null,"descriptions":["<jats:title>Abstract</jats:title>                   <jats:p>                     Sodium‐ion batteries using organic electrode materials are a promising alternative to state‐of‐the‐art lithium‐ion batteries. However, their practical viability is hindered by challenges such as a low specific capacity of the organic electrode materials, or their dissolution in the electrolyte. We herein present a double mitigation strategy to enhance the performance of pillar[5]quinone (P5Q) as positive electrode material in sodium batteries. Using 5                      <jats:sc>m</jats:sc>                     sodium bis(fluorosulfonyl)imide in succinonitrile as highly concentrated electrolyte, as well as encapsulating P5Q in CMK‐3 (Carbon Mesostructured by KAIST with hexagonally ordered rod‐like carbon domains) as templated ordered mesoporous carbon, we achieve a record cycling performance with improved cycling stability even at elevated temperature (40 °C). The P5Q@CMK‐3 composite electrode delivers 430 mAh g                     <jats:sup>−1</jats:sup>                     specific discharge capacity at 0.2 C rate with 90 % retention over 200 cycles. This corresponds to an energy density of 831 Wh kg                     <jats:sup>−1</jats:sup>                     (based on P5Q mass) and surpasses previous reports on pillarquinones. When operated at 40 °C, the P5Q@CMK‐3 composite electrodes deliver a specific discharge capacity of 438 mAh g                     <jats:sup>−1</jats:sup>                     with 88 % capacity retention over 500 cycles (0.02 % per cycle). This study underscores the crucial role the electrolyte plays in advancing organic sodium batteries, offering a promising avenue for the future of sustainable energy technologies.                   </jats:p>"],"publicationDate":"2024-09-02","publisher":"Wiley","embargoEndDate":null,"sources":["Crossref","Batteries & Supercaps, 7 (12), Art.-Nr.: 02400312","ISSN: 2566-6223","Batteries amp; Supercaps 7 2024 , p. e202400312 1 11","Batteries &amp; Supercaps"],"formats":["application/pdf"],"contributors":null,"coverages":null,"bestAccessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/"},"container":{"name":"Batteries &amp; Supercaps","issnPrinted":"2566-6223","issnOnline":"2566-6223","issnLinking":null,"ep":null,"iss":null,"sp":null,"vol":"7","edition":null,"conferencePlace":null,"conferenceDate":null},"documentationUrls":null,"codeRepositoryUrl":null,"programmingLanguage":null,"contactPeople":null,"contactGroups":null,"tools":null,"size":null,"version":null,"geoLocations":null,"id":"doi_dedup___::f85ae4936c4c504f80f3835e5a52e21d","originalIds":["10.1002/batt.202400312","50|doiboost____|f85ae4936c4c504f80f3835e5a52e21d","50|datacite____::7e6931aa2696bab4491769d2a97b99b9","10.5445/ir/1000174239","oai:oparu.uni-ulm.de:123456789/58175","50|od______3587::fd85ff0935610ca1e1d384c876950a83","50|od______3596::7a04440951a73c6f3aeac26e367598cb","oai:EVASTAR-Karlsruhe.de:1000174239","oai:helmholtz.HZB:112257","50|od______3680::bfa4afa1c77ac3607aec2157d69168e4","10.1002/BATT.202400312","50|r3c4b2081b22::2d89b0286810625e343f05fdb5530efe","50|sygma_______::f85ae4936c4c504f80f3835e5a52e21d","ftubkarlsruhe:oai:EVASTAR-Karlsruhe.de:1000174239","50|base_oa_____::f07043e15c9c5b38a395b7dfb08a8a43"],"pids":[{"scheme":"doi","value":"10.1002/batt.202400312"},{"scheme":"doi","value":"10.5445/ir/1000174239"}],"dateOfCollection":null,"lastUpdateTimeStamp":null,"indicators":{"citationImpact":{"citationCount":7.0,"influence":2.3149334E-9,"popularity":6.4560757E-9,"impulse":7.0,"citationClass":"C5","influenceClass":"C5","impulseClass":"C4","popularityClass":"C4"}},"projects":[{"id":"corda_____he::cac6f3787a39e1368ea44451e76955c6","code":"101088146","acronym":"NanOBatt","title":"Nanoporous and redox-active hoops and macrocycles as organic electrode materials for batteries","funder":"European Commission","pids":[{"scheme":"doi","value":"10.3030/101088146"}]}],"organizations":[{"legalName":"University of Ulm","acronym":"University of Ulm","id":"openorgs____::bebf21d464a16875edbb788b6f24577a","pids":[{"scheme":"GRID","value":"grid.6582.9"},{"scheme":"PIC","value":"999882209"},{"scheme":"OrgReg","value":"DE0009"},{"scheme":"ROR","value":"https://ror.org/032000t02"},{"scheme":"fundref","value":"501100013812"},{"scheme":"mag_id","value":"196349391"},{"scheme":"FundRef","value":"501100013812"},{"scheme":"wikidata","value":"Q835662"},{"scheme":"Wikidata","value":"Q835662"},{"scheme":"FundRef","value":"501100019218"},{"s