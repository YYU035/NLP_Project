roducedBy","relatedIdentifier":"dfgf________::1e5e62235d094afd01cd56e65112fc63","relatedRecordType":"project","relationProvenance":"sysimport:actionset","trust":"0.91"},"collectedfrom":[{"dsId":"openaire____::513d203da49f316ec241afa087643a02","dsName":"Deutsche Forschungsgemeinschaft"}],"projectTitle":"unidentified","code":"unidentified","funding":{"funder":{"id":"dfgf________::DFG","shortname":"DFG","name":"Deutsche Forschungsgemeinschaft","jurisdiction":{"code":"DE","label":"Germany"},"pid":null},"level0":{"id":null,"description":null,"name":null},"level1":{"id":null,"description":null,"name":null},"level2":{"id":null,"description":null,"name":null}}}],"otherTitles":null,"green":true,"inDiamondJournal":false,"isGreen":true,"isInDiamondJournal":false},{"authors":[{"id":null,"fullName":"Qing Mu","name":"Qing","surname":"Mu","rank":1,"pid":null},{"id":null,"fullName":"Huanjie Cai","name":"Huanjie","surname":"Cai","rank":2,"pid":null},{"id":null,"fullName":"Shikun Sun","name":"Shikun","surname":"Sun","rank":3,"pid":null},{"id":null,"fullName":"Shanshan Wen","name":"Shanshan","surname":"Wen","rank":4,"pid":null},{"id":null,"fullName":"Jiatun Xu","name":"Jiatun","surname":"Xu","rank":5,"pid":null},{"id":null,"fullName":"Mengqi Dong","name":"Mengqi","surname":"Dong","rank":6,"pid":null},{"id":"orcid_______::59a9d8dc055ee0cfeb72751e36ba36d1","fullName":"Qaisar Saddique","name":"Qaisar","surname":"Saddique","rank":7,"pid":{"id":{"scheme":"orcid","value":"0000-0003-0863-1950"},"provenance":null}}],"openAccessColor":null,"publiclyFunded":false,"eoscIfGuidelines":null,"type":"publication","language":{"code":"eng","label":"English"},"countries":null,"subjects":[{"subject":{"scheme":"FOS","value":"0106 biological sciences"},"provenance":null},{"subject":{"scheme":"SDG","value":"2. Zero hunger"},"provenance":null},{"subject":{"scheme":"SDG","value":"13. Climate action"},"provenance":null},{"subject":{"scheme":"SDG","value":"15. Life on land"},"provenance":null},{"subject":{"scheme":"FOS","value":"01 natural sciences"},"provenance":null},{"subject":{"scheme":"SDG","value":"6. Clean water"},"provenance":null},{"subject":{"scheme":"SDG","value":"3. Good health"},"provenance":null}],"mainTitle":"The physiological response of winter wheat under short-term drought conditions and the sensitivity of different indices to soil water changes","subTitle":null,"descriptions":["Abstract   Studying the physiological responses of winter wheat to drought is conducive to learning to utilize biological water-saving technologies, such as regulating deficit irrigation and obtaining higher water use efficiency (WUE). However, the close relationship between the trend of responses of physiological functions in wheat and changes in soil moisture merits further study. In this study, a two-season pot experiment with three levels of water deficit (45 %–75 % FC, field capacity) was established at three growth stages, based on the theory that the drought-resistant physiological functions of winter wheat could respond to regulated deficit irrigation. The goal was to explore the effects of short-term drought-re-watering on yield and WUE and the sensitivity of wheat leaf physiological indicators to reflect changes in soil moisture. The results showed that the short-term drought in different periods after the jointing period reduced the yield of winter wheat by 2.03 %–64.39 % compared with the treatment of an adequate supply of water (75 %–85 % FC). Priority should be placed on ensuring irrigation during the jointing and filling periods. Treatments that experienced drought during the heading period (55 %–75 % FC) and then recovered to 75 %–85 % FC after flowering can improve the WUE by 5 %–22 %. The physiological function of drought resistance in winter wheat leaves responds noticeably to drought and the re-watering process in the range of 45 %–85 % FC. The maximum values of the activities of superoxide dismutase (SOD) and peroxidase and the contents of malondialdehyde and proline (Pro) during drought increased by 51.9 %, 15.1 %, 40.4 %, and 157.2 %, respectively, compared with those of the control group. The activity of catalase primarily increased after rehydration, and the maximum value was 1.5-fold that of the control group. After 14 days of rehydration, the physiological index values ​​of multiple treatments can be restored to the level of control, which proves that the physiological response within the range of 45 %–85 % FC water change is reversible. Based on the experimental data of the two seasons, the changes in activity of SOD and content of Pro more effectively reflect the changes in soil moisture than the other indicators (ROC analysis, AUC = 0.720−0.978) and have a significant correlation with yield (P"],"publicationDate":"2021-01-01","publisher":"Elsevier BV","embargoEndDate":null,"sources":["Crossref"],"formats":null,"contributors":null,"coverages":null,"bestAccessRight":{"code":"c_14cb","label":"CLOSED","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/"},"container":{"name":"Agricultural Water Management","issnPrinted":"0378-3774","issnOnline":null,"issnLinking":null,"ep":null,"iss":null,"sp":"106475","vol":"243","edition":null,"conferencePlace":null,"conferenceDate":null},"documentationUrls":null,"codeRepositoryUrl":null,"programmingLanguage":null,"contactPeople":null,"contactGroups":null,"tools":null,"size":null,"version":null,"geoLocations":null,"id":"doi_dedup___::422bcc67bce68e4985240386466fdcec","originalIds":["S0378377420313275","10.1016/j.agwat.2020.106475","50|doiboost____|422bcc67bce68e4985240386466fdcec","3082937332"],"pids":[{"scheme":"doi","value":"10.1016/j.agwat.2020.106475"}],"dateOfCollection":null,"lastUpdateTimeStamp":null,"indicators":{"citationImpact":{"citationCount":83.0,"influence":3.9945496E-9,"popularity":5.6891295E-8,"impulse":52.0,"citationClass":"C4","influenceClass":"C4","impulseClass":"C3","popularityClass":"C3"}},"projects":null,"organizations":[{"legalName":"Northwest A&F University","acronym":"NWAFU","id":"pending_org_::74f2798f8eb61164d270501739d97939","pids":[{"scheme":"fundref","value":"501100007548"},{"scheme":"FundRef","value":"501100007548"},{"scheme":"ROR","value":"https://ror.org/0051rme32"},{"scheme":"Wikidata","value":"Q985808"},{"scheme":"OrgRef","value":"19478013"},{"scheme":"wikidata","value":"Q985808"},{"scheme":"ISNI","value":"0000000417604150"},{"scheme":"GRID","value":"grid.144022.1"}],"countries":[{"code":"CN","label":"China (People's Republic of)"}],"websiteurl":"https://www.nwsuaf.edu.cn"},{"legalName":"Northwest A&F University","acronym":"Northwest A&F University","id":"pending_org_::11bc26ed686b10e3428c649f392caa73","pids":[{"scheme":"mag_id","value":"89652312"}],"countries":[{"code":"CN","label":"China (People's Republic of)"}],"websiteurl":"http://www.nwafu.edu.cn/"}],"communities":null,"collectedFrom":[{"key":"openaire____::081b82f96300b6a6e3d282bad31cb6e2","value":"Crossref"},{"key":"openaire____::5f532a3fc4f1ea403f37070f59a7a53a","value":"Microsoft Academic Graph"}],"instances":[{"pids":[{"scheme":"doi","value":"10.1016/j.agwat.2020.106475"}],"license":"Elsevier TDM","accessRight":{"code":"c_14cb","label":"CLOSED","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/","openAccessRoute":null},"type":"Article","urls":["https://doi.org/10.1016/j.agwat.2020.106475"],"publicationDate":"2021-01-01","refereed":"peerReviewed","hostedBy":{"key":"issn___print::258a378f6795ec3fbe5806e6b0fa6835","value":"Agricultural Water Management"},"collectedFrom":{"key":"openaire____::081b82f96300b6a6e3d282bad31cb6e2","value":"Crossref"}},{"alternateIdentifiers":[{"scheme":"doi","value":"10.1016/j.agwat.2020.106475"},{"scheme":"mag_id","value":"3082937332"}],"type":"Article","urls":["https://dx.doi.org/10.1016/j.agwat.2020.106475"],"refereed":"nonPeerReviewed","hostedBy":{"key":"openaire____::55045bd2a65019fd8e6741a755395c8c","value":"Unknown Repository"},"collectedFrom":{"key":"openaire____::5f532a3fc4f1ea403f37070f59a7a53a","value":"Microsoft Academic Graph"}},{"alternateIdentifiers":[{"scheme":"mag_id","value":"3082937332"},{"scheme":"doi","value":"10.1016/j.agwat.2020.106475"}],"type":"Article","urls":["https://dx.doi.org/10.1016/j.agwat.2020.106475"],"refereed":"nonPeerReviewed","hostedBy":{"key":"openaire____::55045bd2a65019fd8e6741a755395c8c","value":"Unknown Repository"},"collectedFrom":{"key":"openaire____::5f532a3fc4f1ea403f37070f59a7a53a","value":"Microsoft Academic Graph"}}],"links":[],"otherTitles":null,"green":false,"inDiamondJournal":false,"isGreen":false,"isInDiamondJournal":false},{"authors":[{"id":null,"fullName":"Kılıç, Fatma Nur","name":"Fatma Nur","surname":"Kılıç","rank":1,"pid":null},{"id":null,"fullName":"Razzaghı, Somayyeh","name":"Somayyeh","surname":"Razzaghı","rank":2,"pid":null}],"openAccessColor":null,"publiclyFunded":false,"eoscIfGuidelines":null,"type":"publication","language":{"code":"eng","label":"English"},"countries":[{"code":"TR","label":"Turkey","provenance":null}],"subjects":[{"subject":{"scheme":"FOS","value":"0106 biological sciences"},"provenance":null},{"subject":{"scheme":"SDG","value":"2. Zero hunger"},"provenance":null},{"subject":{"scheme":"SDG","value":"15. Life on land"},"provenance":null},{"subject":{"scheme":"FOS","value":"01 natural sciences"},"provenance":null},{"subject":{"scheme":"SDG","value":"6. Clean water"},"provenance":null}],"mainTitle":"The impact of antitranspirants on grain yield and photosynthetic characteristics of two wheat cultivars during water deficit stress","subTitle":null,"descriptions":["<p>This study presents the results of a split-plot experiment conducted at Miandoab Agriculture Research Station,West Azarbaijan, during the 2015-2016 years. The study aimed to assess the effects of antitranspirants onseveral physiological traits of wheat, including photosynthesis, total chlorophyll content (chlorophyll a andchlorophyll b), grain protein percentage, grain yield, transpiration rate, and photosynthetic water useefficiency, under water deficit stress conditions. The experiment utilized a randomized complete block designwith three replications. The main plots were subjected to different irrigation treatments, involving completeirrigation, irrigation withholding at heading stages, and irrigation withholding at flowering stages. Within eachmain plot, subplots were allocated for foliar applications of distinct antitranspirants, namely Prometrin, Kaolin,Tmatrom, Chitosan, and a control group. Additionally, two wheat cultivars, Zarin and Mihan, were evaluatedto study cultivar-specific responses. The findings revealed significant effects of the antitranspirants on variousphysiological characteristics of wheat under drought stress. Specifically, the application of prometrin duringirrigation withholding at the flowering stage resulted in increased photosynthesis at 2 μmol CO2 m-2s-1compared to the control. Chitosan treatment at irrigation withholding during the heading stage exhibited thehighest total chlorophyll content (4.69 μg/g FW), while chitosan treatment also demonstrated the highestchlorophyll content (2.42 μg/g FW). In the Zarin cultivar, chitosan application during irrigation withholdingat the heading stage showed the highest chlorophyll b content. Furthermore, chitosan treatment duringirrigation withholding at the flowering stage significantly increased the protein content (12.27 mg/g DW) andenhanced the yield by 868 kg/ha in the Mihan cultivar compared to the control. Notably, the lowesttranspiration rate was observed during the irrigation withholding stage (3.83 mM H2O m-2 s-1). Overall, theresults highlighted the importance of considering the timing of stress and the type of cultivar in assessing theeffects of antitranspirants. Chitosan, in particular, showed promising potential for improving thephotosynthetic properties of wheat (Mihan cultivar) and enhancing seed yield under drought stress conditions.Keywords: Low irrigation, Chitosan, Chlorophyll, Protein, Wheat Cultivars, Grain Yield<br></p>"],"publicationDate":"2023-10-18","publisher":null,"embargoEndDate":null,"sources":null,"formats":null,"contributors":null,"coverages":null,"bestAccessRight":{"code":"c_14cb","label":"CLOSED","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/"},"container":null,"documentationUrls":null,"codeRepositoryUrl":null,"programmingLanguage":null,"contactPeople":null,"contactGroups":null,"tools":null,"size":null,"version":null,"geoLocations":null,"id":"od______9447::a95604c403851dc47537d5c3fd852404","originalIds":["fddcf699-d6db-4963-ac4d-9ea707e5ee91","50|od______9447::a95604c403851dc47537d5c3fd852404"],"pids":null,"dateOfCollection":null,"lastUpdateTimeStamp":null,"indicators":{"citationImpact":{"citationCount":0.0,"influence":2.1746283E-9,"popularity":1.6835128E-9,"impulse":0.0,"citationClass":"C5","influenceClass":"C5","impulseClass":"C5","popularityClass":"C5"}},"projects":null,"organizations":[{"legalName":"Erciyes University","acronym":"Erciyes University","id":"openorgs____::50ff920e3f2baaa9d847e091109b5328","pids":[{"scheme":"ISNI","value":"0000000123312603"},{"scheme":"mag_id","value":"87673952"},{"scheme":"FundRef","value":"501100016209"},{"scheme":"fundref","value":"501100016209"},{"scheme":"ROR","value":"https://ror.org/047g8vk19"},{"scheme":"GRID","value":"grid.411739.9"},{"scheme":"Wikidata","value":"Q4810943"},{"scheme":"OrgRef","value":"3748597"},{"scheme":"PIC","value":"996573830"},{"scheme":"FundRef","value":"501100003062"},{"scheme":"wikidata","value":"Q4810943"},{"scheme":"fundref","value":"501100003062"},{"scheme":"OrgReg","value":"TR0038"}],"countries":[{"code":"TR","label":"Turkey"}],"websiteurl":"http://en.erciyes.edu.tr/"}],"communities":null,"collectedFrom":[{"key":"opendoar____::22456f4b545572855c766df5eefc9832","value":"Erciyes University - AVESIS"}],"instances":[{"accessRight":{"code":"c_14cb","label":"CLOSED","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/","openAccessRoute":null},"type":"Conference object","urls":["https://avesis.erciyes.edu.tr/publication/details/fddcf699-d6db-4963-ac4d-9ea707e5ee91/oai"],"publicationDate":"2023-10-18","refereed":"nonPeerReviewed","hostedBy":{"key":"opendoar____::22456f4b545572855c766df5eefc9832","value":"Erciyes University - AVESIS"},"collectedFrom":{"key":"opendoar____::22456f4b545572855c766df5eefc9832","value":"Erciyes University - AVESIS"}}],"links":[],"otherTitles":null,"green":false,"inDiamondJournal":false,"isGreen":false,"isInDiamondJournal":false},{"authors":[{"id":null,"fullName":"Mohammad reza Rafie","name":null,"surname":null,"rank":1,"pid":null},{"id":null,"fullName":"Mahmoud Sohi","name":null,"surname":null,"rank":2,"pid":null},{"id":null,"fullName":"Maryam Javadzadeh","name":null,"surname":null,"rank":3,"pid":null}],"openAccessColor":"gold","publiclyFunded":false,"eoscIfGuidelines":null,"type":"publication","language":{"code":"fas/per","label":"Persian"},"countries":null,"subjects":[{"subject":{"scheme":"SDG","value":"2. Zero hunger"},"provenance":null},{"subject":{"scheme":"keyword","value":"Environmental sciences"},"provenance":null},{"subject":{"scheme":"keyword","value":"nutrients"},"provenance":null},{"subject":{"scheme":"FOS","value":"0401 agriculture, forestry, and fisheries"},"provenance":null},{"subject":{"scheme":"keyword","value":"GE1-350"},"provenance":null},{"subject":{"scheme":"FOS","value":"04 agricultural and veterinary sciences"},"provenance":null},{"subject":{"scheme":"SDG","value":"15. Life on land"},"provenance":null},{"subject":{"scheme":"keyword","value":"yield"},"provenance":null},{"subject":{"scheme":"keyword","value":"growth biostimulant"},"provenance":null},{"subject":{"scheme":"SDG","value":"6. Clean water"},"provenance":null},{"subject":{"scheme":"keyword","value":"irrigation"},"provenance":null},{"subject":{"scheme":"keyword","value":"yield components"},"provenance":null}],"mainTitle":"Evaluation the effect of amini acid, fulvic acid and seaweed extract application in normal and drought stress conditions on quantitative and qualitative characteristics of wheat in Behbahan region","subTitle":null,"descriptions":["IntroductionWheat (Triticum aestivum L.) is one of the important crops in our country. this plant contains starch, protein, sugar and provides food for human population. In recent years, drought stress has become the main abiotic stress, and could decrease growth and yield of wheat. The application of biostimulants, i.e. amino acids, fulvic acid or seaweed extract were found to positive effect on plant growth which overcomes the harmful effect of some environmental stress such as drought. In recent years, the favorable effects of these substances on vegetative characteristics, yield and grain quality of wheat have been reported. Many studies have shown that the application of biostimulants can increase plant tolerance during abiotic stresses, especially water deficit. Little research have been done about the effects of biostimulants on wheat in Khuzestan yet. Therefore, this experiment was conducted to evaluate the effect of amini acid, fulvic acid and seaweed extract in drought stress on quantitative and qualitative characteristics of wheat. Materials and methodsThis experiment was conducted as split-plot in randomized complete block design with three replications at Behbahan Agricultural Research Station for one year (2017-2018). Irrigation interval considered as main factor in two levels: (70 mm and 130 mm evaporation from class A pan) and the sub factor was growth biostimulants in four levels :control (application of chemical fertilizers according to soil test), amino acid, fulvic acid and seaweed extract. Foliar application of amino ccid, fulvic acid and seaweed extract was done at a concentration of 0.5 % at two stages, tillering and heading. During experiment: plant height, number of spikes per m2, number of grain per spike, 1000- grain weight, grain yield, nitrogen, phosphorus, potassium, zinc, manganes and iron were recorded. Varince analysis were done by MSTATC statistical software and meanes were compared using Duncan,s Multiple Range Test. Results and discussionThe results showed a significant increase in grain yield in plants treated with biostimulants compared with control. The highest plant height, number of spikes per m2, number of grain per spike, 1000-grain weight and grain yield were recorded in amino acid treatment. The highest increase in N, K and grain Fe was achieved by amino acid while the highest increase in P, Zn and Mn of grain was obtained by seaweed extract compared with control. The results indicated that water deficit stress significantly reduced plant height, number of spikes per m-2, 1000 seed weight, grain yield and nutrients. Also, drought stress significantly reduced grain nutrient uptake. Intreraction of the irrigation levels and biostimulants on grain yield indicated that all biostimulants significantly increased the yield in drought stress. The application of amino acids and seaweeds significantly increased grain yield in compared with both controls (under water deficit stress and under water normal conditions) while the use of fulvic acid significantly increased grain yield in comparison to control under water deficit stress. Therefore, the application of amino acid and seaweed extract reduced the effects of water deficit stress. ConclusionsThe results of this study showed that increasing water deficit stress caused significant reduction of all studied traits. However, the application of amino acid and seaweed extract reduced the effects of water deficit stress and increased these traits compared with control under favorable irrigation condition. According to the results, the application of amino acid or seaweed extract is recommended in normal and drought stress condition for wheat cv brat."],"publicationDate":"2021-03-01","publisher":"University of Birjand","embargoEndDate":null,"sources":["تنش های محیطی در علوم زراعی, Vol 14, Iss 1, Pp 131-141 (2021)"],"formats":null,"contributors":null,"coverages":null,"bestAccessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/"},"container":{"name":"تنش های محیطی در علوم زراعی","issnPrinted":"2383-3084","issnOnline":null,"issnLinking":null,"ep":null,"iss":null,"sp":null,"vol":null,"edition":null,"conferencePlace":null,"conferenceDate":null},"documentationUrls":null,"codeRepositoryUrl":null,"programmingLanguage":null,"contactPeople":null,"contactGroups":null,"tools":null,"size":null,"version":null,"geoLocations":null,"id":"dedup_wf_002::e2fdae872a0f9a6d2bdd3bdefd131021","originalIds":["oai:doaj.org/article:6a6ff821075f443989e7fed001139fc8","50|doajarticles::1ecc17f059e92da6d37fba1a9be9bda8"],"pids":null,"dateOfCollection":null,"lastUpdateTimeStamp":null,"indicators":{"citationImpact":{"citationCount":0.0,"influence":2.1746283E-9,"popularity":1.272318E-9,"impulse":0.0,"citationClass":"C5","influenceClass":"C5","impulseClass":"C5","popularityClass":"C5"}},"projects":null,"organizations":null,"communities":null,"collectedFrom":[{"key":"driver______::bee53aa31dc2cbb538c10c2b65fa5824","value":"DOAJ"}],"instances":[{"alternateIdentifiers":[{"scheme":"doi","value":"10.22077/escs.2019.2702.1707"}],"accessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/","openAccessRoute":"gold"},"type":"Article","urls":["https://doaj.org/article/6a6ff821075f443989e7fed001139fc8"],"publicationDate":"2021-03-01","refereed":"nonPeerReviewed","hostedBy":{"key":"doajarticles::36be0d20246d3ca0ff884880ec1dfe58","value":"تنش های محیطی در علوم زراعی"},"collectedFrom":{"key":"driver______::bee53aa31dc2cbb538c10c2b65fa5824","value":"DOAJ"}}],"links":[],"otherTitles":null,"green":false,"inDiamondJournal":false,"isGreen":false,"isInDiamondJournal":false},{"authors":[{"id":"orcid_______::1b79cf76ef72ac079ffc92771345a51a","fullName":"Sumera Anwar","name":"Sumera","surname":"Anwar","rank":1,"pid":{"id":{"scheme":"orcid","value":"0000-0001-8224-7370"},"provenance":null}},{"id":null,"fullName":"Razieh Khalilzadeh","name":"Razieh","surname":"Khalilzadeh","rank":2,"pid":null},{"id":"orcid_______::1b4da7a6c048eda64ee9acd4b1bcbd2e","fullName":"Shahbaz Khan","name":"Shahbaz","surname":"Khan","rank":3,"pid":{"id":{"scheme":"orcid","value":"0000-0002-3885-3688"},"provenance":null}},{"id":"orcid_______::d6cadd1ae50ea18a2ffe5307119470ba","fullName":"null Zaib-un-Nisa","name":null,"surname":"Zaib-un-Nisa","rank":4,"pid":{"id":{"scheme":"orcid","value":"0000-0002-8233-0972"},"provenance":null}},{"id":null,"fullName":"Rohina Bashir","name":"Rohina","surname":"Bashir","rank":5,"pid":null},{"id":null,"fullName":"Alireza Pirzad","name":"Alireza","surname":"Pirzad","rank":6,"pid":null},{"id":null,"fullName":"Arif Malik","name":"Arif","surname":"Malik","rank":7,"pid":null}],"openAccessColor":null,"publiclyFunded":false,"eoscIfGuidelines":null,"type":"publication","language":{"code":"eng","label":"English"},"countries":null,"subjects":[{"subject":{"scheme":"SDG","value":"2. Zero hunger"},"provenance":null},{"subject":{"scheme":"FOS","value":"0401 agriculture, forestry, and fisheries"},"provenance":null},{"subject":{"scheme":"FOS","value":"04 agricultural and veterinary sciences"},"provenance":null},{"subject":{"scheme":"SDG","value":"15. Life on land"},"provenance":null},{"subject":{"scheme":"SDG","value":"6. Clean water"},"provenance":null}],"mainTitle":"Mitigation of Drought Stress and Yield Improvement in Wheat by Zinc Foliar Spray Relates to Enhanced Water Use Efficiency and Zinc Contents","subTitle":null,"descriptions":["Water and nutrients scarcity are the two major factors for yield reduction in many wheat-producing areas of the world. Drought stress also restricts micronutrient uptake and thus induces micronutrient deficiency. Zinc is the most important micronutrient for abiotic stress tolerance. A field trial was conducted from 2013 to 2015 to study the effect of foliar application of zinc under normal (100% field capacity) and water deficit (60% field capacity) conditions on quantitative and qualitative aspects of wheat (Triticum aestivum L. var. Faisalabad-08). Three Zn levels (0, 0.1%, and 0.2% by using ZnSO4. 7H2O) were foliar sprayed at the vegetative and reproductive stages of wheat. Obtained results revealed that the growth, yield traits, photosynthetic pigments, and WUE were negatively affected by lower water supply. Zinc foliar application did not affect yield under normal irrigation conditions, however, under water deficit foliar application of 0.2% Zn enhanced grain yield to 25–40%. Zinc foliar spray at both vegetative and reproductive stages increased the chlorophyll contents and WUE. Zinc contents of wheat grain were more when 0.1% Zn was sprayed at the reproductive stage or 0.2% Zn at the vegetative stage. Thus, the foliar application of Zn is a promising short-term approach to improve productivity and grain nutrient content in wheat under water deficit stress. Furthermore, the timing and rate of Zn application could be helpful for the efficient use of water for increasing grain yield."],"publicationDate":"2021-03-06","publisher":"Springer Science and Business Media LLC","embargoEndDate":null,"sources":["Crossref"],"formats":null,"contributors":null,"coverages":null,"bestAccessRight":{"code":"c_14cb","label":"CLOSED","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/"},"container":{"name":"International Journal of Plant Production","issnPrinted":"1735-6814","issnOnline":"1735-8043","issnLinking":null,"ep":"389","iss":null,"sp":"377","vol":"15","edition":null,"conferencePlace":null,"conferenceDate":null},"documentationUrls":null,"codeRepositoryUrl":null,"programmingLanguage":null,"contactPeople":null,"contactGroups":null,"tools":null,"size":null,"version":null,"geoLocations":null,"id":"doi_dedup___::50806ee0d11188290ad3009946de3924","originalIds":["136","10.1007/s42106-021-00136-6","50|doiboost____|50806ee0d11188290ad3009946de3924","3134689387"],"pids":[{"scheme":"doi","value":"10.1007/s42106-021-00136-6"}],"dateOfCollection":null,"lastUpdateTimeStamp":null,"indicators":{"citationImpact":{"citationCount":32.0,"influence":2.9991385E-9,"popularity":2.2212133E-8,"impulse":19.0,"citationClass":"C4","influenceClass":"C4","impulseClass":"C4","popularityClass":"C4"}},"projects":null,"organizations":[{"legalName":"University of Lahore","acronym":"UOL","id":"openorgs____::cc9afd62d07034388a3e95835f011e60","pids":[{"scheme":"wikidata","value":"Q3694742"},{"scheme":"ROR","value":"https://ror.org/051jrjw38"},{"scheme":"OrgRef","value":"2959312"},{"scheme":"ISNI","value":"0000000104154232"},{"scheme":"GRID","value":"grid.440564.7"},{"scheme":"mag_id","value":"142204992"},{"scheme":"Wikidata","value":"Q3694742"}],"countries":[{"code":"PK","label":"Pakistan"}],"websiteurl":"https://www.uol.edu.pk/"},{"legalName":"Urmia University","acronym":"Urmia University","id":"openorgs____::4ac0f8f5eb4b1bdc9e76acfa96130502","pids":[{"scheme":"wikidata","value":"Q3874128"},{"scheme":"ISNI","value":"0000000404428645"},{"scheme":"OrgRef","value":"5888970"},{"scheme":"fundref","value":"501100007298"},{"scheme":"mag_id","value":"38476204"},{"scheme":"OrgRef","value":"3529631"},{"scheme":"GRID","value":"grid.412763.5"},{"scheme":"Wikidata","value":"Q3874128"},{"scheme":"FundRef","value":"501100007298"},{"scheme":"ROR","value":"https://ror.org/032fk0x53"}],"countries":[{"code":"IR","label":"Iran (Islamic Republic of)"}],"websiteurl":"http://www.urmia.ac.ir/"},{"legalName":"Shanxi Agricultural University","acronym":"Shanxi Agricultural University","id":"openorgs____::8aa35465c7ca4f98b41d2ae47c83af91","pids":[{"scheme":"PIC","value":"921238392"},{"scheme":"Wikidata","value":"Q1389327"},{"scheme":"wikidata","value":"Q1389327"},{"scheme":"ROR","value":"https://ror.org/05e9f5362"},{"scheme":"fundref","value":"501100013805"},{"scheme":"FundRef","value":"501100013805"},{"scheme":"mag_id","value":"119868032"},{"scheme":"GRID","value":"grid.412545.3"},{"scheme":"ISNI","value":"0000000417981300"},{"scheme":"OrgRef","value":"919247"}],"countries":[{"code":"CN","label":"China (People's Republic of)"}],"websiteurl":"http://www.sxau.edu.cn/"},{"legalName":"Government College University, Faisalabad","acronym":"GCUF","id":"openorgs____::64f0d884ab242aa73bea1110e101e2ff","pids":[{"scheme":"OrgRef","value":"35553608"},{"scheme":"ISNI","value":"000000040637891X"},{"scheme":"mag_id","value":"194348271"},{"scheme":"wikidata","value":"Q5588732"},{"scheme":"ROR","value":"https://ror.org/051zgra59"},{"scheme":"GRID","value":"grid.411786.d"},{"scheme":"Wikidata","value":"Q5588732"}],"countries":[{"code":"PK","label":"Pakistan"}],"websiteurl":"http://gcuf.edu.pk/"}],"communities":null,"collectedFrom":[{"key":"openaire____::081b82f96300b6a6e3d282bad31cb6e2","value":"Crossref"},{"key":"openaire____::5f532a3fc4f1ea403f37070f59a7a53a","value":"Microsoft Academic Graph"}],"instances":[{"pids":[{"scheme":"doi","value":"10.1007/s42106-021-00136-6"}],"license":"Springer TDM","accessRight":{"code":"c_14cb","label":"CLOSED","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/","openAccessRoute":null},"type":"Article","urls":["https://doi.org/10.1007/s42106-021-00136-6"],"publicationDate":"2021-03-06","refereed":"peerReviewed","hostedBy":{"key":"issn___print::d954302b63ff32bbc44eef656cb9a5de","value":"International Journal of Plant Production"},"collectedFrom":{"key":"openaire____::081b82f96300b6a6e3d282bad31cb6e2","value":"Crossref"}},{"alternateIdentifiers":[{"scheme":"mag_id","value":"3134689387"},{"scheme":"doi","value":"10.1007/s42106-021-00136-6"}],"type":"Article","urls":["https://dx.doi.org/10.1007/s42106-021-00136-6"],"refereed":"nonPeerReviewed","hostedBy":{"key":"openaire____::55045bd2a65019fd8e6741a755395c8c","value":"Unknown Repository"},"collectedFrom":{"key":"openaire____::5f532a3fc4f1ea403f37070f59a7a53a","value":"Microsoft Academic Graph"}},{"alternateIdentifiers":[{"scheme":"mag_id","value":"3134689387"},{"scheme":"doi","value":"10.1007/s42106-021-00136-6"}],"type":"Article","urls":["https://dx.doi.org/10.1007/s42106-021-00136-6"],"refereed":"nonPeerReviewed","hostedBy":{"key":"openaire____::55045bd2a65019fd8e6741a755395c8c","value":"Unknown Repository"},"collectedFrom":{"key":"openaire____::5f532a3fc4f1ea403f37070f59a7a53a","value":"Microsoft Academic Graph"}}],"links":[],"otherTitles":null,"green":false,"inDiamondJournal":false,"isGreen":false,"isInDiamondJournal":false},{"authors":[{"id":"orcid_______::d8848fcf86148f841b39b2bedc3ad924","fullName":"A. G. Komisarenko","name":"A. G.","surname":"Komisarenko","rank":1,"pid":{"id":{"scheme":"orcid","value":"0000-0003-2081-4055"},"provenance":null}},{"id":"orcid_______::d1f332f1e8e6b1120736c5460c657a93","fullName":"L. O. Mykhalskyi","name":"L. O.","surname":"Mykhalskyi","rank":2,"pid":{"id":{"scheme":"orcid","value":"0000-0001-8835-0862"},"provenance":null}}],"openAccessColor":"gold","publiclyFunded":false,"eoscIfGuidelines":null,"type":"publication","language":{"code":"und","label":"Undetermined"},"countries":null,"subjects":[{"subject":{"scheme":"FOS","value":"0106 biological sciences"},"provenance":null},{"subject":{"scheme":"FOS","value":"01 natural sciences"},"provenance":null}],"mainTitle":"Study of adaptive potential to drought in offspring of genetically modified wheat plants (Triticum aestivum L.)","subTitle":null,"descriptions":["<jats:p>Aim. To investigate the tolerance of the seed generation (T4) of genetically modified common wheat plants (Triticum aestivum L.) containing a suppressor of the proline catabolism gene (pdh) to osmotic stress, based on the analysis of physiological and biochemical parameters and yield structure. Methods. Determination of free L-proline (Pro) content, physiological and growth parameters and grain yield. Results. The Pro level was investigated and growth parameters, physiological state and main elements of yield were analyzed in transgenic and original forms under normal/stress/recovery conditions. Conclusions. T4 wheat plants under water deficit were characterized by a higher percentage and faster seed germination rate than the original genotypes. The survival rate of genetically modified forms was 76.8 %, while the original ones were only 14 %. Transgenic seedlings had a higher L-proline content, compared to the control ones, under optimal irrigation by an average of 1.7 times, and under water deficit by 30 %. During the recovery period, its level decreased in the initial forms by an average of 49 %, and in T4 by 28 %. Under optimal irrigation conditions, the studied plant variants did not significantly differ in productivity elements. Drought led to their decrease, but in T4 descendants they were less pronounced and significantly higher.</jats:p>"],"publicationDate":"2025-09-01","publisher":"Institute of Molecular Biology and Genetics (NAS Ukraine)","embargoEndDate":null,"sources":["Crossref"],"formats":null,"contributors":null,"coverages":null,"bestAccessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/"},"container":{"name":"Faktori eksperimental'noi evolucii organizmiv","issnPrinted":"2219-3782","issnOnline":"2415-3826","issnLinking":null,"ep":"157","iss":null,"sp":"152","vol":"37","edition":null,"conferencePlace":null,"conferenceDate":null},"documentationUrls":null,"codeRepositoryUrl":null,"programmingLanguage":null,"contactPeople":null,"contactGroups":null,"tools":null,"size":null,"version":null,"geoLocations":null,"id":"doi_________::ca96ce0fbb265e667c4618818c6e2bc3","originalIds":["10.7124/feeo.v37.1763","50|doiboost____|ca96ce0fbb265e667c4618818c6e2bc3"],"pids":[{"scheme":"doi","value":"10.7124/feeo.v37.1763"}],"dateOfCollection":null,"lastUpdateTimeStamp":null,"indicators":{"citationImpact":{"citationCount":0.0,"influence":2.1746283E-9,"popularity":2.2497804E-9,"impulse":0.0,"citationClass":"C5","influenceClass":"C5","impulseClass":"C5","popularityClass":"C5"}},"projects":null,"organizations":[{"legalName":"Institute of Plant Physiology and Genetics of the National Academy of Sciences of Ukraine","acronym":"IPPG","id":"pending_org_::955113ae9ccc21f231e31c0fc398e713","pids":[{"scheme":"wikidata","value":"Q12074697"},{"scheme":"ROR","value":"https://ror.org/04qaccc26"}],"countries":[{"code":"UA","label":"Ukraine"}],"websiteurl":"https://www.ifrg.kiev.ua"}],"communities":null,"collectedFrom":[{"key":"openaire____::081b82f96300b6a6e3d282bad31cb6e2","value":"Crossref"}],"instances":[{"pids":[{"scheme":"doi","value":"10.7124/feeo.v37.1763"}],"accessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/","openAccessRoute":"gold"},"type":"Article","urls":["https://doi.org/10.7124/feeo.v37.1763"],"publicationDate":"2025-09-01","refereed":"peerReviewed","hostedBy":{"key":"doajarticles::c5cafee4e804399c34ef748e9a6673c1","value":"Фактори експериментальної еволюції організмів"},"collectedFrom":{"key":"openaire____::081b82f96300b6a6e3d282bad31cb6e2","value":"Crossref"}}],"links":[],"otherTitles":null,"green":false,"inDiamondJournal":false,"isGreen":false,"isInDiamondJournal":false},{"authors":[{"id":null,"fullName":"Adnan Shehzad","name":null,"surname":"Adnan Shehzad","rank":1,"pid":null},{"id":null,"fullName":"Abdul majid","name":null,"surname":"Abdul majid","rank":2,"pid":null},{"id":null,"fullName":"Ubairah","name":null,"surname":"Ubairah","rank":3,"pid":null},{"id":null,"fullName":"Hafiz Ullah","name":null,"surname":"Hafiz Ullah","rank":4,"pid":null},{"id":null,"fullName":"Nasr Ullah Khan","name":null,"surname":"Nasr Ullah Khan","rank":5,"pid":null}],"openAccessColor":null,"publiclyFunded":false,"eoscIfGuidelines":null,"type":"publication","language":{"code":"und","label":"Undetermined"},"countries":null,"subjects":[{"subject":{"scheme":"FOS","value":"0106 biological sciences"},"provenance":null},{"subject":{"scheme":"FOS","value":"01 natural sciences"},"provenance":null}],"mainTitle":"Screening of Wheat (Triticum aestivum L.) Genotypes for Drought Tolerance through Estimation of Chlorophyll and Proline Contents","subTitle":null,"descriptions":["Wheat (Triticum aestivum L) is a staple food cereal crop for the majority of the global population. Water scarcity is a major challenge to wheat productivity under changing climate conditions, especially in arid and semi-arid regions. During recent years, different agronomic, physiological, and molecular approaches have been used to overcome the problems related to drought stress. The adverse effects of single or multiple environmental stresses, such as drought, high and low temperatures, and nutrient deficiencies on plant growth and yield have become severe in recent years due to increased global climate change and the occurrence of extreme weather events. This study was designed to investigate the screening of wheat genotypes under drought and irrigated conditions and to identify the best-performing genotypes under both conditions. Five different genotypes were used in two factors and three replications at Gomal University, Dera Ismail Khan, and investigated for yield and drought tolerance under irrigated and drought conditions by the estimation of chlorophyll and proline contents.  Data collected for yield/pot (g) and drought tolerance by estimating chlorophyll and proline contents was subjected to Statistix 8.1 software at the 5% probability level. Results revealed significant differences (P ≤ 0.01) among genotypes for chlorophyll and proline contents, and yield/pot. Under both irrigated and drought treatments, AZRC Dera exhibited the highest chlorophyll content value (46.33 and 45.11, respectively), followed by RK-2022 (43.32 and 41.89, respectively). Similarly, under drought stress conditions, RK-2022 (20.21) and AZRC Dera (18.86) recorded the accumulation of the highest proline content, followed by Wadan (18.21). Moreover, the irrigation treatments and stressed plants varied the grain yield from 0.72 to 0.49 and 0.52 to 0.28 grams/plot, respectively. AZRC Dera and RK-2022 exhibited a higher yield/plot (g) under both irrigated (0.72g and 0.65g, respectively) and drought (0.52g and 0.48g, respectively) conditions. Considering yield and drought-responsive high chlorophyll and proline contents, AZRC Dera and RK-2022 showed greater drought tolerance and revealed potential to grow under water deficit conditions in comparison to other cultivars."],"publicationDate":"2025-04-17","publisher":"BWO Researches International","embargoEndDate":null,"sources":null,"formats":null,"contributors":null,"coverages":null,"bestAccessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/"},"container":null,"documentationUrls":null,"codeRepositoryUrl":null,"programmingLanguage":null,"contactPeople":null,"contactGroups":null,"tools":null,"size":null,"version":null,"geoLocations":null,"id":"doi_dedup___::15ae60d6faecea9fabcec9fe0296eb89","originalIds":["50|datacite____::15ae60d6faecea9fabcec9fe0296eb89","10.5281/zenodo.15235114","50|datacite____::18ae4f5dd4ea2d544c73a5d82df419a6","10.5281/zenodo.15235115","50|od______2659::18ae4f5dd4ea2d544c73a5d82df419a6","oai:zenodo.org:15235115"],"pids":[{"scheme":"doi","value":"10.5281/zenodo.15235114"},{"scheme":"doi","value":"10.5281/zenodo.15235115"}],"dateOfCollection":null,"lastUpdateTimeStamp":null,"indicators":{"citationImpact":{"citationCount":0.0,"influence":2.1746283E-9,"popularity":2.2497804E-9,"impulse":0.0,"citationClass":"C5","influenceClass":"C5","impulseClass":"C5","popularityClass":"C5"}},"projects":null,"organizations":[{"legalName":"COMSATS University Islamabad","acronym":"CIIT","id":"openorgs____::0394966b2599d6af91ba409b34b9a3be","pids":[{"scheme":"Wikidata","value":"Q5013372"},{"scheme":"GRID","value":"grid.418920.6"},{"scheme":"wikidata","value":"Q5013372"},{"scheme":"ISNI","value":"0000000406070704"},{"scheme":"mag_id","value":"16076960"},{"scheme":"FundRef","value":"100009529"},{"scheme":"OrgRef","value":"2817531"},{"scheme":"ROR","value":"https://ror.org/00nqqvk19"},{"scheme":"fundref","value":"100009529"}],"countries":[{"code":"PK","label":"Pakistan"}],"websiteurl":"https://www.comsats.edu.pk/"},{"legalName":"University of Agriculture","acronym":"UAP","id":"openorgs____::960fcbd5a9e0039becd9adcf98bae948","pids":[{"scheme":"Wikidata","value":"Q4693940"},{"scheme":"GRID","value":"grid.412298.4"},{"scheme":"FundRef","value":"100015889"},{"scheme":"wikidata","value":"Q4693940"},{"scheme":"ROR","value":"https://ror.org/02sp3q482"},{"scheme":"OrgRef","value":"1369976"},{"scheme":"fundref","value":"100015888"},{"scheme":"PIC","value":"950042639"},{"scheme":"ISNI","value":"0000000085778102"},{"scheme":"FundRef","value":"100015888"},{"scheme":"fundref","value":"100015889"},{"scheme":"mag_id","value":"246743127"}],"countries":[{"code":"PK","label":"Pakistan"}],"websiteurl":"http://www.aup.edu.pk/"},{"legalName":"Gomal University","acronym":"Gomal University","id":"openorgs____::f7b1ff2df11e70a343e512542117c7fd","pids":[{"scheme":"GRID","value":"grid.411749.e"},{"scheme":"OrgRef","value":"3558457"},{"scheme":"ROR","value":"https://ror.org/0241b8f19"},{"scheme":"ISNI","value":"0000000102216962"},{"scheme":"wikidata","value":"Q13211646"},{"scheme":"Wikidata","value":"Q13211646"},{"scheme":"mag_id","value":"172324550"}],"countries":[{"code":"PK","label":"Pakistan"}],"websiteurl":"http://www.gu.edu.pk/New/index.asp"}],"communities":[{"code":"eosc","label":"EOSC","provenance":null}],"collectedFrom":[{"key":"openaire____::9e3be59865b2c1c335d32dae2fe7b254","value":"Datacite"},{"key":"opendoar____::358aee4cc897452c00244351e4d91f69","value":"ZENODO"}],"instances":[{"pids":[{"scheme":"doi","value":"10.5281/zenodo.15235114"}],"license":"CC BY","type":"Article","urls":["https://dx.doi.org/10.5281/zenodo.15235114"],"publicationDate":"2025-04-17","refereed":"nonPeerReviewed","hostedBy":{"key":"opendoar____::358aee4cc897452c00244351e4d91f69","value":"ZENODO"},"collectedFrom":{"key":"openaire____::9e3be59865b2c1c335d32dae2fe7b254","value":"Datacite"}},{"pids":[{"scheme":"doi","value":"10.5281/zenodo.15235115"}],"license":"CC BY","type":"Article","urls":["https://dx.doi.org/10.5281/zenodo.15235115"],"publicationDate":"2025-04-17","refereed":"nonPeerReviewed","hostedBy":{"key":"opendoar____::358aee4cc897452c00244351e4d91f69","value":"ZENODO"},"collectedFrom":{"key":"openaire____::9e3be59865b2c1c335d32dae2fe7b254","value":"Datacite"}},{"pids":[{"scheme":"doi","value":"10.5281/zenodo.15235115"}],"alternateIdentifiers":[{"scheme":"oai","value":"oai:zenodo.org:15235115"}],"license":"CC BY","accessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/","openAccessRoute":null},"type":"Article","urls":["https://zenodo.org/records/15235115","http://dx.doi.org/10.5281/zenodo.15235115"],"publicationDate":"2025-04-17","refereed":"nonPeerReviewed","hostedBy":{"key":"opendoar____::358aee4cc897452c00244351e4d91f69","value":"ZENODO"},"collectedFrom":{"key":"opendoar____::358aee4cc897452c00244351e4d91f69","value":"ZENODO"}}],"links":[],"otherTitles":null,"green":true,"inDiamondJournal":false,"isGreen":true,"isInDiamondJournal":false},{"authors":[{"id":null,"fullName":"Yaoyuan Zhang","name":"Yaoyuan","surname":"Zhang","rank":1,"pid":{"id":{"scheme":"orcid_pending","value":"0009-0008-5150-909x"},"provenance":null}},{"id":null,"fullName":"Haojie Yin","name":"Haojie","surname":"Yin","rank":2,"pid":null},{"id":null,"fullName":"Rongrong Wang","name":"Rongrong","surname":"Wang","rank":3,"pid":null},{"id":null,"fullName":"Fangfang He","name":"Fangfang","surname":"He","rank":4,"pid":null},{"id":null,"fullName":"Guiying Jiang","name":"Guiying","surname":"Jiang","rank":5,"pid":null}],"openAccessColor":"gold","publiclyFunded":false,"eoscIfGuidelines":null,"type":"publication","language":{"code":"eng","label":"English"},"countries":null,"subjects":[{"subject":{"scheme":"FOS","value":"0106 biological sciences"},"provenance":null},{"subject":{"scheme":"keyword","value":"morphological characteristics"},"provenance":null},{"subject":{"scheme":"keyword","value":"spring wheat"},"provenance":null},{"subject":{"scheme":"keyword","value":"resistance to lodging"},"provenance":null},{"subject":{"scheme":"keyword","value":"S"},"provenance":null},{"subject":{"scheme":"FOS","value":"0401 agriculture, forestry, and fisheries"},"provenance":null},{"subject":{"scheme":"keyword","value":"Agriculture"},"provenance":null},{"subject":{"scheme":"FOS","value":"04 agricultural and veterinary sciences"},"provenance":null},{"subject":{"scheme":"keyword","value":"lignin metabolism"},"provenance":null},{"subject":{"scheme":"keyword","value":"yield"},"provenance":null},{"subject":{"scheme":"FOS","value":"01 natural sciences"},"provenance":null},{"subject":{"scheme":"keyword","value":"irrigation"},"provenance":null}],"mainTitle":"Effects of Deficit Irrigation on Spring Wheat Lignification Process, Yield Productivity and Stalk Strength","subTitle":null,"descriptions":["<jats:p>Moderate deficit irrigation can improve lignin metabolism, thereby increasing wheat yield and lodging resistance. The moisture-sensitive variety Xinchun 22 (XC22) and drought-resistant variety Xinchun 6 (XC6) were used as experimental materials. We set mild drought (T1, J1 and 60–65% FC, where FC is the field capacity) and moderate drought (T2, J2 and 45–50% FC) during the tillering stage (T) and the jointing stage (J). We used conventional drip irrigation as a control (CK and 75–80% FC). The results show that the activity of lignin synthesis-related enzymes decreased with the growth process, while the accumulation and monomer content of lignin increased under different water treatments. The lignin metabolism and morphological characteristics of XC6 were higher than those of XC22. Under the same processing conditions, the indicators of XC22 showed more significant changes and were more sensitive to changes in the moisture content. Compared with other treatments, the stem thickness and wall thickness of the J1 treatment increased by 0.86–23.49% and 1.72–23.58%. The yield of the T1 treatment was the highest, increasing by 3.05–44.06% compared to other treatments. In addition, by improving PAL, H-type lignin monomers, S-type lignin monomers, stem thickness and lignin metabolism, grain yield can be increased. After mild drought during the jointing stage, J1 significantly improved the lignin metabolism capacity of the stem, increased stem thickness and wall thickness, and was beneficial for improving lodging resistance. The T1 treatment favored the improvement of the production capacity of assimilates, thus promoting a high yield of spring wheat.</jats:p>"],"publicationDate":"2024-11-10","publisher":"MDPI AG","embargoEndDate":null,"sources":["Crossref","Agronomy, Vol 14, Iss 11, p 2647 (2024)","Agronomy","Volume 14","Issue 11","Pages: 2647"],"formats":["application/pdf"],"contributors":null,"coverages":null,"bestAccessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/"},"container":{"name":"Agronomy","issnPrinted":null,"issnOnline":"2073-4395","issnLinking":null,"ep":null,"iss":null,"sp":"2647","vol":"14","edition":null,"conferencePlace":null,"conferenceDate":null},"documentationUrls":null,"codeRepositoryUrl":null,"programmingLanguage":null,"contactPeople":null,"contactGroups":null,"tools":null,"size":null,"version":null,"geoLocations":null,"id":"doi_dedup___::69f30a569f5e01203e921418effc5855","originalIds":["agronomy14112647","10.3390/agronomy14112647","50|doiboost____|69f30a569f5e01203e921418effc5855","oai:doaj.org/article:c5dfd45a115d4b42bdb79e8a6d5d2467","50|doajarticles::40df2229e167aa273702d9c6d0a68f17","oai:mdpi.com:/2073-4395/14/11/2647/","50|multidiscipl::79d837a2ee42b4c6964c63557157de0a"],"pids":[{"scheme":"doi","value":"10.3390/agronomy14112647"}],"dateOfCollection":null,"lastUpdateTimeStamp":null,"indicators":{"citationImpact":{"citationCount":6.0,"influence":2.3355955E-9,"popularity":5.8154406E-9,"impulse":6.0,"citationClass":"C5","influenceClass":"C5","impulseClass":"C4","popularityClass":"C4"}},"projects":null,"organizations":[{"legalName":"Shihezi University","acronym":"Shihezi University","id":"openorgs____::59e13b0d4f3933c2b6f706b75dbdd097","pids":[{"scheme":"fundref","value":"501100004317"},{"scheme":"wikidata","value":"Q2578027"},{"scheme":"OrgRef","value":"19231538"},{"scheme":"mag_id","value":"102208913"},{"scheme":"Wikidata","value":"Q2578027"},{"scheme":"FundRef","value":"501100004317"},{"scheme":"GRID","value":"grid.411680.a"},{"scheme":"ROR","value":"https://ror.org/04x0kvm78"},{"scheme":"ISNI","value":"0000000105144044"}],"countries":[{"code":"CN","label":"China (People's Republic of)"}],"websiteurl":"http://www.shzu.edu.cn/"}],"communities":null,"collectedFrom":[{"key":"openaire____::c2cdfa5866e03cdd07d313cbc8fb8311","value":"Multidisciplinary Digital Publishing Institute"},{"key":"driver______::bee53aa31dc2cbb538c10c2b65fa5824","value":"DOAJ"},{"key":"openaire____::081b82f96300b6a6e3d282bad31cb6e2","value":"Crossref"}],"instances":[{"pids":[{"scheme":"doi","value":"10.3390/agronomy14112647"}],"license":"CC BY","accessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/","openAccessRoute":"gold"},"type":"Article","urls":["https://doi.org/10.3390/agronomy14112647"],"publicationDate":"2024-11-10","refereed":"peerReviewed","hostedBy":{"key":"doajarticles::d22a599d82ed8cbde0534d7f655148cb","value":"Agronomy"},"collectedFrom":{"key":"openaire____::081b82f96300b6a6e3d282bad31cb6e2","value":"Crossref"}},{"alternateIdentifiers":[{"scheme":"doi","value":"10.3390/agronomy14112647"}],"accessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/","openAccessRoute":"gold"},"type":"Article","urls":["https://doaj.org/article/c5dfd45a115d4b42bdb79e8a6d5d2467"],"publicationDate":"2024-11-01","refereed":"nonPeerReviewed","hostedBy":{"key":"doajarticles::d22a599d82ed8cbde0534d7f655148cb","value":"Agronomy"},"collectedFrom":{"key":"driver______::bee53aa31dc2cbb538c10c2b65fa5824","value":"DOAJ"}},{"alternateIdentifiers":[{"scheme":"doi","value":"10.3390/agronomy14112647"}],"license":"CC BY","accessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/","openAccessRoute":"gold"},"type":"Article","urls":["https://dx.doi.org/10.3390/agronomy14112647"],"publicationDate":"2024-11-10","refereed":"peerReviewed","hostedBy":{"key":"doajarticles::d22a599d82ed8cbde0534d7f655148cb","value":"Agronomy"},"collectedFrom":{"key":"openaire____::c2cdfa5866e03cdd07d313cbc8fb8311","value":"Multidisciplinary Digital Publishing Institute"}}],"links":[],"otherTitles":null,"green":false,"inDiamondJournal":false,"isGreen":false,"isInDiamondJournal":false},{"authors":[{"id":null,"fullName":"Ziqiang Che","name":null,"surname":null,"rank":1,"pid":null},{"id":null,"fullName":"Shuting Bie","name":null,"surname":null,"rank":2,"pid":null},{"id":null,"fullName":"Rongrong Wang","name":null,"surname":null,"rank":3,"pid":null},{"id":null,"fullName":"Yilin Ma","name":null,"surname":null,"rank":4,"pid":null},{"id":null,"fullName":"Yaoyuan Zhang","name":null,"surname":null,"rank":5,"pid":null},{"id":null,"fullName":"Fangfang He","name":null,"surname":null,"rank":6,"pid":null},{"id":null,"fullName":"Guiying Jiang","name":null,"surname":null,"rank":7,"pid":null}],"openAccessColor":"gold","publiclyFunded":false,"eoscIfGuidelines":null,"type":"publication","language":{"code":"eng","label":"English"},"countries":null,"subjects":[{"subject":{"scheme":"keyword","value":"protection system"},"provenance":null},{"subject":{"scheme":"keyword","value":"spring wheat"},"provenance":null},{"subject":{"scheme":"keyword","value":"senescence"},"provenance":null},{"subject":{"scheme":"keyword","value":"Agriculture (General)"},"provenance":null},{"subject":{"scheme":"FOS","value":"0401 agriculture, forestry, and fisheries"},"provenance":null},{"subject":{"scheme":"FOS","value":"04 agricultural and veterinary sciences"},"provenance":null},{"subject":{"scheme":"keyword","value":"endogenous hormones"},"provenance":null},{"subject":{"scheme":"keyword","value":"yield"},"provenance":null},{"subject":{"scheme":"keyword","value":"S1-972"},"provenance":null}],"mainTitle":"Mild deficit irrigation delays flag leaf senescence and increases yield in drip-irrigated spring wheat by regulating endogenous hormones","subTitle":null,"descriptions":["Drought is one of the important stress factors affecting the growth and development processes of wheat in China’s arid zones, which severely limits the yield. This study examined the impact of deficit irrigation on the flag leaf protection system and yield of drip-irrigated spring wheat during the growth stages in arid zones. In addition, this study aimed to determine the optimal water supply mode for efficient production under drip irrigation conditions and to provide technical support for water-saving and high-yield cultivation of drip-irrigated wheat. The experiment was conducted with a split plot design using the water-sensitive variety Xinchun 22 (XC22) and the drought-tolerant variety Xinchun 6 (XC6) as the main plots, while a fully irrigated control (CK, 75–80% FC, where FC is field water holding capacity), mild deficit (T1, 60–65% FC) and moderate deficit (T2, 45–50% FC) at the tillering stage, and mild deficit (J1, 60–65% FC) and moderate deficit (J2, 45–50% FC) at the jointing stage were used as the subplots. Systematic studies were conducted on the regulatory effects of deficit irrigation during the tillering and jointing stages on protective substances, membrane lipid metabolism, endogenous hormones in the flag leaf, and yield of spring wheat. Compared with treatments T2 and J2, treatments T1 and J1 were beneficial for increasing the activities of superoxide dismutase (SOD), peroxidase (POD), and catalase (CAT), the levels of proline (Pro), indole-3-acetic acid (IAA), and zeatin riboside (ZR), and the ratios IAA/abscisic acid (ABA), ZR/ABA, IAA/ZR, and (IAA+ZR)/ABA, while reducing the levels of hydrogen peroxide (H2O2), superoxide anion radicals (O2–·), malondialdehyde (MDA), phosphatidic acid (PA), free fatty acids (FFA), ABA, phospholipase D (PLD), and lipoxygenase (LOX), alleviating flag leaf senescence, and increasing yield. Under treatment T1, the SOD, POD, CAT, and Pro levels of flag leaves in XC6 were 11.14, 8.08, 12.98, and 3.66% higher than those of treatment CK, and under treatment J1, they were 6.43, 4.49, 7.36, and 2.50% higher than those of treatment CK. Under treatment T1 in XC6, the IAA, ZR level of the flag leaf, spike number, grains per spike, 1,000-grain weight and yield were 10.50, 5.79, 3.10, 8.84, 3.78, and 10.52% higher than those of treatment CK, and under treatment J1, they were 5.36, 3.94, 2.40, 3.72, 1.37, and 4.46% higher than those of treatment CK. Compared with XC22, XC6 was more conducive to the improvement of flag leaf protective substances, IAA, ZR, dry matter weight, yield components and yield. The correlation analysis showed significant positive correlations between IAA and ZR with SOD, POD, CAT, proline, and yield. IAA and ZR promoted the enhancement of protective enzyme activities, thereby clearing reactive oxygen species to cope with the oxidative stress caused by drought and achieve the effect of delaying senescence. Principal component analysis showed that yield components and dry matter weight, had direct effects on yield. Mild deficiency during the tillering stage without water stress in other stages could effectively optimize yield components, not only achieving high yield while increasing protective substances, but also reducing the reactive oxygen species content. This strategy can be recommended as a water-saving and high-yield production mode for drip irrigation of spring wheat in Xinjiang, China."],"publicationDate":"2025-08-01","publisher":"Elsevier BV","embargoEndDate":null,"sources":["Crossref","Journal of Integrative Agriculture, Vol 24, Iss 8, Pp 2954-2973 (2025)"],"formats":null,"contributors":null,"coverages":null,"bestAccessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/"},"container":{"name":"Journal of Integrative Agriculture","issnPrinted":"2095-3119","issnOnline":null,"issnLinking":null,"ep":"2973","iss":null,"sp":"2954","vol":"24","edition":null,"conferencePlace":null,"conferenceDate":null},"documentationUrls":null,"codeRepositoryUrl":null,"programmingLanguage":null,"contactPeople":null,"contactGroups":null,"tools":null,"size":null,"version":null,"geoLocations":null,"id":"doi_dedup___::85e92584db2ec4233d8fcfa29508b039","originalIds":["S2095311925000644","10.1016/j.jia.2025.03.009","50|doiboost____|85e92584db2ec4233d8fcfa29508b039","50|doajarticles::650f4edb0fc27c7f8df5390444ca9ece","oai:doaj.org/article:930cc795454b449981d46ea6731bb9e1"],"pids":[{"scheme":"doi","value":"10.1016/j.jia.2025.03.009"}],"dateOfCollection":null,"lastUpdateTimeStamp":null,"indicators":{"citationImpact":{"citationCount":10.0,"influence":2.5607767E-9,"popularity":8.711195E-9,"impulse":10.0,"citationClass":"C4","influenceClass":"C5","impulseClass":"C4","popularityClass":"C4"}},"projects":null,"organizations":null,"communities":null,"collectedFrom":[{"key":"driver______::bee53aa31dc2cbb538c10c2b65fa5824","value":"DOAJ"},{"key":"openaire____::081b82f96300b6a6e3d282bad31cb6e2","value":"Crossref"}],"instances":[{"pids":[{"scheme":"doi","value":"10.1016/j.jia.2025.03.009"}],"license":"CC BY NC ND","accessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/","openAccessRoute":"gold"},"type":"Article","urls":["https://doi.org/10.1016/j.jia.2025.03.009"],"publicationDate":"2025-08-01","refereed":"peerReviewed","hostedBy":{"key":"doajarticles::5a78345b522873ba784747028d7135a7","value":"Journal of Integrative Agriculture"},"collectedFrom":{"key":"openaire____::081b82f96300b6a6e3d282bad31cb6e2","value":"Crossref"}},{"alternateIdentifiers":[{"scheme":"doi","value":"10.1016/j.jia.2025.03.009"}],"accessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/","openAccessRoute":"gold"},"type":"Article","urls":["https://doaj.org/article/930cc795454b449981d46ea6731bb9e1"],"publicationDate":"2025-08-01","refereed":"nonPeerReviewed","hostedBy":{"key":"doajarticles::5a78345b522873ba784747028d7135a7","value":"Journal of Integrative Agriculture"},"collectedFrom":{"key":"driver______::bee53aa31dc2cbb538c10c2b65fa5824","value":"DOAJ"}}],"links":[],"otherTitles":null,"green":false,"inDiamondJournal":false,"isGreen":false,"isInDiamondJournal":false}]}