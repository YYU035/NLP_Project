"value":"10.3329/bjb.v50i2.54078"}],"type":"Article","urls":["https://dx.doi.org/10.3329/bjb.v50i2.54078"],"refereed":"nonPeerReviewed","hostedBy":{"key":"openaire____::55045bd2a65019fd8e6741a755395c8c","value":"Unknown Repository"},"collectedFrom":{"key":"openaire____::5f532a3fc4f1ea403f37070f59a7a53a","value":"Microsoft Academic Graph"}}],"links":[],"otherTitles":null,"green":false,"inDiamondJournal":false,"isGreen":false,"isInDiamondJournal":false},{"authors":[{"id":null,"fullName":"Tajwar Alam","name":null,"surname":"Tajwar Alam","rank":1,"pid":{"id":{"scheme":"orcid_pending","value":"0009-0008-7065-3898"},"provenance":null}},{"id":null,"fullName":"Muhammad Anwar‐ul‐Haq","name":null,"surname":"Muhammad Anwar‐ul‐Haq","rank":2,"pid":{"id":{"scheme":"orcid_pending","value":"0000-0002-6623-5756"},"provenance":null}},{"id":null,"fullName":"M. Ahmed","name":null,"surname":"M. Ahmed","rank":3,"pid":null},{"id":null,"fullName":"Asim Hayat","name":null,"surname":"Asim Hayat","rank":4,"pid":{"id":{"scheme":"orcid_pending","value":"0000-0003-3125-9405"},"provenance":null}},{"id":null,"fullName":"Nida Fatima","name":null,"surname":"Nida Fatima","rank":5,"pid":{"id":{"scheme":"orcid_pending","value":"0000-0002-0951-0758"},"provenance":null}},{"id":null,"fullName":"Saba Babar","name":null,"surname":"Saba Babar","rank":6,"pid":null},{"id":null,"fullName":"Muhammad Ikram","name":null,"surname":"Muhammad Ikram","rank":7,"pid":{"id":{"scheme":"orcid_pending","value":"0000-0002-6988-7338"},"provenance":null}},{"id":null,"fullName":"Zahid Iqbal","name":null,"surname":"Zahid Iqbal","rank":8,"pid":{"id":{"scheme":"orcid_pending","value":"0000-0001-6337-5799"},"provenance":null}}],"openAccessColor":"hybrid","publiclyFunded":false,"eoscIfGuidelines":null,"type":"publication","language":{"code":"und","label":"Undetermined"},"countries":null,"subjects":[{"subject":{"scheme":"keyword","value":"Drought stress"},"provenance":null},{"subject":{"scheme":"keyword","value":"Deficit Irrigation for Agricultural Water Management"},"provenance":null},{"subject":{"scheme":"keyword","value":"Soil Moisture"},"provenance":null},{"subject":{"scheme":"keyword","value":"Soil Science"},"provenance":null},{"subject":{"scheme":"keyword","value":"Rice Water Management and Productivity Enhancement"},"provenance":null},{"subject":{"scheme":"keyword","value":"Flooding Stress"},"provenance":null},{"subject":{"scheme":"keyword","value":"Plant Science"},"provenance":null},{"subject":{"scheme":"keyword","value":"Astrophysics"},"provenance":null},{"subject":{"scheme":"keyword","value":"Gene"},"provenance":null},{"subject":{"scheme":"keyword","value":"Crop Productivity"},"provenance":null},{"subject":{"scheme":"keyword","value":"Agricultural and Biological Sciences"},"provenance":null},{"subject":{"scheme":"keyword","value":"Genetics"},"provenance":null},{"subject":{"scheme":"keyword","value":"Genetic variation"},"provenance":null},{"subject":{"scheme":"keyword","value":"Biology"},"provenance":null},{"subject":{"scheme":"SDG","value":"2. Zero hunger"},"provenance":null},{"subject":{"scheme":"keyword","value":"Physics"},"provenance":null},{"subject":{"scheme":"keyword","value":"Life Sciences"},"provenance":null},{"subject":{"scheme":"FOS","value":"04 agricultural and veterinary sciences"},"provenance":null},{"subject":{"scheme":"SDG","value":"15. Life on land"},"provenance":null},{"subject":{"scheme":"keyword","value":"Agronomy"},"provenance":null},{"subject":{"scheme":"SDG","value":"6. Clean water"},"provenance":null},{"subject":{"scheme":"SDG","value":"3. Good health"},"provenance":null},{"subject":{"scheme":"keyword","value":"Plant Responses to Flooding Stress"},"provenance":null},{"subject":{"scheme":"keyword","value":"FOS: Biological sciences"},"provenance":null},{"subject":{"scheme":"keyword","value":"Variation (astronomy)"},"provenance":null},{"subject":{"scheme":"FOS","value":"0401 agriculture, forestry, and fisheries"},"provenance":null},{"subject":{"scheme":"keyword","value":"Grain Yield"},"provenance":null}],"mainTitle":"Soil Manuring and Genetic Variation Conjunctively Surmount the Partial Drought Stress in Wheat (Triticum aestivum L.)","subTitle":null,"descriptions":["<jats:p>Crop growth is negatively influenced under water-stress conditions, which is among the most yield-limiting factors significantly decreasing crop yield. This study evaluated the effect of water-deficit stress on physiological, bio-chemical and yield attributes of wheat (Triticum aestivum L.) under both constantly wet and water-stressed conditions on two wheat varieties (UJALA-14, SARC-4). Further, the combined impacts of crop genetic variability and organic manuring in soil was studied for overcoming the partial drought stress in wheat. Treatments of different levels of irrigation water alone or with farmyard manure (FYM) @ 20 Mg ha‒1 were compared as: constantly wet irrigation (control), irrigation intensity equal to field capacity (FC), ½ FC + FYM, and ¼ FC + FYM. Crop growth, physiological and chlorophyll as well as sodium and potassium contents were measured. The findings of current study exhibited that shortage of water had negative effects on growth, physiological, bio-chemical and yield attributes of wheat. Genotype SARC-4 exhibited superior growth response having constantly wet and field capacity condition, on the other hand UJALA-14 gave better growth response under water stress conditions of ½ FC and ¼ FC when treated with FYM amendment. It is concluded that partial drought stress developed tolerance in wheat genotypes particularly in UJALA-14, which was strengthened with organic amendment. Combined use of drought tolerant varieties and application of FYM as a fertilizer is very effective way to enhance crop yield.</jats:p>"],"publicationDate":"2023-12-30","publisher":"EScience Press Inc (Publications)","embargoEndDate":null,"sources":["Crossref"],"formats":null,"contributors":null,"coverages":null,"bestAccessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/"},"container":{"name":"Journal of Plant and Environment","issnPrinted":"2710-1657","issnOnline":"2710-1665","issnLinking":null,"ep":"108","iss":null,"sp":"99","vol":"5","edition":null,"conferencePlace":null,"conferenceDate":null},"documentationUrls":null,"codeRepositoryUrl":null,"programmingLanguage":null,"contactPeople":null,"contactGroups":null,"tools":null,"size":null,"version":null,"geoLocations":null,"id":"doi_dedup___::acc0cb9d7e1eaacf53281e73a78d1dea","originalIds":["10.33687/jpe.005.02.4419","50|doiboost____|acc0cb9d7e1eaacf53281e73a78d1dea","50|datacite____::f17866cdd0ca5608d57784e30f68d702","10.60692/pvd6z-jth55","50|datacite____::f19b2c7688315d417212624544b1ddf2","10.60692/6edv1-gbp80"],"pids":[{"scheme":"doi","value":"10.33687/jpe.005.02.4419"},{"scheme":"doi","value":"10.60692/pvd6z-jth55"},{"scheme":"doi","value":"10.60692/6edv1-gbp80"}],"dateOfCollection":null,"lastUpdateTimeStamp":null,"indicators":{"citationImpact":{"citationCount":6.0,"influence":2.2892297E-9,"popularity":5.576112E-9,"impulse":6.0,"citationClass":"C5","influenceClass":"C5","impulseClass":"C4","popularityClass":"C4"}},"projects":null,"organizations":[{"legalName":"Pir Mehr Ali Shah Arid Agriculture University","acronym":"AAUR","id":"openorgs____::dd230da3bb3960cca56c6ad0739cbb1d","pids":[{"scheme":"ROR","value":"https://ror.org/035zn2q74"},{"scheme":"Wikidata","value":"Q4790314"},{"scheme":"mag_id","value":"200749728"},{"scheme":"wikidata","value":"Q4790314"},{"scheme":"GRID","value":"grid.440552.2"},{"scheme":"OrgRef","value":"1651588"},{"scheme":"ISNI","value":"0000000092968318"}],"countries":[{"code":"PK","label":"Pakistan"}],"websiteurl":"http://www.uaar.edu.pk/"},{"legalName":"University of Agriculture Faisalabad","acronym":"UAF","id":"openorgs____::7bcd22f273031885d22e9152a6bbfc0b","pids":[{"scheme":"wikidata","value":"Q7895024"},{"scheme":"Wikidata","value":"Q7895024"},{"scheme":"mag_id","value"