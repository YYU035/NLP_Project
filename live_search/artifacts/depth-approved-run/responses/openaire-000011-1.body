548d36b244b28d","value":"University of Copenhagen: Research"},"collectedFrom":{"key":"openaire____::df45502607927471ecf8a6ae83683ff5","value":"Bielefeld Academic Search Engine (BASE)"}},{"alternateIdentifiers":[{"scheme":"mag_id","value":"2930362719"},{"scheme":"doi","value":"10.1016/j.hal.2019.03.012"}],"type":"Article","urls":["https://dx.doi.org/10.1016/j.hal.2019.03.012"],"refereed":"nonPeerReviewed","hostedBy":{"key":"openaire____::55045bd2a65019fd8e6741a755395c8c","value":"Unknown Repository"},"collectedFrom":{"key":"openaire____::5f532a3fc4f1ea403f37070f59a7a53a","value":"Microsoft Academic Graph"}}],"links":[],"otherTitles":null,"inDiamondJournal":false,"green":true,"isGreen":true,"isInDiamondJournal":false},{"authors":[{"id":null,"fullName":"Nicolas Metzl","name":"Nicolas","surname":"Metzl","rank":1,"pid":null},{"id":"orcid_______::790b8030cbefe4ecf6d8aa78faf8ccb0","fullName":"Bronte Tilbrook","name":"Bronte","surname":"Tilbrook","rank":2,"pid":{"id":{"scheme":"orcid","value":"0000-0001-9385-3827"},"provenance":null}},{"id":null,"fullName":"John Akl","name":"John","surname":"Akl","rank":3,"pid":null},{"id":null,"fullName":"Craig Neill","name":"Craig","surname":"Neill","rank":4,"pid":null},{"id":"orcid_______::c70a0d3aa6dacc167991c3644d781219","fullName":"Alexandra Aymard","name":"Alexandra","surname":"Aymard","rank":5,"pid":{"id":{"scheme":"orcid","value":"0009-0002-3159-3059"},"provenance":null}},{"id":null,"fullName":"Claire Lo Monaco","name":"Claire","surname":"Lo Monaco","rank":6,"pid":null},{"id":"orcid_______::965e604461f06708c10ec0be1244e6d6","fullName":"Gilles Reverdin","name":"Gilles","surname":"Reverdin","rank":7,"pid":{"id":{"scheme":"orcid","value":"0000-0002-5583-8236"},"provenance":null}},{"id":null,"fullName":"Jean-Baptiste Sallée","name":"Jean-Baptiste","surname":"Sallée","rank":8,"pid":null},{"id":null,"fullName":"Aude Barton","name":"Aude","surname":"Barton","rank":9,"pid":null},{"id":null,"fullName":"Frédéric Chevallier","name":"Frédéric","surname":"Chevallier","rank":10,"pid":{"id":{"scheme":"orcid_pending","value":"0000-0002-4327-3813"},"provenance":null}},{"id":null,"fullName":"Marion Gehlen","name":"Marion","surname":"Gehlen","rank":11,"pid":{"id":{"scheme":"orcid_pending","value":"0000-0002-9688-0692"},"provenance":null}}],"openAccessColor":"hybrid","publiclyFunded":false,"eoscIfGuidelines":null,"type":"publication","language":{"code":"und","label":"Undetermined"},"countries":[{"code":"FR","label":"France","provenance":null}],"subjects":[{"subject":{"scheme":"FOS","value":"01 natural sciences"},"provenance":null},{"subject":{"scheme":"FOS","value":"0105 earth and related environmental sciences"},"provenance":null}],"mainTitle":"Acidification in coastal waters of Adélie Land, Antarctica (1985–2025)","subTitle":null,"descriptions":["<jats:p>Abstract. Ocean acidification is expected to be particularly severe in Antarctic continental shelves due to enhanced anthropogenic carbon uptake in cold waters in response to rising atmospheric CO2, sea-ice retreat, freshening and climate-change feedbacks. Models suggest that undersaturated conditions with respect to aragonite (Ωar), a major form of calcium carbonate formed by marine species, could be reached as soon as 2052 for austral winter.  Here we present new ocean carbonate system observations from cruises conducted since 2010 in the Adélie Land coastal region in East Antarctica, along with data from a BCG-Argo float and results from a neural network model for the period 1985–2025. The region is a permanent CO2 sink and was most pronounced since 2006. The CO2 sink leads to a positive increase of surface water total CO2 concentrations (CT) (+0.44 ± 0.01 µmol.kg-1.yr-1) and to a progressive decrease of pH (-0.013 per decade) and Ωar (-0.035 per decade) for the winter season. The lowest surface Ωar of 1.2 was observed in winter 2024 from the float data, a critical limit for some marine species such as pteropod. A projection of the CT concentrations in the future, based on observed anthropogenic CO2 concentrations and emissions scenarios, suggests that aragonite saturation state (Ωar = 1) will occur in surface waters as soon as 2055 in the Adélie Land region, which is part of a larger area of East Antarctica proposed as a Marine Protected Area by the Commission for the Conservation of Antarctic Marine Living Resources since the early 2010s.</jats:p>"],"publicationDate":"2026-04-16","publisher":"Copernicus GmbH","embargoEndDate":null,"sources":["Crossref","eISSN:","EGUsphere [preprint] (Copernicus GmbH) In Press"],"formats":["application/pdf"],"contributors":null,"coverages":null,"bestAccessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/"},"container":null,"documentationUrls":null,"codeRepositoryUrl":null,"programmingLanguage":null,"contactPeople":null,"contactGroups":null,"tools":null,"size":null,"version":null,"geoLocations":null,"id":"doi_dedup___::71c9e92cd9356236fedadf0ce303e272","originalIds":["10.5194/egusphere-2026-1664","50|doiboost____|71c9e92cd9356236fedadf0ce303e272","oai:publications.copernicus.org:egusphere139861","50|copernicuspu::55228b661d0b6be89266be4c5280aee0","oai:archimer.ifremer.fr:113579","50|od_________7::03205caf600a435775d2f22340c2a812"],"pids":[{"scheme":"doi","value":"10.5194/egusphere-2026-1664"}],"dateOfCollection":null,"lastUpdateTimeStamp":null,"indicators":{"citationImpact":{"citationCount":0.0,"influence":2.1746283E-9,"popularity":2.6085654E-9,"impulse":0.0,"citationClass":"C5","influenceClass":"C5","impulseClass":"C5","popularityClass":"C5"}},"projects":[{"id":"corda__h2020::64ceaf6b6613c07dc7858c11dc0d29b1","code":"633211","acronym":"AtlantOS","title":"Optimizing and Enhancing the Integrated Atlantic Ocean Observing System","funder":"European Commission","pids":[{"scheme":"doi","value":"10.3030/633211"}]}],"organizations":[{"legalName":"French Research Institute for Exploitation of the Sea","acronym":"IFREMER","id":"openorgs____::a6bfaa7b9934dd8459ca94deac34c127","pids":[{"scheme":"GRID","value":"grid.4825.b"},{"scheme":"fundref","value":"100009111"},{"scheme":"OrgRef","value":"2796232"},{"scheme":"RNSR","value":"RNSR:201122297T"},{"scheme":"RNSR","value":"RNSR:201122298U"},{"scheme":"RNSR","value":"RNSR:201122270N"},{"scheme":"RNSR","value":"RNSR:201122276V"},{"scheme":"RNSR","value":"RNSR:201122271P"},{"scheme":"Wikidata","value":"Q1657069"},{"scheme":"RNSR","value":"RNSR:201122278X"},{"scheme":"mag_id","value":"154202486"},{"scheme":"RNSR","value":"RNSR:202224206V"},{"scheme":"wikidata","value":"Q1657069"},{"scheme":"RNSR","value":"RNSR:200816947R"},{"scheme":"RNSR","value":"RNSR:200816948S"},{"scheme":"RNSR","value":"RNSR:199612326V"},{"scheme":"RNSR","value":"RNSR:201122282B"},{"scheme":"RNSR","value":"RNSR:201521641M"},{"scheme":"FundRef","value":"100009111"},{"scheme":"RNSR","value":"RNSR:202224207W"},{"scheme":"RNSR","value":"RNSR:202224205U"},{"scheme":"RNSR","value":"RNSR:201122279Y"},{"scheme":"ROR","value":"https://ror.org/044jxhp58"},{"scheme":"RNSR","value":"RNSR:200412248A"},{"scheme":"ISNI","value":"0000000406419240"},{"scheme":"OrgReg","value":"FR1023"},{"scheme":"PIC","value":"999630300"}],"countries":[{"code":"FR","label":"France"}],"websiteurl":"http://wwz.ifremer.fr/institut_eng"}],"communities":[{"code":"mes","label":"European Marine Science","provenance":null}],"collectedFrom":[{"key":"openaire____::081b82f96300b6a6e3d282bad31cb6e2","value":"Crossref"},{"key":"openaire____::5a38cb462ac487bf26bdb86009fe3e74","value":"Copernicus Publications"},{"key":"opendoar____::8f14e45fceea167a5a36dedd4bea2543","value":"ArchiMer - Institutional Archive of Ifremer"}],"instances":[{"pids":[{"scheme":"doi","value":"10.5194/egusphere-2026-1664"}],"license":"CC BY","accessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/","openAccessRoute":"hybrid"},"type":"Article","urls":["https://doi.org/10.5194/egusphere-2026-1664"],"publicationDate":"2026-04-16","refereed":"peerReviewed","hostedBy":{"key":"openaire____::55045bd2a65019fd8e6741a755395c8c","value":"Unknown Repository"},"collectedFrom":{"key":"openaire____::081b82f96300b6a6e3d282bad31cb6e2","value":"Crossref"}},{"alternateIdentifiers":[{"scheme":"doi","value":"10.5194/egusphere-2026-1664"}],"type":"Other literature type","urls":["https://egusphere.copernicus.org/preprints/2026/egusphere-2026-1664/","https://doi.org/10.5194/egusphere-2026-1664"],"publicationDate":"2026-04-16","refereed":"nonPeerReviewed","hostedBy":{"key":"openaire____::5a38cb462ac487bf26bdb86009fe3e74","value":"Copernicus Publications"},"collectedFrom":{"key":"openaire____::5a38cb462ac487bf26bdb86009fe3e74","value":"Copernicus Publications"}},{"alternateIdentifiers":[{"scheme":"doi","value":"10.5194/egusphere-2026-1664"}],"accessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/","openAccessRoute":null},"type":"Other literature type","urls":["https://archimer.ifremer.fr/doc/01024/113579/128086.pdf","https://archimer.ifremer.fr/doc/01024/113579/128087.pdf","https://archimer.ifremer.fr/doc/01024/113579/"],"publicationDate":"2026-04-16","refereed":"nonPeerReviewed","hostedBy":{"key":"opendoar____::8f14e45fceea167a5a36dedd4bea2543","value":"ArchiMer - Institutional Archive of Ifremer"},"collectedFrom":{"key":"opendoar____::8f14e45fceea167a5a36dedd4bea2543","value":"ArchiMer - Institutional Archive of Ifremer"}}],"links":[{"header":{"relationType":"resultProject","relationClass":"isProducedBy","relatedIdentifier":"corda__h2020::64ceaf6b6613c07dc7858c11dc0d29b1","relatedRecordType":"project","relationProvenance":"sysimport:actionset","trust":"0.91"},"collectedfrom":[{"dsId":"openaire____::a55eb91348674d853191f4f4fd73d078","dsName":"CORDA - COmmon Research DAta Warehouse - Horizon 2020"}],"projectTitle":"Optimizing and Enhancing the Integrated Atlantic Ocean Observing System","code":"633211","funding":{"funder":{"id":"ec__________::EC","shortname":"EC","name":"European Commission","jurisdiction":{"code":"EU","label":"European Union"},"pid":null},"level0":{"id":"ec__________::EC::H2020","description":"Horizon 2020 Framework Programme","name":"H2020"},"level1":{"id":"ec__________::EC::H2020::RIA","description":"Research and Innovation action","name":"RIA"},"level2":{"id":null,"description":null,"name":null}},"startDate":"2015-04-01","endDate":"2019-09-30"}],"otherTitles":null,"inDiamondJournal":false,"green":true,"isGreen":true,"isInDiamondJournal":false},{"authors":[{"id":null,"fullName":"Alcaraz-Rocha, Paulo","name":"Paulo","surname":"Alcaraz-Rocha","rank":1,"pid":null},{"id":null,"fullName":"Puig-Fábregas, Júlia","name":"Júlia","surname":"Puig-Fábregas","rank":2,"pid":null},{"id":null,"fullName":"Fuentes-Lema, A.","name":"A.","surname":"Fuentes-Lema","rank":3,"pid":null},{"id":null,"fullName":"Garrido, J. L.","name":"J. L.","surname":"Garrido","rank":4,"pid":null},{"id":null,"fullName":"Sobrino, Cristina","name":"Cristina","surname":"Sobrino","rank":5,"pid":null}],"openAccessColor":null,"publiclyFunded":false,"eoscIfGuidelines":null,"type":"publication","language":{"code":"eng","label":"English"},"countries":[{"code":"ES","label":"Spain","provenance":null}],"subjects":[{"subject":{"scheme":"FOS","value":"0106 biological sciences"},"provenance":null},{"subject":{"scheme":"FOS","value":"01 natural sciences"},"provenance":null}],"mainTitle":"Effects of the atmospheric CO2 increase in pigment concentration in the Cyanobacteria synechococcus spp. from two differeent marine habitats","subTitle":null,"descriptions":["Previous studies have shown that high CO2 levels expected for future scenarios of global change might result in phytoplankton with higher sensitivity to photoinhibitory conditions than those exposed to present CO2 levels. This response, mainly observed in diatoms, has been attributed to a decrease in the repair rates caused by the lower levels of enzymatic activity and cellular pools observed, but could also be attributed to greater damage related to decreased protection. In this study, we will focus on the effects of elevated CO2 on the components of the xanthophyll cycle, a pigment cycle involved in the dissipation of excessive energy in the cell. The CO2 effect will be tested on a globally distributed cyanobacteria species, Synechococcus spp., isolated from two different marine habitats: the strain WH7803, typical from coastal areas, is observed during transition periods between mixing and stratification, while the strain WH8102 is adapted to oligotrophic environments and appears in open-ocean waters. The cultures were acclimated during at least 3 weeks with current concentrations of atmospheric CO2 (400 ppmv CO2 = Low CO2) and with concentrations expected for future scenarios of climate change (1000 ppmv CO2 = High CO2). HPLC results showed that in Synechococcus spp. violaxanthin was first de-epoxidated to antheraxanthin and then to zeaxanthin, which relates to cell protection. Chlorophyll a and β-carotene concentrations were lower than zeaxanthin concentration in both strains. However, zeaxanthin concentration increased significantly under high CO2 conditions in the coastal strain after a perturbation but did not change in the open-ocean strain under similar conditions. The results from the coastal strain were more similar to those observed in coastal diatoms, which might imply that differences in functional traits between phytoplankton assemblages from open-ocean vs. coastal waters are more significant than their taxonomic features regarding responses to ocean acidification","This work was funded by the Ministery of Economy and Competitiveness under the project: Down-regulation of phytoplankon metabolism in a high CO2 world: Consequences for resistance to abiotic and biotic stress (CTM2014-59345-R)","Poster.-- VI International Symposium on Marine Sciences, Vigo (Spain), 20-22th June 2018","Peer reviewed"],"publicationDate":"2026-06-16","publisher":null,"embargoEndDate":null,"sources":null,"formats":null,"contributors":["Ministerio de Economía y Competitividad (España)"],"coverages":null,"bestAccessRight":{"code":"c_14cb","label":"CLOSED","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/"},"container":null,"documentationUrls":null,"codeRepositoryUrl":null,"programmingLanguage":null,"contactPeople":null,"contactGroups":null,"tools":null,"size":null,"version":null,"geoLocations":null,"id":"od______1106::53cca9e3118cfc92abdbaadcb8f06988","originalIds":["50|od______1106::53cca9e3118cfc92abdbaadcb8f06988","oai:digital.csic.es:10261/435869"],"pids":[{"scheme":"handle","value":"10261/435869"}],"dateOfCollection":null,"lastUpdateTimeStamp":null,"indicators":{"citationImpact":{"citationCount":0.0,"influence":2.1746283E-9,"popularity":2.6085654E-9,"impulse":0.0,"citationClass":"C5","influenceClass":"C5","impulseClass":"C5","popularityClass":"C5"}},"projects":null,"organizations":[{"legalName":"Spanish National Research Council","acronym":"CSIC","id":"openorgs____::7b08393d24bb163bc4b5008322df6894","pids":[{"scheme":"wikidata","value":"Q1024362"},{"scheme":"RRID","value":"RRID:nlx_156803"},{"scheme":"OrgRef","value":"5195182"},{"scheme":"mag_id","value":"134820265"},{"scheme":"FundRef","value":"501100003339"},{"scheme":"Wikidata","value":"Q1024362"},{"scheme":"ISNI","value":"0000000121834846"},{"scheme":"OrgReg","value":"ES1031"},{"scheme":"fundref","value":"501100003339"},{"scheme":"ROR","value":"https://ror.org/02gfc7t72"},{"scheme":"PIC","value":"999991722"},{"scheme":"RRID","value":"RRID:SCR_011534"},{"scheme":"GRID","value":"grid.4711.3"}],"countries":[{"code":"ES","label":"Spain"}],"websiteurl":"http://www.csic.es/"}],"communities":null,"collectedFrom":[{"key":"opendoar____::c9f95a0a5af052bffce5c89917335f67","value":"DIGITAL.CSIC"}],"instances":[{"pids":[{"scheme":"handle","value":"10261/435869"}],"accessRight":{"code":"c_14cb","label":"CLOSED","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/","openAccessRoute":null},"type":"Conference object","urls":["http://hdl.handle.net/10261/435869"],"publicationDate":"2026-06-16","refereed":"peerReviewed","hostedBy":{"key":"opendoar____::c9f95a0a5af052bffce5c89917335f67","value":"DIGITAL.CSIC"},"collectedFrom":{"key":"opendoar____::c9f95a0a5af052bffce5c89917335f67","value":"DIGITAL.CSIC"}}],"links":[],"otherTitles":null,"inDiamondJournal":false,"green":false,"isGreen":false,"isInDiamondJournal":false},{"authors":[{"id":null,"fullName":"Pamela A, Fernández","name":"Pamela A","surname":"Fernández","rank":1,"pid":null},{"id":null,"fullName":"Charles D, Amsler","name":"Charles D","surname":"Amsler","rank":2,"pid":null},{"id":null,"fullName":"Catriona L, Hurd","name":"Catriona L","surname":"Hurd","rank":3,"pid":null},{"id":null,"fullName":"Patricio A, Díaz","name":"Patricio A","surname":"Díaz","rank":4,"pid":null},{"id":"orcid_______::b7a6dd4b59828befe75abbfabdd58107","fullName":"Juan Diego, Gaitán-Espitia","name":"Juan Diego","surname":"Gaitán-Espitia","rank":5,"pid":{"id":{"scheme":"orcid","value":"0000-0001-8781-5736"},"provenance":null}},{"id":null,"fullName":"Erasmo C, Macaya","name":"Erasmo C","surname":"Macaya","rank":6,"pid":null},{"id":"orcid_______::1b7fb6625e0f21ff3c66c2f08c03897a","fullName":"Andreas, Schmider-Martínez","name":"Andreas","surname":"Schmider-Martínez","rank":7,"pid":{"id":{"scheme":"orcid","value":"0009-0009-2826-6971"},"provenance":null}},{"id":null,"fullName":"Ignacio, Garrido","name":"Ignacio","surname":"Garrido","rank":8,"pid":null},{"id":"orcid_______::9e65dd89fe926a9dd36a9546d63efd2f","fullName":"Pedro, Murúa","name":"Pedro","surname":"Murúa","rank":9,"pid":{"id":{"scheme":"orcid","value":"0000-0002-1598-7261"},"provenance":null}},{"id":"orcid_______::3d67b092bc291f0e769347104c9d1c4d","fullName":"Alejandro H, Buschmann","name":"Alejandro H","surname":"Buschmann","rank":10,"pid":{"id":{"scheme":"orcid","value":"0000-0003-3246-681x"},"provenance":null}}],"openAccessColor":null,"publiclyFunded":false,"eoscIfGuidelines":null,"type":"publication","language":{"code":"eng","label":"English"},"countries":null,"subjects":[{"subject":{"scheme":"FOS","value":"0106 biological sciences"},"provenance":null},{"subject":{"scheme":"keyword","value":"Species Specificity"},"provenance":null},{"subject":{"scheme":"keyword","value":"Ocean Acidification"},"provenance":null},{"subject":{"scheme":"keyword","value":"Climate Change"},"provenance":null},{"subject":{"scheme":"keyword","value":"Oceans and Seas"},"provenance":null},{"subject":{"scheme":"keyword","value":"Antarctic Regions"},"provenance":null},{"subject":{"scheme":"keyword","value":"Seawater"},"provenance":null},{"subject":{"scheme":"keyword","value":"Hydrogen-Ion Concentration"},"provenance":null},{"subject":{"scheme":"keyword","value":"Carbon Dioxide"},"provenance":null},{"subject":{"scheme":"keyword","value":"Seaweed"},"provenance":null},{"subject":{"scheme":"FOS","value":"01 natural sciences"},"provenance":null},{"subject":{"scheme":"keyword","value":"Carbon"},"provenance":null},{"subject":{"scheme":"keyword","value":"Ecosystem"},"provenance":null}],"mainTitle":"Diverse inorganic carbon uptake strategies in Antarctic seaweeds: Revealing species-specific responses and implications for Ocean Acidification","subTitle":null,"descriptions":["Seaweeds are important components of coastal benthic ecosystems along the Western Antarctic Peninsula (WAP), providing refuge, food, and habitat for numerous associated species. Despite their crucial role, the WAP is among the regions most affected by global climate change, potentially impacting the ecology and physiology of seaweeds. Elevated atmospheric CO2 concentrations have led to increased dissolved inorganic carbon (Ci) with consequent declines in oceanic pH and alterations in seawater carbonate chemistry, known as Ocean Acidification (OA). Seaweeds possess diverse strategies for Ci uptake, including CO2 concentrating mechanisms (CCMs), which may distinctly respond to changes in Ci concentrations. Conversely, some seaweeds do not operate CCMs (non-CCM species) and rely solely on CO2. Nevertheless, our understanding of the status and functionality of Ci uptake strategies in Antarctic seaweeds remains limited. Here, we investigated the Ci uptake strategies of seaweeds along a depth gradient in the WAP. Carbon isotope signatures (δ13C) and pH drift assays were used as indicators of the presence or absence of CCMs. Our results reveal variability in CCM occurrence among algal phyla and depths ranging from 0 to 20 m. However, this response was species specific. Among red seaweeds, the majority relied solely on CO2 as an exogenous Ci source, with a high percentage of non-CCM species. Green seaweeds exhibited depth-dependent variations in CCM status, with the proportion of non-CCM species increasing at greater depths. Conversely, brown seaweeds exhibited a higher prevalence of CCM species, even in deep waters, indicating the use of CO2 and HCO3-. Our results are similar to those observed in temperate and tropical regions, indicating that the potential impacts of OA on Antarctic seaweeds will be species specific. Additionally, OA may potentially increase the abundance of non-CCM species relative to those with CCMs."],"publicationDate":"2024-10-01","publisher":"Elsevier BV","embargoEndDate":null,"sources":["Crossref"],"formats":null,"contributors":null,"coverages":null,"bestAccessRight":{"code":"c_14cb","label":"CLOSED","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/"},"container":{"name":"Science of The Total Environment","issnPrinted":"0048-9697","issnOnline":null,"issnLinking":null,"ep":null,"iss":null,"sp":"174006","vol":"945","edition":null,"conferencePlace":null,"conferenceDate":null},"documentationUrls":null,"codeRepositoryUrl":null,"programmingLanguage":null,"contactPeople":null,"contactGroups":null,"t