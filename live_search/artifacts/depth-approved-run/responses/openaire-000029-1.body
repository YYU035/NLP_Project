alue":"DOAJ"}},{"alternateIdentifiers":[{"scheme":"doi","value":"10.3389/fnagi.2021.750401"},{"scheme":"mag_id","value":"3214422062"}],"type":"Article","urls":["https://dx.doi.org/10.3389/fnagi.2021.750401"],"refereed":"nonPeerReviewed","hostedBy":{"key":"openaire____::55045bd2a65019fd8e6741a755395c8c","value":"Unknown Repository"},"collectedFrom":{"key":"openaire____::5f532a3fc4f1ea403f37070f59a7a53a","value":"Microsoft Academic Graph"}},{"alternateIdentifiers":[{"scheme":"mag_id","value":"3214422062"},{"scheme":"doi","value":"10.3389/fnagi.2021.750401"}],"type":"Article","urls":["https://dx.doi.org/10.3389/fnagi.2021.750401"],"refereed":"nonPeerReviewed","hostedBy":{"key":"openaire____::55045bd2a65019fd8e6741a755395c8c","value":"Unknown Repository"},"collectedFrom":{"key":"openaire____::5f532a3fc4f1ea403f37070f59a7a53a","value":"Microsoft Academic Graph"}}],"links":[{"header":{"relationType":"resultProject","relationClass":"isProducedBy","relatedIdentifier":"dfgf________::1e5e62235d094afd01cd56e65112fc63","relatedRecordType":"project","relationProvenance":"sysimport:actionset","trust":"0.91"},"collectedfrom":[{"dsId":"openaire____::513d203da49f316ec241afa087643a02","dsName":"Deutsche Forschungsgemeinschaft"}],"projectTitle":"unidentified","code":"unidentified","funding":{"funder":{"id":"dfgf________::DFG","shortname":"DFG","name":"Deutsche Forschungsgemeinschaft","jurisdiction":{"code":"DE","label":"Germany"},"pid":null},"level0":{"id":null,"description":null,"name":null},"level1":{"id":null,"description":null,"name":null},"level2":{"id":null,"description":null,"name":null}}}],"otherTitles":null,"inDiamondJournal":false,"green":true,"isGreen":true,"isInDiamondJournal":false},{"authors":[{"id":null,"fullName":"Berginström, Nils","name":"Nils","surname":"Berginström","rank":1,"pid":null},{"id":null,"fullName":"Haldorson, Anders","name":"Anders","surname":"Haldorson","rank":2,"pid":null},{"id":null,"fullName":"Nouf, Amin","name":"Amin","surname":"Nouf","rank":3,"pid":null},{"id":null,"fullName":"Stenlund, Tova","name":"Tova","surname":"Stenlund","rank":4,"pid":null}],"openAccessColor":"gold","publiclyFunded":false,"eoscIfGuidelines":null,"type":"publication","language":{"code":"und","label":"Undetermined"},"countries":[{"code":"SE","label":"Sweden","provenance":null}],"subjects":[{"subject":{"scheme":"keyword","value":"Psykologi"},"provenance":null},{"subject":{"scheme":"keyword","value":"Procedural memory"},"provenance":null},{"subject":{"scheme":"keyword","value":"Physical activity"},"provenance":null},{"subject":{"scheme":"FOS","value":"05 social sciences"},"provenance":null},{"subject":{"scheme":"keyword","value":"Declarative memory"},"provenance":null},{"subject":{"scheme":"keyword","value":"Learning"},"provenance":null},{"subject":{"scheme":"keyword","value":"Psychology"},"provenance":null},{"subject":{"scheme":"FOS","value":"0501 psychology and cognitive sciences"},"provenance":null}],"mainTitle":"Does a Single Bout of Exercise Improve Memory and Learning?","subTitle":null,"descriptions":["<jats:p>Physical activity in general, and a single bout of exercise in particular, has been found to have a positive effect on memory and learning. However, findings have shown different results for declarative memory (explicit knowledge) and procedural memory (implicit knowledge). The aim of this interventional study was to investigate the effects of a single bout of moderate-to-vigorous exercise during memory consolidation on both memory types compared to physical inactivity. A between-within group study design consisted of two test sessions with 24 hours in between. Forty-four participants were randomized into an exercise group (18 males, 4 females, M = 24 years) or a control group (18 males, 4 females, M = 25.2 years). Both groups underwent memory testing the first day, with the exercise group afterwards performing a single bout of moderate-to-vigorous physical activity (cycling) for approximately 30 minutes. Memory tests were repeated the second day. Results showed that the improvement for the exercise group was significantly better compared to the control group on measures of procedural memory. No differences were found regarding declarative memory.</jats:p>"],"publicationDate":"2025-07-04","publisher":"Det Kgl. Bibliotek/Royal Danish Library","embargoEndDate":null,"sources":["Crossref"],"formats":["application/pdf"],"contributors":null,"coverages":null,"bestAccessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/"},"container":{"name":"Scandinavian Journal of Sport and Exercise Psychology","issnPrinted":null,"issnOnline":"2596-741X","issnLinking":null,"ep":"39","iss":null,"sp":"29","vol":"7","edition":null,"conferencePlace":null,"conferenceDate":null},"documentationUrls":null,"codeRepositoryUrl":null,"programmingLanguage":null,"contactPeople":null,"contactGroups":null,"tools":null,"size":null,"version":null,"geoLocations":null,"id":"doi_dedup___::713c80c77278da7d8479e276be2d5481","originalIds":["10.7146/sjsep.v7i.150557","50|doiboost____|713c80c77278da7d8479e276be2d5481","50|od_______264::7ef822c85452527c4ac4e0dafa427012","oai:DiVA.org:umu-243178","50|od_______681::7ef822c85452527c4ac4e0dafa427012"],"pids":[{"scheme":"doi","value":"10.7146/sjsep.v7i.150557"}],"dateOfCollection":null,"lastUpdateTimeStamp":null,"indicators":{"citationImpact":{"citationCount":0.0,"influence":2.1746283E-9,"popularity":2.2497804E-9,"impulse":0.0,"citationClass":"C5","influenceClass":"C5","impulseClass":"C5","popularityClass":"C5"}},"projects":null,"organizations":[{"legalName":"Umeå University","acronym":"Umeå University","id":"openorgs____::6ae429ff143831bc3eb5ba2b04485c0c","pids":[{"scheme":"PIC","value":"999881821"},{"scheme":"fundref","value":"501100010794"},{"scheme":"mag_id","value":"90267481"},{"scheme":"fundref","value":"501100009984"},{"scheme":"OrgRef","value":"31798"},{"scheme":"OrgReg","value":"SE0005"},{"scheme":"FundRef","value":"501100009984"},{"scheme":"ISNI","value":"0000000110343451"},{"scheme":"ROR","value":"https://ror.org/05kb8h459"},{"scheme":"GRID","value":"grid.12650.30"},{"scheme":"Wikidata","value":"Q1144565"},{"scheme":"wikidata","value":"Q1144565"},{"scheme":"fundref","value":"501100004886"},{"scheme":"FundRef","value":"501100004886"},{"scheme":"FundRef","value":"501100010794"},{"scheme":"FundRef","value":"501100008461"},{"scheme":"FundRef","value":"501100004885"},{"scheme":"fundref","value":"501100008461"},{"scheme":"fundref","value":"501100004885"}],"countries":[{"code":"SE","label":"Sweden"}],"websiteurl":"http://www.umu.se/english"}],"communities":[{"code":"uarctic","label":"UArctic","provenance":null}],"collectedFrom":[{"key":"opendoar____::1595af6435015c77a7149e92a551338e","value":"Digitala Vetenskapliga Arkivet - Academic Archive On-line"},{"key":"openaire____::081b82f96300b6a6e3d282bad31cb6e2","value":"Crossref"},{"key":"opendoar____::d6baf65e0b240ce177cf70da146c8dc8","value":"Publikationer från Umeå universitet"}],"instances":[{"pids":[{"scheme":"doi","value":"10.7146/sjsep.v7i.150557"}],"accessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/","openAccessRoute":"gold"},"type":"Article","urls":["https://doi.org/10.7146/sjsep.v7i.150557"],"publicationDate":"2025-07-04","refereed":"peerReviewed","hostedBy":{"key":"issn__online::a1ec9782f6f7602e92968a8c89c135b3","value":"Scandinavian Journal of Sport and Exercise Psychology"},"collectedFrom":{"key":"openaire____::081b82f96300b6a6e3d282bad31cb6e2","value":"Crossref"}},{"alternateIdentifiers":[{"scheme":"doi","value":"10.7146/sjsep.v7i.150557"}],"accessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/","openAccessRoute":null},"type":"Article","urls":["http://urn.kb.se/resolve?urn=urn:nbn:se:umu:diva-243178"],"publicationDate":"2025-01-01","refereed":"peerReviewed","hostedBy":{"key":"opendoar____::d6baf65e0b240ce177cf70da146c8dc8","value":"Publikationer från Umeå universitet"},"collectedFrom":{"key":"opendoar____::d6baf65e0b240ce177cf70da146c8dc8","value":"Publikationer från Umeå universitet"}},{"alternateIdentifiers":[{"scheme":"doi","value":"10.7146/sjsep.v7i.150557"}],"accessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/","openAccessRoute":null},"type":"Article","urls":["http://urn.kb.se/resolve?urn=urn:nbn:se:umu:diva-243178"],"publicationDate":"2025-01-01","refereed":"peerReviewed","hostedBy":{"key":"opendoar____::1595af6435015c77a7149e92a551338e","value":"Digitala Vetenskapliga Arkivet - Academic Archive On-line"},"collectedFrom":{"key":"opendoar____::1595af6435015c77a7149e92a551338e","value":"Digitala Vetenskapliga Arkivet - Academic Archive On-line"}}],"links":[],"otherTitles":null,"inDiamondJournal":false,"green":true,"isGreen":true,"isInDiamondJournal":false},{"authors":[{"id":null,"fullName":"Justin Cantrelle","name":"Justin","surname":"Cantrelle","rank":1,"pid":{"id":{"scheme":"orcid_pending","value":"0000-0002-2464-3794"},"provenance":null}},{"id":"orcid_______::a2c21b307633692624fc2d789927db96","fullName":"Grace Burnett","name":"Grace","surname":"Burnett","rank":2,"pid":{"id":{"scheme":"orcid","value":"0009-0006-8317-5309"},"provenance":null}},{"id":null,"fullName":"Paul D. Loprinzi","name":"Paul D.","surname":"Loprinzi","rank":3,"pid":{"id":{"scheme":"orcid_pending","value":"0000-0001-7711-4741"},"provenance":null}}],"openAccessColor":"gold","publiclyFunded":false,"eoscIfGuidelines":null,"type":"publication","language":{"code":"eng","label":"English"},"countries":null,"subjects":[{"subject":{"scheme":"keyword","value":"cognition"},"provenance":null},{"subject":{"scheme":"SDG","value":"2. Zero hunger"},"provenance":null},{"subject":{"scheme":"keyword","value":"Nutrition. Foods and food supply"},"provenance":null},{"subject":{"scheme":"FOS","value":"05 social sciences"},"provenance":null},{"subject":{"scheme":"FOS","value":"03 medical and health sciences"},"provenance":null},{"subject":{"scheme":"keyword","value":"walking"},"provenance":null},{"subject":{"scheme":"FOS","value":"0302 clinical medicine"},"provenance":null},{"subject":{"scheme":"keyword","value":"running"},"provenance":null},{"subject":{"scheme":"FOS","value":"0501 psychology and cognitive sciences"},"provenance":null},{"subject":{"scheme":"keyword","value":"TX341-641"},"provenance":null},{"subject":{"scheme":"keyword","value":"Original Article"},"provenance":null},{"subject":{"scheme":"keyword","value":"Public aspects of medicine"},"provenance":null},{"subject":{"scheme":"keyword","value":"RA1-1270"},"provenance":null},{"subject":{"scheme":"SDG","value":"10. No inequality"},"provenance":null},{"subject":{"scheme":"keyword","value":"metacognition"},"provenance":null}],"mainTitle":"Acute exercise on memory function: open vs. closed skilled exercise","subTitle":null,"descriptions":["<jats:p><jats:bold>Background:</jats:bold>Previous studies suggest that acute exercise may improve memory function. Few studies, however, have investigated the differential effect of the acute exercise movement patterns on memory. Such an effect is plausible, as research demonstrates that open-skilled exercise (e.g.,racquetball) may have a greater effect on memory-related neurotrophins (e.g., brain-derived neurotrophic factors) when compared to closed-skilled exercise (e.g. treadmill exercise). A key distinction between open- and closed-skilled exercise is that open-skilled exercises are those that require an individual to react in a dynamic way to a changing, unpredictable environment. Our aim in this study was to assess wether retrospective and prospective memory are differentially influenced from open- and closed-skilled acute exercise.<jats:bold>Methods:</jats:bold>A within-subject design was employed. Participants (M<jats:sub>age</jats:sub>= 20.6 years; 69% female)completed two visits, in a counterbalanced order. The two experimental conditions included open-skilled acute exercise (racquetball) and closed-skilled acute exercise (treadmill exercise),each lasting 30-minute at 60% of heart rate reserve (HRR). During both experimental conditions,participants completed short- and long-term assessments of retrospective and prospective memory function. Retrospective memory was evaluated across multiple word-list trials (e.g.,Trials 1-6, 20-minute delay, 24-hour delay).<jats:bold>Results:</jats:bold>No significant effect of exercise was found on prospective memory. For retrospective memory, there was a significant main effect for condition, F(1, 57) = 5.33, P = 0.02, η<jats:sup>2</jats:sup>= 0.004,main effect for trial, F(4.12, 234.9) = 227.85,<jats:italic>P</jats:italic>&lt; 0.001, η<jats:sup>2</jats:sup>= 0.46, but no condition by trial interaction, F(4.63, 264.08) = 1.022,<jats:italic>P</jats:italic>= 0.40, η<jats:sup>2</jats:sup>= 0.002.<jats:bold>Conclusion:</jats:bold>Retrospective memory was greater after closed-skilled exercise (treadmill) when compared to open-skilled exercise (racquetball).</jats:p>"],"publicationDate":"2020-03-30","publisher":"Maad Rayan Publishing Company","embargoEndDate":null,"sources":["Crossref","Health Promot Perspect","Health Promotion Perspectives, Vol 10, Iss 2, Pp 123-128 (2020)"],"formats":null,"contributors":null,"coverages":null,"bestAccessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/"},"container":{"name":"Health Promotion Perspectives","issnPrinted":null,"issnOnline":"2228-6497","issnLinking":null,"ep":"128","iss":null,"sp":"123","vol":"10","edition":null,"conferencePlace":null,"conferenceDate":null},"documentationUrls":null,"codeRepositoryUrl":null,"programmingLanguage":null,"contactPeople":null,"contactGroups":null,"tools":null,"size":null,"version":null,"geoLocations":null,"id":"doi_dedup___::e4397e6542802b193d5ddc4491a763aa","o