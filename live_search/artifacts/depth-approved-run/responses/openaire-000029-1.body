rg/documentation/access_rights/","openAccessRoute":null},"type":"Article","urls":["https://doi.org/10.1145/3544793.3560346"],"publicationDate":"2022-09-11","refereed":"peerReviewed","hostedBy":{"key":"openaire____::55045bd2a65019fd8e6741a755395c8c","value":"Unknown Repository"},"collectedFrom":{"key":"openaire____::081b82f96300b6a6e3d282bad31cb6e2","value":"Crossref"}},{"alternateIdentifiers":[{"scheme":"doi","value":"10.1145/3544793.3560346"}],"type":"Conference object","urls":["https://doi.org/10.1145/3544793.3560346","https://dblp.org/rec/conf/huc/VargoONK22.html"],"refereed":"nonPeerReviewed","hostedBy":{"key":"openaire____::d8b68cc0a53121f6f896883a7d60c1db","value":"DBLP"},"collectedFrom":{"key":"openaire____::d8b68cc0a53121f6f896883a7d60c1db","value":"DBLP"}}],"links":[],"otherTitles":null,"inDiamondJournal":false,"green":false,"isGreen":false,"isInDiamondJournal":false},{"authors":[{"id":null,"fullName":"Madhu Chaudhary","name":null,"surname":null,"rank":1,"pid":null},{"id":null,"fullName":"Salman Masood","name":null,"surname":null,"rank":2,"pid":null},{"id":null,"fullName":"Mojahid Anwar","name":null,"surname":null,"rank":3,"pid":null},{"id":null,"fullName":"Shahnawaz Alam","name":null,"surname":null,"rank":4,"pid":null},{"id":null,"fullName":"Najmul Aqib Khan","name":null,"surname":null,"rank":5,"pid":null},{"id":null,"fullName":"Fareha Husain Khan","name":null,"surname":null,"rank":6,"pid":null},{"id":null,"fullName":"Qazi","name":null,"surname":null,"rank":7,"pid":null}],"openAccessColor":"gold","publiclyFunded":false,"eoscIfGuidelines":null,"type":"publication","language":{"code":"und","label":"Undetermined"},"countries":null,"subjects":[{"subject":{"scheme":"keyword","value":"memory"},"provenance":null},{"subject":{"scheme":"FOS","value":"03 medical and health sciences"},"provenance":null},{"subject":{"scheme":"FOS","value":"0302 clinical medicine"},"provenance":null},{"subject":{"scheme":"keyword","value":"aerobic exercise"},"provenance":null},{"subject":{"scheme":"keyword","value":"short term"},"provenance":null},{"subject":{"scheme":"keyword","value":"R"},"provenance":null},{"subject":{"scheme":"keyword","value":"Medicine"},"provenance":null},{"subject":{"scheme":"keyword","value":"endocannabinoids"},"provenance":null},{"subject":{"scheme":"SDG","value":"3. Good health"},"provenance":null}],"mainTitle":"Effect of acute aerobic exercise on short-term memory, long-term memory, and working memory in medical students of a tertiary care center in India: Possible role of endocannabinoids","subTitle":null,"descriptions":["<jats:p>Background: Recent studies have suggested that memory might benefit from physical exercise. Some studies also show that exercise has adverse effects on short-term memory. The number of studies on the effects of a single bout of exercise on memory is rather limited, and their results are inconsistent. In this study, we want to see the effect of a single bout of aerobic exercise on memory (short term and long term) when the learning session is before the exercise. We also want to see the effect of aerobic exercise on working memory when the learning session is after the exercise. Aims and Objectives: The aim is to find the effect of aerobic exercise on working, short-term and long-term memory. Materials and Methods: Sixty healthy medical students were divided into two groups of 30 each. Both groups were asked to listento 20 Arabic words (proper nouns) before the experiment. Students having any knowledge of Arabic were excluded from the study. Then, one group performed high-intensity exercise on a Bicycle Ergometer for 30 min and the other group silently relaxed on a chair. The subjects were asked to repeat the words heard after 20 min of exercise and 24 h of exercise. Data were recorded manually and analyzed statistically. In another experiment, the words were listened after the exercise was over, and the subjects were asked to recall after 20 min of exercise. Unpaired t-test was applied to compare the data between the two groups, and P-value and t-value were calculated. Results: When the words were recalled 20 min after exercise, the mean number of recalled words was more in the relaxing group (RG) than in the exercise group, but the result was reverse when recall was made 24 h after the exercise, i.e., more recall by exercise group. When the learning session was after the exercise and subjects were asked to recall words 20 min after the exercise, we found more recall by RG than the exercise group. Conclusion: We conclude that aerobic exercise has an adverse effect on short-term memory and working memory but has a beneficial effect on long-term memory.</jats:p>"],"publicationDate":"2022-06-01","publisher":"Pharmamedix India Publication Pvt Ltd","embargoEndDate":null,"sources":["Crossref","Asian Journal of Medical Sciences, Vol 13, Iss 6, Pp 85-89 (2022)"],"formats":null,"contributors":null,"coverages":null,"bestAccessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/"},"container":{"name":"Asian Journal of Medical Sciences","issnPrinted":"2467-9100","issnOnline":"2091-0576","issnLinking":null,"ep":"89","iss":null,"sp":"85","vol":"13","edition":null,"conferencePlace":null,"conferenceDate":null},"documentationUrls":null,"codeRepositoryUrl":null,"programmingLanguage":null,"contactPeople":null,"contactGroups":null,"tools":null,"size":null,"version":null,"geoLocations":null,"id":"doi_dedup___::440d7609f2cc3b4446f6cff1e8f4a5aa","originalIds":["10.3126/ajms.v13i6.42052","50|doiboost____|440d7609f2cc3b4446f6cff1e8f4a5aa","50|doajarticles::cb9134cc7df6a81c54317f4b792254e9","oai:doaj.org/article:b1b4ebc6a6de4fceb7dc3c18d1651b93"],"pids":[{"scheme":"doi","value":"10.3126/ajms.v13i6.42052"}],"dateOfCollection":null,"lastUpdateTimeStamp":null,"indicators":{"citationImpact":{"citationCount":1.0,"influence":2.2154154E-9,"popularity":2.1108457E-9,"impulse":1.0,"citationClass":"C5","influenceClass":"C5"