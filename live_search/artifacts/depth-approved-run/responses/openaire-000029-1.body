b82f96300b6a6e3d282bad31cb6e2","value":"Crossref"},{"key":"opendoar____::8b6dd7db9af49e67306feb59a8bdc52c","value":"Europe PubMed Central"}],"instances":[{"pids":[{"scheme":"doi","value":"10.1080/09658211.2022.2072895"}],"type":"Article","urls":["https://doi.org/10.1080/09658211.2022.2072895"],"publicationDate":"2022-05-06","refereed":"peerReviewed","hostedBy":{"key":"issn___print::161f85a4abab8e595d8fff717d368181","value":"Memory"},"collectedFrom":{"key":"openaire____::081b82f96300b6a6e3d282bad31cb6e2","value":"Crossref"}},{"pids":[{"scheme":"pmid","value":"35522241"}],"alternateIdentifiers":[{"scheme":"doi","value":"10.1080/09658211.2022.2072895"}],"type":"Article","urls":["https://pubmed.ncbi.nlm.nih.gov/35522241"],"publicationDate":"2022-08-29","refereed":"nonPeerReviewed","hostedBy":{"key":"issn___print::161f85a4abab8e595d8fff717d368181","value":"Memory"},"collectedFrom":{"key":"opendoar____::8b6dd7db9af49e67306feb59a8bdc52c","value":"Europe PubMed Central"}},{"alternateIdentifiers":[{"scheme":"doi","value":"10.1080/09658211.2022.2072895"}],"accessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/","openAccessRoute":null},"type":"Article","publicationDate":"2022-05-06","refereed":"nonPeerReviewed","hostedBy":{"key":"openaire____::0a836ef43dcb67bb7cbd4dd509b11b73","value":"CORE (RIOXX-UK Aggregator)"},"collectedFrom":{"key":"openaire____::0a836ef43dcb67bb7cbd4dd509b11b73","value":"CORE (RIOXX-UK Aggregator)"}}],"links":[],"otherTitles":null,"inDiamondJournal":false,"green":true,"isGreen":true,"isInDiamondJournal":false},{"authors":[{"id":null,"fullName":"Paul D. Loprinzi","name":"Paul D.","surname":"Loprinzi","rank":1,"pid":{"id":{"scheme":"orcid_pending","value":"0000-0001-7711-4741"},"provenance":null}},{"id":"orcid_______::8a921871d0fce4debe1cd9ea80d33dde","fullName":"Marc Roig","name":"Marc","surname":"Roig","rank":2,"pid":{"id":{"scheme":"orcid","value":"0000-0002-1016-467x"},"provenance":null}},{"id":"orcid_______::9cafa6bb0f9d90d5307d33bbbbeeefcf","fullName":"Phillip D. Tomporowski","name":"Phillip D.","surname":"Tomporowski","rank":3,"pid":{"id":{"scheme":"orcid","value":"0000-0002-6915-1013"},"provenance":null}},{"id":"orcid_______::c8de0066dcfd353d1dce1bf5809135aa","fullName":"Amir-Homayoun Javadi","name":"Amir-Homayoun","surname":"Javadi","rank":4,"pid":{"id":{"scheme":"orcid","value":"0000-0003-0569-6441"},"provenance":null}},{"id":"orcid_______::0f50627bdf0b88611c9f718e72b36bd5","fullName":"William L. Kelemen","name":"William L.","surname":"Kelemen","rank":5,"pid":{"id":{"scheme":"orcid","value":"0000-0002-3965-1025"},"provenance":null}}],"openAccessColor":null,"publiclyFunded":false,"eoscIfGuidelines":null,"type":"publication","language":{"code":"eng","label":"English"},"countries":null,"subjects":[{"subject":{"scheme":"keyword","value":"Adult"},"provenance":null},{"subject":{"scheme":"FOS","value":"03 medical and health sciences"},"provenance":null},{"subject":{"scheme":"keyword","value":"Young Adult"},"provenance":null},{"subject":{"scheme":"FOS","value":"0302 clinical medicine"},"provenance":null},{"subject":{"scheme":"keyword","value":"Memory, Long-Term"},"provenance":null},{"subject":{"scheme":"keyword","value":"Cognition"},"provenance":null},{"subject":{"scheme":"keyword","value":"Memory, Episodic"},"provenance":null},{"subject":{"scheme":"FOS","value":"05 social sciences"},"provenance":null},{"subject":{"scheme":"keyword","value":"Mental Recall"},"provenance":null},{"subject":{"scheme":"keyword","value":"Humans"},"provenance":null},{"subject":{"scheme":"FOS","value":"0501 psychology and cognitive sciences"},"provenance":null},{"subject":{"scheme":"keyword","value":"Exercise"},"provenance":null},{"subject":{"scheme":"keyword","value":"Article"},"provenance":null}],"mainTitle":"Effects of acute exercise on memory: Considerations of exercise intensity, post-exercise recovery period and aerobic endurance","subTitle":null,"descriptions":["Accumulating research demonstrates that acute exercise can enhance long-term episodic memory. However, it is unclear if there is an intensity-specific effect of acute exercise on long-term episodic memory function and whether this is influenced by the post-exercise recovery period, which was the primary objective of this experiment. Another uncertainty in the literature is whether aerobic endurance influences the interaction between exercise intensity and post-exercise recovery period on long-term episodic memory function, which was a secondary objective of this study. With exercise intensity and post-exercise recovery period occurring as within-subject factors, and fitness as a between-subject factor, 59 participants (Mage = 20 years) completed 12 primary laboratory visits. These visits included a 20-min bout of exercise (Control, Moderate, and Vigorous), followed by a recovery period (1, 5, 10, and 15 min) and then a word-list episodic memory task, involving an encoding phase and two long-term recall assessments (20-min and 24-h delayed recall). The primary finding from this experiment was that moderate and vigorous-intensity exercise improved memory function when compared to a non-exercise control. A secondary finding was that individuals with higher levels of aerobic endurance, compared to their lesser fit counterparts, had greater memory performance after exercise (moderate or vigorous) when compared to after a control condition. Additionally, individuals with higher levels of aerobic endurance, compared to their lesser fit counterparts, generally performed better on the memory task with longer post-exercise recovery periods. Future research should carefully consider these parameters when evaluating the effects of acute exercise on long-term episodic memory."],"publicationDate":"2022-11-18","publisher":"Springer Science and Business Media LLC","embargoEndDate":null,"sources":["Crossref","Mem Cognit"],"formats":null,"contributors":null,"coverages":null,"bestAccessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/"},"container":{"name":"Memory &amp; Cognition","issnPrinted":"0090-502X","issnOnline":"1532-5946","issnLinking":null,"ep":"1026","iss":null,"sp":"1011","vol":"51","edition":null,"conferencePlace":null,"conferenceDate":null},"documentationUrls":null,"codeRepositoryUrl":null,"programmingLanguage":null,"contactPeople":null,"contactGroups":null,"tools":null,"size":null,"version":null,"geoLocations":null,"id":"doi_dedup___::f2ae94d7f94227ef8ed8df9ceccd0d29","originalIds":["1373","10.3758/s13421-022-01373-4","50|doiboost____|f2ae94d7f94227ef8ed8df9ceccd0d29","od_______267::4128aa0c222a70e649db2ef7f00aa277","36401115","PMC9676734","50|od_______267::4128aa0c222a70e649db2ef7f00aa277","oai:pubmedcentral.nih.gov:9676734"],"pids":[{"scheme":"doi","value":"10.3758/s13421-022-01373-4"},{"scheme":"pmid","value":"36401115"},{"scheme":"pmc","value":"PMC9676734"}],"dateOfCollection":null,"lastUpdateTimeStamp":null,"indicators":{"citationImpact":{"citationCount":33.0,"influence":2.8825506E-9,"popularity":2.2133436E-8,"impulse":29.0,"citationClass":"C4","influenceClass":"C4","impulseClass":"C4","popularityClass":"C4"}},"projects":null,"organizations":[{"legalName":"McGill University","acronym":"McGill University","id":"openorgs____::4ebada891b1bf2c5c6fb2560a5170a02","pids":[{"scheme":"fundref","value":"100008583"},{"scheme":"FundRef","value":"100008919"},{"scheme":"RRID","value":"RRID:SCR_011388"},{"scheme":"ISNI","value":"0000000419368649"},{"scheme":"OrgRef","value":"7954643"},{"scheme":"FundRef","value":"100008583"},{"scheme":"FundRef","value":"100008644"},{"scheme":"FundRef","value":"100008582"},{"scheme":"mag_id","value":"5023651"},{"scheme":"RRID","value":"RRID:nlx_60719"},{"scheme":"fundref","value":"100009137"},{"scheme":"FundRef","value":"100009137"},{"scheme":"fundref","value":"100008644"},{"scheme":"FundRef","value":"100018482"},{"scheme":"fundref","value