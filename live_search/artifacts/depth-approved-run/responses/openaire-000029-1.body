},{"scheme":"fundref","value":"100006808"},{"scheme":"FundRef","value":"100013056"},{"scheme":"wikidata","value":"Q2092214"},{"scheme":"wikidata","value":"Q1783178"},{"scheme":"FundRef","value":"100015514"},{"scheme":"RRID","value":"RRID:SCR_006100"},{"scheme":"ROR","value":"https://ror.org/04dawnj30"},{"scheme":"GRID","value":"grid.266856.9"},{"scheme":"OrgRef","value":"77958"},{"scheme":"FundRef","value":"100013506"},{"scheme":"GRID","value":"grid.10698.36"},{"scheme":"FundRef","value":"100007810"},{"scheme":"fundref","value":"100011485"},{"scheme":"fundref","value":"100010942"},{"scheme":"fundref","value":"100005899"},{"scheme":"ISNI","value":"0000000122483208"},{"scheme":"ROR","value":"https://ror.org/0130frc33"},{"scheme":"OrgRef","value":"4326148"},{"scheme":"fundref","value":"100011106"},{"scheme":"FundRef","value":"100008615"},{"scheme":"mag_id","value":"114027177"},{"scheme":"ISNI","value":"0000000098130452"},{"scheme":"ISNI","value":"000000010671255X"},{"scheme":"fundref","value":"100015514"}],"countries":[{"code":"US","label":"United States"}],"websiteurl":"http://www.unc.edu/"}],"communities":[{"code":"neuroscience","label":"Neuroscience","provenance":null}],"collectedFrom":[{"key":"openaire____::081b82f96300b6a6e3d282bad31cb6e2","value":"Crossref"},{"key":"openaire____::5f532a3fc4f1ea403f37070f59a7a53a","value":"Microsoft Academic Graph"},{"key":"opendoar____::8b6dd7db9af49e67306feb59a8bdc52c","value":"Europe PubMed Central"}],"instances":[{"pids":[{"scheme":"doi","value":"10.1016/j.ijpsycho.2020.09.018"}],"license":"Elsevier TDM","accessRight":{"code":"c_14cb","label":"CLOSED","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/","openAccessRoute":null},"type":"Article","urls":["https://doi.org/10.1016/j.ijpsycho.2020.09.018"],"publicationDate":"2020-12-01","refereed":"peerReviewed","hostedBy":{"key":"issn___print::b84d9001cf0be482352bfc8620250f13","value":"International Journal of Psychophysiology"},"collectedFrom":{"key":"openaire____::081b82f96300b6a6e3d282bad31cb6e2","value":"Crossref"}},{"pids":[{"scheme":"pmid","value":"33164850"}],"alternateIdentifiers":[{"scheme":"doi","value":"10.1016/j.ijpsycho.2020.09.018"}],"type":"Article","urls":["https://pubmed.ncbi.nlm.nih.gov/33164850"],"publicationDate":"2021-10-25","refereed":"nonPeerReviewed","hostedBy":{"key":"openaire____::55045bd2a65019fd8e6741a755395c8c","value":"Unknown Repository"},"collectedFrom":{"key":"opendoar____::8b6dd7db9af49e67306feb59a8bdc52c","value":"Europe PubMed Central"}},{"alternateIdentifiers":[{"scheme":"doi","value":"10.1016/j.ijpsycho.2020.09.018"},{"scheme":"mag_id","value":"3093890694"}],"type":"Article","urls":["https://dx.doi.org/10.1016/j.ijpsycho.2020.09.018"],"refereed":"nonPeerReviewed","hostedBy":{"key":"openaire____::55045bd2a65019fd8e6741a755395c8c","value":"Unknown Repository"},"collectedFrom":{"key":"openaire____::5f532a3fc4f1ea403f37070f59a7a53a","value":"Microsoft Academic Graph"}},{"alternateIdentifiers":[{"scheme":"mag_id","value":"3093890694"},{"scheme":"doi","value":"10.1016/j.ijpsycho.2020.09.018"}],"type":"Article","urls":["https://dx.doi.org/10.1016/j.ijpsycho.2020.09.018"],"refereed":"nonPeerReviewed","hostedBy":{"key":"openaire____::55045bd2a65019fd8e6741a755395c8c","value":"Unknown Repository"},"collectedFrom":{"key":"openaire____::5f532a3fc4f1ea403f37070f59a7a53a","value":"Microsoft Academic Graph"}}],"links":[],"otherTitles":null,"inDiamondJournal":false,"green":false,"isGreen":false,"isInDiamondJournal":false},{"authors":[{"id":"orcid_______::2fc744bf61e200973ae1533b496adfdf","fullName":"Liye, Zou","name":"Liye","surname":"Zou","rank":1,"pid":{"id":{"scheme":"orcid","value":"0000-0001-6411-5710"},"provenance":null}},{"id":"orcid_______::302590ff4597ba9839b42ebc958cd7fd","fullName":"Qian, Yu","name":"Qian","surname":"Yu","rank":2,"pid":{"id":{"scheme":"orcid","value":"0000-0001-8882-1994"},"provenance":null}},{"id":null,"fullName":"Shijie, Liu","name":"Shijie","surname":"Liu","rank":3,"pid":null},{"id":null,"fullName":"Paul D, Loprinzi","name":"Paul D","surname":"Loprinzi","rank":4,"pid":null}],"openAccessColor":null,"publiclyFunded":false,"eoscIfGuidelines":null,"type":"publication","language":{"code":"eng","label":"English"},"countries":null,"subjects":[{"subject":{"scheme":"FOS","value":"03 medical and health sciences"},"provenance":null},{"subject":{"scheme":"keyword","value":"Memory Disorders"},"provenance":null},{"subject":{"scheme":"FOS","value":"0302 clinical medicine"},"provenance":null},{"subject":{"scheme":"keyword","value":"Physical Conditioning, Animal"},"provenance":null},{"subject":{"scheme":"FOS","value":"05 social sciences"},"provenance":null},{"subject":{"scheme":"keyword","value":"Animals"},"provenance":null},{"subject":{"scheme":"keyword","value":"Humans"},"provenance":null},{"subject":{"scheme":"FOS","value":"0501 psychology and cognitive sciences"},"provenance":null},{"subject":{"scheme":"keyword","value":"Exercise"},"provenance":null},{"subject":{"scheme":"keyword","value":"Exercise Therapy"},"provenance":null},{"subject":{"scheme":"keyword","value":"Spatial Memory"},"provenance":null}],"mainTitle":"Exercise on Visuo-Spatial Memory: Direct Effects and Underlying Mechanisms","subTitle":null,"descriptions":["<jats:p><jats:bold>Objective:</jats:bold> There is suggestive evidence that exercise may have a greater effect on visuo-spatial memory, compared to other memory types. However, we have a limited understanding as to the mechanisms through which exercise may subserve visuo-spatial memory. Thus, the purpose of  this review is to evaluate the extent to which exercise may influence visuo-spatial memory, whether exercise can attenuate drug- and diseased-induced declines in memory, and determine the underlying mechanisms of these relationships. <jats:bold>Methods:</jats:bold> We employed a systematic review approach.  We identified studies using electronic databases, including PubMed, PsychInfo, Sports Discus and Google Scholar. <jats:bold>Results:</jats:bold> In total, we identified 32 articles. Among these, 2 were among humans and 30 were conducted in animal models. There was strong evidence sup- porting the facilitative  role of chronic exercise in visuo-spatial memory improvements, as well as attenuation of drug- and diseased-induced memory decline. There are various mechanisms through which chronic exercise may influence visuo-spatial memory, including increased neuro-genesis, angiogenesis, improved neural  efficiency, CB<jats:sub>1</jats:sub> receptor signaling, activation of H<jats:sub>2</jats:sub> receptors, and increased number of synaptic structures (eg, AMPA and NMDA receptors). <jats:bold>Conclusion: </jats:bold>Exercise may help to enhance visuo-spatial memory.</jats:p>"],"publicationDate":"2020-03-01","publisher":"JCFCorp SG PTE LTD","embargoEndDate":null,"sources":["Crossref"],"formats":null,"contributors":null,"coverages":null,"bestAccessRight":null,"container":{"name":"American Journal of Health Behavior","issnPrinted":"1087-3244","issnOnline":null,"issnLinking":null,"ep":"179","iss":null,"sp":"169","vol":"44","edition":null,"conferencePlace":null,"conferenceDate":null},"documentationUrls":null,"codeRepositoryUrl":null,"programmingLanguage":null,"contactPeople":null,"contactGroups":null,"tools":null,"size":null,"version":null,"geoLocations":null,"id":"doi_dedup___::93259ffa5db13b8d32a60c1fe2ba007e","originalIds":["1087-3244(20200301)44:2L.169;1-","10.5993/ajhb.44.2.5","50|doiboost____|93259ffa5db13b8d32a60c1fe2ba007e","32019650","3005019192"],"pids":[{"scheme":"doi","value":"10.5993/ajhb.44.2.5"},{"scheme":"pmid","value":"32019650"}],"dateOfCollection":null,"lastUpdateTimeStamp":null,"indicators":{"citationImpact":{"citationCount":7.0,"influence":2.2921487E-9,"popularity":5.0795217E-9,"impulse":5.0,"citationClass":"C5","influenceClass":"C5","impulseClass":"C4","popularityClass":"C4"}},"projects":null,"organizations":[{"legalName":"Zhengzhou University","acronym":"Zhengzhou University","id":"openorgs____::06b32746794cdba54ce5d3b19d8b4792","pids":[{"scheme":"GRID","value":"grid.207374.5"},{"scheme":"fundref","value":"501100004605"},{"scheme":"ROR","value":"https://ror.org/04ypx8c21"},{"scheme":"FundRef","value":"501100004605"},{"scheme":"ISNI","value":"0000000121893846"},{"scheme":"wikidata","value":"Q649895"},{"scheme":"Wikidata","value":"Q649895"},{"scheme":"mag_id","value":"38877650"},{"scheme":"OrgRef","value":"919119"}],"countries":[{"code":"CN","label":"China (People's Republic of)"}],"websiteurl":"http://www.zzu.edu.cn/"},{"legalName":"University of Mississippi","acronym":"University of Mississippi","id":"openorgs____::079ba973bec14d5d19423a79e16ee0bf","pids":[{"scheme":"wikidata","value":"Q1138384"},{"scheme":"fundref","value":"100006804"},{"scheme":"FundRef","value":"100006940"},{"scheme":"GRID","value":"grid.251313.7"},{"scheme":"fundref","value":"100006940"},{"scheme":"FundRef","value":"100006804"},{"scheme":"Wikidata","value":"Q1138384"},{"scheme":"ISNI","value":"0000000121692489"},{"scheme":"mag_id","value":"368840534"},{"scheme":"OrgRef","value":"65542"},{"scheme":"ROR","value":"https://ror.org/02teq1165"}],"countries":[{"code":"US","label":"United States"}],"websiteurl":"http://www.olemiss.edu/"},{"legalName":"Shenzhen University","acronym":"SZU","id":"openorgs____::03b0b55dced73b74d394734165f3d4e5","pids":[{"scheme":"FundRef","value":"501100009019"},{"scheme":"OrgRef","value":"3804886"},{"scheme":"ROR","value":"https://ror.org/01vy4gh70"},{"scheme":"ISNI","value":"0000000104729649"},{"scheme":"Wikidata","value":"Q1945756"},{"scheme":"GRID","value":"grid.263488.3"},{"scheme":"mag_id","value":"180726961"},{"scheme":"wikidata","value":"Q1945756"},{"scheme":"fundref","value":"501100009019"}],"countries":[{"code":"CN","label":"China (People's Republic of)"}],"websiteurl":"http://www.szu.edu.cn/2014/en/"},{"legalName":"Fifth Affiliated Hospital of Zhengzhou University","acronym":"Fifth Affiliated Hospital of Zhengzhou University","id":"openorgs____::a6dadf651f7b72c006dd71bb278ac8d2","pids":[{"scheme":"ROR","value":"https://ror.org/01wfgh551"},{"scheme":"GRID","value":"grid.460069.d"}],"countries":[{"code":"CN","label":"China (People's Republic of)"}],"websiteurl":"http://www.ztzy.com/"}],"communities":null,"collectedFrom":[{"key":"openaire____::081b82f96300b6a6e3d282bad31cb6e2","value":"Crossref"},{"key":"openaire____::5f532a3fc4f1ea403f37070f59a7a53a","value":"Microsoft Academic Graph"},{"key":"opendoar____::8b6dd7db9af49e67306feb59a8bdc52c","value":"Europe PubMed Central"}],"instances":[{"pids":[{"scheme":"doi","value":"10.5993/ajhb.44.2.5"}],"type":"Article","urls":["https://doi.org/10.5993/ajhb.44.2.5"],"publicationDate":"2020-03-01","refereed":"peerReviewed","hostedBy":{"key":"issn___print::97bacc73605e623726883596e8222b86","value":"American Journal of Health Behavior"},"collectedFrom":{"key":"openaire____::081b82f96300b6a6e3d282bad31cb6e2","value":"Crossref"}},{"pids":[{"scheme":"pmid","value":"32019650"}],"alternateIdentifiers":[{"scheme":"doi","value":"10.5993/ajhb.44.2.5"}],"type":"Article","urls":["https://pubmed.ncbi.nlm.nih.gov/32019650"],"publicationDate":"2021-01-25","refereed":"nonPeerReviewed","hostedBy":{"key":"issn___print::97bacc73605e623726883596e8222b86","value":"American Journal of Health Behavior"},"collectedFrom":{"key":"opendoar____::8b6dd7db9af49e67306feb59a8bdc52c","value":"Europe PubMed Central"}},{"alternateIdentifiers":[{"scheme":"mag_id","value":"3005019192"},{"scheme":"doi","value":"10.5993/ajhb.44.2.5"}],"type":"Article","urls":["https://dx.doi.org/10.5993/ajhb.44.2.5"],"refereed":"nonPeerReviewed","hostedBy":{"key":"openaire____::55045bd2a65019fd8e6741a755395c8c","value":"Unknown Repository"},"collectedFrom":{"key":"openaire____::5f532a3fc4f1ea403f37070f59a7a53a","value":"Microsoft Academic Graph"}},{"alternateIdentifiers":[{"scheme":"mag_id","value":"3005019192"},{"scheme":"doi","value":"10.5993/ajhb.44.2.5"}],"type":"Article","urls":["https://dx.doi.org/10.5993/ajhb.44.2.5"],"refereed":"nonPeerReviewed","hostedBy":{"key":"openaire____::55045bd2a65019fd8e6741a755395c8c","value":"Unknown Repository"},"collectedFrom":{"key":"openaire____::5f532a3fc4f1ea403f37070f59a7a53a","value":"Microsoft Academic Graph"}}],"links":[],"otherTitles":null,"inDiamondJournal":false,"green":false,"isGreen":false,"isInDiamondJournal":false},{"authors":[{"id":null,"fullName":"Olafson, Danielle","name":"Danielle","surname":"Olafson","rank":1,"pid":null}],"openAccessColor":null,"publiclyFunded":false,"eoscIfGuidelines":null,"type":"publication","language":{"code":"eng","label":"English"},"countries":[{"code":"CA","label":"Canada","provenance":null}],"subjects":[{"subject":{"scheme":"keyword","value":"memory"},"provenance":null},{"subject":{"scheme":"keyword","value":"exercise"},"provenance":null},{"subject":{"scheme":"FOS","value":"05 social sciences"},"provenance":null},{"subject":{"scheme":"keyword","value":"association"},"provenance":null},{"subject":{"scheme":"keyword","value":"acute"},"provenance":null},{"subject":{"scheme":"keyword","value":"emotion"},"provenance":null},{"subject":{"scheme":"FOS","value":"0501 psychology and cognitive sciences"},"provenance":null},{"subject":{"scheme":"keyword","value":"emotional"},"provenance":null},{"subject":{"scheme":"keyword","value":"episodic"},"provenance":null},{"subject":{"scheme":"keyword","value":"declarative"},"provenance":null},{"subject":{"scheme":"keyword","value":"fitness"},"provenance":null}],"mainTitle":"Influence of acute exercise on association memory for emotional and neutral pictures","subTitle":null,"descriptions":["Introduction: The beneficial effects of chronic exercise on hippocampal volume and associated memory functions are well studied, especially in the context of aging and dementia. These effects are thought to be mediated by multiple exercise-induced physiological and molecular factors (e.g., cortisol, BDNF, neurotransmitters), which directly or indirectly influence hippocampal structure and function. However, whether an acute bout of exercise can influence memory functions is less clear. In humans, association memory, i.e., relational memory for two or more items has been associated with hippocampal function, and some studies have examined how acute exercise may affect associative memory performance. Acute exercise also influences mood, but effects on emotional types of memory are sparse and equivocal. In the current study, we used an association memory task with emotional and neutral picture pairs, previously shown to engage the hippocampus, and to produce an emotional memory bias favoring neutral pairs of images over emotional (negative, high-arousing) pairs. The purpose of the current study was to test whether differing intensities of exercise change emotional association memory performance in this task. Hypotheses: We tested two alternative hypotheses. Compared to low-intensity exercise and no-activity controls: 1) High intensity exercise will nullify arousal effects of the emotional materials on memory and decrease the typical memory bias for neutral picture pairs. 2) High intensity exercise will intensify the typical memory bias, creating an even larger memory advantage for neutral pairs. In addition, based on previous non-emotional association memory studies, we predicted: 3) High intensity exercise will increase overall association memory regardless of emotional valence of the pictures. Methods: In a pseudorandomized blinded experiment, 95 undergraduate students were assigned to one of three experimental groups: A high intensity group in which participants cycled to 90% of their maximum heart rate (n=31), a low intensity group which leisurely cycled to no more than 50% of their maximum heart rate (n=33), and a no-activity control group watching a nature video (n=31). Heart rate was continuously monitored to measure physiological reactivity. The memory task (from Madan et al., 2017) contained negative and neutral picture pairs, tested association memory through associative recognition, and was conducted before and after the intervention. Results: Results indicated that the exercise intervention was successful. Both the low and high intensity groups had the same resting heart rate, but the high-intensity group demonstrated more pronounced heart rate changes compared to the low intensity group throughout the intervention. Average association memory performance, differential memory for neutral versus emotional pairs, and subjective memory performance were indistinguishable between groups, with clear evidence for null findings based on Bayesian statistics, although the high intensity group showed atypical memory performance already prior to the intervention. Within the high intensity group, participants who had a greater physiological response to the intervention demonstrated better memory both before and after the intervention than individuals with a weaker response. Discussion and conclusion: Based on these outcomes, acute exercise seems ineffective to change performance in emotional association memory, with Bayes factors conclusively suggesting null-findings. Nevertheless, outcomes could also be linked to a variety of experimental factors including high variability of the memory bias across participants, recruitment/sampling, test duration, and other uncontrolled factors (dispositional fitness levels, recent real-life exercise, time of day). The relationship between the responsiveness to high intensity exercise and memory mirrors similar findings in previous literature, indicating that responsiveness to higher intensities of exercise is related to better memory. This suggests that participants who are physiologically more responsive (higher heart rate) to high intensity exercise may have better memory performance regardless of acute exercise. In conclusion, future studies with healthy, young participants may focus on non-emotional association memory tasks with a shorter duration and may benefit from more intensive investigation of participant fitness levels as well as additional heart rate measures (e.g., variability, fluctuations) in order to ascertain whether exercise-based association memory changes are restricted to individuals with a stronger response to exercise."],"publicationDate":"2020-01-01","publisher":null,"embargoEndDate":null,"sources":null,"formats":["application/pdf"],"contributors":["Fujiwara, Esther (Psychiatry)"],"coverages":null,"bestAccessRight":null,"container":null,"documentationUrls":null,"codeRepositoryUrl":null,"programmingLanguage":null,"contactPeople":null,"contactGroups":null,"tools":null,"size":null,"version":null,"geoLocations":null,"id":"doi_dedup___::ffa326d1947b46f82672973a6c27794d","originalIds":["50|datacite____::ffa326d1947b46f82672973a6c27794d","10.7939/r3-r0cm-xt26","50|od______1875::ab4c689f4295c0d6dc37b820e0dd5268","oai:ualberta.scholaris.ca:123456789/88452"],"pids":[{"scheme":"doi","value":"10.7939/r3-r0cm-xt26"}],"dateOfCollection":null,"lastUpdateTimeStamp":null,"indicators":{"citationImpact":{"citationCount":0.0,"influence":2.1746283E-9,"popularity":1.1111055E-9,"impulse":0.0,"citationClass":"C5","influenceClass":"C5","impulseClass":"C5","popularityClass":"C5"}},"projects":null,"organizations":[{"legalName":"University of Alberta","acronym":"University of Alberta","id":"openorgs____::57c282a96132a7f3d1dbe740ee8a7aa4","pids":[{"scheme":"fundref","value":"501100007201"},{"scheme":"fundref","value":"100006516"},{"scheme":"FundRef","value":"501100019556"},{"scheme":"OrgRef","value":"1765506"},{"scheme":"ROR","value":"https://ror.org/0160cpw27"},{"scheme":"FundRef","value":"501100000067"},{"scheme":"Wikidata","value":"Q640694"},{"scheme":"fundref","value":"501100019556"},{"scheme":"fundref","value":"501100000144"},{"scheme":"FundRef","value":"501100000190"},{"scheme":"OrgRef","value":"242057"},{"scheme":"GRID","value":"grid.17089.37"},{"scheme":"FundRef","value":"100008741"},{"scheme":"FundRef","value":"501100000103"},{"scheme":"mag_id","value":"154425047"},{"scheme":"fundref","value":"501100003179"},{"scheme":"FundRef","value":"501100019691"},{"scheme":"FundRef","value":"100006516"},{"scheme":"wikidata","value":"Q640694"},{"scheme":"FundRef","value":"501100000144"},{"scheme":"RRID","value":"RRID:SCR_001853"},{"scheme":"FundRef","value":"501100007201"},{"scheme":"fundref","value":"501100019691"},{"scheme":"FundRef","value":"501100006441"},{"scheme":"fundref","value":"501100006043"},{"scheme":"RRID","value":"RRID:nlx_10148"},{"scheme":"fundref","value":"501100000067"},{"scheme":"FundRef","value":"501100006043"},{"scheme":"fundref","value":"501100000190"},{"scheme":"fundref","value":"100008741"},{"scheme":"fundref","value":"501100000103"},{"scheme":"FundRef","value":"501100003179"},{"scheme":"fundref","value":"501100006441"}],"countries":[{"code":"CA","label":"Canada"}],"websiteurl":"http://ualberta.ca/"}],"communities":[{"code":"uarctic","label":"UArctic","provenance":null}],"collectedFrom":[{"key":"openaire____::9e3be59865b2c1c335d32dae2fe7b254","value":"Datacite"},{"key":"opendoar____::7e9e346dc5fd268b49bf418523af8679","value":"Education and Research Archive"}],"instances":[{"pids":[{"scheme":"doi","value":"10.7939/r3-r0cm-xt26"}],"type":"Thesis","urls":["https://dx.doi.org/10.7939/r3-r0cm-xt26"],"publicationDate":"2020-01-01","refereed":"nonPeerReviewed","hostedBy":{"key":"openaire____::55045bd2a65019fd8e6741a755395c8c","value":"Unknown Repository"},"collectedFrom":{"key":"openaire____::9e3be59865b2c1c335d32dae2fe7b254","value":"Datacite"}},{"alternateIdentifiers":[{"scheme":"doi","value":"10.7939/r3-r0cm-xt26"}],"type":"Thesis","urls":["https://doi.org/10.7939/r3-r0cm-xt26"],"publicationDate":"2020-11-01","refereed":"nonPeerReviewed","hostedBy":{"key":"opendoar____::7e9e346dc5fd268b49bf418523af8679","value":"Education and Research Archive"},"collectedFrom":{"key":"opendoar____::7e9e346dc5fd268b49bf418523af8679","value":"Education and Research Archive"}}],"links":[],"otherTitles":null,"inDiamondJournal":false,"green":false,"isGreen":false,"isInDiamondJournal":false},{"authors":[{"id":null,"fullName":"Laura A. Kuhne","name":"Laura A.","surname":"Kuhne","rank":1,"pid":null},{"id":null,"fullName":"Anna-Maria Ksiezarczyk","name":null,"surname":null,"rank":2,"pid":null},{"id":null,"fullName":"Klaus-Michael Braumann","name":null,"surname":null,"rank":3,"pid":null},{"id":null,"fullName":"Rüdiger Reer","name":null,"surname":null,"rank":4,"pid":null},{"id":null,"fullName":"Thomas Jacobs","name":null,"surname":null,"rank":5,"pid":null},{"id":"orcid_______::55d706d35873ed830ec0707561923d7e","fullName":"Brigitte Röder","name":null,"surname":null,"rank":6,"pid":{"id":{"scheme":"orcid","value":"0000-0003-3088-8023"},"provenance":null}},{"id":"orcid_______::09b22942781f58d10cad8acd795295d7","fullName":"Kirsten Hötting","name":null,"surname":null,"rank":7,"pid":{"id":{"scheme":"orcid","value":"0000-0002-3987-7657"},"provenance":null}}],"openAccessColor":"gold","publiclyFunded":false,"eoscIfGuidelines":null,"type":"publication","language":{"code":"und","label":"Undetermined"},"countries":null,"subjects":[{"subject":{"scheme":"keyword","value":"memory"},"provenance":null},{"subject":{"scheme":"FOS","value":"03 medical and health sciences"},"provenance":null},{"subject":{"scheme":"FOS","value":"0302 clinical medicine"},"provenance":null},{"subject":{"scheme":"keyword","value":"learning"},"provenance":null},{"subject":{"scheme":"keyword","value":"BDNF"},"provenance":null},{"subject":{"scheme":"keyword","value":"neurotrophic factors"},"provenance":null},{"subject":{"scheme":"keyword","value":"physical exercise"},"provenance":null},{"subject":{"scheme":"keyword","value":"Neurosciences. Biological psychiatry. Neuropsychiatry"},"provenance":null},{"subject":{"scheme":"keyword","value":"VEGF"},"provenance":null},{"subject":{"scheme":"keyword","value":"RC321-571"},"provenance":null},{"subject":{"scheme":"keyword","value":"Neuroscience"},"provenance":null},{"subject":{"scheme":"SDG","value":"3. Good health"},"provenance":null}],"mainTitle":"The Effects of Acute Cardiovascular Exercise on Memory and Its Associations With Exercise-Induced Increases in Neurotrophic Factors","subTitle":null,"descriptions":["<jats:p>Due to increasing life expectancy, low-cost interventions to counteract age-related memory impairment have gained popularity. Physical activity has been shown to positively affect memory and hippocampal plasticity in rodents and humans. These effects have been proposed to be mediated by the release of neurotrophic factors. However, studies examining the effects of a single cardiovascular exercise session on human memory have yielded conflicting results. Moreover, it remains unclear whether exercise-induced memory enhancements are related to changes in peripheral neurotrophic factor concentrations. The present study tested whether one bout of cardiovascular exercise during an early phase of memory consolidation, compared to one bout of stretching and toning, positively affected memory. Furthermore, it was analyzed whether exercise-induced changes in the brain-derived neurotrophic factor (BDNF) and vascular endothelial growth factor (VEGF) were related to memory enhancement after a single bout of physical exercise. Fifty healthy participants (20–40 years) were randomly assigned to either a cycling group (BIKE) or a stretching and toning group (STRETCH). Participants performed an implicit vocabulary learning task which was immediately followed by physical exercise. Memory for the learned vocabulary was tested 1–2 weeks later. To measure exercise-induced changes in serum neurotrophic factor levels, blood samples were collected at rest (baseline) and immediately after the exercise session. Results did not show a significant difference in memory between the BIKE group and the STRETCH group. However, in the BIKE group, a larger increase in BDNF and VEGF levels was observed than in the STRETCH group. Moreover, the increase in BDNF and memory performance tended to be positively related in the BIKE group. We speculate that the correlation between exercise-increased BDNF levels and memory in the cycling group may indicate an involvement of BDNF in mediating memory processes after acute cardiovascular exercise.</jats:p>"],"publicationDate":"2021-11-08","publisher":"Frontiers Media SA","embargoEndDate":null,"sources":["Crossref","Front Aging Neurosci","Frontiers in Aging Neuroscience, Vol 13 (2021)"],"formats":null,"contributors":null,"coverages":null,"bestAccessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/"},"container":{"name":"Frontiers in Aging Neuroscience","issnPrinted":null,"issnOnline":"1663-4365","issnLinking":null,"ep":null,"iss":null,"sp":null,"vol":"13","edition":null,"conferencePlace":null,"conferenceDate":null},"documentationUrls":null,"codeRepositoryUrl":null,"programmingLanguage":null,"contactPeople":null,"contactGroups":null,"tools":null,"size":null,"version":null,"geoLocations":null,"id":"doi_dedup___::1cf1b0ce517fb933a6ef817be7dc4d5c","originalIds":["10.3389/fnagi.2021.750401","50|doiboost____|1cf1b0ce517fb933a6ef817be7dc4d5c","od_______267::9046b6a253d089c2cb60e938b47d0ea1","34858160","PMC8630591","oai:pubmedcentral.nih.gov:8630591","50|od_______267::9046b6a253d089c2cb60e938b47d0ea1","50|doajarticles::b1a0767c8988b09ec93599e024b2dbaa","oai:doaj.org/article:bc5ad464da314d87968d3d84c6e9baf8","3214422062"],"pids":[{"scheme":"doi","value":"10.3389/fnagi.2021.750401"},{"scheme":"pmid","value":"34858160"},{"scheme":"pmc","value":"PMC8630591"}],"dateOfCollection":null,"lastUpdateTimeStamp":null,"indicators":{"citationImpact":{"citationCount":5.0,"influence":2.2323212E-9,"popularity":4.487358E-9,"impulse":3.0,"citationClass":"C5","influenceClass":"C5","impulseClass":"C5","popularityClass":"C4"}},"projects":[{"id":"dfgf________::1e5e62235d094afd01cd56e65112fc63","code":"unidentified","acron