1100004484"},{"scheme":"OrgRef","value":"3977331"},{"scheme":"fundref","value":"501100005391"},{"scheme":"mag_id","value":"70640408"}],"countries":[{"code":"IR","label":"Iran (Islamic Republic of)"}],"websiteurl":"http://gsia.tums.ac.ir/en"}],"communities":null,"collectedFrom":[{"key":"openaire____::081b82f96300b6a6e3d282bad31cb6e2","value":"Crossref"},{"key":"opendoar____::8b6dd7db9af49e67306feb59a8bdc52c","value":"Europe PubMed Central"}],"instances":[{"pids":[{"scheme":"doi","value":"10.1007/s11064-022-03552-w"}],"license":"Springer TDM","accessRight":{"code":"c_14cb","label":"CLOSED","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/","openAccessRoute":null},"type":"Article","urls":["https://doi.org/10.1007/s11064-022-03552-w"],"publicationDate":"2022-02-23","refereed":"peerReviewed","hostedBy":{"key":"issn___print::158477fff34677b11bbc2006af9cf4ae","value":"Neurochemical Research"},"collectedFrom":{"key":"openaire____::081b82f96300b6a6e3d282bad31cb6e2","value":"Crossref"}},{"pids":[{"scheme":"pmid","value":"35195832"}],"alternateIdentifiers":[{"scheme":"doi","value":"10.1007/s11064-022-03552-w"}],"type":"Article","urls":["https://pubmed.ncbi.nlm.nih.gov/35195832"],"publicationDate":"2022-05-24","refereed":"nonPeerReviewed","hostedBy":{"key":"issn___print::158477fff34677b11bbc2006af9cf4ae","value":"Neurochemical Research"},"collectedFrom":{"key":"opendoar____::8b6dd7db9af49e67306feb59a8bdc52c","value":"Europe PubMed Central"}}],"links":[],"otherTitles":null,"inDiamondJournal":false,"green":false,"isGreen":false,"isInDiamondJournal":false},{"authors":[{"id":null,"fullName":"Rob Sillevis","name":"Rob","surname":"Sillevis","rank":1,"pid":null},{"id":null,"fullName":"Nicole Levi","name":"Nicole","surname":"Levi","rank":2,"pid":null},{"id":null,"fullName":"Meghan Sparacio","name":"Meghan","surname":"Sparacio","rank":3,"pid":null}],"openAccessColor":null,"publiclyFunded":null,"eoscIfGuidelines":null,"type":"publication","language":{"code":"und","label":"Undetermined"},"countries":null,"subjects":null,"mainTitle":"Effects of Moderate-Intensity Exercise and Timing of Memory Encoding on Memory Retention in Healthy Young Adults","subTitle":null,"descriptions":["<jats:p>Background: Acute exercise has been shown to influence cognitive performance, particularly memory; however, the impact of exercise timing relative to memory encoding remains unclear. Most studies have examined single temporal conditions in isolation, limiting understanding of how exercise before, during, or after encoding differentially affects memory processes.Objective: This study aimed to investigate the effects of moderate- intensity aerobic exercise and the timing of memory encoding on short-term and long-term memory retention in healthy young adults.Methods: This pilot study employed a randomized controlled mixed factorial design with one between-subject factor (exercise timing condition) and one within-subject factor (memory assessment time point). Participants (N=46, (21.89 ± 2.83 years)) were assigned to one of four conditions: encoding before exercise, during exercise, after exercise, or a non-exercise control. The intervention consisted of a 25-minute moderate-intensity cycling protocol (60–70% HRmax). Memory performance was assessed using standardized word recall tasks at baseline, immediately post-encoding, and after a 24-hour delay. Non-parametric analyses (Kruskal–Wallis and Mann–Whitney U tests) were used to evaluate group differences.Results: No significant differences were observed between groups for baseline or short-term memory performance (p &gt; 0.05). However, significant differences were identified for long-term memory recall (H(3)=8.29, p=0.041). The control group demonstrated the highest long-term retention, while encoding during and after exercise resulted in significantly lower performance compared to control (p=0.043 and p=0.010, respectively). Encoding prior to exercise showed relatively preserved memory performance. Age and education level were significantly associated with memory outcomes, whereas gender was not.Conclusion: The timing of exercise relative to memory encoding may influence long-term memory retention. Moderate-intensity exercise did not consistently enhance memory performance and may be associated with reduced retention when performed during or immediately after encoding. These findings suggest temporal specificity may play an important role in the exercise–cognition relationship.</jats:p>"],"publicationDate":"2026-06-01","publisher":"Gexinonline Publications","embargoEndDate":null,"sources":["Crossref"],"formats":null,"contributors":null,"coverages":null,"bestAccessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/"},"container":{"name":"Journal of Rehabilitation Practices and Research","issnPrinted":null,"issnOnline":"2583-1593","issnLinking":null,"ep":null,"iss":null,"sp":null,"vol":"7","edition":null,"conferencePlace":null,"conferenceDate":null},"documentationUrls":null,"codeRepositoryUrl":null,"programmingLanguage":null,"contactPeople":null,"contactGroups":null,"tools":null,"size":null,"version":null,"geoLocations":null,"id":"doi_________::672f305d89fa0602a33bfa40c7640f85","originalIds":["10.33790/jrpr1100207","50|doiboost____|672f305d89fa0602a33bfa40c7640f85"],"pids":[{"scheme":"doi","value":"10.33790/jrpr1100207"}],"dateOfCollection":null,"lastUpdateTimeStamp":null,"indicators":{"citationImpact":{"citationCount":0.0,"influence":2.1746283E-9,"popularity":2.6085654E-9,"impulse":0.0,"citationClass":"C5","influenceClass":"C5","impulseClass":"C5","popularityClass":"C5"}},"projects":null,"organizations":null,"communities":null,"collectedFrom":[{"key":"openaire____::081b82f96300b6a6e3d282bad31cb6e2","value":"Crossref"}],"instances":[{"pids":[{"scheme":"doi","value":"10.33790/jrpr1100207"}],"license":"CC BY","accessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/","openAccessRoute":"hybrid"},"type":"Article","urls":["https://doi.org/10.33790/jrpr1100207"],"publicationDate":"2026-06-01","refereed":"peerReviewed","hostedBy":{"key":"issn__online::d05622ee9319fabc3ea0b9c1d012966c","value":"Journal of Rehabilitation Practices and Research"},"collectedFrom":{"key":"openaire____::081b82f96300b6a6e3d282bad31cb6e2","value":"Crossref"}}],"links":null,"otherTitles":null,"inDiamondJournal":null,"green":null,"isGreen":null,"isInDiamondJournal":null},{"authors":[{"id":"orcid_______::0298c377b3d363aa9d6ca25c231dea47","fullName":"Sebastian Ludyga","name":"Sebastian","surname":"Ludyga","rank":1,"pid":{"id":{"scheme":"orcid","value":"0000-0002-3905-7894"},"provenance":null}},{"id":null,"fullName":"Markus Gerber","name":"Markus","surname":"Gerber","rank":2,"pid":null},{"id":null,"fullName":"Keita Kamijo","name":"Keita","surname":"Kamijo","rank":3,"pid":null}],"openAccessColor":null,"publiclyFunded":false,"eoscIfGuidelines":null,"type":"publication","language":{"code":"eng","label":"English"},"countries":null,"subjects":[{"subject":{"scheme":"FOS","value":"03 medical and health sciences"},"provenance":null},{"subject":{"scheme":"FOS","value":"0302 clinical medicine"},"provenance":null},{"subject":{"scheme":"keyword","value":"Cognition"},"provenance":null},{"subject":{"scheme":"keyword","value":"Memory, Short-Term"},"provenance":null},{"subject":{"scheme":"keyword","value":"Adolescent"},"provenance":null},{"subject":{"scheme":"FOS","value":"05 social sciences"},"provenance":null},{"subject":{"scheme":"keyword","value":"Humans"},"provenance":null},{"subject":{"scheme":"keyword","value":"Learning"},"provenance":null},{"subject":{"scheme":"FOS","value":"0501 psychology and cognitive sciences"},"provenance":null},{"subject":{"scheme":"keyword","value":"Child"},"provenance":null},{"subject":{"scheme":"keyword","value":"Exercise"},"provenance":null},{"subject":{"scheme":"keyword","value":"Exercise Therapy"},"provenance":null}],"mainTitle":"Exercise types and working memory components during development","subTitle":null,"descriptions":["Working memory is crucial to learning and academic success. Exercise has been found to benefit working memory in late life, but its effects during cognitive development are less clear. Building on findings that working memory is supported by the motor system, we highlight the sensitivity of different working memory components to acute and long-term exercise in children and adolescents. We also consider how the specific skill demands of endurance and coordinative exercise influence this sensitivity. Distinct effects of these exercise types are further linked with neurocognitive and neuroendocrine pathways. Our review suggests long-term rather than acute benefits of exercise for children and adolescents' working memory, which are more pronounced and specific for exercise with high coordinative demands."],"publicationDate":"2022-03-01","publisher":"Elsevier BV","embargoEndDate":null,"sources":["Crossref"],"formats":null,"contributors":null,"coverages":null,"bestAccessRight":{"code":"c_14cb","label":"CLOSED","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/"},"container":{"name":"Trends in Cognitive Sciences","issnPrinted":"1364-6613","issnOnline":null,"issnLinking":null,"ep":"203","iss":null,"sp":"191","vol":"26","edition":null,"conferencePlace":null,"conferenceDate":null},"documentationUrls":null,"codeRepositoryUrl":null,"programmingLanguage":null,"contactPeople":null,"contactGroups":null,"tools":null,"size":null,"version":null,"geoLocations":null,"id":"doi_dedup___::f5aa98c5f65d5a5483b947c54c5f9106","originalIds":["S1364661321003120","10.1016/j.tics.2021.12.004","50|doiboost____|f5aa98c5f65d5a5483b947c54c5f9106","35031211"],"pids":[{"scheme":"doi","value":"10.1016/j.tics.2021.12.004"},{"scheme":"pmid","value":"35031211"}],"dateOfCollection":null,"lastUpdateTimeStamp":null,"indicators":{"citationImpact":{"citationCount":72.0,"influence":3.8601713E-9,"popularity":4.9089543E-8,"impulse":63.0,"citationClass":"C4","influenceClass":"C4","impulseClass":"C3","popularityClass":"C3"}},"projects":null,"organizations":[{"legalName":"University of Basel","acronym":"UNIBAS","id":"openorgs____::a5124687d06ee9348a73a7dcfba96ec7","pids":[{"scheme":"fundref","value":"501100008595"},{"scheme":"wikidata","value":"Q372608"},{"scheme":"OrgReg","value":"CH0001"},{"scheme":"RRID","value":"RRID:nlx_24036"},{"scheme":"fundref","value":"100008375"},{"scheme":"Wikidata","value":"Q372608"},{"scheme":"FundRef","value":"100008375"},{"scheme":"OrgRef","value":"427614"},{"scheme":"GRID","value":"grid.509969.a"},{"scheme":"PIC","value":"998079658"},{"scheme":"Wikidata","value":"Q22387380"},{"scheme":"ROR","value":"https://ror.org/03ybx0x41"},{"scheme":"FundRef","value":"100008550"},{"scheme":"FundRef","value":"100018710"},{"scheme":"FundRef","value":"501100008595"},{"scheme":"ISNI","value":"0000000419370642"},{"scheme":"RRID","value":"RRID:SCR_002699"},{"scheme":"ROR","value":"https://ror.org/02s6k3f65"},{"scheme":"wikidata","value":"Q22387380"},{"scheme":"PIC","value":"999907914"},{"scheme":"fundref","value":"100018710"},{"scheme":"GRID","value":"grid.6612.3"},{"scheme":"mag_id","value":"1850255"}],"countries":[{"code":"CH","label":"Switzerland"}],"websiteurl":"https://www.unibas.ch/de"},{"legalName":"Chukyo University","acronym":"Chukyo University","id":"openorgs____::8a9da966b6a7e5d06a5579f757ea6d22","pids":[{"scheme":"GRID","value":"grid.411620.0"},{"scheme":"fundref","value":"100017481"},{"scheme":"wikidata","value":"Q3083225"},{"scheme":"ROR","value":"https://ror.org/04ajrmg05"},{"scheme":"FundRef","value":"100017481"},{"scheme":"Wikidata","value":"Q3083225"},{"scheme":"OrgRef","value":"2134478"},{"scheme":"ISNI","value":"000000010018125X"},{"scheme":"mag_id","value":"98940699"}],"countries":[{"code":"JP","label":"Japan"}],"websiteurl":"http://www.chukyo-u.ac.jp/english/"}],"communities":[{"code":"neuroscience","label":"Neuroscience","provenance":null}],"collectedFrom":[{"key":"openaire____::081b82f96300b6a6e3d282bad31cb6e2","value":"Crossref"},{"key":"opendoar____::8b6dd7db9af49e67306feb59a8bdc52c","value":"Europe PubMed Central"}],"instances":[{"pids":[{"scheme":"doi","value":"10.1016/j.tics.2021.12.004"}],"license":"Elsevier TDM","accessRight":{"code":"c_14cb","label":"CLOSED","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/","openAccessRoute":null},"type":"Article","urls":["https://doi.org/10.1016/j.tics.2021.12.004"],"publicationDate":"2022-03-01","refereed":"peerReviewed","hostedBy":{"key":"issn___print::5d48035bfc1cfff0958b15c8b1dce41e","value":"Trends in Cognitive Sciences"},"collectedFrom":{"key":"openaire____::081b82f96300b6a6e3d282bad31cb6e2","value":"Crossref"}},{"pids":[{"scheme":"pmid","value":"35031211"}],"alternateIdentifiers":[{"scheme":"doi","value":"10.1016/j.tics.2021.12.004"}],"type":"Article","urls":["https://pubmed.ncbi.nlm.nih.gov/35031211"],"publicationDate":"2022-04-05","refereed":"nonPeerReviewed","hostedBy":{"key":"openaire____::55045bd2a65019fd8e6741a755395c8c","value":"Unknown Repository"},"collectedFrom":{"key":"opendoar____::8b6dd7db9af49e67306feb59a8bdc52c","value":"Europe PubMed Central"}}],"links":[],"otherTitles":null,"inDiamondJournal":false,"green":false,"isGreen":false,"isInDiamondJournal":false},{"authors":[{"id":null,"fullName":"Paul Loprinzi","name":"Paul","surname":"Loprinzi","rank":1,"pid":{"id":{"scheme":"orcid_pending","value":"0000-0001-7711-4741"},"provenance":null}},{"id":"orcid_______::c8de0066dcfd353d1dce1bf5809135aa","fullName":"Amir-Homayoun Javadi","name":"Amir-Homayoun","surname":"Javadi","rank":2,"pid":{"id":{"scheme":"orcid","value":"0000-0003-0569-6441"},"provenance":null}},{"id":null,"fullName":"Myungjin Jung","name":"Myungjin","surname":"Jung","rank":3,"pid":null},{"id":null,"fullName":"Hanna Watson","name":"Hanna","surname":"Watson","rank":4,"pid":null},{"id":null,"fullName":"Claire Sanderson","name":"Claire","surname":"Sanderson","rank":5,"pid":null},{"id":"orcid_______::21821099dfcf15868ea34c46857d092d","fullName":"Minsoo Kang","name":"Minsoo","surname":"Kang","rank":6,"pid":{"id":{"scheme":"orcid","value":"0000-0002-9225-1004"},"provenance":null}},{"id":"orcid_______::0f50627bdf0b88611c9f718e72b36bd5","fullName":"William L. Kelemen","name":"William L.","surname":"Kelemen","rank":7,"pid":{"id":{"scheme":"orcid","value":"0000-0002-3965-1025"},"provenance":null}}],"openAccessColor":null,"publiclyFunded":false,"eoscIfGuidelines":null,"type":"publication","language":{"code":"eng","label":"English"},"countries":null,"subjects":[{"subject":{"scheme":"FOS","value":"03 medical and health sciences"},"provenance":null},{"subject":{"scheme":"keyword","value":"H"},"provenance":null},{"subject":{"scheme":"FOS","value":"0302 clinical medicine"},"provenance":null},{"subject":{"scheme":"keyword","value":"Memory, Long-Term"},"provenance":null},{"subject":{"scheme":"keyword","value":"Memory"},"provenance":null},{"subject":{"scheme":"keyword","value":"Memory, Episodic"},"provenance":null},{"subject":{"scheme":"FOS","value":"05 social sciences"},"provenance":null},{"subject":{"scheme":"keyword","value":"Mental Recall"},"provenance":null},{"subject":{"scheme":"keyword","value":"Humans"},"provenance":null},{"subject":{"scheme":"FOS","value":"0501 psychology and cognitive sciences"},"provenance":null},{"subject":{"scheme":"keyword","value":"Recognition, Psychology"},"provenance":null},{"subject":{"scheme":"keyword","value":"Exercise"},"provenance":null}],"mainTitle":"Vigorous-intensity acute exercise during encoding can reduce levels of episodic and false memory","subTitle":null,"descriptions":["The potential benefits (veridical memory) and, importantly, costs (false memory) of acute exercise on memory in conjunction with the timing and type of exercise have not been fully studied. In Experiment 1, we employed a three-condition (15-minute vigorous-intensity acute exercise Before or During memory encoding, or a Control condition of watching a video), within-subjects, counterbalanced design. The procedures included an immediate and delayed (20-minute post encoding) free recall assessment. Veridical memory was determined by the number of studied words that were recalled, whereas false memory was determined by retrieving a non-presented, critical item. For veridical memory, Before was not different than Control (p = .42), however, During was worse than Before and Control (p's < .001). No differences occurred for false memory. Experiment 2 was conducted that included several additional exercise conditions (e.g., light-intensity exercise) during memory encoding, used a recognition task instead of a free recall task, and extended the long-term memory assessment out to 24-hours. Experiment 2 demonstrated that vigorous-intensity acute exercise during encoding reduced both veridical and false memory for related new items (p < .05). These findings demonstrate that the timing and intensity of exercise play an important role in influencing memory performance."],"publicationDate":"2022-05-06","publisher":"Informa UK Limited","embargoEndDate":null,"sources":["Crossref","0965-8211"],"formats":["application/pdf"],"contributors":null,"coverages":null,"bestAccessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/"},"container":{"name":"Memory","issnPrinted":"0965-8211","issnOnline":"1464-0686","issnLinking":null,"ep":"1045","iss":null,"sp":"1031","vol":"30","edition":null,"conferencePlace":null,"conferenceDate":null},"documentationUrls":null,"codeRepositoryUrl":null,"programmingLanguage":null,"contactPeople":null,"contactGroups":null,"tools":null,"size":null,"version":null,"geoLocations":null,"id":"doi_dedup___::1da05bf4ba3ff9ab2e5f38fd5002f89d","originalIds":["10.1080/09658211.2022.2072895","50|doiboost____|1da05bf4ba3ff9ab2e5f38fd5002f89d","35522241","oai