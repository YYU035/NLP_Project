d Central"}],"instances":[{"pids":[{"scheme":"doi","value":"10.34172/hpp.2020.20"}],"accessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/","openAccessRoute":"gold"},"type":"Article","urls":["https://doi.org/10.34172/hpp.2020.20"],"publicationDate":"2020-03-30","refereed":"peerReviewed","hostedBy":{"key":"doajarticles::b23936ceb2d66dcac65b6738c7446cce","value":"Health Promotion Perspectives"},"collectedFrom":{"key":"openaire____::081b82f96300b6a6e3d282bad31cb6e2","value":"Crossref"}},{"pids":[{"scheme":"doi","value":"10.34172/hpp.2020.20"}],"license":"CC BY","accessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/","openAccessRoute":"gold"},"type":"Article","urls":["https://hpp.tbzmed.ac.ir/PDF/hpp-10-123.pdf"],"refereed":"nonPeerReviewed","hostedBy":{"key":"doajarticles::b23936ceb2d66dcac65b6738c7446cce","value":"Health Promotion Perspectives"},"collectedFrom":{"key":"openaire____::8ac8380272269217cb09a928c8caa993","value":"UnpayWall"}},{"pids":[{"scheme":"pmid","value":"32296624"},{"scheme":"pmc","value":"PMC7146046"}],"alternateIdentifiers":[{"scheme":"doi","value":"10.34172/hpp.2020.20"}],"accessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/","openAccessRoute":"gold"},"type":"Article","urls":["https://pubmed.ncbi.nlm.nih.gov/32296624"],"refereed":"nonPeerReviewed","hostedBy":{"key":"doajarticles::b23936ceb2d66dcac65b6738c7446cce","value":"Health Promotion Perspectives"},"collectedFrom":{"key":"opendoar____::8b6dd7db9af49e67306feb59a8bdc52c","value":"Europe PubMed Central"}},{"alternateIdentifiers":[{"scheme":"doi","value":"10.34172/hpp.2020.20"}],"license":"CC BY","accessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/","openAccessRoute":null},"type":"Article","urls":["http://dx.do