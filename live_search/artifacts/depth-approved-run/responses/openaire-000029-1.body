___::8b6dd7db9af49e67306feb59a8bdc52c","value":"Europe PubMed Central"}],"instances":[{"pids":[{"scheme":"doi","value":"10.1016/j.jsams.2024.10.011"}],"license":"CC BY NC ND","accessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/","openAccessRoute":"hybrid"},"type":"Article","urls":["https://doi.org/10.1016/j.jsams.2024.10.011"],"publicationDate":"2025-03-01","refereed":"peerReviewed","hostedBy":{"key":"issn___print::107fbb7f1e75532a493d835cb60d1f43","value":"Journal of Science and Medicine in Sport"},"collectedFrom":{"key":"openaire____::081b82f96300b6a6e3d282bad31cb6e2","value":"Crossref"}},{"pids":[{"scheme":"pmid","value":"39572311"}],"alternateIdentifiers":[{"scheme":"doi","value":"10.1016/j.jsams.2024.10.011"}],"type":"Article","urls":["https://pubmed.ncbi.nlm.nih.gov/39572311"],"publicationDate":"2025-03-07","refereed":"nonPeerReviewed","hostedBy":{"key":"openaire____::55045bd2a65019fd8e6741a755395c8c","value":"Unknown Repository"},"collectedFrom":{"key":"opendoar____::8b6dd7db9af49e67306feb59a8bdc52c","value":"Europe PubMed Central"}}],"links":[],"otherTitles":null,"inDiamondJournal":false,"green":false,"isGreen":false,"isInDiamondJournal":false},{"authors":[{"id":null,"fullName":"Paul Loprinzi","name":"Paul","surname":"Loprinzi","rank":1,"pid":null},{"id":null,"fullName":"Danielle Olafson","name":"Danielle","surname":"Olafson","rank":2,"pid":null},{"id":null,"fullName":"Claire Scavuzzo","name":"Claire","surname":"Scavuzzo","rank":3,"pid":null},{"id":null,"fullName":"Ashley Lovorn","name":"Ashley","surname":"Lovorn","rank":4,"pid":null},{"id":null,"fullName":"Mara Mather","name":"Mara","surname":"Mather","rank":5,"pid":null},{"id":"orcid_______::cbd4f103c836979d790146e2bc7e10e9","fullName":"Emily Frith","name":"Emily","surname":"Frith","rank":6,"pid":{"id":{"scheme":"orcid","value":"0000-0002-5205-943x"},"provenance":null}},{"id":"orcid_______::39bff8b321214516dd8579772059df0c","fullName":"Esther Fujiwara","name":"Esther","surname":"Fujiwara","rank":7,"pid":{"id":{"scheme":"orcid","value":"0000-0003-4154-0145"},"provenance":null}}],"openAccessColor":null,"publiclyFunded":false,"eoscIfGuidelines":null,"type":"publication","language":{"code":"eng","label":"English"},"countries":null,"subjects":[{"subject":{"scheme":"FOS","value":"03 medical and health sciences"},"provenance":null},{"subject":{"scheme":"FOS","value":"0302 clinical medicine"},"provenance":null},{"subject":{"scheme":"FOS","value":"05 social sciences"},"provenance":null},{"subject":{"scheme":"keyword","value":"Emotions"},"provenance":null},{"subject":{"scheme":"keyword","value":"Mental Recall"},"provenance":null},{"subject":{"scheme":"keyword","value":"Humans"},"provenance":null},{"subject":{"scheme":"FOS","value":"0501 psychology and cognitive sciences"},"provenance":null},{"subject":{"scheme":"keyword","value":"Recognition, Psychology"},"provenance":null},{"subject":{"scheme":"keyword","value":"Arousal"},"provenance":null},{"subject":{"scheme":"keyword","value":"Exercise"},"provenance":null}],"mainTitle":"Effects of acute exercise on emotional memory","subTitle":null,"descriptions":["Research has demonstrated beneficial effects of acute exercise on memory for neutral materials, such as word lists of neutral valence/low arousal. However, the impacts of exercise on emotional memory is less understood. Across three laboratory experiments in college students, we tested if acute exercise could enhance both neutral and emotional memory performance, anticipating a greater effect for emotional memory. We examined effects of exercise at varying intensities (Experiment 1: high-intensity; Experiment 2: low- and high-intensity; Experiment 3: moderate-intensity), of diverse modalities (Experiment 1: treadmill jogging; Experiment 2: cycling; Experiment 3: open-skill (racquetball) and closed-skill (treadmill jogging) exercise), and on emotional memory performance assessed at increasing levels of hippocampal dependency (Experiment 1: Y/N recognition task; Experiment 2: paired-associative recognition task; Experiment 3: cued-recall task). We found that, in all experiments, acute exercise did not significantly influence emotional or neutral memory performance relative to sedentary control conditions. However, we observed several noteworthy outcomes indicating that acute exercise may be linked to improvements in memory confidence and accuracy for central aspects of emotional memory stimuli, and that select exercise modalities (e.g. treadmill exercise) may also be associated with increased frequency of memory intrusions."],"publicationDate":"2022-03-16","publisher":"Informa UK Limited","embargoEndDate":null,"sources":["Crossref"],"formats":null,"contributors":null,"coverages":null,"bestAccessRight":null,"container":{"name":"Cognition and Emotion","issnPrinted":"0269-9931","issnOnline":"1464-0600","issnLinking":null,"ep":"689","iss":null,"sp":"660","vol":"36","edition":null,"conferencePlace":null,"conferenceDate":null},"documentationUrls":null,"codeRepositoryUrl":null,"programmingLanguage":null,"contactPeople":null,"contactGroups":null,"tools":null,"size":null,"version":null,"geoLocations":null,"id":"doi_dedup___::dea4f09a63cebd1e2dd01b0489aa6966","originalIds":["10.1080/02699931.2022.2050890","50|doiboost____|dea4f09a63cebd1e2dd01b0489aa6966","od_______267::bb1d833e918ff92605ada4694e99d28f","35293844","PMC10278038"],"pids":[{"scheme":"doi","value":"10.1080/02699931.2022.2050890"},{"scheme":"pmid","value":"35293844"},{"scheme":"pmc","value":"PMC10278038"}],"dateOfCollection":null,"lastUpdateTimeStamp":null,"indicators":{"citationImpact":{"citationCount":8.0,"influence":2.3124478E-9,"popularity":6.565465E-9,"impulse":5.0,"citationClass":"C5","influenceClass":"C5","impulseClass":"C4","popularityClass":"C4"}},"projects":null,"organizations":[{"legalName":"UNIVERSITY OF SOUTHERN CALIFORNIA","acronym":"UNIV. S. CALIF. ISI","id":"pending_org_::a96641377fb0460b5e1de690b7c5b