7"},{"scheme":"Wikidata","value":"Q5588977"},{"scheme":"GRID","value":"grid.413228.e"},{"scheme":"wikidata","value":"Q5588977"}],"countries":[{"code":"IN","label":"India"}],"websiteurl":"http://www.gmcaurangabad.com/home.html"}],"communities":null,"collectedFrom":[{"key":"driver______::bee53aa31dc2cbb538c10c2b65fa5824","value":"DOAJ"},{"key":"openaire____::081b82f96300b6a6e3d282bad31cb6e2","value":"Crossref"}],"instances":[{"pids":[{"scheme":"doi","value":"10.3126/ajms.v13i6.42052"}],"license":"CC BY NC","accessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/","openAccessRoute":"gold"},"type":"Article","urls":["https://doi.org/10.3126/ajms.v13i6.42052"],"publicationDate":"2022-06-01","refereed":"peerReviewed","hostedBy":{"key":"doajarticles::673ce7f9046310545304642518b52736","value":"Asian Journal of Medical Sciences"},"collectedFrom":{"key":"openaire____::081b82f96300b6a6e3d282bad31cb6e2","value":"Crossref"}},{"alternateIdentifiers":[{"scheme":"doi","value":"10.3126/ajms.v13i6.42052"}],"accessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/","openAccessRoute":null},"type":"Article","urls":["https://doaj.org/article/b1b4ebc6a6de4fceb7dc3c18d1651b93","https://doi.org/10.3126/ajms.v13i6.42052"],"publicationDate":"2022-06-01","refereed":"nonPeerReviewed","hostedBy":{"key":"openaire____::55045bd2a65019fd8e6741a755395c8c","value":"Unknown Repository"},"collectedFrom":{"key":"driver______::bee53aa31dc2cbb538c10c2b65fa5824","value":"DOAJ"}}],"links":[],"otherTitles":null,"inDiamondJournal":false,"green":false,"isGreen":false,"isInDiamondJournal":false},{"authors":[{"id":"orcid_______::61c851f886adbfd684d14288478feecb","fullName":"Ananya Jain","name":"Ananya","surname":"Jain","rank":1,"pid":{"id":{"scheme":"orcid","value":"0009-0007-1870-9164"},"provenance":null}}],"openAccessColor":"gold","publiclyFunded":false,"eoscIfGuidelines":null,"type":"publication","language":{"code":"und","label":"Undetermined"},"countries":null,"subjects":[{"subject":{"scheme":"FOS","value":"03 medical and health sciences"},"provenance":null},{"subject":{"scheme":"FOS","value":"0302 clinical medicine"},"provenance":null},{"subject":{"scheme":"SDG","value":"3. Good health"},"provenance":null}],"mainTitle":"Mechanisms Underlying Exercise-Induced BDNF Stimulated Memory Improvements in Rodents","subTitle":null,"descriptions":["<jats:p>Introduction: Increases in Brain-Derived Neurotrophic Factor (BDNF), are known to be associated with improvements in memory and can be increased by exercise. This suggests that these memory improvements could be induced from exercise associated increases in BDNF in key memory related areas of the brain such as the hippocampus. However, the underlying neurobiology outlining how exercise may affect memory remains elusive. Thus, the focus of this review is to understand the relationship between exercise induced increases in BDNF and memory improvements, and to identify potential pathways of activation that may induce these effects. Methods: An in-depth literature review was performed to analyze the mechanisms of memory involving exercise induced increases of BDNF in rodents. Both primary and review articles were used, found through Google Scholar, PubMed, and the George Washington University Gelman Library databases, and were found using search terms that included exercise, memory, rodents, and BDNF. Results: Pathways found to be potentially involved in this mechanism include the TrkB ERK1 pathway, TrkB activation of β-CaMKII, PI3-K and MAPK pathways, and the BDNF/TrkB/SYN pathway, with the SIRT1/PGC1a/FNDC5 pathway being a potential upstream pathway to induce BDNF activity. It was also found that exercise induced BDNF increases can recover memory impairments in different neurodegenerative states, such as in rodent models of Alzheimer’s disease and Down syndrome. Discussion: The collected studies demonstrate that exercise induced increases in BDNF expression are related to improved memory at least partially due to increased BDNF expression in memory associated brain regions, such as the hippocampus. The underlying neurobiology is still unclear, although potential pathways for this mechanism have been identified. Conclusion: These results of this review expose avenues of research to better understand the underlying neurobiology of exercise enhanced BDNF effects on memory improvements. The identified link between exercise and memory improvements via exercise induced BDNF increases can be potentially applied and used for future investigations into clinical therapeutic treatments for improving memory through exercise.</jats:p>"],"publicationDate":"2021-09-10","publisher":"Undergraduate Research in Natural and Clinical Science and Technology (URNCST) Journal","embargoEndDate":null,"sources":["Crossref"],"formats":null,"contributors":null,"coverages":null,"bestAccessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/"},"container":{"name":"Undergraduate Research in Natural and Clinical Science and Technology Journal","issnPrinted":null,"issnOnline":"2561-5637","issnLinking":null,"ep":"7","iss":null,"sp":"1","vol":"5","edition":null,"conferencePlace":null,"conferenceDate":null},"documentationUrls":null,"codeRepositoryUrl":null,"programmingLanguage":null,"contactPeople":null,"contactGroups":null,"tools":null,"size":null,"version":null,"geoLocations":null,"id":"doi_dedup___::134c1ce0aec1312f01e7c4789a103772","originalIds":["10.26685/urncst.298","50|doiboost____|134c1ce0aec1312f01e7c4789a103772","3201543307"],"pids":[{"scheme":"doi","value":"10.26685/urncst.298"}],"dateOfCollection":null,"lastUpdateTimeStamp":null,"indicators":{"citationImpact":{"citationCount":2.0,"influence":2.2393658E-9,"popularity":2.5508262E-9,"impulse":1.0,"citationClass":"C5","influenceClass":"C5","impulseClass":"C5","popularityClass":"C5"}},"projects":null,"organizations":[{"legalName":"George Washington University","acronym":"GWU","id":"openorgs____::6826d6fe825462bcc65f365b6701bda5","pids":[{"scheme":"fundref","value":"100008449"},{"scheme":"fundref","value":"100007815"},{"scheme":"mag_id","value":"193531525"},{"scheme":"wikidata","value":"Q432637"},{"scheme":"GRID","value":"grid.253615.6"},{"scheme":"FundRef","value":"100007108"},{"scheme":"ISNI","value":"0000000419369510"},{"scheme":"FundRef","value":"100005905"},{"scheme":"FundRef","value":"100007815"},{"scheme":"FundRef","value":"100015466"},{"scheme":"GRID","value":"grid.448864.2"},{"scheme":"FundRef","value":"100019659"},{"scheme":"OrgRef","value":"268451"},{"scheme":"fundref","value":"100015466"},{"scheme":"Wikidata","value":"Q432637"},{"scheme":"ROR","value":"https://ror.org/00y4zzh67"},{"scheme":"OrgRef","value":"22065131"},{"scheme":"fundref","value":"100007108"},{"scheme":"fundref","value":"100005905"},{"scheme":"FundRef","value":"100008449"},{"scheme":"OrgRef","value":"1878671"},{"scheme":"mag_id","value":"865166595"},{"scheme":"fundref","value":"100019659"},{"scheme":"fundref","value":"100014746"},{"scheme":"FundRef","value":"100014746"}],"countries":[{"code":"US","label":"United States"}],"websiteurl":"http://www.gwu.edu/"},{"legalName":"Florida State University College of Arts and Sciences","acronym":"Florida State University College of Arts and Sciences","id":"pending_org_::51dc76eb2b72638e6dfaf16a68d45ee8","pids":[{"scheme":"mag_id","value":"182273258"}],"countries":[{"code":"US","label":"United States"}],"websiteurl":"http://artsandsciences.fsu.edu/"}],"communities":null,"collectedFrom":[{"key":"openaire____::8ac8380272269217cb09a928c8caa993","value":"UnpayWall"},{"key":"openaire____::081b82f96300b6a6e3d282bad31cb6e2","value":"Crossref"},{"key":"openaire____::5f532a3fc4f1ea403f37070f59a7a53a","value":"Microsoft Academic Graph"}],"instances":[{"pids":[{"scheme":"doi","value":"10.26685/urncst.298"}],"license":"CC BY","accessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/","openAccessRoute":"gold"},"type":"Article","urls":["https://doi.org/10.26685/urncst.298"],"publicationDate":"2021-09-10","refereed":"peerReviewed","hostedBy":{"key":"issn__online::28cedbffb4ed0abec1066d9f436c045d","value":"Undergraduate Research in Natural and Clinical Science and Technology Journal"},"collectedFrom":{"key":"openaire____::081b82f96300b6a6e3d282bad31cb6e2","value":"Crossref"}},{"pids":[{"scheme":"doi","value":"10.26685/urncst.298"}],"license":"CC BY","accessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/","openAccessRoute":"gold"},"type":"Article","urls":["https://urncst.com/index.php/urncst/article/download/298/129"],"refereed":"nonPeerReviewed","hostedBy":{"key":"issn__online::28cedbffb4ed0abec1066d9f436c045d","value":"Undergraduate Research in Natural and Clinical Science and Technology Journal"},"collectedFrom":{"key":"openaire____::8ac8380272269217cb09a928c8caa993","value":"UnpayWall"}},{"alternateIdentifiers":[{"scheme":"doi","value":"10.26685/urncst.298"},{"scheme":"mag_id","value":"3201543307"}],"type":"Other literature type","urls":["https://dx.doi.org/10.26685/urncst.298"],"refereed":"nonPeerReviewed","hostedBy":{"key":"openaire____::55045bd2a65019fd8e6741a755395c8c","value":"Unknown Repository"},"collectedFrom":{"key":"openaire____::5f532a3fc4f1ea403f37070f59a7a53a","value":"Microsoft Academic Graph"}},{"alternateIdentifiers":[{"scheme":"mag_id","value":"3201543307"},{"scheme":"doi","value":"10.26685/urncst.298"}],"type":"Other literature type","urls":["https://dx.doi.org/10.26685/urncst.298"],"refereed":"nonPeerReviewed","hostedBy":{"key":"openaire____::55045bd2a65019fd8e6741a755395c8c","value":"Unknown Repository"},"collectedFrom":{"key":"openaire____::5f532a3fc4f1ea403f37070f59a7a53a","value":"Microsoft Academic Graph"}}],"links":[],"otherTitles":null,"inDiamondJournal":false,"green":false,"isGreen":false,"isInDiamondJournal":false},{"authors":[{"id":null,"fullName":"Alexis B, Slutsky-Ganesh","name":"Alexis B","surname":"Slutsky-Ganesh","rank":1,"pid":null},{"id":"orcid_______::0ab9d4be151e398b7a2c3e0ccb468109","fullName":"Jennifer L, Etnier","name":"Jennifer L","surname":"Etnier","rank":2,"pid":{"id":{"scheme":"orcid","value":"0000-0002-3080-0565"},"provenance":null}},{"id":"orcid_______::c9cbebb2f0855db61e1f9f2c0056fd07","fullName":"Jeffrey D, Labban","name":"Jeffrey D","surname":"Labban","rank":3,"pid":{"id":{"scheme":"orcid","value":"0000-0002-3138-6925"},"provenance":null}}],"openAccessColor":null,"publiclyFunded":false,"eoscIfGuidelines":null,"type":"publication","language":{"code":"eng","label":"English"},"countries":null,"subjects":[{"subject":{"scheme":"FOS","value":"03 medical and health sciences"},"provenance":null},{"subject":{"scheme":"keyword","value":"Young Adult"},"provenance":null},{"subject":{"scheme":"FOS","value":"0302 clinical medicine"},"provenance":null},{"subject":{"scheme":"keyword","value":"Memory"},"provenance":null},{"subject":{"scheme":"FOS","value":"05 social sciences"},"provenance":null},{"subject":{"scheme":"keyword","value":"Mental Recall"},"provenance":null},{"subject":{"scheme":"keyword","value":"Humans"},"provenance":null},{"subject":{"scheme":"FOS","value":"0501 psychology and cognitive sciences"},"provenance":null},{"subject":{"scheme":"keyword","value":"Exercise"},"provenance":null},{"subject":{"scheme":"keyword","value":"Magnetic Resonance Imaging"},"provenance":null},{"subject":{"scheme":"keyword","value":"Temporal Lobe"},"provenance":null},{"subject":{"scheme":"SDG","value":"3. Good health"},"provenance":null}],"mainTitle":"Acute exercise, memory, and neural activation in young adults","subTitle":null,"descriptions":["Acute exercise benefits memory, and the temporal placement of exercise relative to exposure can affect the magnitude of benefits observed. Although the temporal placement appears to be important, there is a limited understanding as to how cognitive benefits in response to acute exercise are achieved. Hence, we conducted a two-part study including a behavioral study and a follow-up functional magnetic resonance imaging (fMRI) study to advance our understanding of the potential role of the effects of exercise on memory and neural activation. For Study One, we assessed the effect of acute exercise on memory in young adults. Participants were randomized to exercise before exposure for 20 min (before only, BO), after exposure for 20 min (After Only, AO), before and after exposure for 10 min at each time (before and after, BA), or to receive no exercise (No-exercise Control, NC). Similar to previous findings, any exercise prior to exposure (BO, BA) benefited some aspects of memory performance. Interestingly, the more consistent and larger benefits were seen with a shorter duration of exercise both before and after exposure (BA). Study Two replicated the methods of Study One comparing the BA condition (which had the most robust benefits) to the NC condition while collecting fMRI data during the memory task. Analyses assessed condition differences of activation during encoding and recall. There were no condition differences during memory encoding, however there was a condition effect on activation in occipito-temporal regions during the memory recall trials. Consistent with previous research, exercise appears to benefit memory with some exercise prior to exposure being important for the benefits achieved. Further, exercise affects neural activation and the results appear complementary to the behavior findings. Future research should use a within-subjects design to control for heterogeneity in behavior and neural activation."],"publicationDate":"2020-12-01","publisher":"Elsevier BV","embargoEndDate":null,"sources":["Crossref"],"formats":null,"contributors":null,"coverages":null,"bestAccessRight":{"code":"c_14cb","label":"CLOSED","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/"},"container":{"name":"International Journal of Psychophysiology","issnPrinted":"0167-8760","issnOnline":null,"issnLinking":null,"ep":"309","iss":null,"sp":"299","vol":"158","edition":null,"conferencePlace":null,"conferenceDate":null},"documentationUrls":null,"codeRepositoryUrl":null,"programmingLanguage":null,"contactPeople":null,"contactGroups":null,"tools":null,"size":null,"version":null,"geoLocations":null,"id":"doi_dedup___::dada2a914fe3c89835f9f230ef7ef6c8","originalIds":["S0167876020302464","10.1016/j.ijpsycho.2020.09.018","50|doiboost____|dada2a914fe3c89835f9f230ef7ef6c8","33164850","3093890694"],"pids":[{"scheme":"doi","value":"10.1016/j.ijpsycho.2020.09.018"},{"scheme":"pmid","value":"33164850"}],"dateOfCollection":null,"lastUpdateTimeStamp":null,"indicators":{"citationImpact":{"citationCount":19.0,"influence":2.5928801E-9,"popularity":1.3606098E-8,"impulse":7.0,"citationClass":"C4","influenceClass":"C5","impulseClass":"C4","popularityClass":"C4"}},"projects":null,"organizations":[{"legalName":"University of North Carolina at Greensboro","acronym":"UNCG","id":"openorgs____::b33eff37f950338714c2d9120e353e5e","pids":[{"scheme":"ROR","value":"https://ror.org/04fnxsj42"},{"scheme":"OrgRef","value":"77958"},{"scheme":"GRID","value":"grid.266860.c"},{"scheme":"mag_id","value":"169335092"},{"scheme":"Wikidata","value":"Q1321380"},{"scheme":"ISNI","value":"000000010671255X"}],"countries":[{"code":"US","label":"United States"}],"websiteurl":"https://www.uncg.edu/"},{"legalName":"University of North Carolina at Chapel Hill","acronym":"UNC","id":"openorgs____::0598c13eee48e349298faf6960fb8d4f","pids":[{"scheme":"Wikidata","value":"Q192334"},{"scheme":"fundref","value":"100017079"},{"scheme":"FundRef","value":"100005539"},{"scheme":"OrgRef","value":"89510"},{"scheme":"fundref","value":"100005539"},{"scheme":"FundRef","value":"100016294"},{"scheme":"fundref","value":"10000559