inst-2020"},"level1":{"id":null,"description":null,"name":null},"level2":{"id":null,"description":null,"name":null}},"startDate":"2020-01-01","endDate":"2024-12-31"}],"otherTitles":null,"green":true,"inDiamondJournal":false,"isGreen":true,"isInDiamondJournal":false},{"authors":[{"id":"orcid_______::621867a53410325ac9b5d0851bae0705","fullName":"Nitya Ravi","name":"Nitya","surname":"Ravi","rank":1,"pid":{"id":{"scheme":"orcid","value":"0000-0002-4248-2840"},"provenance":null}},{"id":null,"fullName":"Kelly A. Douglass","name":"Kelly A.","surname":"Douglass","rank":2,"pid":{"id":{"scheme":"orcid_pending","value":"0000-0002-9540-546x"},"provenance":null}},{"id":"orcid_______::8cbe1ae423c3e1bd7e5716b87de9731e","fullName":"Regina Demina","name":"Regina","surname":"Demina","rank":3,"pid":{"id":{"scheme":"orcid","value":"0000-0002-7852-167x"},"provenance":null}}],"openAccessColor":"gold","publiclyFunded":false,"eoscIfGuidelines":null,"type":"publication","language":{"code":"und","label":"Undetermined"},"countries":null,"subjects":[{"subject":{"scheme":"keyword","value":"Galaxy dark matter halos"},"provenance":null},{"subject":{"scheme":"keyword","value":"QB460-466"},"provenance":null},{"subject":{"scheme":"keyword","value":"Galaxy dynamics"},"provenance":null},{"subject":{"scheme":"keyword","value":"Galaxy masses"},"provenance":null},{"subject":{"scheme":"keyword","value":"Astrophysics of Galaxies (astro-ph.GA)"},"provenance":null},{"subject":{"scheme":"FOS","value":"0103 physical sciences"},"provenance":null},{"subject":{"scheme":"keyword","value":"Galaxy rotation curves"},"provenance":null},{"subject":{"scheme":"keyword","value":"FOS: Physical sciences"},"provenance":null},{"subject":{"scheme":"keyword","value":"Astrophysics"},"provenance":null},{"subject":{"scheme":"FOS","value":"01 natural sciences"},"provenance":null},{"subject":{"scheme":"keyword","value":"Disk galaxies"},"provenance":null},{"subject":{"scheme":"keyword","value":"Astrophysics - Astrophysics of Galaxies"},"provenance":null},{"subject":{"scheme":"keyword","value":"Late-type galaxies"},"provenance":null}],"mainTitle":"A Full Accounting of the Visible Mass in SDSS MaNGA Disk Galaxies","subTitle":null,"descriptions":["<jats:title>Abstract</jats:title>                <jats:p>We present a study of the ratio of visible mass to total mass in spiral galaxies to better understand the relative amount of dark matter present in galaxies of different masses and evolutionary stages. Using the velocities of the H<jats:italic>α</jats:italic> emission line measured in spectroscopic observations from the Sloan Digital Sky Survey (SDSS) MaNGA Data Release 17 (DR 17), we evaluate the rotational velocity of over 5500 disk galaxies at their 90% elliptical Petrosian radii, <jats:italic>R</jats:italic>                   <jats:sub>90</jats:sub>. We compare this to the velocity expected from the total visible mass, which we compute from the stellar, H <jats:sc>i</jats:sc>, H<jats:sub>2</jats:sub>, and heavy metals and dust masses. H<jats:sub>2</jats:sub> mass measurements are available for only a small subset of galaxies observed in SDSS MaNGA DR17, so we derive a parameterization of the H<jats:sub>2</jats:sub> mass as a function of absolute magnitude in the <jats:italic>r</jats:italic> band using galaxies observed as part of SDSS DR7. With these parameterizations, we calculate the fraction of visible mass within <jats:italic>R</jats:italic>                   <jats:sub>90</jats:sub> that corresponds to the observed velocity. Based on statistically analyzing the likelihood of this fraction, we conclude that the null hypothesis (no dark matter) cannot be excluded at a confidence level better than 95% within the visible extent of the disk galaxies. We also find that when all mass components are included, the ratio of visible to total mass within the visible extent of star-forming disk galaxies increases with galaxy luminosity.</jats:p>"],"publicationDate":"2024-05-28","publisher":"American Astronomical Society","embargoEndDate":"2023-10-01","sources":["Crossref","The Astrophysical Journal, Vol 967, Iss 2, p 135 (2024)"],"formats":null,"contributors":null,"coverages":null,"bestAccessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/"},"container":{"name":"The Astrophysical Journal","issnPrinted":"0004-637X","issnOnline":"1538-4357","issnLinking":null,"ep":null,"iss":null,"sp":"135","vol":"967","edition":null,"conferencePlace":null,"conferenceDate":null},"documentationUrls":null,"codeRepositoryUrl":null,"programmingLanguage":null,"contactPeople":null,"contactGroups":null,"tools":null,"size":null,"version":null,"geoLocations":null,"id":"doi_dedup___::3dbda627dd236b421a890a7e738021de","originalIds":["10.3847/1538-4357/ad36c2","50|doiboost____|eb2f9c229733b23b4cba5e7a02f8e58b","50|datacite____::3dbda627dd236b421a890a7e738021de","10.48550/arxiv.2310.11422","oai:arXiv.org:2310.11422","50|od________18::75f3edb226d43446e0c1eb3fc7960fad","oai:doaj.org/article:fbc9c545e1494f86ad100f0ed8bc2dc5","50|doajarticles::a68802770266ffda721d3067fa0c91f4"],"pids":[{"scheme":"doi","value":"10.3847/1538-4357/ad36c2"},{"scheme":"doi","value":"10.48550/arxiv.2310.11422"},{"scheme":"arXiv","value":"2310.11422"}],"dateOfCollection":null,"lastUpdateTimeStamp":null,"indicators":{"citationImpact":{"citationCount":3.0,"influence":2.2231326E-9,"popularity":3.853206E-9,"impulse":3.0,"citationClass":"C5","influenceClass":"C5","impulseClass":"C5","popularityClass":"C4"}},"projects":null,"organizations":[{"legalName":"University of Rochester","acronym":"UR","id":"openorgs____::07cf0f86af976ed535d846745e4cbf7f","pids":[{"scheme":"GRID","value":"grid.419853.2"},{"scheme":"wikidata","value":"Q149990"},{"scheme":"Wikidata","value":"Q6983313"},{"scheme":"PIC","value":"999867562"},{"scheme":"fundref","value":"100008091"},{"scheme":"mag_id","value":"5388228"},{"scheme":"ROR","value":"https://ror.org/0224bx186"},{"scheme":"ROR","v