heme":"FundRef","value":"501100005705"},{"scheme":"fundref","value":"501100023913"},{"scheme":"FundRef","value":"501100000587"},{"scheme":"fundref","value":"501100000585"},{"scheme":"wikidata","value":"Q181892"},{"scheme":"OrgRef","value":"25978572"},{"scheme":"fundref","value":"501100000602"},{"scheme":"fundref","value":"501100000580"},{"scheme":"OrgRef","value":"48671"},{"scheme":"Wikidata","value":"Q181892"},{"scheme":"fundref","value":"501100006299"},{"scheme":"FundRef","value":"501100000648"},{"scheme":"FundRef","value":"501100000622"},{"scheme":"FundRef","value":"501100000585"},{"scheme":"FundRef","value":"501100016412"},{"scheme":"fundref","value":"501100007552"},{"scheme":"OrgRef","value":"75963"},{"scheme":"FundRef","value":"501100000621"},{"scheme":"OrgRef","value":"212179"}],"countries":[{"code":"GB","label":"United Kingdom"}],"websiteurl":"http://www.cam.ac.uk/"},{"legalName":"Cambridge University Press","acronym":"CUP","id":"openorgs____::92a4280028f8efb6cd0f2a778d09a2eb","pids":[{"scheme":"ROR","value":"https://ror.org/03jsdjx34"},{"scheme":"wikidata","value":"Q912887"},{"scheme":"ISNI","value":"0000000110880337"},{"scheme":"Wikidata","value":"Q912887"},{"scheme":"GRID","value":"grid.431478.d"}],"countries":[{"code":"GB","label":"United Kingdom"}],"websiteurl":"http://www.cambridge.org/"},{"legalName":"Shahid Beheshti University","acronym":"SBU","id":"openorgs____::4e7a193a2ea405eea82bb924cd0b7496","pids":[{"scheme":"ROR","value":"https://ror.org/0091vmj44"},{"scheme":"wikidata","value":"Q609586"},{"scheme":"wikidata","value":"Q4116835"},{"scheme":"mag_id","value":"48379061"},{"scheme":"FundRef","value":"100020481"},{"scheme":"OrgRef","value":"24665789"},{"scheme":"GRID","value":"grid.412502.0"},{"scheme":"Wikidata","value":"Q4116835"},{"scheme":"ISNI","value":"0000000106864748"},{"scheme":"OrgRef","value":"1248359"},{"scheme":"Wikidata","value":"Q609586"},{"scheme":"fundref","value":"100020481"}],"countries":[{"code":"IR","label":"Iran (Islamic Republic of)"}],"websiteurl":"http://en.sbu.ac.ir/sitepages/home.aspx"}],"communities":null,"collectedFrom":[{"key":"openaire____::9e3be59865b2c1c335d32dae2fe7b254","value":"Datacite"},{"key":"driver______::bee53aa31dc2cbb538c10c2b65fa5824","value":"DOAJ"},{"key":"openaire____::081b82f96300b6a6e3d282bad31cb6e2","value":"Crossref"},{"key":"opendoar____::6f4922f45568161a8cdf4ad2299f6d23","value":"arXiv.org e-Print Archive"}],"instances":[{"pids":[{"scheme":"doi","value":"10.3847/1538-4357/acb99b"}],"license":"CC BY","accessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/","openAccessRoute":"gold"},"type":"Article","urls":["https://doi.org/10.3847/1538-4357/acb99b"],"publicationDate":"2023-03-01","refereed":"peerReviewed","hostedBy":{"key":"doajarticles::f5c883d7dea7cfa40d9bf7581df67fde","value":"The Astrophysical Journal"},"collectedFrom":{"key":"openaire____::081b82f96300b6a6e3d282bad31cb6e2","value":"Crossref"}},{"pids":[{"scheme":"doi","value":"10.48550/arxiv.2205.09069"}],"license":"CC BY","type":"Article","urls":["https://dx.doi.org/10.48550/arxiv.2205.09069"],"publicationDate":"2022-01-01","refereed":"nonPeerReviewed","hostedBy":{"key":"openaire____::55045bd2a65019fd8e6741a755395c8c","value":"Unknown Repository"},"collectedFrom":{"key":"openaire____::9e3be59865b2c1c335d32dae2fe7b254","value":"Datacite"}},{"pids":[{"scheme":"arXiv","value":"2205.09069"}],"alternateIdentifiers":[{"scheme":"doi","value":"10.3847/1538-4357/acb99b"}],"accessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/","openAccessRoute":null},"type":"Preprint","urls":["http://arxiv.org/abs/2205.09069"],"publicationDate":"2022-05-18","refereed":"nonPeerReviewed","hostedBy":{"key":"opendoar____::6f4922f45568161a8cdf4ad2299f6d23","value":"arXiv.org e-Print Archive"},"collectedFrom":{"key":"opendoar____::6f4922f45568161a8cdf4ad2299f6d23","value":"arXiv.org e-Print Archive"}},{"alternateIdentifiers":[{"scheme":"doi","value":"10.3847/1538-4357/acb99b"}],"accessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/","openAccessRoute":"gold"},"type":"Article","urls":["https://doaj.org/article/f25705eaf47b454fa0f8f52a13e3ea48"],"publicationDate":"2023-01-01","refereed":"nonPeerReviewed","hostedBy":{"key":"doajarticles::f5c883d7dea7cfa40d9bf7581df67fde","value":"The Astrophysical Journal"},"collectedFrom":{"key":"driver______::bee53aa31dc2cbb538c10c2b65fa5824","value":"DOAJ"}}],"links":[],"otherTitles":null,"green":true,"inDiamondJournal":false,"isGreen":true,"isInDiamondJournal":false},{"authors":[{"id":null,"fullName":"Thierry, Seamus","name":"Seamus","surname":"Thierry","rank":1,"pid":{"id":{"scheme":"orcid_pending","value":"0000-0002-1900-9430"},"provenance":null}}],"openAccessColor":null,"publiclyFunded":false,"eoscIfGuidelines":null,"type":"publication","language":{"code":"und","label":"Undetermined"},"countries":null,"subjects":[{"subject":{"scheme":"FOS","value":"0103 physical sciences"},"provenance":null},{"subject":{"scheme":"FOS","value":"01 natural sciences"},"provenance":null}],"mainTitle":"The Gravitomagnetic Onion: Dual Precession in Rotating Axisymmetric Metrics and Its Implications for Galactic Dynamics and Local Cosmology","subTitle":null,"descriptions":["The Gravitomagnetic Onion: Dual Precession in Rotating Axisymmetric Metrics and Its Implications for Galactic Dynamics and Local Cosmology  Spiral galaxies exhibit flat rotation curves, kinematic asymmetries, warps, and excess vertical velocity dispersion, features traditionally attributed to dark matter. We propose that these phenomena arise from dual (azimuthal and vertical) gravitomagnetic precession in thick, differentially rotating disks within a time-dependent axisymmetric metric — the Gravitomagnetic Onion. By integrating the median gravitational potential along null geodesics (rather than the density-weighted mean) and accounting for the evolution of the gravitomagnetic field over the photon light-crossing timescale (∼105 \\sim 10^5 ∼105 yr), the model reproduces the observed rotation curves of NGC 3198 and the Milky Way with reduced χ2≈0.9 \\chi^2 \\approx 0.9 χ2≈0.9, using only the observed baryonic distribution. The same mechanism implies that the Milky Way itself acts as a gravitomagnetic self-lensing foreground, introducing a direction-dependent bias of ∼1.1 \\sim 1.1 ∼1.1–2.3 km s−1 Mpc−1 2.3\\,\\mathrm{km\\,s^{-1}\\,Mpc^{-1}} 2.3kms−1Mpc−1 in low-redshift (z≲0.02 z \\lesssim 0.02 z≲0.02) determinations of H0 H_0 H0. This threshold-dominated, dark-matter-free framework offers a testable alternative to standard dark-matter interpretations and constitutes a natural, purely geometric contribution to the Hubble tension that vanishes at higher redshifts. Rigorous numerical validation with 3+1 general-relativistic codes is required.In conclusion, we emphasize that the gravito-magnetic Onion is not a universal alternative to dark matter, but a threshold-dominated geometric effect. What has long been interpreted as a “missing mass” problem may in many cases reflect a “missing geometry”: only massive, thick, differentially rotating spiral disks possess the organized multi-layer structure required to generate significant dual gravitomagnetic precession and the associated supra-additive velocity boosts. In contrast, dwarf galaxies, irregulars, and ellipticals lack this high degree of rotational organization and internal resonance; they therefore exhibit negligible gravitomagnetic amplification and continue to require dark matter to explain their dynamics. This naturally accounts for the observed distribution of flat rotation curves and kinematic anomalies without invoking a universal dark-matter halo around every galaxy.  Keywords: general relativity, galactic rotation curves, dark matter alternatives, frame-dragging, gravitomagnetic precession, self-lensing, Hubble tension"],"publicationDate":"2026-04-28","publisher":"Zenodo","embargoEndDate":null,"sources":null,"formats":null,"contributors":null,"coverages":null,"bestAccessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/"},"container":null,"documentationUrls":null,"codeRepositoryUrl":null,"programmingLanguage":null,"contactPeople":null,"contactGroups":null,"tools":null,"size":null,"version":null,"geoLocations":null,"id":"doi_dedup___::21366e5a0255511cd5f4a97bcdd1f0a6","originalIds":["50|datacite____::21366e5a0255511cd5f4a97bcdd1f0a6","10.5281/zenodo.19853194","50|od______2659::21366e5a0255511cd5f4a97bcdd1f0a6","oai:zenodo.org:19853194","50|datacite____::60db8c9d75fb2186462498a4d31f2722","10.5281/zenodo.19853022","50|datacite____::f1321f4c81651eeb0f8de5b399931e04","10.5281/zenodo.19853023","oai:zenodo.org:19853023","50|od______2659::f1321f4c81651eeb0f8de5b399931e04"],"pids":[{"scheme":"doi","value":"10.5281/zenodo.19853194"},{"scheme":"doi","value":"10.5281/zenodo.19853022"},{"scheme":"doi","value":"10.5281/zenodo.19853023"}],"dateOfCollection":null,"lastUpdateTimeStamp":null,"indicators":{"citationImpact":{"citationCount":0.0,"influence":2.1746283E-9,"popularity":2.6085654E-9,"impulse":0.0,"citationClass":"C5","influenceClass":"C5","impulseClass":"C5","popularityClass":"C5"}},"projects":null,"organizations":null,"communities":[{"code":"eosc","label":"EOSC","provenance":null}],"collectedFrom":[{"key":"openaire____::9e3be59865b2c1c335d32dae2fe7b254","value":"Datacite"},{"key":"opendoar____::358aee4cc897452c00244351e4d91f69","value":"ZENODO"}],"instances":[{"pids":[{"scheme":"doi","value":"10.5281/zenodo.19853194"}],"license":"CC BY","type":"Other literature type","urls":["https://dx.doi.org/10.5281/zenodo.19853194"],"publicationDate":"2026-04-28","refereed":"nonPeerReviewed","hostedBy":{"key":"opendoar____::358aee4cc897452c00244351e4d91f69","value":"ZENODO"},"collectedFrom":{"key":"openaire____::9e3be59865b2c1c335d32dae2fe7b254","value":"Datacite"}},{"pids":[{"scheme":"doi","value":"10.5281/zenodo.19853194"}],"alternateIdentifiers":[{"scheme":"oai","value":"oai:zenodo.org:19853194"}],"license":"CC BY","accessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/","openAccessRoute":null},"type":"Other literature type","urls":["https://zenodo.org/records/19853194","http://dx.doi.org/10.5281/zenodo.19853194"],"publicationDate":"2026-04-28","refereed":"nonPeerReviewed","hostedBy":{"key":"opendoar____::358aee4cc897452c00244351e4d91f69","value":"ZENODO"},"collectedFrom":{"key":"opendoar____::358aee4cc897452c00244351e4d91f69","value":"ZENODO"}},{"pids":[{"scheme":"doi","value":"10.5281/zenodo.19853022"}],"license":"CC BY","type":"Other literature type","urls":["https://dx.doi.org/10.5281/zenodo.19853022"],"publicationDate":"2026-04-28","refereed":"nonPeerReviewed","hostedBy":{"key":"opendoar____::358aee4cc897452c00244351e4d91f69","value":"ZENODO"},"collectedFrom":{"key":"openaire____::9e3be59865b2c1c335d32dae2fe7b254","value":"Datacite"}},{"pids":[{"scheme":"doi","value":"10.5281/zenodo.19853023"}],"license":"CC BY","type":"Other literature type","urls":["https://dx.doi.org/10.5281/zenodo.19853023"],"publicationDate":"2026-04-28","refereed":"nonPeerReviewed","hostedBy":{"key":"opendoar____::358aee4cc897452c00244351e4d91f69","value":"ZENODO"},"collectedFrom":{"key":"openaire____::9e3be59865b2c1c335d32dae2fe7b254","value":"Datacite"}},{"pids":[{"scheme":"doi","value":"10.5281/zenodo.19853023"}],"alternateIdentifiers":[{"scheme":"oai","value":"oai:zenodo.org:19853023"}],"license":"CC BY","accessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/","openAccessRoute":null},"type":"Other literature type","urls":["https://zenodo.org/records/19853023","http://dx.doi.org/10.5281/zenodo.19853023"],"publicationDate":"2026-04-28","refereed":"nonPeerReviewed","hostedBy":{"key":"opendoar____::358aee4cc897452c00244351e4d91f69","value":"ZENODO"},"collectedFrom":{"key":"opendoar____::358aee4cc897452c00244351e4d91f69","value":"ZENODO"}}],"links":[],"otherTitles":null,"green":true,"inDiamondJournal":false,"isGreen":true,"isInDiamondJournal":false},{"authors":[{"id":null,"fullName":"Cappelletti, Leonardo Damian","name":"Leonardo Damian","surname":"Cappelletti","rank":1,"pid":null}],"openAccessColor":null,"publiclyFunded":false,"eoscIfGuidelines":null,"type":"publication","language":{"code":"eng","label":"English"},"countries":null,"subjects":[{"subject":{"scheme":"FOS","value":"0103 physical sciences"},"provenance":null},{"subject":{"scheme":"keyword","value":"Astrophysics, TFMR, Dark Matter, Galactic Rotation Curves, Tully-Fisher Relation, Functional Gravity, Cosmology, Action Principle."},"provenance":null},{"subject":{"scheme":"FOS","value":"01 natural sciences"},"provenance":null}],"mainTitle":"TFMR: A Functional Framework for Galactic Dynamics and the Tully-Fisher Relation without Dark Matter","subTitle":null,"descriptions":["This series of 15 reference documents (DR-1 to DR-15) presents the complete development of the Multidimensional Feedback Flow Theory (TFMR). TFMR proposes a new framework for fundamental physics, starting with a universal functional kernel from which the laws of galactic dynamics emerge.  The work unfolds in three main phases:  Theoretical Foundations (DR-1 to DR-9): A mother kernel with functional modes is postulated to describe the system's dynamics. It is rigorously demonstrated that the form of these modes is not an arbitrary assumption but emerges from a functional action principle. Additionally, the concept of functional anti-gravity is explored as a natural consequence of the same kernel, suggesting a unified explanation for cosmic expansion without the need for dark energy.  Empirical Validation (DR-10 to DR-13): The theory is successfully applied to the rotational dynamics of four spiral galaxies: the Milky Way, M33, NGC 3198, and M31 (Andromeda). The calculations show exceptional predictive power, reproducing the observed rotation curves with consistently low relative errors (typically below 3%), without postulating the existence of dark matter.  Unification and Prediction (DR-14 and DR-15): The theory culminates with the derivation of the Tully-Fisher relation from its functional principles. It is demonstrated that this empirical law, which links a galaxy's visible mass to its rotational velocity, is a natural consequence of the TFMR's structure. The final work concludes with the verification of this relation using the results from the four galaxies, confirming the unifying and predictive power of the theory.  This collection of documents represents a significant advance in the search for a theory that resolves cosmological discrepancies in a coherent and elegant manner, offering a viable alternative to dark matter and dark energy.         "],"publicationDate":"2025-08-09","publisher":"Zenodo","embargoEndDate":null,"sources":null,"formats":null,"contributors":null,"coverages":null,"bestAccessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/"},"container":null,"documentationUrls":null,"codeRepositoryUrl":null,"programmingLanguage":null,"contactPeople":null,"contactGroups":null,"tools":null,"size":null,"version":null,"geoLocations":null,"id":"doi_dedup___::833d3b9ba425981b73beb533f41d0116","originalIds":["50|datacite____::833d3b9ba425981b73beb533f41d0116","10.5281/zenodo.16785591","oai:zenodo.org:16785591","50|od______2659::833d3b9ba425981b73beb533f41d0116","50|datacite____::e7381f86636946616faa4b601da323ed","10.5281/zenodo.16785590"],"pids":[{"scheme":"doi","value":"10.5281/zenodo.16785591"},{"scheme":"doi","value":"10.5281/zenodo.16785590"}],"dateOfCollection":null,"lastUpdateTimeStamp":null,"indicators":{"citationImpact":{"citationCount":0.0,"influence":2.1746283E-9,"popularity":2.2497804E-9,"impulse":0.0,"citationClass":"C5","influenceClass":"C5","impulseClass":"C5","popularityClass":"C5"}},"projects":null,"organizations":null,"communities":[{"code":"eosc","label":"EOSC","provenance":null}],"collectedFrom":[{"key":"openaire____::9e3be59865b2c1c335d32dae2fe7b254","value":"Datacite"},{"key":"opendoar____::358aee4cc897452c00244351e4d91f69","value":"ZENODO"}],"instances":[{"pids":[{"scheme":"doi","value":"10.5281/zenodo.16785591"}],"license":"CC BY","type":"Preprint","urls":["https://dx.doi.org/10.5281/zenodo.16785591"],"publicationDate":"2025-08-09","refereed":"nonPeerReviewed","hostedBy":{"key":"opendoar____::358aee4cc897452c00244351e4d91f69","value":"ZENODO"},"collectedFrom":{"key":"openaire____::9e3be59865b2c1c335d32dae2fe7b254","value":"Datacite"}},{"pids":[{"scheme":"doi","value":"10.5281/zenodo.16785591"}],"alternateIdentifiers":[{"scheme":"oai","value":"oai:zenodo.org:16785591"}],"license":"CC BY","accessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/","openAccessRoute":null},"type":"Preprint","urls":["http://dx.doi.org/10.5281/zenodo.16785591","https://zenodo.org/records/16785591"],"publicationDate":"2025-08-09","refereed":"nonPeerReviewed","hostedBy":{"key":"opendoar____::358aee4cc897452c00244351e4d91f69","value":"ZENODO"},"collectedFrom":{"key":"opendoar____::358aee4cc897452c00244351e4d91f69","value":"ZENODO"}},{"pids":[{"scheme":"doi","value":"10.5281/zenodo.16785590"}],"license":"CC BY","type":"Preprint","urls":["https://dx.doi.org/10.5281/zenodo.16785590"],"publicationDate":"2025-08-09","refereed":"nonPeerReviewed","hostedBy":{"key":"opendoar____::358aee4cc897452c00244351e4d91f69","value":"ZENODO"},"collectedFrom":{"key":"openaire____::9e3be59865b2c1c335d32dae2fe7b254","value":"Datacite"}}],"links":[],"otherTitles":null,"green":true,"inDiamondJournal":false,"isGreen":true,"isInDiamondJournal":false},{"authors":[{"id":null,"fullName":"Serramo Lopez, Luiz Carlos","name":"Luiz Carlos","surname":"Serramo Lopez","rank":1,"pid":{"id":{"scheme":"orcid_pending","value":"0000-0002-9983-5563"},"provenance":null}}],"openAccessColor":null,"publiclyFunded":false,"eoscIfGuidelines":null,"type":"publication","language":{"code":"und","label":"Undetermined"},"countries":null,"subjects":[{"subject":{"scheme":"FOS","value":"0103 physical sciences"},"provenance":null},{"subject":{"scheme":"FOS","value":"01 natural sciences"},"provenance":null}],"mainTitle":"Kinematic Space-Time Symmetry V: Resolving Galactic Rotation Curves Without Exotic Dark Matter Halos","subTitle":null,"descriptions":["We extend the Symmetric Time Approach (STA) framework to galactic scales to address themissing mass problem without invoking non-baryonic dark matter particles. Standard astrophysicsinterprets the flat rotation curves of spiral galaxies as evidence for missing mass halos, under theassumption of an invariant, globally synchronized temporal rate. By applying a fundamental kinematic velocity symmetry between space and time, we demonstrate that the intrinsic velocity of timeflow (τ ≡ 1/γ) varies non-linearly across galactic radii as macroscopic system velocities approachthe Cosmic Microwave Background (CMB) rest frame. As baryonic density and local kinetic interactions decay toward the outer edges of a galaxy, the local kinematic parameter β drops, forcingperipheral clocks to accelerate along the steep low-energy asymptote of the STA curve (Y > 0).When external spectroscopic Doppler shifts are corrected for this internal galactic temporal gradient, the anomalous rotational velocities match the visible baryonic mass distribution. The modelsatisfies the Tully-Fisher relation structurally, preserves standard Newtonian dynamics within densestellar cores, and offers testable predictions for localized frequency drifts in peripheral hydrogenclouds."],"publicationDate":"2026-06-07","publisher":"Zenodo","embargoEndDate":null,"sources":null,"formats":null,"contributors":null,"coverages":null,"bestAccessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/"},"container":null,"documentationUrls":null,"codeRepositoryUrl":null,"programmingLanguage":null,"contactPeople":null,"contactGroups":null,"tools":null,"size":null,"version":null,"geoLocations":null,"id":"doi_________::f70680b3d9630d1b93cbf88a02de25d1","originalIds":["50|od______2659::f70680b3d9630d1b93cbf88a02de25d1","oai:zenodo.org:20583957"],"pids":[{"scheme":"doi","value":"10.5281/zenodo.20583957"}],"dateOfCollection":null,"lastUpdateTimeStamp":null,"indicators":{"citationImpact":{"citationCount":0.0,"influence":2.1746283E-9,"popularity":2.6085654E-9,"impulse":0.0,"citationClass":"C5","influenceClass":"C5","impulseClass":"C5","popularityClass":"C5"}},"projects":null,"organizations":null,"communities":[{"code":"eosc","label":"EOSC","provenance":null}],"collectedFrom":[{"key":"opendoar____::358aee4cc897452c00244351e4d91f69","value":"ZENODO"}],"instances":[{"pids":[{"scheme":"doi","value":"10.5281/zenodo.20583957"}],"alternateIdentifiers":[{"scheme":"oai","value":"oai:zenodo.org:20583957"}],"license":"CC BY","accessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/","openAccessRoute":null},"type":"Preprint","urls":["https://zenodo.org/records/20583957","http://dx.doi.org/10.5281/zenodo.20583957"],"publicationDate":"2026-06-07","refereed":"nonPeerReviewed","hostedBy":{"key":"opendoar____::358aee4cc897452c00244351e4d91f69","value":"ZENODO"},"collectedFrom":{"key":"opendoar____::358aee4cc897452c00244351e4d91f69","value":"ZENODO"}}],"links":null,"otherTitles":null,"green":true,"inDiamondJournal":false,"isGreen":true,"isInDiamondJournal":false},{"authors":[{"id":null,"fullName":"Fedorchenko, Andrey Vladimirovich","name":"Andrey Vladimirovich","surname":"Fedorchenko","rank":1,"pid":null},{"id":null,"fullName":"DeepSeek, DeepSeek R-1","name":"DeepSeek R-1","surname":"DeepSeek","rank":2,"pid":null}],"openAccessColor":null,"publiclyFunded":false,"eoscIfGuidelines":null,"type":"publication","language":{"code":"und","label":"Undetermined"},"countries":null,"subjects":[{"subject":{"scheme":"FOS","value":"0103 physical sciences"},"provenance":null},{"subject":{"scheme":"FOS","value":"01 natural sciences"},"provenance":null}],"mainTitle":"Inversion Field Theory: Analytical Investigation of Galaxy Rotation Curves","subTitle":null,"descriptions":["The nature of dark matter remains one of the most pressing open questions in modern astrophysics. The flat rotation curves of spiral galaxies, conventionally attributed to halos of invisible particles, have eluded a universally accepted explanation despite decades of experimental searches. We propose an alternative framework based on the inversion field theory, in which a single scalar field \\(\\Phi\\) acts as a universal conductor permeating all of spacetime. Within this theory, the rotational motion of baryonic matter in galaxies generates a vortex in the conductor field through an axial current coupling. The energy stored in this vortex gravitates, producing an additional contribution to the galactic gravitational potential. We derive analytically the resulting circular velocity profile and show that it naturally yields a flat rotation curve at large radii. Furthermore, the asymptotic velocity \\(v_{\\rm flat}\\) is found to obey the baryonic Tully--Fisher relation \\(v_{\\rm flat}^4 \\propto M_{\\rm bar}\\), with a predicted normalisation of \\(v_{\\rm flat}^4 = (4.2 \\pm 0.8) \\times 10^{10} \\, (M_{\\rm bar} / 10^{10} M_\\odot)\\) km\\(^4\\) s\\(^{-4}\\). The observed value from the SPARC sample is \\((4.8 \\pm 1.2) \\times 10^{10}\\) in the same units, corresponding to a deviation of less than \\(0.5\\sigma\\). No free parameters are fitted to individual galaxies; the single coupling constant \\(g_{\\rm vort} \\approx 0.005\\) is extracted from the ensemble average and is predicted to be universal. These results demonstrate that the inversion field theory reproduces the key observational features of galactic dynamics without invoking particle dark matter or modifying the laws of gravity."],"publicationDate":"2026-06-27","publisher":"Zenodo","embargoEndDate":null,"sources":null,"formats":null,"contributors":null,"coverages":null,"bestAccessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/"},"container":null,"documentationUrls":null,"codeRepositoryUrl":null,"programmingLanguage":null,"contactPeople":null,"contactGroups":null,"tools":null,"size":null,"version":null,"geoLocations":null,"id":"doi_dedup___::1fd4b371c0c64014f3a0dacf8d39c1d5","originalIds":["50|datacite____::1fd4b371c0c64014f3a0dacf8d39c1d5","10.5281/zenodo.20966353","50|datacite____::a9fbc13386ab03d51d62cfb70ebccac7","10.5281/zenodo.20966354","50|od______2659::a9fbc13386ab03d51d62cfb70ebccac7","oai:zenodo.org:20966354"],"pids":[{"scheme":"doi","value":"10.5281/zenodo.20966353"},{"scheme":"doi","value":"10.5281/zenodo.20966354"}],"dateOfCollection":null,"lastUpdateTimeStamp":null,"indicators":{"citationImpact":{"citationCount":0.0,"influence":2.1746283E-9,"popularity":2.6085654E-9,"impulse":0.0,"citationClass":"C5","influenceClass":"C5","impulseClass":"C5","popularityClass":"C5"}},"projects":null,"organizations":null,"communities":[{"code":"eosc","label":"EOSC","provenance":null}],"collectedFrom":[{"key":"openaire____::9e3be59865b2c1c335d32dae2fe7b254","value":"Datacite"},{"key":"opendoar____::358aee4cc897452c00244351e4d91f69","value":"ZENODO"}],"instances":[{"pids":[{"scheme":"doi","value":"10.5281/zenodo.20966353"}],"license":"CC BY","type":"Preprint","urls":["https://dx.doi.org/10.5281/zenodo.20966353"],"publicationDate":"2026-06-27","refereed":"nonPeerReviewed","hostedBy":{"key":"opendoar____::358aee4cc897452c00244351e4d91f69","value":"ZENODO"},"collectedFrom":{"key":"openaire____::9e3be59865b2c1c335d32dae2fe7b254","value":"Datacite"}},{"pids":[{"scheme":"doi","value":"10.5281/zenodo.20966354"}],"license":"CC BY","type":"Preprint","urls":["https://dx.doi.org/10.5281/zenodo.20966354"],"publicationDate":"2026-06-27","refereed":"nonPeerReviewed","hostedBy":{"key":"opendoar____::358aee4cc897452c00244351e4d91f69","value":"ZENODO"},"collectedFrom":{"key":"openaire____::9e3be59865b2c1c335d32dae2fe7b254","value":"Datacite"}},{"pids":[{"scheme":"doi","value":"10.5281/zenodo.20966354"}],"alternateIdentifiers":[{"scheme":"oai","value":"oai:zenodo.org:20966354"}],"license":"CC BY","accessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/","openAccessRoute":null},"type":"Preprint","urls":["https://zenodo.org/records/20966354","http://dx.doi.org/10.5281/zenodo.20966354"],"publicationDate":"2026-06-27","refereed":"nonPeerReviewed","hostedBy":{"key":"opendoar____::358aee4cc897452c00244351e4d91f69","value":"ZENODO"},"collectedFrom":{"key":"opendoar____::358aee4cc897452c00244351e4d91f69","value":"ZENODO"}}],"links":[],"otherTitles":null,"green":true,"inDiamondJournal":false,"isGreen":true,"isInDiamondJournal":false},{"authors":[{"id":null,"fullName":"han, runguang","name":"runguang","surname":"han","rank":1,"pid":{"id":{"scheme":"orcid_pending","value":"0000-0002-9054-2588"},"provenance":null}}],"openAccessColor":null,"publiclyFunded":false,"eoscIfGuidelines":null,"type":"publication","language":{"code":"und","label":"Undetermined"},"countries":null,"subjects":[{"subject":{"scheme":"SDG","value":"13. Climate action"},"provenance":null},{"subject":{"scheme":"FOS","value":"0103 physical sciences"},"provenance":null},{"subject":{"scheme":"FOS","value":"01 natural sciences"},"provenance":null},{"subject":{"scheme":"SDG","value":"7. Clean energy"},"provenance":null}],"mainTitle":"The Essence of Universal Gravitation and the Power of Cosmic expansion","subTitle":null,"descriptions":["Based on the scientific achievements of the Big Bang Theory, quark model, Parton model and other scientific achievements, this paper proposes a new theoretical model(the polaron sea model) on the essence of universal gravity and the origin of dark matter and dark energy. Based on this model, a new formula of universal gravitation is deduced, the essence of universal gravitation is revealed, and the origin of dark matter and dark energy hypothesis is given. The new formula of universal gravitation can be converted into Newton's formula of universal gravitation. It is concluded that the gravitational constant G is a slowly changing quantity, the gravitational force of celestial bodies is limited, and may not form a real black hole, and the current total density of the universe is greater than the critical density. The new universal gravitation formula can explain the problem of rotational velocity of spiral galaxies. The theory predicts that universal gravitation can be partially shielded, and the problems of the generation of de Broglie wave and the interference of single photon (particle) double slit are related to the polaron sea. Chinese version DOI:https://doi.org/10.55375/preprints.2022.1.4"],"publicationDate":"2023-01-01","publisher":null,"embargoEndDate":null,"sources":null,"formats":null,"contributors":null,"coverages":null,"bestAccessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/"},"container":null,"documentationUrls":null,"codeRepositoryUrl":null,"programmingLanguage":null,"contactPeople":null,"contactGroups":null,"tools":null,"size":null,"version":null,"geoLocations":null,"id":"doi_dedup___::bab48d13e9156094f58603201dd7719e","originalIds":["50|datacite____::bab48d13e9156094f58603201dd7719e","10.6084/m9.figshare.20101667.v12","50|datacite____::f3106ce828d1ec585680c29b8f54b02a","10.6084/m9.figshare.20101667.v11"],"pids":[{"scheme":"doi","value":"10.6084/m9.figshare.20101667.v12"},{"scheme":"doi","value":"10.6084/m9.figshare.20101667.v11"}],"dateOfCollection":null,"lastUpdateTimeStamp":null,"indicators":{"citationImpact":{"citationCount":0.0,"influence":2.1746283E-9,"popularity":1.6835128E-9,"impulse":0.0,"citationClass":"C5","influenceClass":"C5","impulseClass":"C5","popularityClass":"C5"}},"projects":null,"organizations":null,"communities":[{"code":"energy-planning","label":"Energy Planning","provenance":null}],"collectedFrom":[{"key":"openaire____::9e3be59865b2c1c335d32dae2fe7b254","value":"Datacite"}],"instances":[{"pids":[{"scheme":"doi","value":"10.6084/m9.figshare.20101667.v12"}],"license":"CC BY","accessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/","openAccessRoute":null},"type":"Thesis","urls":["https://dx.doi.org/10.6084/m9.figshare.20101667.v12"],"publicationDate":"2023-01-01","refereed":"nonPeerReviewed","hostedBy":{"key":"fairsharing_::4888241374e8c62ddd9b4c3cfd091f96","value":"figshare"},"collectedFrom":{"key":"openaire____::9e3be59865b2c1c335d32dae2fe7b254","value":"Datacite"}},{"pids":[{"scheme":"doi","value":"10.6084/m9.figshare.20101667.v11"}],"license":"CC BY","accessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/","openAccessRoute":null},"type":"Thesis","urls":["https://dx.doi.org/10.6084/m9.figshare.20101667.v11"],"publicationDate":"2023-01-01","refereed":"nonPeerReviewed","hostedBy":{"key":"fairsharing_::4888241374e8c62ddd9b4c3cfd091f96","value":"figshare"},"collectedFrom":{"key":"openaire____::9e3be59865b2c1c335d32dae2fe7b254","value":"Datacite"}}],"links":[],"otherTitles":null,"green":true,"inDiamondJournal":false,"isGreen":true,"isInDiamondJournal":false},{"authors":[{"id":"orcid_______::5527f1132db27e26bc698c6f8600dc3f","fullName":"J. François","name":"J.","surname":"François","rank":1,"pid":{"id":{"scheme":"orcid","value":"0000-0002-3808-6343"},"provenance":null}},{"id":"orcid_______::0ac2e2480d80aedaed4b3eaeab0d1175","fullName":"L. Ravera","name":"L.","surname":"Ravera","rank":2,"pid":{"id":{"scheme":"orcid","value":"0000-0003-4516-5127"},"provenance":null}}],"openAccessColor":null,"publiclyFunded":false,"eoscIfGuidelines":null,"type":"publication","language":{"code":"eng","label":"English"},"countries":[{"code":"IT","label":"Italy","provenance":null}],"subjects":[{"subject":{"scheme":"keyword","value":"High Energy Physics - Theory"},"provenance":null},{"subject":{"scheme":"keyword","value":"High Energy Physics - Theory (hep-th)"},"provenance":null},{"subject":{"scheme":"FOS","value":"0103 physical sciences"},"provenance":null},{"subject":{"scheme":"keyword","value":"Galaxy rotation curves, Diffeomorphisms invariance, Dressing Field Method, Relational physics"},"provenance":null},{"subject":{"scheme":"keyword","value":"FOS: Physical sciences"},"provenance":null},{"subject":{"scheme":"keyword","value":"General Relativity and Quantum Cosmology (gr-qc)"},"provenance":null},{"subject":{"scheme":"FOS","value":"01 natural sciences"},"provenance":null},{"subject":{"scheme":"keyword","value":"General Relativity and Quantum Cosmology"},"provenance":null}],"mainTitle":"Raising galaxy rotation curves via dressing","subTitle":null,"descriptions":["We present a manifestly diffeomorphism-invariant simple model of galaxy dynamics obtained by applying the Dressing Field Method (DFM) to a general-relativistic system comprising the metric and four scalar fields, phenomenologically representing the four-velocity of a cosmological fluid or dust field. The DFM, a systematic tool for extracting the gauge-invariant content in general-relativistic theories, provides a physical coordinatization that yields corrective terms to the rotational velocity profile. These corrections produce galaxy rotation curves that combine a Keplerian and a constant velocity terms, effectively emulating a Dark Matter contribution. We compare DFM-derived rotation curves to observed data for spiral galaxies, from the Spitzer Photometry and Accurate Rotation Curves (SPARC) database, showing that the DFM allows to fit them well.","10 pages, 9 figures, 1 table, Supplemental Material included. Published 6 October, 2025"],"publicationDate":"2025-10-06","publisher":"American Physical Society (APS)","embargoEndDate":"2025-10-01","sources":["Crossref"],"formats":["application/pdf"],"contributors":null,"coverages":null,"bestAccessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/"},"container":{"name":"Physical Review D","issnPrinted":"2470-0010","issnOnline":"2470-0029","issnLinking":null,"ep":null,"iss":null,"sp":null,"vol":"112","edition":null,"conferencePlace":null,"conferenceDate":null},"documentationUrls":null,"codeRepositoryUrl":null,"programmingLanguage":null,"contactPeople":null,"contactGroups":null,"tools":null,"size":null,"version":null,"geoLocations":null,"id":"doi_dedup___::5092eb7dd56733a082d239b45430c3b5","originalIds":["10.1103/m9xl-9vvk","50|doiboost____|5092eb7dd56733a082d239b45430c3b5","50|datacite____::ca5941bc00e3bda3ad8a61a4ff5cee05","10.48550/arxiv.2510.18549","50|od________18::e6f22a5d1405f3c8c88ec748d284a2cb","oai:arXiv.org:2510.18549","50|od______2153::9a0841a361aa3153c290aa7fcdc5ead2","oai:iris.polito.it:11583/3012405"],"pids":[{"scheme":"doi","value":"10.1103/m9xl-9vvk"},{"scheme":"doi","value":"10.48550/arxiv.2510.18549"},{"scheme":"arXiv","value":"2510.18549"},{"scheme":"handle","value":"11583/3012405"}],"dateOfCollection":null,"lastUpdateTimeStamp":null,"indicators":{"citationImpact":{"citationCount":2.0,"influence":2.2936129E-9,"popularity":3.5729038E-9,"impulse":2.0,"citationClass":"C5","influenceClass":"C5","impulseClass":"C5","popularityClass":"C4"}},"projects":null,"organizations":[{"legalName":"Polytechnic University of Turin","acronym":"POLITO","id":"openorgs____::d3e085ecb411286b3e3929a885b7a9ce","pids":[{"scheme":"ROR","value":"https://ror.org/00bgk9508"},{"scheme":"PIC","