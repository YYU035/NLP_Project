"label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/","openAccessRoute":null},"type":"Preprint","urls":["http://arxiv.org/abs/2510.18549"],"publicationDate":"2025-10-21","refereed":"nonPeerReviewed","hostedBy":{"key":"opendoar____::6f4922f45568161a8cdf4ad2299f6d23","value":"arXiv.org e-Print Archive"},"collectedFrom":{"key":"opendoar____::6f4922f45568161a8cdf4ad2299f6d23","value":"arXiv.org e-Print Archive"}},{"pids":[{"scheme":"handle","value":"11583/3012405"}],"alternateIdentifiers":[{"scheme":"doi","value":"10.1103/m9xl-9vvk"},{"scheme":"urn","value":"2-s2.0-105021051048"}],"license":"CC BY NC SA","accessRight":{"code":"c_abf2","label":"OPEN","scheme":"http://vocabularies.coar-repositories.org/documentation/access_rights/","openAccessRoute":null},"type":"Article","urls":["https://journals.aps.org/prd/abstract/10.1103/m9xl-9vvk","https://hdl.handle.net/11583/3012405","https://doi.org/10.1103/m9xl-9vvk"],"publicationDate":"2025-01-01","refereed":"nonPeerReviewed","hostedBy":{"key":"opendoar____::cb8da6767461f2812ae4290eac7cbc42","value":"Publications Open Repository TOrino"},"collectedFrom":{"key":"opendoar____::cb8da6767461f2812ae4290eac7cbc42","value":"Publications Open Repository TOrino"}}],"links":[],"otherTitles":null,"green":true,"inDiamondJournal":false,"isGreen":true,"isInDiamondJournal":false},{"authors":[{"id":"orcid_______::7348bf961497fd5fc4663b7eeadb8788","fullName":"BRICIO ARZUBIDE, Alvaro Fabian","name":"Alvaro Fabian","surname":"BRICIO ARZUBIDE","rank":1,"pid":{"id":{"scheme":"orcid","value":"0009-0009-4280-799x"},"provenance":null}}],"openAccessColor":null,"publiclyFunded":false,"eoscIfGuidelines":null,"type":"publication","language":{"code":"eng","label":"English"},"countries":null,"subjects":[{"subject":{"scheme":"keyword","value":"Momentum-based gravity"},"provenance":null},{"subject":{"scheme":"keyword","value":"Spiral galaxies"},"provenance":null},{"subject":{"scheme":"FOS","value":"0103 physical sciences"},"provenance":null},{"subject":{"scheme":"keyword","value":"Angular momentum"},"provenance":null},{"subject":{"scheme":"keyword","value":"Alternative to dark matter"},"provenance":null},{"subject":{"scheme":"keyword","value":"Universal scaling laws"},"provenance":null},{"subject":{"scheme":"keyword","value":"MIND framework"},"provenance":null},{"subject":{"scheme":"keyword","value":"Classical mechanics"},"provenance":null},{"subject":{"scheme":"keyword","value":"Astrophysical scaling relations"},"provenance":null},{"subject":{"scheme":"FOS","value":"01 natural sciences"},"provenance":null},{"subject":{"scheme":"keyword","value":"Galactic dynamics"},"provenance":null},{"subject":{"scheme":"keyword","value":"Emergent gravity"},"provenance":null}],"mainTitle":"The Universality of n₀ in the MIND Framework: A Fundamental Law of Spin-Geometry Coupling","subTitle":null,"descriptions":["This work introduces a universal momentum scale n_0 governing the dynamics of spiral galaxies, derived from fundamental physical considerations and dimensional consistency.Rather than modifying gravity or invoking dark matter, the framework reinterprets galactic rotation phenomena through momentum organization and coherence across a characteristic transverse scale.  A minimal, dimensionally consistent formulation is presented, leading to a simple scaling law that depends on a transverse coupling length and the characteristic rotational velocity. The resulting expression is shown to be physically transparent, free of ad-hoc terms, and compatible with classical mechanics, relativistic principles, and conservation laws.  This paper focuses on the formulation, physical interpretation, and theoretical implications of the momentum scale, while empirical validation using observational data is presented separately in a companion study."],"publicationDate":"2026-01-01","publisher":"Zenodo","embargoEndDate":null,"sources":null,"formats":null,"contributors":null,"coverages":null,"bestAccessRight"