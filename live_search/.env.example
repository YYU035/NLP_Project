# Template only: .env files are not automatically loaded.
# Export these variables in your shell before loading Settings.
PAPER_SEARCH_TIMEOUT_SECONDS=30
# Legacy SearchPipeline limit; retrieve(..., top_k=30) sets its own limit.
PAPER_SEARCH_MAX_RESULTS=30
PAPER_SEARCH_MAX_QUERIES=2
# Ablations: original_only or original_plus_concepts
PAPER_SEARCH_QUERY_MODE=original_plus_concepts
PAPER_SEARCH_QUERY_MODEL=en_core_web_sm
PAPER_SEARCH_LOG_LEVEL=INFO
PAPER_SEARCH_OPENALEX_ENABLED=true
PAPER_SEARCH_ARXIV_ENABLED=true
PAPER_SEARCH_SEMANTIC_SCHOLAR_ENABLED=false
# Optional: verified OpenAlex key for a larger API budget.
OPENALEX_API_KEY=
# Optional: Semantic Scholar Academic Graph key.
SEMANTIC_SCHOLAR_API_KEY=
# Final retrieval policy includes OpenAIRE; legacy Settings defaults differ.
PAPER_SEARCH_OPENAIRE_ENABLED=true
OPENAIRE_TOKEN=
# Separate optional relevance evaluator; never used by retrieval.
# Use only a Gemini project with NO linked billing account.
GEMINI_API_KEY=
# Short-lived OAuth token for read-only key ownership/billing verification.
# Do not store real tokens here. See docs/gemini_relevance.md.
GOOGLE_OAUTH_ACCESS_TOKEN=
