* text=auto
*.py text eol=lf
*.md text eol=lf
*.ps1 text eol=lf
*.cmd text eol=crlf
*.toml text eol=lf
*.yml text eol=lf
*.lock text eol=lf
# Preserve all hash-bound research/replay bytes across platforms.
*.json -text whitespace=cr-at-eol,-blank-at-eol
*.jsonl -text whitespace=cr-at-eol,-blank-at-eol
*.csv -text whitespace=cr-at-eol,-blank-at-eol
*.html -text whitespace=-blank-at-eol
docs/history/** -text

# Preserve complete published evidence bundles and original checkout newlines.
evaluation/** -text whitespace=cr-at-eol,-blank-at-eol,-blank-at-eof
examples/** -text whitespace=cr-at-eol,-blank-at-eol,-blank-at-eof
config/** -text whitespace=cr-at-eol,-blank-at-eol,-blank-at-eof
docs/contributions/source_records/** -text whitespace=cr-at-eol,-blank-at-eol,-blank-at-eof
docs/history/** -text whitespace=cr-at-eol,-blank-at-eol,-blank-at-eof
# Upstream source/test EOF formatting is provenance, not a release edit.
src/paper_search/** whitespace=-blank-at-eof
tests/discovery/** whitespace=-blank-at-eof
