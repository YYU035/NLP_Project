# Set these in the server's environment. This file is documentation, not auto-loaded.
# No hosted inference services or API keys are used for explanations.
# Run setup-local-llm.ps1 once to download the Apache-2.0 model.
EXPLANATION_LOCAL_TIMEOUT=60
# EXPLANATION_LOCAL_MODEL_PATH=C:/path/to/local/Qwen2.5-0.5B-Instruct
# Trusted Python factory returning a NEW provider instance per session/run:
# EXPLANATION_PIPELINE_FACTORY=my_team_bridge:create_provider
# Downstream-only factory that consumes selected discovery candidates:
# EXPLANATION_VERIFY_DISCOVERY_FACTORY=explanation_frontend.your_bridge:create_provider
# Public catalogue discovery runs without credentials; configured keys are ignored.
# EXPLANATION_DISCOVERY_MODEL_PATH=C:/path/to/local/all-MiniLM-L6-v2

# Built-in default for both factories (no environment setting required):
# explanation_frontend.pipeline:create_provider
# Run setup-pipeline.ps1 once for pinned local NLI weights and discovery setup.
