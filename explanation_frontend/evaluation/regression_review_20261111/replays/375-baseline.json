      "processing_failures": [],
      "evidence_passages": [
        {
          "passage_id": "1522647:abstract:210:345:e09b9a72d2f4",
          "paper_id": "1522647",
          "section": "abstract",
          "text": "We hypothesized that circulating cell-free mtDNA levels would be associated with mortality and improve risk prediction in ICU patients.",
          "score": 0.6436275243759155,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "1522647:abstract:0:106:432893536d61",
          "paper_id": "1522647",
          "section": "abstract",
          "text": "BACKGROUND Mitochondrial DNA (mtDNA) is a critical activator of inflammation and the innate immune system.",
          "score": 0.6269182562828064,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "1522647:abstract:1433:1612:67ffa8ec1538",
          "paper_id": "1522647",
          "section": "abstract",
          "text": "In the BWH RoCI cohort, those with an elevated mtDNA level had an increased risk of death, even in analyses limited to patients with sepsis or acute respiratory distress syndrome.",
          "score": 0.6151493787765503,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "20459964:abstract:934:1036:f82d51cedd3c",
          "paper_id": "20459964",
          "section": "abstract",
          "text": "A mechanism of extracellular release of mitochondrial DNA accompanies the active stage of the disease.",
          "score": 0.6740630865097046,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "20459964:abstract:1037:1095:022f350db321",
          "paper_id": "20459964",
          "section": "abstract",
          "text": "Circulating mtDNA is extremely high in untreated patients.",
          "score": 0.6485217809677124,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "20459964:abstract:1096:1184:a4464360833e",
          "paper_id": "20459964",
          "section": "abstract",
          "text": "This suggests that biomarker properties of mtDNA are useful for monitoring of treatment.",
          "score": 0.5117858648300171,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "3883485:abstract:334:639:61916c502556",
          "paper_id": "3883485",
          "section": "abstract",
          "text": "Using human mitochondrial replacement stem cell lines, we show that, even though the low levels of heteroplasmy introduced into human oocytes by mitochondrial carryover during nuclear transfer often vanish, they can sometimes instead result in mtDNA genotypic drift and reversion to the original genotype.",
          "score": 0.5915555953979492,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "3883485:abstract:843:1058:b2303c96a8db",
          "paper_id": "3883485",
          "section": "abstract",
          "text": "Thus, although functional replacement of the mitochondrial genome is possible, even low levels of heteroplasmy can affect the stability of the mtDNA genotype and compromise the efficacy of mitochondrial replacement.",
          "score": 0.5769681930541992,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "3883485:abstract:0:172:12d790168d06",
          "paper_id": "3883485",
          "section": "abstract",
          "text": "Replacement of mitochondria through nuclear transfer between oocytes of two different women has emerged recently as a strategy for preventing inheritance of mtDNA diseases.",
          "score": 0.5732730031013489,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "44693226:abstract:1096:1216:173d30d05ff6",
          "paper_id": "44693226",
          "section": "abstract",
          "text": "Oxidative damage to mitochondrial DNA was one order of magnitude higher than that of nuclear DNA in both dietary groups.",
          "score": 0.6128090620040894,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "44693226:abstract:959:1095:374425618302",
          "paper_id": "44693226",
          "section": "abstract",
          "text": "Neither mitochondrial H(2)O(2) production nor oxidative damage to mitochondrial or nuclear DNA was modified in lipid-restricted animals.",
          "score": 0.5072118043899536,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "28249680:abstract:422:552:91983b326b78",
          "paper_id": "28249680",
          "section": "abstract",
          "text": "Subsequent cell death is independent of BAX, and probably BAK, and proceeds through the intrinsic mitochondrial apoptosis pathway.",
          "score": 0.546624481678009,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        }
      ],
