      "processing_failures": [],
      "evidence_passages": [
        {
          "passage_id": "15803282:abstract:447:636:820d7d5fe4f5",
          "paper_id": "15803282",
          "section": "abstract",
          "text": "Here we show that overexpression of a related H3K9me3 demethylase KDM4A improves human SCNT, and that, as in mice, H3K9me3 in the human somatic cell genome is an SCNT reprogramming barrier.",
          "score": 0.6959171295166016,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "15803282:abstract:253:446:0a064ef36e3b",
          "paper_id": "15803282",
          "section": "abstract",
          "text": "We previously showed in mice that reduction of histone H3 lysine 9 trimethylation (H3K9me3) through ectopic expression of the H3K9me3 demethylase Kdm4d greatly improves SCNT embryo development.",
          "score": 0.6754196882247925,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "4547102:abstract:1039:1148:40126ba29a42",
          "paper_id": "4547102",
          "section": "abstract",
          "text": "Furthermore, we show that interactions between RNA and KDM4E are essential for H3K9 demethylation during EGA.",
          "score": 0.64869624376297,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "4547102:abstract:831:1038:08b59cb88f5a",
          "paper_id": "4547102",
          "section": "abstract",
          "text": "Our results thereby indicate that KDM4E can function as a crucial epigenetic regulator of EGA and as an internal defective factor responsible for persistent H3K9me3/2 barriers to SCNT-mediated reprogramming.",
          "score": 0.6047118902206421,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "4547102:abstract:337:601:e114defff071",
          "paper_id": "4547102",
          "section": "abstract",
          "text": "Here, we provide evidence that two H3K9 demethylase genes, lysine-specific demethylase 4D (KDM4D) and 4E (KDM4E), are related to active H3K9me3/2 demethylation in in vitro fertilized (IVF) embryos and are deficiently expressed in cloned embryos at the time of EGA.",
          "score": 0.588161826133728,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "12100854:abstract:1352:1569:c2d6850d246e",
          "paper_id": "12100854",
          "section": "abstract",
          "text": "Despite largely non-overlapping functions and the predominant association of Cbx3 with active transcription, the H3K9 methyltransferases and Cbx3 both inhibit reprogramming by repressing the pluripotency factor Nanog.",
          "score": 0.5815646648406982,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "12100854:abstract:852:995:768bd16a7446",
          "paper_id": "12100854",
          "section": "abstract",
          "text": "Similarly, we find that inhibition of heterochromatin protein-1γ (Cbx3), a protein known to recognize H3K9 methylation, enhances reprogramming.",
          "score": 0.5506294965744019,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "12100854:abstract:599:851:940933febe94",
          "paper_id": "12100854",
          "section": "abstract",
          "text": "Dissecting the contribution of H3K9 methylation to reprogramming, we show that the H3K9 methyltransferases Ehmt1, Ehmt2 and Setdb1 regulate global H3K9me2/me3 levels and that their depletion increases iPSC formation from both fibroblasts and pre-iPSCs.",
          "score": 0.5479575991630554,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "8548635:abstract:905:1048:ecc1d5eeb1b4",
          "paper_id": "8548635",
          "section": "abstract",
          "text": "Taken together, these results suggest that H3K4me3/me2 demethylation regulated by the JARID1 family plays an important role during development.",
          "score": 0.5592308044433594,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        }
      ],
