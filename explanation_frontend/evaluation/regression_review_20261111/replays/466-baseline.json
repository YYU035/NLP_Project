        {
          "passage_id": "22544171:abstract:0:222:6b0edb21378f",
          "paper_id": "22544171",
          "section": "abstract",
          "text": "Hutchinson-Gilford progeria syndrome (HGPS) is a childhood premature aging disease caused by a spontaneous point mutation in lamin A (encoded by LMNA), one of the major architectural elements of the mammalian cell nucleus.",
          "score": 0.6974594593048096,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "22544171:abstract:223:400:0ac6bdc29090",
          "paper_id": "22544171",
          "section": "abstract",
          "text": "The HGPS mutation activates an aberrant cryptic splice site in LMNA pre-mRNA, leading to synthesis of a truncated lamin A protein and concomitant reduction in wild-type lamin A.",
          "score": 0.5481820106506348,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "22544171:abstract:700:895:5f8a08fb14fe",
          "paper_id": "22544171",
          "section": "abstract",
          "text": "The mutant LMNA mRNA and lamin A protein can be efficiently eliminated by correction of the aberrant splicing event using a modified oligonucleotide targeted to the activated cryptic splice site.",
          "score": 0.5476819276809692,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "834336:abstract:0:239:4d8c136e7b64",
          "paper_id": "834336",
          "section": "abstract",
          "text": "Hutchinson–Gilford progeria syndrome (HGPS; OMIM 176670) is an extremely rare but devastating disorder that mimics premature aging.1–3 Affected children appear normal at birth but typically develop failure to thrive in the first two years.",
          "score": 0.6292802691459656,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "15692098:abstract:2083:2158:6f1d75bdab97",
          "paper_id": "15692098",
          "section": "abstract",
          "text": "Of 34 LMNA mutations found in progeria patients, there were 26 classical p.",
          "score": 0.6594675779342651,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "15692098:abstract:0:266:bf60c7af566f",
          "paper_id": "15692098",
          "section": "abstract",
          "text": "Hutchinson-Gilford progeria syndrome (HGPS) is a rare but well known entity characterized by extreme short stature, low body weight, early loss of hair, lipodystrophy, scleroderma, decreased joint mobility, osteolysis, and facial features that resemble aged persons.",
          "score": 0.6054012179374695,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "14178995:abstract:0:201:a348afa0b4a5",
          "paper_id": "14178995",
          "section": "abstract",
          "text": "The genetic diseases Hutchinson-Gilford progeria syndrome (HGPS) and restrictive dermopathy (RD) arise from accumulation of farnesylated prelamin A because of defects in the lamin A maturation pathway.",
          "score": 0.6640655398368835,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "14178995:abstract:995:1163:2abb23383200",
          "paper_id": "14178995",
          "section": "abstract",
          "text": "This suggests that DNA damage accumulation and aberrant nuclear morphology are independent phenotypes arising from prelamin A accumulation in these progeroid syndromes.",
          "score": 0.5116671323776245,
