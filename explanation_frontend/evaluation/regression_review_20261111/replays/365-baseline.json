      "evidence_passages": [
        {
          "passage_id": "600437:abstract:646:793:3e33feb3d5dc",
          "paper_id": "600437",
          "section": "abstract",
          "text": "Such defects are mimicked by downregulation of OSBP, a VAP interactor and PI4P transporter that participates in VAP-dependent ER-endosomes tethers.",
          "score": 0.6325727701187134,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "600437:abstract:219:435:b730a824580a",
          "paper_id": "600437",
          "section": "abstract",
          "text": "Here, we report that by regulating PI4P levels on endosomes, VAP affects WASH-dependent actin nucleation on these organelles and the function of the retromer, a protein coat responsible for endosome-to-Golgi traffic.",
          "score": 0.6302318572998047,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "600437:abstract:794:881:de171a9a4f00",
          "paper_id": "600437",
          "section": "abstract",
          "text": "These results reveal a role of PI4P in retromer-/WASH-dependent budding from endosomes.",
          "score": 0.5576017498970032,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "25623469:abstract:829:1109:34eac2bf90d6",
          "paper_id": "25623469",
          "section": "abstract",
          "text": "Finally, Nem1p, has been shown to deposphorylate the yeast phosphatidic acid phosphatase Smp2p [Santos-Rosa H, Leung J, Grimsey N, Peak-Chew S, Siniossoglou S (2005) EMBO J 24:1931-1941], and we show that Dullard dephosphorylates the mammalian phospatidic acid phosphatase, lipin.",
          "score": 0.5370891094207764,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "25623469:abstract:1110:1287:8c6b6f1c2938",
          "paper_id": "25623469",
          "section": "abstract",
          "text": "Therefore, we propose that Dullard participates in a unique phosphatase cascade regulating nuclear membrane biogenesis, and that this cascade is conserved from yeast to mammals.",
          "score": 0.5056991577148438,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "4429388:abstract:242:430:64d71df2017e",
          "paper_id": "4429388",
          "section": "abstract",
          "text": "VPS4 ATPases perform a key function in this pathway by recognizing membrane-associated ESCRT-III assemblies and catalysing their disassembly, possibly in conjunction with membrane fission.",
          "score": 0.5243349075317383,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "26019505:abstract:377:582:87bbd83c5aff",
          "paper_id": "26019505",
          "section": "abstract",
          "text": "We identified 749 protein interactions, including 599 previously unrecognized interactions, and demonstrated that several interactions with serine and threonine phosphatases were phosphorylation-dependent.",
          "score": 0.5307501554489136,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "26019505:abstract:978:1281:27dd6a223f84",
          "paper_id": "26019505",
          "section": "abstract",
          "text": "Phosphatase inhibition produced temporally distinct changes in proteins that interacted with MOB1A and MOB1B (Mps one binder kinase activator-like 1A and 1B) and promoted interactions with upstream Hippo pathway proteins, such as MST1 and MST2, and with the trimeric protein phosphatase 6 complex (PP6).",
          "score": 0.5235857963562012,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "11250124:abstract:265:390:9cfecf16a4b5",
          "paper_id": "11250124",
          "section": "abstract",
          "text": "The ubiquitously expressed AP-1-sigma1A complex mediates protein sorting between the trans-Golgi network and early endosomes.",
          "score": 0.5723040699958801,
