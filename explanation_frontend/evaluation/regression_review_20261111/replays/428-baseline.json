      "processing_failures": [],
      "evidence_passages": [
        {
          "passage_id": "16728949:abstract:0:205:9f3bc1d31dd4",
          "paper_id": "16728949",
          "section": "abstract",
          "text": "The forkhead O (FoxO) family of transcription factors participates in diverse physiologic processes, including induction of cell-cycle arrest, stress resistance, differentiation, apoptosis, and metabolism.",
          "score": 0.7611713409423828,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "4418070:abstract:186:429:389edd487429",
          "paper_id": "4418070",
          "section": "abstract",
          "text": "Foxp3 operates as a late-acting differentiation factor controlling Treg cell homeostasis and function, whereas the early Treg-cell-lineage commitment is regulated by the Akt kinase and the forkhead box O (Foxo) family of transcription factors.",
          "score": 0.5809476375579834,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "4418070:abstract:577:646:1ae7b072a5d5",
          "paper_id": "4418070",
          "section": "abstract",
          "text": "Here we show that Foxo1 is a pivotal regulator of Treg cell function.",
          "score": 0.5051380395889282,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "919007:abstract:0:223:40d70aa3b564",
          "paper_id": "919007",
          "section": "abstract",
          "text": "The forkhead box (Fox) family of transcription factors, which originated in unicellular eukaryotes, has expanded over time through multiple duplication events, and sometimes through gene loss, to over 40 members in mammals.",
          "score": 0.7157260775566101,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "919007:abstract:224:314:4179ca2914fe",
          "paper_id": "919007",
          "section": "abstract",
          "text": "Fox genes have evolved to acquire a specialized function in many key biological processes.",
          "score": 0.5482255220413208,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "9393969:abstract:114:329:2ce95470c6e0",
          "paper_id": "9393969",
          "section": "abstract",
          "text": "The forkhead box O (FOXO) transcription factor DAF-16 (hereafter referred to as DAF-16/FOXO) is a central nexus in these responses, but despite its importance little is known about how it regulates its target genes.",
          "score": 0.6454992294311523,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "9393969:abstract:670:872:87c640512c58",
          "paper_id": "9393969",
          "section": "abstract",
          "text": "We show that specifically for gene activation, DAF-16/FOXO depends on SWI/SNF, facilitating SWI/SNF recruitment to target promoters, to activate transcription by presumed remodelling of local chromatin.",
          "score": 0.5441473126411438,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        }
      ],
