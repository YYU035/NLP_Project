      "processing_failures": [],
      "evidence_passages": [
        {
          "passage_id": "1550937:abstract:865:1030:d6e839b91474",
          "paper_id": "1550937",
          "section": "abstract",
          "text": "Thus, Egr2 and Egr3 regulate B and T cell function in adaptive immune responses and homeostasis by promoting antigen receptor signaling and controlling inflammation.",
          "score": 0.8518802523612976,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "1550937:abstract:419:636:6ea86b5f5fe4",
          "paper_id": "1550937",
          "section": "abstract",
          "text": "Egr2- and Egr3-defective B and T cells had hyperactive signal transducer and activator of transcription-1 (STAT1) and STAT3 while antigen receptor-induced activation of transcription factor AP-1 was severely impaired.",
          "score": 0.6744157075881958,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "1550937:abstract:167:418:ffb105df99b0",
          "paper_id": "1550937",
          "section": "abstract",
          "text": "Here, we report that deletion of both transcription factors Egr2 and Egr3 in lymphocytes resulted in a lethal autoimmune syndrome with excessive serum proinflammatory cytokines but also impaired antigen receptor-induced proliferation of B and T cells.",
          "score": 0.651024580001831,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "7399084:abstract:639:789:a2a07b76d727",
          "paper_id": "7399084",
          "section": "abstract",
          "text": "These data identify Blimp-1 as an essential regulator of T cell homeostasis and suggest that Blimp-1 regulates both B cell and T cell differentiation.",
          "score": 0.5849015712738037,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "7399084:abstract:0:231:bef93891585d",
          "paper_id": "7399084",
          "section": "abstract",
          "text": "T cell homeostasis is crucial for a functional immune system, as the accumulation of T cells resulting from lack of regulatory T cells or an inability to shut down immune responses can lead to inflammation and autoimmune pathology.",
          "score": 0.5706275701522827,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "38587347:abstract:777:1027:7f163d3cacd8",
          "paper_id": "38587347",
          "section": "abstract",
          "text": "Recent studies have identified a role for the orphan receptor, EBV-induced molecule 2 (EBI2; GPR183), in guiding activated B cells to inter and outer follicular niche(s) and down-regulation of this receptor is essential for organizing cells into GCs.",
          "score": 0.5197994112968445,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "38587347:abstract:395:508:ba8bab873a2c",
          "paper_id": "38587347",
          "section": "abstract",
          "text": "B cells must migrate from niche to niche in a rapid and highly regulated manner to successfully mount a response.",
          "score": 0.503119170665741,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "32101982:abstract:976:1120:866e15cb79ea",
          "paper_id": "32101982",
          "section": "abstract",
          "text": "Hence, our data indicate that KLF2 plays a critical role in dictating normal subset differentiation and functional reactivity of mature B cells.",
          "score": 0.5245848298072815,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "32101982:abstract:0:142:b71cbe348d09",
          "paper_id": "32101982",
          "section": "abstract",
          "text": "The transcription factor Krüppel-like factor 2 (KLF2) is critical for normal trafficking of T lymphocytes, but its role in B cells is unclear.",
          "score": 0.5201483964920044,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "21012916:abstract:173:342:0f49c8879896",
          "paper_id": "21012916",
          "section": "abstract",
          "text": "Here we found that GC-expressed ephrin B1 (EFNB1) repulsively inhibited T cell to B cell adhesion and GC TFH retention by signaling through TFH-expressed EPHB6 receptor.",
          "score": 0.5688570737838745,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        }
      ],
