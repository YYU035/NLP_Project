      "processing_failures": [],
      "evidence_passages": [
        {
          "passage_id": "25148216:abstract:1220:1523:6cfd5a26c8c0",
          "paper_id": "25148216",
          "section": "abstract",
          "text": "In addition, inducible expression of KLF4 in the HL60 human acute myeloid leukemia cell line stimulated monocytic differentiation and enhanced 12-O-tetradecanoylphorbol 13-acetate induced macrophage differentiation, but blocked all-trans-retinoic acid induced granulocytic differentiation of HL60 cells.",
          "score": 0.5960831642150879,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "25148216:abstract:0:179:568e7e5d4088",
          "paper_id": "25148216",
          "section": "abstract",
          "text": "Several members of the Kruppel-like factor (KLF) family of transcription factors play important roles in differentiation, survival, and trafficking of blood and immune cell types.",
          "score": 0.5830720663070679,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "25148216:abstract:1524:1765:441c564bc7ab",
          "paper_id": "25148216",
          "section": "abstract",
          "text": "The inflammation-selective effects of loss-of-KLF4 and the gain-of-KLF4-induced monocytic differentiation in HL60 cells identify KLF4 as a key regulator of monocytic differentiation and a potential target for translational immune modulation.",
          "score": 0.5666275024414062,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "22150633:abstract:663:741:71211a41b234",
          "paper_id": "22150633",
          "section": "abstract",
          "text": "Simultaneous depletion of Klf2, Klf4 and Klf5 lead to ES cell differentiation.",
          "score": 0.6765613555908203,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "22150633:abstract:463:575:22acf45ff778",
          "paper_id": "22150633",
          "section": "abstract",
          "text": "Maintenance of self-renewal and pluripotency of ES cells requires Oct4, Sox2 and c-Myc, but Klf4 is dispensable.",
          "score": 0.626876950263977,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "18489989:abstract:813:940:bfac90753a62",
          "paper_id": "18489989",
          "section": "abstract",
          "text": "In contrast, ES cells overexpressing Klf4 had a greater capacity to self-renew based on secondary embryoid body (EB) formation.",
          "score": 0.5877899527549744,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "18489989:abstract:1066:1187:8d9b56d8aaf8",
          "paper_id": "18489989",
          "section": "abstract",
          "text": "These findings verify the negative role of SOCS-3 on LIF signaling and provide a novel role for Klf4 in ES cell function.",
          "score": 0.562142014503479,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "18489989:abstract:941:1065:5ecfac860f6c",
          "paper_id": "18489989",
          "section": "abstract",
          "text": "Klf4-transduced d6 EBs expressed higher levels of Oct-4, consistent with the notion that Klf4 promotes ES cell self-renewal.",
          "score": 0.5569815635681152,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "6493422:abstract:727:885:0fe6259c97b8",
          "paper_id": "6493422",
          "section": "abstract",
          "text": "Collectively, these observations identify KLF2 as a tonic repressor of myeloid cell activation in vivo and an essential regulator of the innate immune system.",
          "score": 0.6702502965927124,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "6493422:abstract:184:308:48783edde645",
          "paper_id": "6493422",
          "section": "abstract",
          "text": "Herein, we identify the Kruppel-like transcription factor 2 (KLF2) as a potent regulator of myeloid cell activation in vivo.",
          "score": 0.6600017547607422,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "6493422:abstract:508:726:0b898b75cc0a",
          "paper_id": "6493422",
          "section": "abstract",
          "text": "Myeloid KLF2 was found to be a potent inhibitor of nuclear factor-kappaB (NF-κB)-dependent HIF-1α transcription and, consequently, a critical determinant of outcome in models of polymicrobial infection and endotoxemia.",
          "score": 0.5210123062133789,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        }
      ],
