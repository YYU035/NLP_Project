      "processing_failures": [],
      "evidence_passages": [
        {
          "passage_id": "25641414:abstract:636:831:67adc48f430d",
          "paper_id": "25641414",
          "section": "abstract",
          "text": "The suicide rate associated with birth was significantly lower (5.9) and the rates associated with miscarriage (18.1) and induced abortion (34.7) were significantly higher than in the population.",
          "score": 0.8252027630805969,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "25641414:abstract:0:91:d4c837fce246",
          "paper_id": "25641414",
          "section": "abstract",
          "text": "OBJECTIVE To determine rates of suicide associated with pregnancy by the type of pregnancy.",
          "score": 0.6751806735992432,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "25641414:abstract:465:584:dfb8920c94cc",
          "paper_id": "25641414",
          "section": "abstract",
          "text": "RESULTS There were 73 suicides associated with pregnancy, representing 5.4% of all suicides in women in this age group.",
          "score": 0.6352640390396118,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "7662395:abstract:711:807:81a5d4141415",
          "paper_id": "7662395",
          "section": "abstract",
          "text": "Three hundred and twelve pregnancies were aborted and 240 ended in miscarriage (total 552, 15%).",
          "score": 0.5204894542694092,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "881332:abstract:710:1031:4587d4b3dad3",
          "paper_id": "881332",
          "section": "abstract",
          "text": "Women with a history of miscarriage were not more likely than woman without a history of miscarriage to score in the probable depression range during the third trimester or at 6 or 12 months postpartum but were more likely at 1 month postpartum, after adjustment for sociodemographic factors (OR 1.66, 95 % CI 1.03–2.69).",
          "score": 0.6793438196182251,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "881332:abstract:1032:1244:069ee333f29a",
          "paper_id": "881332",
          "section": "abstract",
          "text": "Women with a history of miscarriage may be more vulnerable to depression during the first month postpartum than women without prior miscarriage, but this effect does not appear to persist beyond this time period.",
          "score": 0.6575310826301575,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "881332:abstract:0:243:baf1955fa78b",
          "paper_id": "881332",
          "section": "abstract",
          "text": "Our objective was to test the hypothesis that nulliparous women with a history of miscarriage have an increased risk of depression during late pregnancy, and at 1, 6, and 12 months postpartum compared to women without a history of miscarriage.",
          "score": 0.6392627954483032,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "25806385:abstract:734:848:4fd4b7350818",
          "paper_id": "25806385",
          "section": "abstract",
          "text": "With only one exception (Helsinki), the person-based suicide attempt rates were higher among women than among men.",
          "score": 0.5312817096710205,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "1102268:abstract:0:124:88d101c99ac3",
          "paper_id": "1102268",
          "section": "abstract",
          "text": "BACKGROUND Suicide is a significant public health issue with almost one million people dying by suicide each year worldwide.",
          "score": 0.5039325952529907,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        }
      ],
