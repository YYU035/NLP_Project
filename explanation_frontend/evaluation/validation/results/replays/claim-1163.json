      "evidence_passages": [
        {
          "passage_id": "15305881:abstract:337:505:71ef8083aa07",
          "paper_id": "15305881",
          "section": "abstract",
          "text": "Here, we report the 2.8 A structure of DdrB, a single-stranded DNA (ssDNA) binding protein unique to Deinococcus spp. that is crucial for recovery following DNA damage.",
          "score": 0.6934131979942322,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "15305881:abstract:0:188:85d1b6c71acd",
          "paper_id": "15305881",
          "section": "abstract",
          "text": "Deinococcus spp. are renowned for their amazing ability to recover rapidly from severe genomic fragmentation as a result of exposure to extreme levels of ionizing radiation or desiccation.",
          "score": 0.5860298871994019,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "15305881:abstract:801:1080:296783cd1d2d",
          "paper_id": "15305881",
          "section": "abstract",
          "text": "The need for a unique ssDNA binding function in response to severe damage, suggests a distinct role for DdrB which may encompass not only standard SSB protein function in protection of ssDNA, but also more specialized roles in protein recruitment or DNA architecture maintenance.",
          "score": 0.5800168514251709,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "799586:abstract:100:299:934cb663cc95",
          "paper_id": "799586",
          "section": "abstract",
          "text": "In Bacillus subtilis and Streptococcus pneumoniae, an alternative SSB, SsbB, is expressed uniquely during competence for genetic transformation, but its precise role has been disappointingly obscure.",
          "score": 0.5164722800254822,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "799586:abstract:1247:1379:ec8b70b33d58",
          "paper_id": "799586",
          "section": "abstract",
          "text": "SsbBΔ7 fulfils the reservoir function, suggesting that SsbB C-ter is not necessary for processing protein(s) to access stored ssDNA.",
          "score": 0.5049631595611572,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        }
      ],
