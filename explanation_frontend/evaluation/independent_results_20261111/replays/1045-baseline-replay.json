      "evidence_passages": [
        {
          "passage_id": "22500262:abstract:973:1227:2c506c3bc86b",
          "paper_id": "22500262",
          "section": "abstract",
          "text": "Cry1 expression was elevated during the night-day transition, when it reduced fasting gluconeogenic gene expression by blocking glucagon-mediated increases in intracellular cAMP concentrations and in the protein kinase A-mediated phosphorylation of Creb.",
          "score": 0.7261519432067871,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "22500262:abstract:427:617:22082ea9c03e",
          "paper_id": "22500262",
          "section": "abstract",
          "text": "Although the underlying mechanism is unclear, hepatic gluconeogenesis is also regulated by the circadian clock, which coordinates glucose metabolism with changes in the external environment.",
          "score": 0.6794618964195251,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "22500262:abstract:848:972:ffcaf7ad0b06",
          "paper_id": "22500262",
          "section": "abstract",
          "text": "Here we show that Creb activity during fasting is modulated by Cry1 and Cry2, which are rhythmically expressed in the liver.",
          "score": 0.6594104170799255,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "13277039:abstract:0:136:8d27aa64071e",
          "paper_id": "13277039",
          "section": "abstract",
          "text": "The liver contributes to glucose homeostasis by promoting either storage or production of glucose, depending on the physiological state.",
          "score": 0.5543609261512756,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "13277039:abstract:137:337:10003a7b2355",
          "paper_id": "13277039",
          "section": "abstract",
          "text": "The cAMP response element-binding protein (CREB) is a principal regulator of genes involved in coordinating the hepatic response to fasting, but its mechanism of gene activation remains controversial.",
          "score": 0.5078442692756653,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "4587978:abstract:572:767:b26e6cc2d7e5",
          "paper_id": "4587978",
          "section": "abstract",
          "text": "This gain-of-function CRY1 variant causes reduced expression of key transcriptional targets and lengthens the period of circadian molecular rhythms, providing a mechanistic link to DSPD symptoms.",
          "score": 0.7121212482452393,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "4587978:abstract:332:571:1d773e2f1a8e",
          "paper_id": "4587978",
          "section": "abstract",
          "text": "Here, we report a hereditary form of DSPD associated with a dominant coding variation in the core circadian clock gene CRY1, which creates a transcriptional inhibitor with enhanced affinity for circadian activator proteins Clock and Bmal1.",
          "score": 0.6104193329811096,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "11565780:abstract:459:597:c7439c022be0",
          "paper_id": "11565780",
          "section": "abstract",
          "text": "Gene ablation of Rgs16 leads to the loss of circadian production of cAMP and as a result lengthens circadian period of behavioural rhythm.",
          "score": 0.5568222999572754,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "11565780:abstract:220:458:6ae34da85bdc",
          "paper_id": "11565780",
          "section": "abstract",
          "text": "Here we show that the amount of RGS16 (regulator of G protein signalling 16), a protein known to inactivate Gαi, increases at a selective circadian time to allow time-dependent activation of intracellular cyclic AMP signalling in the SCN.",
          "score": 0.5186244249343872,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "14471161:abstract:389:570:1de959a940ba",
          "paper_id": "14471161",
          "section": "abstract",
          "text": "Circadian mRNA expression patterns were determined for clock genes Rev-erbalpha, Per2, and Bmal1, cellular stress genes Hspa8 and Cirbp, and cyclin A2 gene Ccna2 in liver and tumor.",
          "score": 0.5464942455291748,
