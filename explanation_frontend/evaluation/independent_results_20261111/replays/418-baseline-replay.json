      "processing_failures": [],
      "evidence_passages": [
        {
          "passage_id": "16494316:abstract:0:147:0a2e8dce643f",
          "paper_id": "16494316",
          "section": "abstract",
          "text": "Receptor tyrosine kinases are involved in regulation of key processes in endothelial biology, including proliferation, migration, and angiogenesis.",
          "score": 0.5938435792922974,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "16494316:abstract:537:729:f11eccaacee2",
          "paper_id": "16494316",
          "section": "abstract",
          "text": "This review summarizes recent advances in our understanding of endothelial receptor tyrosine kinase endocytosis and signaling using vascular endothelial growth factor receptor-2 as a paradigm.",
          "score": 0.5585147738456726,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "16494316:abstract:148:324:17d0cbacb888",
          "paper_id": "16494316",
          "section": "abstract",
          "text": "It is now generally accepted that receptor tyrosine kinase signaling occurs intracellularly and on the plasma membrane, although many important details remain to be worked out.",
          "score": 0.5116940140724182,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "11771811:abstract:141:494:4d7da1942d68",
          "paper_id": "11771811",
          "section": "abstract",
          "text": "In this study, we show that disruption of baseline fibroblast growth factor (FGF) signaling to the endothelium leads to a dramatic reduction in let-7 miRNA levels that, in turn, increases expression of transforming growth factor (TGF)-β ligands and receptors and activation of TGF-β signaling, leading to endothelial-to-mesenchymal transition (Endo-MT).",
          "score": 0.5644722580909729,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "11771811:abstract:655:888:37e1c0256bdd",
          "paper_id": "11771811",
          "section": "abstract",
          "text": "The decline in endothelial FGF signaling input is due to the appearance of an FGF resistance state that is characterized by inflammation-dependent reduction in expression and activation of key components of the FGF signaling cascade.",
          "score": 0.5618536472320557,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "11771811:abstract:889:1055:d016fe5c393e",
          "paper_id": "11771811",
          "section": "abstract",
          "text": "These results establish FGF signaling as a critical factor in maintenance of endothelial homeostasis and point to an unexpected role of Endo-MT in vascular pathology.",
          "score": 0.5383813977241516,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "19752008:abstract:0:217:467969825a40",
          "paper_id": "19752008",
          "section": "abstract",
          "text": "Phosphatidylinositol (PtdIns) 3-kinase is an enzyme implicated in growth factor signal transduction by associating with receptor and nonreceptor tyrosine kinases, including the platelet-derived growth factor receptor.",
          "score": 0.6185033321380615,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "19752008:abstract:1756:2083:b633eee3c5f8",
          "paper_id": "19752008",
          "section": "abstract",
          "text": "Since PtdIns 3-kinase appears to be centrally involved with growth factor signal transduction, the development of specific inhibitors against the kinase may be beneficial in the treatment of proliferative diseases as well as in elucidating the biological role of the kinase in cellular proliferation and growth factor response.",
          "score": 0.6153344511985779,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "39291138:abstract:1818:1970:a7fef7ee9fd7",
          "paper_id": "39291138",
          "section": "abstract",
          "text": "As it turns out, neural induction can also be achieved with FGF (fibroblast growth factor; Kengaku and Okamoto 1993; Lamb and Harland 1995; Hongo et al.",
          "score": 0.6685353517532349,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "39291138:abstract:2760:2932:6ab505f98f45",
          "paper_id": "39291138",
          "section": "abstract",
          "text": "Because FGF8 and IFG2 activate MAPK, Pera et al. (2003) took heed from previous work showing that MAPK inhibits the BMP signal-transduction factor Smad1 (Kretzschmar et al.",
          "score": 0.5903931260108948,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "39291138:abstract:2035:2089:07218b1d89da",
          "paper_id": "39291138",
          "section": "abstract",
          "text": "2000) and IGF (insulin-like growth factor; Pera et al.",
          "score": 0.5788148641586304,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
