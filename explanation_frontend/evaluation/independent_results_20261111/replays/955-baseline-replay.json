      "processing_failures": [],
      "evidence_passages": [
        {
          "passage_id": "11011905:abstract:867:954:f0ce3465e539",
          "paper_id": "11011905",
          "section": "abstract",
          "text": "Our findings provide insight into how pioneer factors can target naive chromatin sites.",
          "score": 0.7112053632736206,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "11011905:abstract:0:142:2cb80c60650d",
          "paper_id": "11011905",
          "section": "abstract",
          "text": "Pioneer transcription factors (TFs) access silent chromatin and initiate cell-fate changes, using diverse types of DNA binding domains (DBDs).",
          "score": 0.6181707382202148,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "11011905:abstract:305:514:a0c66e351fb9",
          "paper_id": "11011905",
          "section": "abstract",
          "text": "Herein, we compare the nucleosome and chromatin targeting activities of Oct4 (POU DBD), Sox2 (HMG box DBD), Klf4 (zinc finger DBD), and c-Myc (bHLH DBD), which together reprogram somatic cells to pluripotency.",
          "score": 0.5202832818031311,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "4896726:abstract:0:100:6c8888e7727d",
          "paper_id": "4896726",
          "section": "abstract",
          "text": "Pioneer transcription factors establish new cell-fate competence by triggering chromatin remodeling.",
          "score": 0.7194783687591553,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "4896726:abstract:713:989:2ccdf56c24f2",
          "paper_id": "4896726",
          "section": "abstract",
          "text": "Analysis of Pax7 dynamics during pituitary lineage specification shows that Pax7 binds rapidly at uniquely marked heterochromatin pioneer sites and initiates chromatin opening that remains stable after Pax7 withdrawal, with loss of DNA hypermethylation at pioneered enhancers.",
          "score": 0.5610859394073486,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "18998807:abstract:385:805:1b5215f1a97b",
          "paper_id": "18998807",
          "section": "abstract",
          "text": "Three striking aspects of the initial chromatin binding events include an unexpected role for c-Myc in facilitating OSK chromatin engagement, the primacy of O, S, and K as pioneer factors at enhancers of genes that promote reprogramming, and megabase-scale chromatin domains spanned by H3K9me3, including many genes required for pluripotency, that prevent initial OSKM binding and impede the efficiency of reprogramming.",
          "score": 0.5760129690170288,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "2151983:abstract:612:831:25fd35749ae9",
          "paper_id": "2151983",
          "section": "abstract",
          "text": "Importantly, we found that FOXA1 binds to genomic regions showing local DNA hypomethylation and that its cell-type-specific recruitment to chromatin is linked to differential DNA methylation levels of its binding sites.",
          "score": 0.534049391746521,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "2151983:abstract:1078:1213:0ff206e7455b",
          "paper_id": "2151983",
          "section": "abstract",
          "text": "These epigenetic changes may both stabilize FOXA1 binding and allow for subsequent recruitment of transcriptional regulatory effectors.",
          "score": 0.5045053362846375,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "13242763:abstract:314:460:88721bb12432",
          "paper_id": "13242763",
          "section": "abstract",
          "text": "Embryonic stem (ES) cells can be induced to differentiate into the TE lineage by forced repression of the POU-family transcription factor, Oct3/4.",
          "score": 0.5915336012840271,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "13242763:abstract:752:910:a860e3f01c1f",
          "paper_id": "13242763",
          "section": "abstract",
          "text": "In preimplantation embryos, Cdx2 is initially coexpressed with Oct3/4 and they form a complex for the reciprocal repression of their target genes in ES cells.",
          "score": 0.5267446041107178,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        }
      ],
