      "evidence_passages": [
        {
          "passage_id": "4926049:abstract:476:661:f634e94969a3",
          "paper_id": "4926049",
          "section": "abstract",
          "text": "We show that the TRF2-RTEL1 interaction is mediated by a metal-coordinating C4C4 motif in RTEL1, which is compromised by the Hoyeraal-Hreidarsson syndrome (HHS) mutation, RTEL1(R1264H).",
          "score": 0.7642272710800171,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "4926049:abstract:662:936:9e3671294a2b",
          "paper_id": "4926049",
          "section": "abstract",
          "text": "Conversely, we define a TRF2(I124D) substitution mutation within the TRFH domain of TRF2, which eliminates RTEL1 binding and phenocopies the RTEL1(R1264H) mutation, giving rise to aberrant t-loop excision, telomere length heterogeneity, and loss of the telomere as a circle.",
          "score": 0.6762097477912903,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "4926049:abstract:937:1051:1812654a97b7",
          "paper_id": "4926049",
          "section": "abstract",
          "text": "These results implicate TRF2 in the recruitment of RTEL1 to facilitate t-loop disassembly at telomeres in S phase.",
          "score": 0.6735917329788208,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "7848113:abstract:328:400:0f646943e6b0",
          "paper_id": "7848113",
          "section": "abstract",
          "text": "TRF1 and TRF2 are believed to promote the formation of the closed state.",
          "score": 0.5291423797607422,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "7848113:abstract:704:832:11e3fbc77eb8",
          "paper_id": "7848113",
          "section": "abstract",
          "text": "Moreover, the addition of recombinant TRF1 and TRF2 significantly stalled the replication fork progression at telomeric repeats.",
          "score": 0.5102147459983826,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        }
      ],
