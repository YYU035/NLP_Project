      "processing_failures": [],
      "evidence_passages": [
        {
          "passage_id": "24356383:abstract:1661:1787:9460faa0337e",
          "paper_id": "24356383",
          "section": "abstract",
          "text": "Thus, osteoclasts appear to be involved in the osteoblastic population and activity as well as subsequent bone mineralization.",
          "score": 0.6458749175071716,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "24356383:abstract:456:654:80e134e43045",
          "paper_id": "24356383",
          "section": "abstract",
          "text": "In the femoral metaphyses of op/op mice, intense alkaline phosphatase (ALPase)-positive osteoblasts were observed on the metaphyseal bone in close proximity to the erosion zone of the growth plates.",
          "score": 0.596338152885437,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "24356383:abstract:158:338:77fd3343a405",
          "paper_id": "24356383",
          "section": "abstract",
          "text": "In this study, we investigated the femora of op/op mice to clarify whether the osteoblastic population and bone mineralization are involved in osteoclasts or their bone resorption.",
          "score": 0.5699487328529358,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "39776978:abstract:947:1216:ac3bfb0c185a",
          "paper_id": "39776978",
          "section": "abstract",
          "text": "This Review focuses on the principal observations in osteoclast biology derived from genetic mouse models, and highlights emerging concepts that describe how the osteoclast is thought to contribute to the maintenance of adequate bone mass and integrity throughout life.",
          "score": 0.6539289951324463,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "39776978:abstract:200:372:1427f65e9282",
          "paper_id": "39776978",
          "section": "abstract",
          "text": "Over the past 15 years, a detailed picture has emerged describing the origins, differentiation pathways and activation stages that contribute to normal osteoclast function.",
          "score": 0.6277114152908325,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "39776978:abstract:112:199:131ea23b46ea",
          "paper_id": "39776978",
          "section": "abstract",
          "text": "This complex process is performed by the highly specialized, multinucleated osteoclast.",
          "score": 0.5421150922775269,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "43619625:abstract:148:311:8a2d00b6eea1",
          "paper_id": "43619625",
          "section": "abstract",
          "text": "While the role of T cells in osteoclastogenesis has received much attention recently, the effect of T cells on osteoblast formation and activity is poorly defined.",
          "score": 0.5927380323410034,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "43619625:abstract:913:1056:2ac68830d0e0",
          "paper_id": "43619625",
          "section": "abstract",
          "text": "In contrast, RANKL was constitutively expressed in primary osteoblasts and only moderately up-regulated by activated T cell conditioned medium.",
          "score": 0.5745493769645691,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "43619625:abstract:1496:1814:08e5275e0268",
          "paper_id": "43619625",
          "section": "abstract",
          "text": "Based on our data we propose that during chronic inflammation, T cells regulate bone loss by a dual mechanism involving both direct stimulation of osteoclastogenesis, by production of osteoclastogenic cytokines, and indirectly by induction of osteoblast differentiation and up-regulation of bone turnover via coupling.",
          "score": 0.5266991853713989,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "12130067:abstract:178:386:c7dc26b4bd4a",
          "paper_id": "12130067",
          "section": "abstract",
          "text": "We used the oc/oc mouse, a mouse model with impaired endochondral ossification caused by a loss of osteoclast (OCL) activity, to investigate the role of osteoblasts (OBLs) and OCLs in the HSC niche formation.",
          "score": 0.5874127149581909,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "3531388:abstract:0:110:409b84a4b500",
          "paper_id": "3531388",
          "section": "abstract",
          "text": "Bone homeostasis is maintained by the balance between bone-forming osteoblasts and bone-degrading osteoclasts.",
          "score": 0.717057466506958,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "3531388:abstract:200:359:66f554a433e5",
          "paper_id": "3531388",
          "section": "abstract",
          "text": "Osteoclast and osteoblast communication occurs through soluble factors secretion, cell-bone interaction and cell-cell contact, which modulate their activities.",
          "score": 0.6142995357513428,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "3531388:abstract:111:199:2e215542c159",
          "paper_id": "3531388",
          "section": "abstract",
          "text": "Osteoblasts have a mesenchymal origin whereas osteoclasts belong to the myeloid lineage.",
          "score": 0.5391308069229126,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        }
      ],
