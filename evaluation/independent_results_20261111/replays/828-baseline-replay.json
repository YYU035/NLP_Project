      "evidence_passages": [
        {
          "passage_id": "14584755:abstract:155:587:0f080de95554",
          "paper_id": "14584755",
          "section": "abstract",
          "text": "Although both angiotensin-converting enzyme (ACE) inhibitors and angiotensin receptor antagonists (angiotensin receptor blockers; ARBs) are equally important in the treatment of hypertension, according to the results of recent years, there might be substantial differences in their cardiovascular protective effects, and these differences might be explained by our increasing knowledge of their non-overlapping mechanisms of action.",
          "score": 0.5820128321647644,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "26025370:abstract:1207:1536:b383649a5f2f",
          "paper_id": "26025370",
          "section": "abstract",
          "text": "Conclusions: (1) CM-induced intrarenal vasoconstriction was efficiently prohibited by NAC but not bicarbonate or theophylline; (2) the vasodilatory effect of NAC was mediated via increased PGE2 synthesis, and (3) ROS accumulation was a primary renal response to CM-induced injury, not affected by any pharmacologic manipulations.",
          "score": 0.5372687578201294,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "26025370:abstract:171:348:60da457a3f36",
          "paper_id": "26025370",
          "section": "abstract",
          "text": "We compared the effects of N-acetylcysteine (NAC), theophylline or sodium bicarbonate on intrarenal vasoconstriction and ROS generation in a rat model of CM-induced nephropathy.",
          "score": 0.5032746195793152,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "26025370:abstract:922:1002:bff669027273",
          "paper_id": "26025370",
          "section": "abstract",
          "text": "Unlike theophylline or bicarbonate, NAC significantly augmented intrarenal PGE2.",
          "score": 0.5003274083137512,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "26199970:abstract:1863:2027:419b2b5f3531",
          "paper_id": "26199970",
          "section": "abstract",
          "text": "Research specifically designed to analyse the usefulness of drugs that block the angiotensin system is necessary to properly evaluate this novel psychiatric target.",
          "score": 0.5506287217140198,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "4700428:abstract:1337:1452:bcae2c2b4b27",
          "paper_id": "4700428",
          "section": "abstract",
          "text": "Both effects depended on NAC uptake through cysteine transporters and activity of the cysteine/glutamate exchanger.",
          "score": 0.5381298065185547,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "4700428:abstract:208:361:e26510731156",
          "paper_id": "4700428",
          "section": "abstract",
          "text": "Systemic N-acetylcysteine (NAC) has been shown to restore glutamate homeostasis, reduce relapse to cocaine seeking, and depotentiate PFC-NAcore synapses.",
          "score": 0.5158818364143372,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "4700428:abstract:1113:1336:38a59f6aea6c",
          "paper_id": "4700428",
          "section": "abstract",
          "text": "In slices, a low concentration of NAC reduced the amplitude of evoked glutamatergic synaptic currents in the NAcore in an mGluR2/3-dependent manner, while high doses of NAC increased amplitude in an mGluR5-dependent manner.",
