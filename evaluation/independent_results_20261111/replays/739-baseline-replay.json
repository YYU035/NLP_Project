      "processing_failures": [],
      "evidence_passages": [
        {
          "passage_id": "36180468:abstract:999:1202:5c90bc4f2724",
          "paper_id": "36180468",
          "section": "abstract",
          "text": "Thus, large numbers of potentially amyloidogenic fragments of APP are routinely generated in an acidic compartment by noncysteine proteases and then are eliminated within lysosomes by cysteine proteases.",
          "score": 0.5454497337341309,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "36180468:abstract:1378:1582:0556dcd2a514",
          "paper_id": "36180468",
          "section": "abstract",
          "text": "The results provide further support for the hypothesis that an acidic compartment may be involved in amyloid formation and begin to define the proteolytic events that may be important for amyloidogenesis.",
          "score": 0.5327003002166748,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "36180468:abstract:573:665:69f1c4b1eadb",
          "paper_id": "36180468",
          "section": "abstract",
          "text": "Nine likely contain the entire beta/A4 domain and, therefore, are potentially amyloidogenic.",
          "score": 0.5276012420654297,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "4361990:abstract:1067:1226:6c91d923d6cc",
          "paper_id": "4361990",
          "section": "abstract",
          "text": "Our results define a second processing pathway for βAPP and suggest that it may be responsible for generating amyloid-bearing fragments in Alzheimer's disease.",
          "score": 0.5164185762405396,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "37450671:abstract:782:940:b0679cb89a02",
          "paper_id": "37450671",
          "section": "abstract",
          "text": "The amyloid of Alzheimer's disease is similar in subunit size, composition but not sequence to the scrapie-associated fibril and its constituent polypeptides.",
          "score": 0.5798745155334473,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "37450671:abstract:603:781:cf6b858d20c6",
          "paper_id": "37450671",
          "section": "abstract",
          "text": "The non-protein component of the amyloid (aluminum silicate) may form the basis for the deposition or amplification (possible self-replication) of the aggregated amyloid protein.",
          "score": 0.5788760781288147,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "37450671:abstract:208:340:9a7363ec9f10",
          "paper_id": "37450671",
          "section": "abstract",
          "text": "Based on the degree of N-terminal heterogeneity, the amyloid is first deposited in the neuron, and later in the extracellular space.",
          "score": 0.5525366067886353,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "46266579:abstract:417:641:33b2a510d55f",
          "paper_id": "46266579",
          "section": "abstract",
          "text": "In murine amyloid A type amyloidosis, the binding of these antibodies to the residual SAP in amyloid deposits activates complement and triggers the rapid clearance of amyloid by macrophage-derived multinucleated giant cells.",
          "score": 0.51356440782547,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "4459491:abstract:149:335:7332fcd40b73",
          "paper_id": "4459491",
          "section": "abstract",
          "text": "The amyloid hypothesis of Alzheimer’s disease posits that the excessive accumulation of amyloid-β peptide leads to neurofibrillary tangles composed of aggregated hyperphosphorylated tau.",
          "score": 0.5248110890388489,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "4459491:abstract:1581:1683:0aaefa9c4747",
          "paper_id": "4459491",
          "section": "abstract",
          "text": "We also found that glycogen synthase kinase 3 (GSK3) regulated amyloid-β-mediated tau phosphorylation.",
          "score": 0.5110760927200317,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "4459491:abstract:1684:1795:084a4ec90d72",
          "paper_id": "4459491",
          "section": "abstract",
          "text": "We have successfully recapitulated amyloid-β and tau pathology in a single 3D human neural cell culture system.",
          "score": 0.5031173229217529,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        }
      ],
