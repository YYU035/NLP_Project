      "evidence_passages": [
        {
          "passage_id": "24705390:abstract:0:108:f17e654019fd",
          "paper_id": "24705390",
          "section": "abstract",
          "text": "BACKGROUND & AIMS Helicobacter pylori is an important etiologic factor in the development of gastric cancer.",
          "score": 0.8327507972717285,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "24705390:abstract:109:244:b6649c1b611a",
          "paper_id": "24705390",
          "section": "abstract",
          "text": "The aim of this study was to analyze the role of H. pylori infections in the induction of mutagenic events in gastric epithelial cells.",
          "score": 0.8186066150665283,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "24705390:abstract:745:913:38d721f20eb8",
          "paper_id": "24705390",
          "section": "abstract",
          "text": "RESULTS After 6 months, the gastric mutant frequency was 4-fold and 1.7-fold higher in mice infected with H. pylori and H. felis, respectively, than in uninfected mice.",
          "score": 0.7348768711090088,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "22703082:abstract:603:811:85b772a3918a",
          "paper_id": "22703082",
          "section": "abstract",
          "text": "Our findings provide evidence that aberrant AID expression caused by H. pylori infection might be a mechanism of mutation accumulation in the gastric mucosa during H. pylori–associated gastric carcinogenesis.",
          "score": 0.9048489332199097,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "22703082:abstract:0:102:ac3fe6670a91",
          "paper_id": "22703082",
          "section": "abstract",
          "text": "Infection with Helicobacter pylori (H. pylori) is a risk factor for the development of gastric cancer.",
          "score": 0.8354583978652954,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "22703082:abstract:448:602:1720c2132cbe",
          "paper_id": "22703082",
          "section": "abstract",
          "text": "H. pylori–mediated upregulation of AID resulted in the accumulation of nucleotide alterations in the TP53 tumor suppressor gene in gastric cells in vitro.",
          "score": 0.8072202205657959,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "29367554:abstract:821:1005:6e474e667453",
          "paper_id": "29367554",
          "section": "abstract",
          "text": "RESULTS Interaction of H pylori with gastric epithelial cells leads to robust up-regulation of p73 protein in vitro and in vivo in human gastritis specimens and H pylori-infected mice.",
          "score": 0.7809178233146667,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "29367554:abstract:347:576:67f2eccdc832",
          "paper_id": "29367554",
          "section": "abstract",
          "text": "METHODS Gastric epithelial cells were cocultured with Helicobacter pylori, and the roles of p63 and p73 proteins were assessed by luciferase reporter, real-time polymerase chain reaction, immunoblotting, and cell survival assays.",
          "score": 0.7437189817428589,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "29367554:abstract:1378:1563:74a52d6439ba",
          "paper_id": "29367554",
          "section": "abstract",
          "text": "CONCLUSION Our findings implicate p73 in H pylori-induced apoptosis and more generally suggest that the p53 family may play a role in the epithelial cell response to H pylori infection.",
          "score": 0.6432054042816162,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "39550665:abstract:1491:1658:4b88f95fba04",
          "paper_id": "39550665",
          "section": "abstract",
          "text": "CONCLUSIONS Using a novel CagA(+)H pylori infection model, we report here that the development of tolerance to H pylori protects from gastric cancer precursor lesions.",
          "score": 0.8063737154006958,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "39550665:abstract:0:167:5c1aa916a799",
          "paper_id": "39550665",
          "section": "abstract",
          "text": "BACKGROUND & AIMS Chronic infection with the bacterial pathogen Helicobacter pylori causes gastric disorders, ranging from chronic gastritis to gastric adenocarcinoma.",
          "score": 0.683314859867096,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "39550665:abstract:691:884:fb12c57d09dd",
          "paper_id": "39550665",
          "section": "abstract",
          "text": "RESULTS Mice infected at 5-6 weeks of age with CagA(+)H pylori rapidly develop gastritis, gastric atrophy, epithelial hyperplasia, and metaplasia in a type IV secretion system-dependent manner.",
          "score": 0.6729142665863037,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "7465900:abstract:625:774:b284f9ef0481",
          "paper_id": "7465900",
          "section": "abstract",
          "text": "METHODS AGS cells (wild-type or with suppressed APE-1), KATO III cells, and cells isolated from gastric biopsy specimens were infected with H pylori.",
          "score": 0.7306632995605469,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "7465900:abstract:0:271:331d320a4e78",
          "paper_id": "7465900",
          "section": "abstract",
          "text": "BACKGROUND & AIMS Helicobacter pylori-induced gastric epithelial cell (GEC) apoptosis is a complex process that includes activation of the tumor suppressor p53. p53-mediated apoptosis involves p53 activation, bax transcription, and cytochrome c release from mitochondria.",
          "score": 0.6652500629425049,
