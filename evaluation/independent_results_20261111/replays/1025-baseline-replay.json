      "processing_failures": [],
      "evidence_passages": [
        {
          "passage_id": "32408470:abstract:707:843:a5243eacb1af",
          "paper_id": "32408470",
          "section": "abstract",
          "text": "Phosphorylation of IRS1 leads to its degradation, protein kinase B inhibition, and the loss of insulin-mediated inhibition of lipolysis.",
          "score": 0.5222561955451965,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "4319174:abstract:387:691:cf052812d704",
          "paper_id": "4319174",
          "section": "abstract",
          "text": "Acting via the β(3)-adrenergic receptors, noradrenaline induces lipolysis in white adipocytes, whereas it stimulates the expression of thermogenic genes, such as PPAR-γ coactivator 1a (Ppargc1a), uncoupling protein 1 (Ucp1) and acyl-CoA synthetase long-chain family member 1 (Acsl1), in brown adipocytes.",
          "score": 0.5577727556228638,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "4319174:abstract:959:1188:fff5369512cb",
          "paper_id": "4319174",
          "section": "abstract",
          "text": "Exposure to cold temperature rapidly promoted alternative activation of adipose tissue macrophages, which secrete catecholamines to induce thermogenic gene expression in brown adipose tissue and lipolysis in white adipose tissue.",
          "score": 0.5302087068557739,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "17933691:abstract:983:1174:c2f286edd88d",
          "paper_id": "17933691",
          "section": "abstract",
          "text": "Similarly, basic adipocyte functions, such as triglyceride synthesis and lipolysis occurred at levels similar to those observed with subcutaneous adipose tissue progenitor-derived adipocytes.",
          "score": 0.6036329865455627,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "17933691:abstract:126:250:12fafd5003ad",
          "paper_id": "17933691",
          "section": "abstract",
          "text": "The aim of this study was to determine the extent to which these progenitors differentiate into fully functional adipocytes.",
          "score": 0.5476478338241577,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "17933691:abstract:1175:1374:7567c28a8338",
          "paper_id": "17933691",
          "section": "abstract",
          "text": "However, muscle progenitor-derived adipocytes were found to be insensitive to insulin-induced glucose uptake, in association with the impairment of phosphorylation of key insulin-signaling effectors.",
          "score": 0.5392953157424927,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "5106691:abstract:104:336:3770ae4135ac",
          "paper_id": "5106691",
          "section": "abstract",
          "text": "In contrast to the belief that inflammatory signals exert a fundamentally negative impact on metabolism, we show that proinflammatory signaling in the adipocyte is in fact required for proper adipose tissue remodeling and expansion.",
          "score": 0.5955714583396912,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "5106691:abstract:337:558:fc40fd908de7",
          "paper_id": "5106691",
          "section": "abstract",
          "text": "Three mouse models with an adipose tissue-specific reduction in proinflammatory potential were generated that display a reduced capacity for adipogenesis in vivo, while the differentiation potential is unaltered in vitro.",
          "score": 0.5848541259765625,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "5106691:abstract:773:927:09eb4b229a85",
          "paper_id": "5106691",
          "section": "abstract",
          "text": "An impaired local proinflammatory response in the adipocyte leads to increased ectopic lipid accumulation, glucose intolerance, and systemic inflammation.",
          "score": 0.5373210906982422,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "9178310:abstract:576:663:bb6bf384df7e",
          "paper_id": "9178310",
          "section": "abstract",
          "text": "Moreover, cellular senescence and inflammasomes were activated in obese adipose tissue.",
          "score": 0.5363191366195679,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "9178310:abstract:1229:1338:976dfeaffc9f",
          "paper_id": "9178310",
          "section": "abstract",
          "text": "Our findings strongly suggest lysosomal dysfunction is involved in early pathologies of obese adipose tissue.",
          "score": 0.5288715362548828,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "9178310:abstract:402:575:337ece57e51f",
          "paper_id": "9178310",
          "section": "abstract",
          "text": "We also found protein and activity levels of CTSL (cathepsin L) were suppressed in obese adipose tissue, while the activity of CTSB (cathepsin B) was significantly enhanced.",
          "score": 0.5174919366836548,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        }
