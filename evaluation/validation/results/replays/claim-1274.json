      "evidence_passages": [
        {
          "passage_id": "27731651:abstract:0:174:64c1d916482a",
          "paper_id": "27731651",
          "section": "abstract",
          "text": "The bacterial type VI secretion system (T6SS) is an organelle that is structurally and mechanistically analogous to an intracellular membrane-attached contractile phage tail.",
          "score": 0.7181140184402466,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "27731651:abstract:175:425:1cbfeb9cc8d0",
          "paper_id": "27731651",
          "section": "abstract",
          "text": "Recent studies determined that a rapid conformational change in the structure of a sheath protein complex propels T6SS spike and tube components along with antibacterial and antieukaryotic effectors out of predatory T6SS(+) cells and into prey cells.",
          "score": 0.5299181342124939,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "7481159:abstract:0:128:04a115ba3cc4",
          "paper_id": "7481159",
          "section": "abstract",
          "text": "Gram-negative bacteria use the Type VI secretion system (T6SS) to inject toxic proteins into rival bacteria or eukaryotic cells.",
          "score": 0.7191882133483887,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "4406819:abstract:0:177:bd6c3df65139",
          "paper_id": "4406819",
          "section": "abstract",
          "text": "The bacterial type VI secretion system (T6SS) is a large multicomponent, dynamic macromolecular machine that has an important role in the ecology of many Gram-negative bacteria.",
          "score": 0.695891261100769,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "4406819:abstract:1034:1178:03c4f035ad06",
          "paper_id": "4406819",
          "section": "abstract",
          "text": "We demonstrate that PAAR proteins are essential for T6SS-mediated secretion and target cell killing by Vibrio cholerae and Acinetobacter baylyi.",
          "score": 0.5578414797782898,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "12428814:abstract:123:337:7f6eac4495ca",
          "paper_id": "12428814",
          "section": "abstract",
          "text": "Factors mediating substrate recognition by the type VI secretion system (T6SS) of Gram-negative bacteria, a widespread pathway that translocates effector proteins into target bacterial cells, have not been defined.",
          "score": 0.7144898176193237,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "22632303:abstract:0:128:cefe11cd31a2",
          "paper_id": "22632303",
          "section": "abstract",
          "text": "Type VI protein secretion system (T6SS) is important for bacterial competition through contact-dependent killing of competitors.",
          "score": 0.7177459597587585,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "22632303:abstract:1048:1233:f4c5f05cf0b0",
          "paper_id": "22632303",
          "section": "abstract",
          "text": "We also identified their three cognate T6SS-secreted effectors and show these are important for not only antibacterial and antieukaryotic activities but also assembly of T6SS apparatus.",
          "score": 0.6419965624809265,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "22632303:abstract:284:481:090c61f10076",
          "paper_id": "22632303",
          "section": "abstract",
          "text": "Although T6SS has been found in more than 100 gram-negative bacteria including many important human pathogens, few T6SS-dependent effector and immunity proteins have been experimentally determined.",
          "score": 0.539903461933136,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        }
