      "processing_failures": [],
      "evidence_passages": [
        {
          "passage_id": "12588500:abstract:303:462:5a04f188ab88",
          "paper_id": "12588500",
          "section": "abstract",
          "text": "However, the molecular functions of the acetylation of newly synthesized histones in this DNA replication-coupled nucleosome assembly pathway remain enigmatic.",
          "score": 0.620684802532196,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "12588500:abstract:463:729:977c1ed31ccb",
          "paper_id": "12588500",
          "section": "abstract",
          "text": "Here we show that histone H3 acetylated at lysine 56 (H3K56Ac) is incorporated onto replicating DNA and, by increasing the binding affinity of CAF-1 and Rtt106 for histone H3, H3K56Ac enhances the ability of these histone chaperones to assemble DNA into nucleosomes.",
          "score": 0.5845136642456055,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "12588500:abstract:0:148:b03cfafc498e",
          "paper_id": "12588500",
          "section": "abstract",
          "text": "Chromatin assembly factor 1 (CAF-1) and Rtt106 participate in the deposition of newly synthesized histones onto replicating DNA to form nucleosomes.",
          "score": 0.5522099137306213,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "14637235:abstract:423:627:0da7320f7f05",
          "paper_id": "14637235",
          "section": "abstract",
          "text": "Here we demonstrate that excess histones associate with Rad53 in vivo and seem to undergo modifications such as tyrosine phosphorylation and polyubiquitylation, before their proteolysis by the proteasome.",
          "score": 0.7766454219818115,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "14637235:abstract:233:422:8c43d8e11408",
          "paper_id": "14637235",
          "section": "abstract",
          "text": "Although chromosomal histones are stable, excess (non-chromatin bound) histones are rapidly degraded in a Rad53 (radiation sensitive 53) kinase-dependent manner in Saccharomyces cerevisiae.",
          "score": 0.7602537870407104,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "14637235:abstract:0:232:2d6813a622e9",
          "paper_id": "14637235",
          "section": "abstract",
          "text": "Histone levels are tightly regulated to prevent harmful effects such as genomic instability and hypersensitivity to DNA-damaging agents due to the accumulation of these highly basic proteins when DNA replication slows down or stops.",
          "score": 0.632006049156189,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "8267678:abstract:543:778:e46b97b5954f",
          "paper_id": "8267678",
          "section": "abstract",
          "text": "Here, we describe the known histone modifications, define where they are found genomically and discuss some of their functional consequences, concentrating mostly on transcription where the majority of characterisation has taken place.",
          "score": 0.6051290035247803,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "8267678:abstract:382:542:d3a5f11254b1",
          "paper_id": "8267678",
          "section": "abstract",
          "text": "However, it is clear that histone modifications play fundamental roles in most biological processes that are involved in the manipulation and expression of DNA.",
          "score": 0.600459098815918,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "8267678:abstract:144:252:84faef86e739",
          "paper_id": "8267678",
          "section": "abstract",
          "text": "A principle component of chromatin that plays a key role in this regulation is the modification of histones.",
          "score": 0.5501422882080078,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "406733:abstract:256:352:01dfc291dd7d",
          "paper_id": "406733",
          "section": "abstract",
          "text": "We have analyzed where the histones for reassembly of the inactive promoter chromatin come from.",
          "score": 0.5988675355911255,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "406733:abstract:353:585:75191a7ec497",
          "paper_id": "406733",
          "section": "abstract",
          "text": "The use of a strain with two differently tagged and differently regulated versions of histone H3 allowed us to discriminate between histones originating from the chromatin fraction and histones arising from the soluble histone pool.",
          "score": 0.5402109622955322,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "406733:abstract:586:671:af73298e2983",
          "paper_id": "406733",
          "section": "abstract",
          "text": "In this way, we show that the incorporated histones originate from a source in trans.",
          "score": 0.5247347354888916,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "13790144:abstract:128:359:625baa773963",
          "paper_id": "13790144",
          "section": "abstract",
          "text": "Although histones have a high degree of conservation due to constraints to maintain the overall structure of the nucleosomal octameric core, variants have evolved to assume diverse roles in gene regulation and epigenetic silencing.",
          "score": 0.6243557929992676,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "13790144:abstract:360:531:44d3799f27ba",
          "paper_id": "13790144",
          "section": "abstract",
          "text": "Histone variants, post-translational modifications and interactions with chromatin remodeling complexes influence DNA replication, transcription, repair and recombination.",
          "score": 0.549929141998291,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        }
      ],
