      "processing_failures": [],
      "evidence_passages": [
        {
          "passage_id": "7454794:abstract:1082:1223:0349a8de551b",
          "paper_id": "7454794",
          "section": "abstract",
          "text": "In appropriately selected individuals, statins should also be used for primary prevention of ischaemic stroke and transient ischaemic attack.",
          "score": 0.5812031030654907,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "7454794:abstract:662:824:4d984b73415a",
          "paper_id": "7454794",
          "section": "abstract",
          "text": "Data clearly support the use of statins for primary prevention in high-risk individuals, in whom the strategy is cost-effective and the benefits exceed the risks.",
          "score": 0.568985104560852,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "7454794:abstract:275:418:cc99dca953a9",
          "paper_id": "7454794",
          "section": "abstract",
          "text": "Firstly, evidence suggests that, in primary prevention, statins substantially decrease CVD morbidity, but only moderately reduce CVD mortality.",
          "score": 0.5371896624565125,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "21557614:abstract:59:168:a22e91be616a",
          "paper_id": "21557614",
          "section": "abstract",
          "text": "In clinical trials, statins are beneficial in the primary and secondary prevention of coronary heart disease.",
          "score": 0.6081036329269409,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "21557614:abstract:643:737:5b13ca92ee7c",
          "paper_id": "21557614",
          "section": "abstract",
          "text": "Furthermore, statins have beneficial extrahepatic effects on the immune system, CNS, and bone.",
          "score": 0.5431681871414185,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "21557614:abstract:0:58:cb79fc38f06d",
          "paper_id": "21557614",
          "section": "abstract",
          "text": "Statins are potent inhibitors of cholesterol biosynthesis.",
          "score": 0.539008617401123,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "5698494:abstract:1111:1343:f9cdbe772ad7",
          "paper_id": "5698494",
          "section": "abstract",
          "text": "Treatment with statins significantly reduced the risk of all cause mortality (odds ratio 0.88, 95% confidence interval 0.81 to 0.96), major coronary events (0.70, 0.61 to 0.81), and major cerebrovascular events (0.81, 0.71 to 0.93).",
          "score": 0.5505037307739258,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "5698494:abstract:1491:1722:4bc00b6dff26",
          "paper_id": "5698494",
          "section": "abstract",
          "text": "CONCLUSION In patients without established cardiovascular disease but with cardiovascular risk factors, statin use was associated with significantly improved survival and large reductions in the risk of major cardiovascular events.",
          "score": 0.5061843395233154,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        }
