      "processing_failures": [],
      "evidence_passages": [
        {
          "passage_id": "14717500:abstract:1617:1849:a60868c44834",
          "paper_id": "14717500",
          "section": "abstract",
          "text": "In conclusion, uncommon or rare genetic variants can easily create synthetic associations that are credited to common variants, and this possibility requires careful consideration in the interpretation and follow up of GWAS signals.",
          "score": 0.6357018947601318,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "14717500:abstract:0:240:d623adf21696",
          "paper_id": "14717500",
          "section": "abstract",
          "text": "Genome-wide association studies (GWAS) have now identified at least 2,000 common variants that appear associated with common diseases or related traits (http://www.genome.gov/gwastudies), hundreds of which have been convincingly replicated.",
          "score": 0.6238598227500916,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "14717500:abstract:476:731:6a28a040a24f",
          "paper_id": "14717500",
          "section": "abstract",
          "text": "We propose as an alternative explanation that variants much less common than the associated one may create \"synthetic associations\" by occurring, stochastically, more often in association with one of the alleles at the common site versus the other allele.",
          "score": 0.5728593468666077,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "2739854:abstract:0:109:8ddbc2c50202",
          "paper_id": "2739854",
          "section": "abstract",
          "text": "Genome-wide association studies have greatly improved our understanding of the genetic basis of disease risk.",
          "score": 0.5232477784156799,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "23389795:abstract:424:671:e0f2a480b779",
          "paper_id": "23389795",
          "section": "abstract",
          "text": "The identification of rare variants involves the careful selection of candidate genes to examine, the availability of highly efficient resequencing techniques and the appropriate assessment of the functional consequences of the implicated variant.",
          "score": 0.6989741325378418,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "23389795:abstract:0:243:772659cca088",
          "paper_id": "23389795",
          "section": "abstract",
          "text": "Here, we give a historical overview of the search for genetic variants that influence the susceptibility of an individual to a chronic disease, from RA Fisher's seminal work to the current excitement of whole-genome association studies (WGAS).",
          "score": 0.6097698211669922,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "23389795:abstract:244:423:a73208773e1b",
          "paper_id": "23389795",
          "section": "abstract",
          "text": "We then discuss the concepts behind the identification of common variants as disease causal factors and contrast them to the basic ideas that underlie the rare variant hypothesis.",
          "score": 0.5985223650932312,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "13519661:abstract:402:630:8d328612951e",
          "paper_id": "13519661",
          "section": "abstract",
          "text": "In this study, we aimed to assess the importance of common CHEK2 variants on population risk for breast cancer by capturing the majority of diversity in the gene using haplotype tagging single nucleotide polymorphisms (tagSNPs).",
          "score": 0.55661940574646,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "4414547:abstract:0:138:760213a33f29",
          "paper_id": "4414547",
          "section": "abstract",
          "text": "Improved sequencing technologies offer unprecedented opportunities for investigating the role of rare genetic variation in common disease.",
          "score": 0.7222722172737122,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "4414547:abstract:1641:1814:63066ecf5374",
          "paper_id": "4414547",
          "section": "abstract",
          "text": "More generally, these data provide new insights into the role of rare and of mosaic genetic variants in common conditions, and the use of sequencing in their identification.",
          "score": 0.710564136505127,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "4414547:abstract:243:649:5da380b9af24",
          "paper_id": "4414547",
          "section": "abstract",
          "text": "Using pooled next-generation sequencing of 507 genes implicated in the repair of DNA in 1,150 samples, an analytical strategy focused on protein-truncating variants (PTVs) and a large-scale sequencing case–control replication experiment in 13,642 individuals, here we show that rare PTVs in the p53-inducible protein phosphatase PPM1D are associated with predisposition to breast cancer and ovarian cancer.",
          "score": 0.5427759885787964,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        }
      ],
