      "processing_failures": [],
      "evidence_passages": [
        {
          "passage_id": "40900567:abstract:814:963:5d396e49b697",
          "paper_id": "40900567",
          "section": "abstract",
          "text": "P. falciparum parasites causing severe malaria were less selective and multiplied more at high parasitemias than those causing uncomplicated malaria.",
          "score": 0.6272525787353516,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "40900567:abstract:620:813:1732ad749721",
          "paper_id": "40900567",
          "section": "abstract",
          "text": "Parasites causing severe malaria exhibited unrestricted red blood cell invasion, whereas those from uncomplicated malaria were restricted to a geometric mean of 40 (31%-53%) of red blood cells.",
          "score": 0.6057469248771667,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "40900567:abstract:224:374:2b6d4289520b",
          "paper_id": "40900567",
          "section": "abstract",
          "text": "To simulate severe malaria and control for host effects, the in vitro cultures were adjusted to 1% parasitemia and used the same red blood cell donor.",
          "score": 0.5922529697418213,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "1349033:abstract:1047:1262:a126a4d70db1",
          "paper_id": "1349033",
          "section": "abstract",
          "text": "We review historical evidence that larval control of African malaria vectors can be effective and conclude that the only limitations to the effective coverage of larval control are practical rather than fundamental.",
          "score": 0.6708070635795593,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "1349033:abstract:1263:1540:7daec2fa0d21",
          "paper_id": "1349033",
          "section": "abstract",
          "text": "Larval control strategies against the vectors of malaria in sub-Saharan Africa could be highly effective, complementary to adult control interventions, and should be prioritized for further development, evaluation and implementation as an integral part of Rolling Back Malaria.",
          "score": 0.6277798414230347,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "1349033:abstract:0:256:381716385cd4",
          "paper_id": "1349033",
          "section": "abstract",
          "text": "Based on sensitivity analysis of the MacDonald-Ross model, it has long been argued that the best way to reduce malaria transmission is to target adult female mosquitoes with insecticides that can reduce the longevity and human-feeding frequency of vectors.",
          "score": 0.6257884502410889,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "5289038:abstract:0:179:cdc4ef403239",
          "paper_id": "5289038",
          "section": "abstract",
          "text": "Immune clearance and resource limitation (via red blood cell depletion) shape the peaks and troughs of malaria parasitemia, which in turn affect disease severity and transmission.",
          "score": 0.6915985345840454,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "5289038:abstract:273:500:aec5327dd884",
          "paper_id": "5289038",
          "section": "abstract",
          "text": "Using data from rodent malaria, we estimated the effective propagation number, which reflects the relative importance of contrasting within-host control mechanisms through time and is sensitive to the inoculating parasite dose.",
          "score": 0.612435519695282,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "5289038:abstract:501:735:fde4fce317d9",
          "paper_id": "5289038",
          "section": "abstract",
          "text": "Our analysis showed that the capacity of innate responses to restrict initial parasite growth saturates with parasite dose and that experimentally enhanced innate immunity can affect parasite density indirectly via resource depletion.",
          "score": 0.5662504434585571,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "13959707:abstract:0:106:4ef5537f0d29",
          "paper_id": "13959707",
          "section": "abstract",
          "text": "BACKGROUND Plasmodium falciparum malaria remains a major cause of illness and death in sub-Saharan Africa.",
          "score": 0.6106932163238525,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "13959707:abstract:296:519:350b567b0500",
          "paper_id": "13959707",
          "section": "abstract",
          "text": "A better understanding of the host factors associated with immunity to clinical malaria and the ability to sustain asymptomatic P. falciparum infection will aid the development of improved strategies for disease prevention.",
          "score": 0.6067520976066589,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "13959707:abstract:721:892:e13d042aaaa2",
          "paper_id": "13959707",
          "section": "abstract",
          "text": "We find that the ratio of monocytes to lymphocytes, measured in peripheral blood at the time of survey, directly correlates with risk of clinical malaria during follow-up.",
          "score": 0.57955002784729,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "18074797:abstract:214:558:75c38eb206dd",
          "paper_id": "18074797",
          "section": "abstract",
          "text": "METHODS AND FINDINGS We developed an individual-based simulation model for Plasmodium falciparum transmission in an African context incorporating the three major vector species (Anopheles gambiae s.s., An. arabiensis, and An. funestus) with parameters obtained by fitting to parasite prevalence data from 34 transmission settings across Africa.",
          "score": 0.6322886347770691,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "18074797:abstract:2164:2323:5eeb39b35a45",
          "paper_id": "18074797",
          "section": "abstract",
          "text": "CONCLUSIONS Interventions using current tools can result in major reductions in P. falciparum malaria transmission and the associated disease burden in Africa.",
          "score": 0.6253900527954102,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        },
        {
          "passage_id": "18074797:abstract:0:95:c789667495ab",
          "paper_id": "18074797",
          "section": "abstract",
          "text": "BACKGROUND Over the past decade malaria intervention coverage has been scaled up across Africa.",
          "score": 0.5921595692634583,
          "page": null,
          "sentence_indices": [],
          "source_version": null
        }
